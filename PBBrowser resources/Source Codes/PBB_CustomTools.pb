; *******************************************************;;          PB Browser Custom Tools - Nov 2026;;; PB Browser is designed to be a PureBasic tool.; But this tool can also have tools added to it,; which you can write yourself, by tapping into the; library of functions already written to explore; your source code or to transform them in an; automated way.;; To add a tool to the list of PB Browser tools,; nothing could be simpler:; 1- Write a procedure without input parameters; 2- Set up a variable with the structure 'CommandDetails'.;    If you name your variable 'NCommand', for example, it would;    look like: NCommand.CommandDetails\CommandName$ = "Tool Name".;;    You need to fill in the following fields:;     \CommandName$          must contain the name of your tool.;     \Commandtype           must be '1'.;     \CommandDescription$   must contain the tool's description.;     \CommandSimpleProcAddr must contain the address of the procedure.; 3- Add the line 'AddCommandToList(@NCommand)' (with your variable address;    as the parameter) following points 1- and 2-.;; And that's all. From that point, the tool will appear in the; list of PB Browser tools, and you can assign a keyboard shortcut; to it if you wish.;; A small possible subtlety: if you want to make your tool multilingual,; you can add lines in the 'Catalog' files, and indicate the names of these; lines with the mention 'InCatalog:' in the fields; \CommandName$ and \CommandDescription$, as you can see in the tool; 'ExportPBBSrcFile()' below. But this is completely optional.;; To keep it simple, follow the example below:;; Procedure ToolExample();   AlertInPBBWindow("Hello!"); EndProcedure; ;; NCommand.CommandDetails\CommandName$ = "Tool Example"; NCommand\Commandtype = 1; NCommand\CommandDontShow = 0; NCommand\CommandDescription$   = "Tool Example is a very simple tool which does absolutely nothing, except printing a message."; NCommand\CommandSimpleProcAddr = @ToolExample(); AddCommandToList(@NCommand);; If you remove the comments from the lines of this example, you will see it; appear in the list of PB Browser tools.;; Or even shorter, anywhere below 'RegisterCustomTool()' in this file, you can; register your parameterless tool in a single line instead of filling 'NCommand':;; RegisterCustomTool("Tool Example", "Tool Example is a very simple tool which does absolutely nothing, except printing a message.", @ToolExample());; *******************************************************;Procedure RegisterCustomTool(Name$, Description$, *ProcAddr, DontShow = 0)  ;  ; Role: Populates a clean CommandDetails record for a parameterless custom tool (Commandtype = 1)  ;       and registers it in CommandList().  ;  Protected Cmd.CommandDetails  ;  Cmd\CommandName$          = Name$  Cmd\Commandtype           = 1  Cmd\CommandDontShow       = DontShow  Cmd\CommandDescription$   = Description$  Cmd\CommandSimpleProcAddr = *ProcAddr  AddCommandToList(@Cmd)EndProcedure;; --------------------------------------------------------------------------;                   --- Cosmetic File Transformer ---; --------------------------------------------------------------------------;Procedure.i CosmeticOneFile(FileName$)  ;  ; Role: Performs high-speed, single-pass cosmetic whitespace normalization on 'FileName$'.  ;       Standardizes spaces around operators, keywords, module prefixes ('::'), colons, labels,  ;       commas, and parentheses while strictly protecting comments, inline ASM ('!'),  ;       string literals (both standard "..." and escaped ~"..."), and character literals ('...').  ; Output: Returns #True if the file was modified and saved back to disk, #False otherwise.  ;  Protected CodeContent.String  Protected *In.Character              ; Read pointer advancing through the source code  Protected *Out.Character             ; Write pointer assembling formatted text into *OutStart  Protected *OutStart                  ; Base address of the pre-allocated output memory buffer  Protected *WordStartIn.Character     ; Start address of the current alphanumeric identifier in *In  Protected *LookAhead.Character       ; Lookahead pointer used to inspect characters past an identifier  Protected InputLen, OutputBufferSize, WordCharCount, FileEncoding, HasBOM  Protected InString, InEscapedString, InCharLiteral, InComment  Protected AtLineStart = #True        ; #True while copying leading indentation at the start of a line  Protected LineTokenCount             ; Count of tokens seen on the current line (used to detect standalone labels)  Protected LastNonSpaceChar           ; Last significant non-whitespace character written to *Out  Protected C, NextC, PrevC, IsLabel  Protected WordLCase$, FormattedCode$  Protected CharSize = SizeOf(Character)  ;  ; --------------------------------------------------------------------------------------------------  ; STEP 1: LOAD RAW FILE CONTENT (PRESERVING ORIGINAL ENCODING, BOM, AND LINE ENDINGS)  ; --------------------------------------------------------------------------------------------------  CodeContent\s = FileToText(FileName$)  FileEncoding  = BOM  HasBOM        = FileHasBOM  InputLen      = Len(CodeContent\s)  If InputLen = 0    ProcedureReturn #False  EndIf  ;  ; --------------------------------------------------------------------------------------------------  ; STEP 2: PRE-ALLOCATE CONTIGUOUS OUTPUT BUFFER  ; --------------------------------------------------------------------------------------------------  OutputBufferSize = (InputLen * 2 + 4096) * CharSize  *OutStart        = AllocateMemory(OutputBufferSize)  If *OutStart = 0    ProcedureReturn #False  EndIf  ;  *In  = @CodeContent\s  *Out = *OutStart  ;  ; --------------------------------------------------------------------------------------------------  ; STEP 3: SINGLE-PASS STREAM PARSER  ; --------------------------------------------------------------------------------------------------  While *In\c <> 0    C = *In\c    ;    ; ================================================================================================    ; A. COMMENTS (';' TO EOL) & INLINE ASSEMBLY ('!' AT LINE START TO EOL) - PRIORITY #1    ; ================================================================================================    If InComment      *Out\c = C : *Out + CharSize      If C = #CR Or C = #LF        InComment        = #False        AtLineStart      = #True        LineTokenCount   = 0        LastNonSpaceChar = C      EndIf      *In + CharSize      Continue    ElseIf C = ';' And InString = #False And InCharLiteral = #False      InComment = #True      *Out\c = ';' : *Out + CharSize      *In + CharSize      Continue    EndIf    ;    ; ================================================================================================    ; B. STRING LITERALS ("...", ~"...") AND CHARACTER LITERALS ('...')    ; ================================================================================================    If InString      *Out\c = C : *Out + CharSize      *In + CharSize      If InEscapedString And C = '\' And *In\c <> 0 And *In\c <> #CR And *In\c <> #LF        ; Copy the escaped character verbatim so '\"' never prematurely terminates the string        *Out\c = *In\c : *Out + CharSize        *In + CharSize        Continue      EndIf      If C = '"' Or C = #CR Or C = #LF        InString        = #False        InEscapedString = #False        If C = #CR Or C = #LF          AtLineStart      = #True          LineTokenCount   = 0          LastNonSpaceChar = C        Else          LastNonSpaceChar = '"'        EndIf      EndIf      Continue    ElseIf InCharLiteral      *Out\c = C : *Out + CharSize      *In + CharSize      If C = 39 Or C = #CR Or C = #LF        InCharLiteral = #False        If C = #CR Or C = #LF          AtLineStart      = #True          LineTokenCount   = 0          LastNonSpaceChar = C        Else          LastNonSpaceChar = 39        EndIf      EndIf      Continue    ElseIf C = '"'      InString        = #True      InEscapedString = #False      AtLineStart     = #False      LineTokenCount + 2      *Out\c = '"' : *Out + CharSize      *In + CharSize      Continue    ElseIf C = '~' And PeekC(*In + CharSize) = '"'      ; Escaped string literal opener (~"...")      If *Out > *OutStart        PrevC = PeekC(*Out - CharSize)        If PrevC <> ' ' And PrevC <> #TAB And PrevC <> '(' And PrevC <> '[' And PrevC <> ',' And PrevC <> #CR And PrevC <> #LF          *Out\c = ' ' : *Out + CharSize        EndIf      EndIf      InString        = #True      InEscapedString = #True      AtLineStart     = #False      LineTokenCount + 2      *Out\c = '~' : *Out + CharSize      *Out\c = '"' : *Out + CharSize      *In + (2 * CharSize)      Continue    ElseIf C = 39      ; Single-quoted character literal ('x')      InCharLiteral = #True      AtLineStart   = #False      LineTokenCount + 2      *Out\c = 39 : *Out + CharSize      *In + CharSize      Continue    EndIf    ;    ; ================================================================================================    ; C. LINE BREAKS (#CR / #LF), LEADING INDENTATION, AND INLINE ASM ('!')    ; ================================================================================================    If C = #CR Or C = #LF      ; Strip trailing spaces/tabs before the line break      While *Out > *OutStart And (PeekC(*Out - CharSize) = ' ' Or PeekC(*Out - CharSize) = #TAB)        *Out - CharSize      Wend      AtLineStart      = #True      LineTokenCount   = 0      LastNonSpaceChar = C      *Out\c = C : *Out + CharSize      *In + CharSize      Continue    EndIf    ;    If AtLineStart      If C = ' ' Or C = #TAB        *Out\c = C : *Out + CharSize        *In + CharSize        Continue      Else        AtLineStart = #False        If C = '!'          ; Inline assembly line ('! mov ...'): stream entire line untouched like a comment          InComment = #True          *Out\c = '!' : *Out + CharSize          *In + CharSize          Continue        EndIf      EndIf    EndIf    ;    ; ================================================================================================    ; D. MODULE SCOPE ('::'), STANDALONE LABELS ('Label:'), AND STATEMENT COLONS (' : ')    ; ================================================================================================    If C = ':'      If PeekC(*In + CharSize) = ':'        ; Module resolution operator 'Mod::Element': never insert spaces before or after '::'        While *Out > *OutStart And (PeekC(*Out - CharSize) = ' ' Or PeekC(*Out - CharSize) = #TAB)          *Out - CharSize        Wend        *Out\c = ':' : *Out + CharSize        *Out\c = ':' : *Out + CharSize        *In + (2 * CharSize)        While *In\c = ' ' Or *In\c = #TAB          *In + CharSize        Wend        LineTokenCount + 1        LastNonSpaceChar = ':'        Continue      EndIf      ;      ; Look ahead past spaces/tabs after ':' to detect standalone line labels ('MyLabel:' or 'MyLabel: ; comment').      ; In PureBasic, a label never has a space before ':' (whereas 'MyMacro :' with a space is a macro call).      *LookAhead = *In + CharSize      While *LookAhead\c = ' ' Or *LookAhead\c = #TAB        *LookAhead + CharSize      Wend      IsLabel = Bool(LineTokenCount = 1 And *Out > *OutStart And                     PeekC(*Out - CharSize) <> ' ' And PeekC(*Out - CharSize) <> #TAB And                     (*LookAhead\c = #CR Or *LookAhead\c = #LF Or *LookAhead\c = ';' Or *LookAhead\c = 0))      ;      If IsLabel = #False And *Out > *OutStart And LastNonSpaceChar <> #CR And LastNonSpaceChar <> #LF And LastNonSpaceChar <> 0        ; Statement separator colon (or macro followed by ' :'): enforce a single space before ':'        If PeekC(*Out - CharSize) <> ' ' And PeekC(*Out - CharSize) <> #TAB          *Out\c = ' ' : *Out + CharSize        EndIf      EndIf      ;      *Out\c = ':' : *Out + CharSize      *In = *LookAhead      If *In\c <> #CR And *In\c <> #LF And *In\c <> ':' And *In\c <> 0        ; Enforce a single space after ':' before the next statement or inline comment        *Out\c = ' ' : *Out + CharSize      EndIf      LineTokenCount   = 0      LastNonSpaceChar = ':'      Continue    EndIf    ;    ; ================================================================================================    ; E. COMMA SEPARATOR (',')    ; ================================================================================================    If C = ','      While *Out > *OutStart And (PeekC(*Out - CharSize) = ' ' Or PeekC(*Out - CharSize) = #TAB)        *Out - CharSize      Wend      *Out\c = ',' : *Out + CharSize      *In + CharSize      While *In\c = ' ' Or *In\c = #TAB        *In + CharSize      Wend      If *In\c <> #CR And *In\c <> #LF And *In\c <> 0        *Out\c = ' ' : *Out + CharSize      EndIf      LineTokenCount + 1      LastNonSpaceChar = ','      Continue    EndIf    ;    ; ================================================================================================    ; F. PARENTHESES ('(' AND ')')    ; ================================================================================================    If C = '('      *Out\c = '(' : *Out + CharSize      *In + CharSize      While *In\c = ' ' Or *In\c = #TAB        *In + CharSize      Wend      LineTokenCount + 2      LastNonSpaceChar = '('      Continue    ElseIf C = ')'      While *Out > *OutStart And (PeekC(*Out - CharSize) = ' ' Or PeekC(*Out - CharSize) = #TAB)        *Out - CharSize      Wend      *Out\c = ')' : *Out + CharSize      *In + CharSize      LineTokenCount + 1      LastNonSpaceChar = ')'      Continue    EndIf    ;    ; ================================================================================================    ; G. SYMBOLIC OPERATORS (+ - * / % > < = & | ! ~)    ; ================================================================================================    If C = '+' Or C = '-' Or C = '*' Or C = '/' Or C = '%' Or C = '>' Or C = '<' Or C = '=' Or C = '&' Or C = '|' Or C = '!' Or C = '~'      ; --- 1. Binary Literal Prefix ('%1010') vs Modulo Operator ('a % b') ---      If C = '%'        NextC = PeekC(*In + CharSize)        If (NextC = '0' Or NextC = '1') And           (LastNonSpaceChar = '(' Or LastNonSpaceChar = '[' Or LastNonSpaceChar = ',' Or LastNonSpaceChar = '=' Or            LastNonSpaceChar = '+' Or LastNonSpaceChar = '-' Or LastNonSpaceChar = '*' Or LastNonSpaceChar = '/' Or            LastNonSpaceChar = '%' Or LastNonSpaceChar = '<' Or LastNonSpaceChar = '>' Or LastNonSpaceChar = '&' Or            LastNonSpaceChar = '|' Or LastNonSpaceChar = '!' Or LastNonSpaceChar = '~' Or LastNonSpaceChar = ':' Or            LastNonSpaceChar = #CR Or LastNonSpaceChar = #LF Or LastNonSpaceChar = 0 Or            (*Out > *OutStart And (PeekC(*Out - CharSize) = ' ' Or PeekC(*Out - CharSize) = #TAB)))          ; Binary integer literal '%0101...': stream '%' + binary digits contiguously unless preceded by a value          If LastNonSpaceChar = ')' Or LastNonSpaceChar = ']' Or             (LastNonSpaceChar >= '0' And LastNonSpaceChar <= '9') Or             (LastNonSpaceChar >= 'a' And LastNonSpaceChar <= 'z') Or             (LastNonSpaceChar >= 'A' And LastNonSpaceChar <= 'Z') Or LastNonSpaceChar = '_' Or LastNonSpaceChar = '$'            ; Preceded by a value/identifier despite space: treat '%' as modulo operator below          Else            *Out\c = '%' : *Out + CharSize            *In + CharSize            While *In\c = '0' Or *In\c = '1'              *Out\c = *In\c : *Out + CharSize              *In + CharSize            Wend            LineTokenCount + 2            LastNonSpaceChar = PeekC(*In - CharSize)            Continue          EndIf        EndIf      EndIf      ;      ; --- 2. Pointer Dereference / Declaration (*MyPointer) ---      If C = '*'        If RecognizePointer(@CodeContent\s, ((*In - @CodeContent\s) / CharSize) + 1)          If *Out > *OutStart            PrevC = PeekC(*Out - CharSize)            If PrevC <> ' ' And PrevC <> #TAB And PrevC <> '(' And PrevC <> '[' And PrevC <> '\' And               PrevC <> '@' And PrevC <> '?' And PrevC <> '~' And PrevC <> '-' And PrevC <> '*' And               PrevC <> #CR And PrevC <> #LF              *Out\c = ' ' : *Out + CharSize            EndIf          EndIf          *Out\c = '*' : *Out + CharSize          *In + CharSize          While *In\c = ' ' Or *In\c = #TAB            *In + CharSize          Wend          LineTokenCount + 1          LastNonSpaceChar = '*'          Continue        EndIf      EndIf      ;      ; --- 3. Unary Bitwise NOT ('~x') or Unary Minus ('-5', 'x & -2') ---      If C = '~' Or (C = '-' And (LastNonSpaceChar = '(' Or LastNonSpaceChar = '[' Or LastNonSpaceChar = ',' Or                                  LastNonSpaceChar = '=' Or LastNonSpaceChar = '+' Or LastNonSpaceChar = '-' Or                                  LastNonSpaceChar = '*' Or LastNonSpaceChar = '/' Or LastNonSpaceChar = '%' Or                                  LastNonSpaceChar = '<' Or LastNonSpaceChar = '>' Or LastNonSpaceChar = '&' Or                                  LastNonSpaceChar = '|' Or LastNonSpaceChar = '!' Or LastNonSpaceChar = '~' Or                                  LastNonSpaceChar = ':' Or LastNonSpaceChar = #CR Or LastNonSpaceChar = #LF Or LastNonSpaceChar = 0))        If *Out > *OutStart And PeekC(*Out - CharSize) <> ' ' And PeekC(*Out - CharSize) <> #TAB And           LastNonSpaceChar <> '(' And LastNonSpaceChar <> '['          *Out\c = ' ' : *Out + CharSize        EndIf        *Out\c = C : *Out + CharSize        *In + CharSize        While *In\c = ' ' Or *In\c = #TAB          *In + CharSize        Wend        LineTokenCount + 2        LastNonSpaceChar = C        Continue      EndIf      ;      ; --- 4. Standard Binary / Compound Operators (<=, >=, <>, <<, >>) ---      If *Out > *OutStart And PeekC(*Out - CharSize) <> ' ' And PeekC(*Out - CharSize) <> #TAB        *Out\c = ' ' : *Out + CharSize      EndIf      ;      *Out\c = C : *Out + CharSize      *In + CharSize      NextC = *In\c      If (C = '<' And (NextC = '=' Or NextC = '>' Or NextC = '<')) Or         (C = '>' And (NextC = '=' Or NextC = '>'))        *Out\c = NextC : *Out + CharSize        *In + CharSize        C = NextC      EndIf      ;      While *In\c = ' ' Or *In\c = #TAB        *In + CharSize      Wend      If *In\c <> #CR And *In\c <> #LF And *In\c <> 0        *Out\c = ' ' : *Out + CharSize      EndIf      LineTokenCount + 2      LastNonSpaceChar = C      Continue    EndIf    ;    ; ================================================================================================    ; H. WORDS (KEYWORDS, WORD OPERATORS, PROCEDURES, HEX LITERALS, AND IDENTIFIERS)    ; ================================================================================================    If (C >= 'a' And C <= 'z') Or (C >= 'A' And C <= 'Z') Or C = '_' Or C = '#' Or C = '$'      *WordStartIn = *In      While (*In\c >= 'a' And *In\c <= 'z') Or (*In\c >= 'A' And *In\c <= 'Z') Or            (*In\c >= '0' And *In\c <= '9') Or *In\c = '_' Or *In\c = '#' Or *In\c = '$'        *In + CharSize      Wend      ;      WordCharCount = (*In - *WordStartIn) / CharSize      WordLCase$    = "," + LCase(PeekS(*WordStartIn, WordCharCount)) + ","      LineTokenCount + 1      ;      If *Out > *OutStart        PrevC = PeekC(*Out - CharSize)      Else        PrevC = 0      EndIf      *LookAhead = *In      While *LookAhead\c = ' ' Or *LookAhead\c = #TAB        *LookAhead + CharSize      Wend      ;      ; Category 1: Logical word operators, control flow keywords, and include directives      ; (Tokens attached to '*', '\', '.', or '::' are pointers, fields, types, or module members, never keywords)      If PrevC <> '*' And PrevC <> '\' And PrevC <> '.' And PrevC <> ':' And         *LookAhead\c <> '.' And *LookAhead\c <> '\' And         Not (*LookAhead\c = ':' And PeekC(*LookAhead + CharSize) = ':') And         FindString(",and,or,xor,not,to,step,if,elseif,while,until,select,case,with,return,procedurereturn,debug,calldebugger,swap,end,includefile,xincludefile,includepath,includebinary,compilerif,compilerelseif,compilerselect,compilercase,", WordLCase$)        If PrevC <> 0 And PrevC <> ' ' And PrevC <> #TAB And PrevC <> '(' And PrevC <> ',' And PrevC <> #CR And PrevC <> #LF          *Out\c = ' ' : *Out + CharSize        EndIf        ;        CopyMemory(*WordStartIn, *Out, WordCharCount * CharSize)        *Out + (WordCharCount * CharSize)        ;        While *In\c = ' ' Or *In\c = #TAB          *In + CharSize        Wend        If *In\c <> #CR And *In\c <> #LF And *In\c <> ':' And *In\c <> ';' And *In\c <> 0          *Out\c = ' ' : *Out + CharSize        EndIf        LastNonSpaceChar = PeekC(*WordStartIn + (WordCharCount - 1) * CharSize)        Continue      Else        ; Category 2: Standard identifiers (procedures, functions, variables, arrays, maps, constants, hex)        CopyMemory(*WordStartIn, *Out, WordCharCount * CharSize)        *Out + (WordCharCount * CharSize)        ;        ; Attach procedure/array/map identifier directly to its opening '(' by skipping intermediate spaces        *LookAhead = *In        While *LookAhead\c = ' ' Or *LookAhead\c = #TAB          *LookAhead + CharSize        Wend        If *LookAhead\c = '('          *In = *LookAhead        EndIf        LastNonSpaceChar = PeekC(*WordStartIn + (WordCharCount - 1) * CharSize)        Continue      EndIf    EndIf    ;    ; ================================================================================================    ; I. NUMERIC LITERALS (INCLUDING SCIENTIFIC NOTATION 1.5e-4) AND INLINE WHITESPACE    ; ================================================================================================    If C >= '0' And C <= '9'      ; Stream decimal digits, fractional dot, and optional scientific exponent ('e+6', 'E-4') contiguously      While (*In\c >= '0' And *In\c <= '9') Or *In\c = '.'        *Out\c = *In\c : *Out + CharSize        *In + CharSize      Wend      If *In\c = 'e' Or *In\c = 'E'        NextC = PeekC(*In + CharSize)        If (NextC >= '0' And NextC <= '9') Or           ((NextC = '+' Or NextC = '-') And PeekC(*In + 2 * CharSize) >= '0' And PeekC(*In + 2 * CharSize) <= '9')          *Out\c = *In\c : *Out + CharSize : *In + CharSize          If *In\c = '+' Or *In\c = '-'            *Out\c = *In\c : *Out + CharSize : *In + CharSize          EndIf          While *In\c >= '0' And *In\c <= '9'            *Out\c = *In\c : *Out + CharSize            *In + CharSize          Wend        EndIf      EndIf      LineTokenCount + 2      LastNonSpaceChar = PeekC(*In - CharSize)      Continue    EndIf    ;    If C = ' ' Or C = #TAB      If *Out > *OutStart And PeekC(*Out - CharSize) <> ' ' And PeekC(*Out - CharSize) <> #TAB        *Out\c = ' ' : *Out + CharSize      EndIf    Else      *Out\c = C : *Out + CharSize      LineTokenCount + 2      LastNonSpaceChar = C    EndIf    *In + CharSize  Wend  ;  ; --------------------------------------------------------------------------------------------------  ; STEP 4: COMPARE AND SAVE TO DISK ONLY IF MODIFIED  ; --------------------------------------------------------------------------------------------------  FormattedCode$ = PeekS(*OutStart, (*Out - *OutStart) / CharSize)  FreeMemory(*OutStart)  ;  If FormattedCode$ <> CodeContent\s    ProcedureReturn Bool(TexteDansFichier(FileName$, FormattedCode$, FileEncoding, 0, HasBOM) <> 0)  EndIf  ProcedureReturn #FalseEndProcedure;Procedure CosmeticFileTransformer()  ;  ; Role: Runs CosmeticOneFile() across all project files selected via AskAndPrepareProjectCopy()  ;       and triggers a re-exploration if the active project files were updated in place.  ;  Protected Result = 0, Modified = 0, WGadget  Protected TargetDir.String  Protected NewList FilesToChange.FilesToChangeStruct()  ;  Result = AskAndPrepareProjectCopy(FilesToChange(), @TargetDir)  If Result = #PB_MessageRequester_Cancel    ProcedureReturn #False  EndIf  ;  DisablePBBWindow()  WGadget = OpenWaitWindow(GPBBGadgets\PBBWindow, "")  ;  ForEach FilesToChange()    If FileSize(FilesToChange()\TargetFile) > 1      If IsGadget(WGadget)        SetGadgetText(WGadget, GetTextFromCatalogPB("CosmeticFileTransformerTitle") + #CR$ + GetFilePart(FilesToChange()\TargetFile))        UpdateWindow_(GadgetID(WGadget))      EndIf      If CosmeticOneFile(FilesToChange()\TargetFile)        Modified = 1      EndIf    EndIf  Next  ;  If IsGadget(WGadget)    DestroyParentWindow(WGadget)  EndIf  ;  If Modified Or TargetDir\s <> ""    AlertInPBBWindow(GetTextFromCatalogPB("FilesAreUpdated"))    If TargetDir\s <> ""      RunProgram(TargetDir\s)    EndIf    If Modified And Result = #PB_MessageRequester_No      ExplorationState = #ExplorationState_MustRestart    EndIf  Else    AlertInPBBWindow(GetTextFromCatalogPB("NoElementFound"), GetTextFromCatalogPB("CosmeticFileTransformerTitle"))  EndIf  ;  EnablePBBWindow()  ProcedureReturn ResultEndProcedure;RegisterCustomTool("InCatalog:CosmeticFileTransformerTitle", "InCatalog:CosmeticFileTransformerEx", @CosmeticFileTransformer());; --------------------------------------------------------------------------;                 --- Update Project Files (.pbp) ---; --------------------------------------------------------------------------;Procedure.s ConvertListToLegacyString(List TargetList.FileListingStruct())  ;  ; Role: Serializes 'TargetList()' into a "FileName[TAB][CR]" string list  ;       compatible with the .pbp XML comparison and completion helpers.  ;  Protected OutputString$  ;  ForEach TargetList()    OutputString$ + TargetList()\FileName$ + #TAB$ + #CR$  Next  ;  ProcedureReturn OutputString$EndProcedure;Procedure.s GetIDEOptionValue(IDEDescr$, Key$)  ;  ; Role: Extracts the value following 'Key$' up to the end of its line inside 'IDEDescr$',  ;       or returns an empty string if the key is absent.  ;  Protected pd, pf  ;  pd = FindString(IDEDescr$, Key$)  If pd    pd + Len(Key$)    pf = FindString(IDEDescr$, #CR$, pd)    If pf = 0      pf = Len(IDEDescr$) + 1    EndIf    ProcedureReturn FastMid(IDEDescr$, pd, pf - pd)  EndIf  ProcedureReturn ""EndProcedure;Procedure.s AppendIDEMultiNodes(IDEDescr$, Key$, SectionTag$, ItemTag$, ItemSuffix$)  ;  ; Role: Scans 'IDEDescr$' for all occurrences of 'Key$' and wraps their extracted values  ;       inside a '<SectionTag$>...</SectionTag$>' XML block (or returns "" if none exist).  ;  Protected pd, pf  Protected Val$, Block$  ;  Repeat    pd = FindString(IDEDescr$, Key$, pd + 1)    If pd      pd + Len(Key$)      pf = FindString(IDEDescr$, #CR$, pd)      If pf = 0        pf = Len(IDEDescr$) + 1      EndIf      Val$ = FastMid(IDEDescr$, pd, pf - pd)      If Block$ = ""        Block$ = "      <" + SectionTag$ + ">" + #CR$      EndIf      Block$ + "        <" + ItemTag$ + " value=['']" + Val$ + "['']" + ItemSuffix$ + "/>" + #CR$    EndIf  Until pd = 0  ;  If Block$ <> ""    Block$ + "      </" + SectionTag$ + ">" + #CR$  EndIf  ProcedureReturn Block$EndProcedure;Procedure.s CompleteProjectFileList(ProjectDescr$, ListOfFiles$, ProjectAddress$, PBFile = 1, LastOpen = 0)  ;  ; Role: Appends any missing files from 'ListOfFiles$' into the '<section name="files">' block  ;       of 'ProjectDescr$', preserving existing sort indices and computing MD5 fingerprints.  ;  Protected EndOfSection, PosInDescr, fIndex, pf, PosInFileList  Protected EndOfDescr$, QuoteChar$, LineC$, FileName$, RelPath$, DeclaredFile$, AltDeclaredFile$  ;  ProjectDescr$ = ReplaceDoubleSimpleQuoteByDoubleQuote(ProjectDescr$)  ;  PosInDescr = FindString(ProjectDescr$, "<section name=" + #DOUBLEQUOTE$ + "files" + #DOUBLEQUOTE$)  If PosInDescr = 0    ProjectDescr$ + "  <section name=['']files['']>" + #CR$  Else    ; Temporarily detach everything starting from '</section>' so new <file> nodes can be appended cleanly    EndOfSection = FindString(ProjectDescr$, "</section>", PosInDescr)    FastFindPrecReturn(ProjectDescr$, EndOfSection)    EndOfDescr$   = FastMid(ProjectDescr$, EndOfSection + 1)    ProjectDescr$ = FastLeft(ProjectDescr$, EndOfSection)    ;    ; Retrieve the highest existing 'sortindex' attribute value    PosInDescr = ReverseFindString(ProjectDescr$, "sortindex=")    If PosInDescr      PosInDescr + Len("sortindex=")      QuoteChar$ = FastMid(ProjectDescr$, PosInDescr, 1)      If QuoteChar$ = #DOUBLEQUOTE$        PosInDescr + 1        pf = FindString(ProjectDescr$, QuoteChar$, PosInDescr)        If pf          fIndex = Val(FastMid(ProjectDescr$, PosInDescr, pf - PosInDescr))        EndIf      EndIf    EndIf  EndIf  ;  Repeat    PosInFileList + 1    LineC$ = StringField(ListOfFiles$, PosInFileList, #CR$)    If LineC$      FileName$        = StringField(LineC$, 1, #TAB$)      RelPath$         = FullAddressToRelativeAddress(FileName$, ProjectAddress$)      DeclaredFile$    = "<file name=" + #DOUBLEQUOTE$ + RelPath$ + #DOUBLEQUOTE$ + ">"      AltDeclaredFile$ = "<file name=" + #DOUBLEQUOTE$ + ReplaceString(RelPath$, "\", "/") + #DOUBLEQUOTE$ + ">"      ; Check both '\' and '/' path separators to prevent duplicates on IDE-saved .pbp files      If FindString(ProjectDescr$, DeclaredFile$, 1, #PB_String_NoCase) = 0 And         FindString(ProjectDescr$, AltDeclaredFile$, 1, #PB_String_NoCase) = 0        fIndex + 1        ProjectDescr$ + "    " + DeclaredFile$ + #CR$        ProjectDescr$ + "      <config load=['']" + Str(PBFile) + "[''] scan=['']" + Str(PBFile) + "[''] panel=['']1[''] warn=['']" + Str(PBFile) + "[''] lastopen=['']" + Str(LastOpen) + "[''] sortindex=['']" + Str(fIndex) + "[''] panelstate=['']['']/>" + #CR$        ProjectDescr$ + "      <fingerprint md5=['']" + LCase(FileFingerprint(FileName$, #PB_Cipher_MD5)) + "['']/>" + #CR$        ProjectDescr$ + "    </file>" + #CR$      EndIf    EndIf  Until LineC$ = ""  ;  If EndOfSection = 0    ProjectDescr$ + "  </section>" + #CR$  Else    ProjectDescr$ + EndOfDescr$  EndIf  ;  ProcedureReturn ProjectDescr$EndProcedure;Procedure.s DelFilesFromProject(ProjectDescr$, ListOfFiles$, ProjectAddress$)  ;  ; Role: Removes all '<file>...</file>' XML entries matching 'ListOfFiles$' from 'ProjectDescr$',  ;       matching by project-relative path ('\' or '/') first to avoid colliding on identical filenames in subfolders.  ;  Protected PosInFileList, PosInDescr, mPosInDescr, pf  Protected LineC$, FileName$, RelPath$, RelativeTag$, AltRelativeTag$  ;  Repeat    PosInFileList + 1    LineC$ = StringField(ListOfFiles$, PosInFileList, #CR$)    If LineC$      FileName$       = StringField(LineC$, 1, #TAB$)      RelPath$        = FullAddressToRelativeAddress(FileName$, ProjectAddress$)      RelativeTag$    = "<file name=" + #DOUBLEQUOTE$ + RelPath$ + #DOUBLEQUOTE$ + ">"      AltRelativeTag$ = "<file name=" + #DOUBLEQUOTE$ + ReplaceString(RelPath$, "\", "/") + #DOUBLEQUOTE$ + ">"      PosInDescr      = FindString(ProjectDescr$, RelativeTag$, 1, #PB_String_NoCase)      If PosInDescr = 0        PosInDescr = FindString(ProjectDescr$, AltRelativeTag$, 1, #PB_String_NoCase)      EndIf      If PosInDescr = 0        PosInDescr = FindString(ProjectDescr$, GetFilePart(FileName$) + #DOUBLEQUOTE$ + ">", 1, #PB_String_NoCase)      EndIf      If PosInDescr        mPosInDescr = PosInDescr        FastFindPrecReturn(ProjectDescr$, PosInDescr)        If FindString(FastMid(ProjectDescr$, PosInDescr, mPosInDescr - PosInDescr + 6), "<file", 1, #PB_String_NoCase)          pf = FindString(ProjectDescr$, "</file>", PosInDescr, #PB_String_NoCase)          If pf            pf = FindString(ProjectDescr$, #CR$, pf)            If pf              ProjectDescr$ = FastLeft(ProjectDescr$, PosInDescr) + FastMid(ProjectDescr$, pf + 1)            EndIf          EndIf        EndIf      EndIf    EndIf  Until LineC$ = ""  ;  ProcedureReturn ProjectDescr$EndProcedure;Procedure.s CompareTwoFileLists(ListOfFiles1$, ListOfFiles2$)  ;  ; Role: Returns all file paths present in 'ListOfFiles1$' that do not appear as exact entries  ;       in 'ListOfFiles2$' (case-insensitive, immune to substring/extension prefix collisions).  ;  Protected LineC$, FileName$, NormalizedList2$, ListOfMissingFiles$  Protected PosInFileList  ;  ; Build a delimiter-bounded lookup string (#CR$ + CleanPath + #CR$) from ListOfFiles2$  NormalizedList2$ = #CR$  Repeat    PosInFileList + 1    LineC$ = StringField(ListOfFiles2$, PosInFileList, #CR$)    If LineC$      NormalizedList2$ + StringField(LineC$, 1, #TAB$) + #CR$    EndIf  Until LineC$ = ""  ;  PosInFileList = 0  Repeat    PosInFileList + 1    LineC$ = StringField(ListOfFiles1$, PosInFileList, #CR$)    If LineC$      FileName$ = StringField(LineC$, 1, #TAB$)      If FindString(NormalizedList2$, #CR$ + FileName$ + #CR$, 1, #PB_String_NoCase) = 0        ListOfMissingFiles$ + FileName$ + #CR$      EndIf    EndIf  Until LineC$ = ""  ;  ProcedureReturn ListOfMissingFiles$EndProcedure;Procedure.s ChooseProjectCreation()  ;  ; Role: Displays a modal dialog asking whether to locate an existing .pbp file manually,  ;       create a new one, or cancel.  ;  Protected ChooseProjectCreationWdw, GMess, Btn_Manual, Btn_Cancel, Btn_Create  Protected ReturnValue$, OX, OY, GadgetList$  Protected WWidth = 500, WHeight = 100  Protected ParentWindowID = ComputeWinOrigins(@OX, @OY, WWidth, WHeight, GPBBGadgets\PBBWindow)  Protected paraFormat.PARAFORMAT2  ;  DisablePBBWindow()  ChooseProjectCreationWdw = OpenWindow(#PB_Any, OX, OY, WWidth, WHeight, GetTextFromCatalogPB("Attention"), #PB_Window_SystemMenu, ParentWindowID)  If ChooseProjectCreationWdw    ApplyDarkModeToWindow(ChooseProjectCreationWdw)    StickyWindow(ChooseProjectCreationWdw, 1)    ;    GMess = EditorGadget(#PB_Any, 5, 5, 490, 60, #PB_Editor_ReadOnly)    GadgetList$ + Str(GMess) + ","    SendMessage_(GadgetID(GMess), #EM_SETTARGETDEVICE, #Null, 0)    SendMessage_(GadgetID(GMess), #EM_LIMITTEXT, -1, 0)    SendMessage_(GadgetID(GMess), #EM_SETTEXTMODE, #TM_RICHTEXT, 0)    paraFormat\cbSize     = SizeOf(PARAFORMAT2)    paraFormat\dwMask     = #PFM_ALIGNMENT    paraFormat\wAlignment = #PFA_CENTER    SendMessage_(GadgetID(GMess), #EM_SETPARAFORMAT, #SCF_SELECTION, @paraFormat)    AddGadgetItem(GMess, -1, GetTextFromCatalogPB("NoProjectFound"))    ;    Btn_Manual = ButtonGadget(#PB_Any, 5, 70, 210, 25, GetTextFromCatalogPB("LookForProjectManually"))    GadgetList$ + Str(Btn_Manual) + ","    Btn_Cancel = ButtonGadget(#PB_Any, 220, 70, 100, 25, GetTextFromCatalogPB("Cancel"))    GadgetList$ + Str(Btn_Cancel) + ","    Btn_Create = ButtonGadget(#PB_Any, 325, 70, 170, 25, GetTextFromCatalogPB("CreateNewProject"))    GadgetList$ + Str(Btn_Create) + ","    SetFontAndGadgetsColors(ChooseProjectCreationWdw, InterfaceColorPresets(), GadgetList$)    ;    Repeat      If EventWindow() <> ChooseProjectCreationWdw        SetActiveWindow(ChooseProjectCreationWdw)      EndIf      Select WaitWindowEvent()        Case #PB_Event_CloseWindow          Break        Case #PB_Event_Gadget          Select EventGadget()            Case Btn_Manual              ReturnValue$ = "Manual"              Break            Case Btn_Cancel              ReturnValue$ = "Cancel"              Break            Case Btn_Create              ReturnValue$ = "Create"              Break          EndSelect      EndSelect    ForEver    ;    CloseWindow(ChooseProjectCreationWdw)  EndIf  EnablePBBWindow()  ProcedureReturn ReturnValue$EndProcedure;Procedure CreateUpdateProject()  ;  ; Role: Creates a new PureBasic project (.pbp) from the main file's IDE options and inclusion tree,  ;       or synchronizes an existing .pbp file with added/removed source and binary files.  ;  Protected Exec$, OptVal$, ExecutableFormat$, CPU$, VersionField$, Field$, WTitle$  Protected optimizer, asm, thread, xpskin, admin, dpiaware, dllprotection, onerror, pdebug  Protected InfosList, WasOpen, ProjectIsModified, pd, pf, IDEPos  Protected ProjectEOL = #LineEnding_CRLF, ProjectEncoding = #PB_UTF8  Protected ProjectAddress$, Choice$, ListProjectsFiles$, MissingFile$, Message$  Protected *Content.String  Protected ProjectBuf.String  Protected ProjectDescr$, IDEDescr$, LegacyFiles$, LegacyBinaries$  ; Preserves the original .pbp encoding and EOL convention while internal XML helpers operate on #CR$.  ;  If Left(GetFilePart(PBBFicPrincipalPB$), Len("PureBasic_TempFile")) = "PureBasic_TempFile"    AlertInPBBWindow(GetTextFromCatalogPB("NotForTempFile"))    ProcedureReturn #False  EndIf  ;  UseMD5Fingerprint()  If PBBFicPrincipalPB$    LegacyFiles$    = ConvertListToLegacyString(PBB_FileListing())    LegacyBinaries$ = ConvertListToLegacyString(PBB_BinaryFileListing())    ;    *Content  = GetPointedCodeFromFile(PBBFicPrincipalPB$)    IDEPos    = FindIDENotations(*Content)    IDEDescr$ = FastMid(*Content\s, IDEPos)    ;    ; ------------------------------------------------------------    ; Locate an existing .pbp file or ask the user where to create one    ; ------------------------------------------------------------    ProjectAddress$ = GetIDEOptionValue(IDEDescr$, "Project = ")    If ProjectAddress$ <> ""      ProjectAddress$ = RelativeAddressToFullAddress(ProjectAddress$, PBBFicPrincipalPB$)    ElseIf FileSize(ChangeFileExtension(PBBFicPrincipalPB$, "pbp")) > 1      ProjectAddress$ = ChangeFileExtension(PBBFicPrincipalPB$, "pbp")    EndIf    ;    If ProjectAddress$ = ""      Choice$ = ChooseProjectCreation()      If Choice$ = "Manual"        DisablePBBWindow()        ProjectAddress$ = OpenFileRequester(GetTextFromCatalogPB("LookForProjectManually"), "", "PB Project|*.pbp", 0)        EnablePBBWindow()      ElseIf Choice$ = "Create"        ProjectAddress$ = ChangeFileExtension(PBBFicPrincipalPB$, "pbp")        ProjectAddress$ = SaveFileRequester(GetTextFromCatalogPB("CreateNewProject"), ProjectAddress$, "PB Project|*.pbp", 0)      EndIf    EndIf    ;    If ProjectAddress$ = ""      ProcedureReturn #False    EndIf    ;    ; Intentional two-step check: warns the user if the project is currently open in the PB IDE,    ; then re-checks immediately so execution proceeds if the user closed it while the alert was shown.    If LCase(GetPBOpenProject(PureBasicProgAddr$)) = LCase(ProjectAddress$)      WasOpen = 1      AlertInPBBWindow(GetTextFromCatalogPB("ProjectAllreadyOpen"))    EndIf    If LCase(GetPBOpenProject(PureBasicProgAddr$)) = LCase(ProjectAddress$)      ProcedureReturn #False    EndIf    ;    ; ------------------------------------------------------------    ; Update an existing .pbp file or build a new one from IDE options    ; ------------------------------------------------------------    If FileSize(ProjectAddress$) > 1      ProjectBuf\s       = FileToText(ProjectAddress$)      ProjectEncoding    = BOM      ProjectEOL         = DetectLineEndingAndTab(@ProjectBuf)      ProjectDescr$      = ReplaceString(ReplaceString(ProjectBuf\s, #CRLF$, #CR$), #LF$, #CR$)      ListProjectsFiles$ = ListProjectsFiles(ProjectAddress$)      ;      MissingFile$ = CompareTwoFileLists(LegacyFiles$, ListProjectsFiles$)      If MissingFile$        Message$ = GetTextFromCatalogPB("WouldYouAdd") + #CR$ + #CR$ + GetTextFromCatalogPB("IncludedFilesIntro") + #CR$ + MissingFile$        WTitle$  = GetTextFromCatalogPB("IncludedFilesIntro")        If AlertInPBBWindow(Message$, WTitle$, 1, 0, 0, 0, "", #AW_YesOrNo_YesByDefault) = #PB_MessageRequester_Yes          ProjectDescr$     = CompleteProjectFileList(ProjectDescr$, MissingFile$, ProjectAddress$, 1)          ProjectIsModified = 1        EndIf      EndIf      ;      MissingFile$ = CompareTwoFileLists(LegacyBinaries$, ListProjectsFiles$)      If MissingFile$        Message$ = GetTextFromCatalogPB("WouldYouAdd") + #CR$ + #CR$ + GetTextFromCatalogPB("IncludedBinaries") + #CR$ + MissingFile$        WTitle$  = GetTextFromCatalogPB("IncludedBinaries")        If AlertInPBBWindow(Message$, WTitle$, 1, 0, 0, 0, "", #AW_YesOrNo_YesByDefault) = #PB_MessageRequester_Yes          ; Pass PBFile = 0 so PureBasic IDE registers binary assets without loading or scanning them as source code          ProjectDescr$     = CompleteProjectFileList(ProjectDescr$, MissingFile$, ProjectAddress$, 0)          ProjectIsModified = 1        EndIf      EndIf      ;      MissingFile$ = CompareTwoFileLists(ListProjectsFiles$, LegacyFiles$ + LegacyBinaries$)      If MissingFile$        Message$ = GetTextFromCatalogPB("WouldYouDel") + #CR$ + #CR$ + GetTextFromCatalogPB("FilesToDelete") + #CR$ + MissingFile$        WTitle$  = GetTextFromCatalogPB("FilesToDelete")        If AlertInPBBWindow(Message$, WTitle$, 1, 0, 0, 0, "", #AW_YesOrNo_YesByDefault) = #PB_MessageRequester_Yes          ProjectDescr$     = DelFilesFromProject(ProjectDescr$, MissingFile$, ProjectAddress$)          ProjectIsModified = 1        EndIf      EndIf    Else      ProjectIsModified = 1      ;      ; Build XML project header ('http://www.purebasic.com/namespace' is mandatory for PB IDE recognition)      ProjectDescr$ = "<?xml version=['']1.0[''] encoding=['']UTF-8['']?>" + #CR$ + #CR$      ProjectDescr$ + "<project xmlns=['']http://www.purebasic.com/namespace[''] version=['']1.0[''] creator=['']PBBrowser['']>" + #CR$      ProjectDescr$ + "  <section name=['']config['']>" + #CR$      ProjectDescr$ + "    <options closefiles=['']0[''] openmode=['']0[''] name=['']" + FilePartSsExt(PBBFicPrincipalPB$) + "['']/>" + #CR$      ProjectDescr$ + "  </section>" + #CR$      ProjectDescr$ + "  <section name=['']data['']>" + #CR$      ProjectDescr$ + "    <explorer view=['']" + GetPathPart(PBBFicPrincipalPB$) + "[''] pattern=['']0['']/>" + #CR$      ProjectDescr$ + "    <log show=['']1['']/>" + #CR$      ProjectDescr$ + "    <lastopen date=['']" + FormatDate("%yyyy-%mm-%dd %hh:%ii", Date()) + "[''] user=['']" + GetUserName() + "[''] host=['']" + GetComputerName() + "['']/>" + #CR$      ProjectDescr$ + "  </section>" + #CR$      ;      ProjectDescr$ = CompleteProjectFileList(ProjectDescr$, PBBFicPrincipalPB$, ProjectAddress$, 1, 1)      ProjectDescr$ = CompleteProjectFileList(ProjectDescr$, LegacyFiles$, ProjectAddress$, 1)      ProjectDescr$ = CompleteProjectFileList(ProjectDescr$, LegacyBinaries$, ProjectAddress$, 0)      ;      ProjectDescr$ + "  <section name=['']targets['']>" + #CR$      ProjectDescr$ + "    <target name=['']" + GetTextFromCatalogPB("DefaultTarget") + "[''] enabled=['']1[''] default=['']1['']>" + #CR$      ProjectDescr$ + "      <inputfile value=['']" + FullAddressToRelativeAddress(PBBFicPrincipalPB$, ProjectAddress$) + "['']/>" + #CR$      ;      Exec$ = GetIDEOptionValue(IDEDescr$, "Executable = ")      If Exec$ = ""        Exec$ = ChangeFileExtension(PBBFicPrincipalPB$, ".exe")      Else        Exec$ = RelativeAddressToFullAddress(Exec$, PBBFicPrincipalPB$)      EndIf      ProjectDescr$ + "      <outputfile value=['']" + FullAddressToRelativeAddress(Exec$, ProjectAddress$) + "['']/>" + #CR$      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "CommandLine = ")      If OptVal$ <> "" : ProjectDescr$ + "      <commandline value=['']" + OptVal$ + "['']/>" + #CR$ : EndIf      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "CurrentDirectory = ")      If OptVal$ <> "" : ProjectDescr$ + "      <directory value=['']" + OptVal$ + "['']/>" + #CR$ : EndIf      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "Compiler = ")      If OptVal$ <> "" : ProjectDescr$ + "      <compiler version=['']" + OptVal$ + "['']/>" + #CR$ : EndIf      ;      optimizer     = Bool(FindString(IDEDescr$, "Optimizer") > 0)      asm           = Bool(FindString(IDEDescr$, "EnableAsm") > 0)      thread        = Bool(FindString(IDEDescr$, "EnableThread") > 0)      xpskin        = Bool(FindString(IDEDescr$, "EnableXP") > 0)      admin         = Bool(FindString(IDEDescr$, "EnableAdmin") > 0)      dpiaware      = Bool(FindString(IDEDescr$, "DPIAware") > 0)      dllprotection = Bool(FindString(IDEDescr$, "DllProtection") > 0)      onerror       = Bool(FindString(IDEDescr$, "EnableOnError") > 0)      pdebug        = Bool(FindString(IDEDescr$, "DisableDebugger") = 0)      ProjectDescr$ + "      <options asm=['']" + Str(asm) + "[''] thread=['']" + Str(thread) + "[''] xpskin=['']" + Str(xpskin) + "[''] admin=['']" + Str(admin) + "[''] dpiaware=['']" + Str(dpiaware) + "[''] dllprotection=['']" + Str(dllprotection) + "[''] debug=['']" + Str(pdebug) + "[''] onerror=['']" + Str(onerror) + "[''] optimizer=['']" + Str(optimizer) + "['']/>" + #CR$      ;      If FindString(IDEDescr$, "EnablePurifier")        ProjectDescr$ + "      <purifier enable=['']1['']/>" + #CR$      EndIf      If FindString(IDEDescr$, "CompileSourceDirectory")        ProjectDescr$ + "      <temporaryexe value=['']source['']/>" + #CR$      EndIf      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "SubSystem = ")      If OptVal$ <> "" : ProjectDescr$ + "      <subsystem value=['']" + OptVal$ + "['']/>" + #CR$ : EndIf      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "LinkerOptions = ")      If OptVal$ <> "" : ProjectDescr$ + "      <linker value=['']" + OptVal$ + "['']/>" + #CR$ : EndIf      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "ExecutableFormat = ")      If OptVal$ <> "" : ExecutableFormat$ = "exe=['']" + LCase(OptVal$) + "['']" : EndIf      OptVal$ = GetIDEOptionValue(IDEDescr$, "CPU = ")      If OptVal$ <> ""        CPU$ = "cpu=['']" + OptVal$ + "['']"        If ExecutableFormat$ <> "" : CPU$ = " " + CPU$ : EndIf      EndIf      If ExecutableFormat$ <> "" Or CPU$ <> ""        ProjectDescr$ + "      <format " + ExecutableFormat$ + CPU$ + "/>" + #CR$      EndIf      ;      If FindString(IDEDescr$, "IncludeVersionInfo")        ProjectDescr$ + "      <versioninfo enable=['']1['']>" + #CR$        InfosList = 1      EndIf      Repeat        pd = FindString(IDEDescr$, "VersionField", pd + 1)        If pd          pf = FindString(IDEDescr$, "=", pd)          If pf = 0 : pf = Len(IDEDescr$) + 1 : EndIf          VersionField$ = ReplaceString(LCase(Trim(FastMid(IDEDescr$, pd, pf - pd))), "version", "")          pd            = pf + 2          pf            = FindString(IDEDescr$, #CR$, pd)          If pf = 0 : pf = Len(IDEDescr$) + 1 : EndIf          Field$ = FastMid(IDEDescr$, pd, pf - pd)          If InfosList = 0            InfosList = 1            ProjectDescr$ + "      <versioninfo enable=['']0['']>" + #CR$          EndIf          ProjectDescr$ + "        <" + VersionField$ + " value=['']" + Field$ + "['']/>" + #CR$        EndIf      Until pd = 0      If InfosList        ProjectDescr$ + "      </versioninfo>" + #CR$      EndIf      ;      ProjectDescr$ + AppendIDEMultiNodes(IDEDescr$, "AddResource = ", "resources", "resource", "")      ProjectDescr$ + AppendIDEMultiNodes(IDEDescr$, "Constant = ", "constants", "constant", " enable=['']1['']")      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "UseIcon = ")      If OptVal$ <> ""        ProjectDescr$ + "      <icon enable=['']1['']>" + FullAddressToRelativeAddress(RelativeAddressToFullAddress(OptVal$, PBBFicPrincipalPB$), ProjectAddress$) + "</icon>" + #CR$      EndIf      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "Debugger = ")      If OptVal$ <> "" : ProjectDescr$ + "      <debugger custom=['']1[''] type=['']" + LCase(OptVal$) + "['']/>" + #CR$ : EndIf      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "Warnings = ")      If OptVal$ <> "" : ProjectDescr$ + "      <warnings custom=['']1[''] type=['']" + LCase(OptVal$) + "['']/>" + #CR$ : EndIf      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "EnableCompileCount = ")      If OptVal$ <> "" : ProjectDescr$ + "      <compilecount enable=['']1[''] value=['']" + OptVal$ + "['']/>" + #CR$ : EndIf      ;      OptVal$ = GetIDEOptionValue(IDEDescr$, "EnableBuildCount = ")      If OptVal$ <> "" : ProjectDescr$ + "      <buildcount enable=['']1[''] value=['']" + OptVal$ + "['']/>" + #CR$ : EndIf      ;      If FindString(IDEDescr$, "EnableExeConstant")        ProjectDescr$ + "      <execonstant enable=['']1['']/>" + #CR$      EndIf      ;      ProjectDescr$ + "    </target>" + #CR$      ProjectDescr$ + "  </section>" + #CR$      ProjectDescr$ + "</project>" + #CR$    EndIf    ;    If ProjectIsModified      ProjectBuf\s = ReplaceDoubleSimpleQuoteByDoubleQuote(ProjectDescr$)      ApplyLineEnding(@ProjectBuf, ProjectEOL)      If TexteDansFichier(ProjectAddress$, ProjectBuf\s, ProjectEncoding, 0, 0) = 0        AlertInPBBWindow(GetTextFromCatalogPB("ErrorWithFile") + " " + ProjectAddress$)        ProcedureReturn #False      EndIf    EndIf    ;    If ProjectIsModified Or WasOpen      Message$ = GetTextFromCatalogPB("WouldYouOpenProject")      If WasOpen And ProjectIsModified = 0        Message$ = GetTextFromCatalogPB("ProjectNotModified") + #CR$ + #CR$ + Message$      EndIf      If AlertInPBBWindow(Message$, "", 1, 0, 0, 0, "", #AW_YesOrNo_YesByDefault) = #PB_MessageRequester_Yes        RunProgram(#DOUBLEQUOTE$ + PureBasicProgAddr$ + #DOUBLEQUOTE$, #DOUBLEQUOTE$ + ProjectAddress$ + #DOUBLEQUOTE$, GetPathPart(ProjectAddress$))      EndIf    Else      AlertInPBBWindow(GetTextFromCatalogPB("ProjectNotModified"))    EndIf  EndIfEndProcedure;RegisterCustomTool("InCatalog:CreateUpdateProjectTitle", "InCatalog:CreateUpdateProjectEx", @CreateUpdateProject());Procedure ExportPBBSrcFile()  ;  ; Role: Opens the PBBrowser download webpage in the system's default browser.  ;  RunProgram("https://www.editions-humanis.com/downloads/PureBasic/ZapmanDowloads_EN.htm")EndProcedure;RegisterCustomTool("InCatalog:ExportSourceCodeTitle", "InCatalog:ExportSourceCodeEx", @ExportPBBSrcFile(), 1);; --------------------------------------------------------------------------;                        --- Erase Comments ---; --------------------------------------------------------------------------;EnumerationBinary EraseCommentsOptions  #ECCancel   = 1 ; User cancelled or closed the dialog  #ECComments = 2 ; Erase all comments from source files  #ECSpaces   = 4 ; Clean inline spaces/tabs and collapse empty lines  #ECCopy     = 8 ; Apply changes to a backup copy in *TargetDir\s instead of in-placeEndEnumeration;Procedure.i EraseCommentsOptionsWindow(*TargetDir.String)  ;  ; Role: Displays a single themed modal dialog collecting comment/whitespace cleaning flags  ;       and project backup copy settings in one step, returning an EraseCommentsOptions bitmask.  ;  Protected WinID, ChkComments, ChkSpaces, ChkCopy, StrFolder, BtnBrowse, BtnOK, BtnCancel  Protected WWidth = 460, WHeight = 195, OX, OY, ParentWindowID  Protected Event, ValidateChoice, CanValidate, Result = #ECCancel  Protected DefaultDir$, PickedDir$, GadgetList$  ;  DefaultDir$    = GetDefaultProjectCopyDir()  ParentWindowID = ComputeWinOrigins(@OX, @OY, WWidth, WHeight, GPBBGadgets\PBBWindow)  ;  DisablePBBWindow()  WinID = OpenWindow(#PB_Any, OX, OY, WWidth, WHeight, GetTextFromCatalogPB("EraseCommentsTitle"), #PB_Window_SystemMenu | #PB_Window_Invisible, ParentWindowID)  If WinID    ApplyDarkModeToWindow(WinID)    StickyWindow(WinID, 1)    ;    ChkComments = CheckBoxGadget(#PB_Any, 18, 16, 424, 24, GetTextFromCatalogPB("EC_EraseAllComments"))    SetGadgetState(ChkComments, #PB_Checkbox_Checked)    GadgetList$ + Str(ChkComments) + ","    ;    ChkSpaces = CheckBoxGadget(#PB_Any, 18, 44, 424, 24, GetTextFromCatalogPB("EC_EraseExtraSpaces"))    GadgetList$ + Str(ChkSpaces) + ","    ;    ChkCopy = CheckBoxGadget(#PB_Any, 18, 78, 424, 24, GetTextFromCatalogPB("EC_WorkOnCopy"))    SetGadgetState(ChkCopy, #PB_Checkbox_Checked)    GadgetList$ + Str(ChkCopy) + ","    ;    StrFolder = StringGadget(#PB_Any, 38, 106, 368, 24, DefaultDir$)    GadgetList$ + Str(StrFolder) + ","    ;    BtnBrowse = ButtonGadget(#PB_Any, 412, 106, 30, 24, "...")    GadgetList$ + Str(BtnBrowse) + ","    ;    BtnCancel = ButtonGadget(#PB_Any, 252, 150, 90, 28, GetTextFromCatalogPB("Cancel"))    GadgetList$ + Str(BtnCancel) + ","    ;    BtnOK = ButtonGadget(#PB_Any, 352, 150, 90, 28, GetTextFromCatalogPB("OK"), #PB_Button_Default)    GadgetList$ + Str(BtnOK) + ","    ;    ; Evaluate initial validation state before showing the dialog in case DefaultDir$ is empty    CanValidate = Bool(Trim(DefaultDir$) <> "")    DisableGadget(BtnOK, Bool(CanValidate = #False))    ;    SetFontAndGadgetsColors(WinID, InterfaceColorPresets(), GadgetList$)    AddKeyboardShortcut(WinID, #PB_Shortcut_Return, 100)    AddKeyboardShortcut(WinID, #PB_Shortcut_Escape, 101)    ClearKeyboardBuffer(WinID)    HideWindow(WinID, #False)    ;    Repeat      Event = WaitWindowEvent()      If EventWindow() <> WinID        SetActiveWindow(WinID)      Else        Select Event          Case #PB_Event_CloseWindow            Break            ;          Case #PB_Event_Menu            Select EventMenu()              Case 100                If CanValidate                  ValidateChoice = #True                EndIf              Case 101                Break            EndSelect            ;          Case #PB_Event_Gadget            Select EventGadget()              Case BtnOK                If CanValidate                  ValidateChoice = #True                EndIf              Case BtnCancel                Break              Case BtnBrowse                PickedDir$ = PathRequester(GetTextFromCatalogPB("SelectFolder"), GetGadgetText(StrFolder))                If PickedDir$ <> ""                  SetGadgetText(StrFolder, PickedDir$)                EndIf            EndSelect            ;            ; Synchronize folder controls and block validation if no cleaning action or target folder is valid            CanValidate = Bool((GetGadgetState(ChkComments) = #PB_Checkbox_Checked Or GetGadgetState(ChkSpaces) = #PB_Checkbox_Checked) And                               (GetGadgetState(ChkCopy) = #PB_Checkbox_Unchecked Or Trim(GetGadgetText(StrFolder)) <> ""))            DisableGadget(StrFolder, Bool(GetGadgetState(ChkCopy) = #PB_Checkbox_Unchecked))            DisableGadget(BtnBrowse, Bool(GetGadgetState(ChkCopy) = #PB_Checkbox_Unchecked))            DisableGadget(BtnOK, Bool(CanValidate = #False))        EndSelect        ;        If ValidateChoice          Result = 0          If GetGadgetState(ChkComments) = #PB_Checkbox_Checked : Result | #ECComments : EndIf          If GetGadgetState(ChkSpaces) = #PB_Checkbox_Checked   : Result | #ECSpaces   : EndIf          If GetGadgetState(ChkCopy) = #PB_Checkbox_Checked            Result | #ECCopy            If *TargetDir              *TargetDir\s = Trim(GetGadgetText(StrFolder))            EndIf          ElseIf *TargetDir            *TargetDir\s = ""          EndIf          Break        EndIf      EndIf    ForEver    ;    ClearKeyboardBuffer(WinID)    CloseWindow(WinID)  EndIf  ;  EnablePBBWindow()  ProcedureReturn ResultEndProcedure;Procedure EraseCommentsOneFile(FileName$, CleanSpaces, EraseAllComments)  ;  ; Role: Strips comments and/or normalizes spaces and empty lines in 'FileName$' according to  ;       'CleanSpaces' and 'EraseAllComments', saving back to disk only if content changed  ;       while preserving the original file encoding and physical BOM state.  ;  Protected CodeContent.String  Protected FileEncoding, HasBOM  Protected OriginalContent$  ;  CodeContent\s = FileToText(FileName$)  FileEncoding  = BOM  HasBOM        = FileHasBOM  If CodeContent\s = ""    ProcedureReturn #False  EndIf  ;  OriginalContent$ = CodeContent\s  DeleteCommentsAndSpacesFromPBCode(@CodeContent, CleanSpaces, EraseAllComments)  ;  If CodeContent\s <> OriginalContent$    ProcedureReturn Bool(TexteDansFichier(FileName$, CodeContent\s, FileEncoding, 0, HasBOM) <> 0)  EndIf  ProcedureReturn #FalseEndProcedure;Procedure EraseComments()  ;  ; Role: Prompts the user once via EraseCommentsOptionsWindow() for cleaning and backup options,  ;       processes all target project files, and triggers a full re-scan if modified in place.  ;  Protected NewList FilesToChange.FilesToChangeStruct()  Protected TargetDir.String  Protected Options, CleanSpaces, EraseAllComments, MakeCopy, WGadget, Modified  ;  If Left(GetFilePart(PBBFicPrincipalPB$), Len("PureBasic_TempFile")) = "PureBasic_TempFile"    AlertInPBBWindow(GetTextFromCatalogPB("NotForTempFile"))    ProcedureReturn #False  EndIf  ;  Options = EraseCommentsOptionsWindow(@TargetDir)  If (Options & #ECCancel) Or Options = 0    ProcedureReturn #False  EndIf  ;  CleanSpaces      = Bool(Options & #ECSpaces)  EraseAllComments = Bool(Options & #ECComments)  MakeCopy         = Bool(Options & #ECCopy)  ;  If PrepareProjectTargetFiles(MakeCopy, FilesToChange(), @TargetDir) = #False    ProcedureReturn #False  EndIf  ;  DisablePBBWindow()  WGadget = OpenWaitWindow(GPBBGadgets\PBBWindow, "")  ;  ForEach FilesToChange()    If FileSize(FilesToChange()\TargetFile) > 1      If IsGadget(WGadget)        SetGadgetText(WGadget, GetTextFromCatalogPB("EraseCommentsTitle") + #CR$ + GetFilePart(FilesToChange()\TargetFile))        UpdateWindow_(GadgetID(WGadget))      EndIf      If EraseCommentsOneFile(FilesToChange()\TargetFile, CleanSpaces, EraseAllComments)        Modified = 1      EndIf    EndIf  Next  ;  If IsGadget(WGadget)    DestroyParentWindow(WGadget)  EndIf  ;  If Modified Or (MakeCopy And TargetDir\s <> "")    AlertInPBBWindow(GetTextFromCatalogPB("FilesAreUpdated"))    If MakeCopy And TargetDir\s <> ""      RunProgram(TargetDir\s)    EndIf    If Modified And MakeCopy = #False      ExplorationState = #ExplorationState_MustRestart    EndIf  Else    AlertInPBBWindow(GetTextFromCatalogPB("NoElementFound"), GetTextFromCatalogPB("EraseCommentsTitle"))  EndIf  ;  EnablePBBWindow()  ProcedureReturn #TrueEndProcedure;RegisterCustomTool("InCatalog:EraseCommentsTitle", "InCatalog:EraseCommentsEx", @EraseComments(), 1);; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 755; FirstLine = 681; Folding = GT+; EnableXP; DPIAware; UseMainFile = ..\..\PBBrowser.pb