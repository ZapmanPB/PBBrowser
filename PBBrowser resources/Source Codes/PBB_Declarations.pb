; *******************************************************************************;;     Declarations of constants, structures, and global variables for PBBrowser;; *******************************************************************************;; ===============================================================================; 1. DEPENDENCIES, APPLICATION MODES & ENVIRONMENT GLOBALS; ===============================================================================;IncludePath  "Zapman libraries"XIncludeFile "GetTextFromCatalog.pbi"XIncludeFile "ApplyColorThemes.pbi"XIncludeFile "SetMenuItemEx.pbi"XIncludeFile "ZapmanFontRequester.pbi"XIncludeFile "ZapmanCommon.pbi";XIncludeFile "Alert.pbi"XIncludeFile "TOM_Functions.pbi"XIncludeFile "Pipe.pbi"XIncludeFile "FastStringFunctions.pbi";#PBBPortableMode = #False ; Suggestion from Michael Vogel: https://www.purebasic.fr/english/viewtopic.php?p=631763#p631763                          ; By setting #PBBPortableMode to #True and recompiling this code, you get a portable version                          ; of PBBrowser: a folder named "PBBrowser_Data" is created next to PBBrowser.exe to store                          ; its preferences and all required data files.                          ; You can then copy PBBrowser.exe and its "PBBrowser_Data" folder onto a USB drive, for example,                          ; to carry it from one computer to another without losing your settings.;; Another way to run PBBrowser in portable mode is to pass a command line; starting with the "\PORTABLE" switch at launch. Perform both steps below:; 1- Create a shortcut to PBBrowser.exe, right-click on the shortcut,;    and append " \PORTABLE" (including the leading space) at the end of the 'Target' field.;    Then, always launch PBBrowser using this shortcut.; 2- Open "Configure Tools..." in the PureBasic IDE, select;    'PB Browser', click 'Edit', and insert "\PORTABLE " before "%HOME" (with a space between;    "\PORTABLE" and "%HOME").;Global PureBasicProgAddr$, PBUnderCursor$, PBBFicPrincipalPB$, PBBEditorSourceFile$, PBUnderCursorPos ; Arguments passed by the PureBasic IDE.Global PBBCurrentProject$      ; Full path to the project file (.pbp), if any.Global MyAppDataFolder$        ; Path to the folder containing all resources for PBBrowser (including the .prefs file).Global PBBrowserPrefile$       ; Full path to the preferences file.Global PBBFirstLaunch          ; #True on the very first launch of the application.Global BOM                     ; String encoding BOM detected when reading source files.;; Fallback PureBasic IDE preference values required by PBBrowser, allowing it; to run properly on a machine where PureBasic is not installed:Global PBPrefSecure$PBPrefSecure$ = "ASMKeywordColor = 7490450" + #CR$ + "BackgroundColor = 14680063" + #CR$ + "BasicKeywordColor = 6710784" + #CR$PBPrefSecure$ + "CommentColor = 11184640" + #CR$ + "ConstantColor = 7490450" + #CR$ + "LabelColor = 0" + #CR$ + "NormalTextColor = 0" + #CR$PBPrefSecure$ + "NumberColor = 0" + #CR$ + "OperatorColor = 0" + #CR$ + "PointerColor = 0" + #CR$ + "PureKeywordColor = 6710784" + #CR$PBPrefSecure$ + "SeparatorColor = 0" + #CR$ + "StringColor = 14643200" + #CR$ + "StructureColor = 0" + #CR$ + "LineNumberColor = 8421504" + #CR$PBPrefSecure$ + "LineNumberBackColor = 14155775" + #CR$ + "MarkerColor = 11184640" + #CR$ + "CurrentLineColor = 12058623" + #CR$PBPrefSecure$ + "SelectionColor = 14120960" + #CR$ + "SelectionFrontColor = 16777215" + #CR$ + "CursorColor = 0" + #CR$PBPrefSecure$ + "Debugger_LineColor = 16771304" + #CR$ + "Debugger_LineSymbolColor = 16771304" + #CR$ + "Debugger_ErrorColor = 255" + #CR$PBPrefSecure$ + "Debugger_ErrorSymbolColor = 255" + #CR$ + "Debugger_BreakPointColor = 16776960" + #CR$PBPrefSecure$ + "Debugger_BreakpointSymbolColor = 16776960" + #CR$ + "DisabledBackColor = 16316664" + #CR$ + "GoodBraceColor = 6710784" + #CR$PBPrefSecure$ + "BadBraceColor = 255" + #CR$ + "ProcedureBackColor = 14680063" + #CR$ + "CustomKeywordColor = 6684672" + #CR$PBPrefSecure$ + "Debugger_WarningColor = 53503" + #CR$ + "Debugger_WarningSymbolColor = 53503" + #CR$ + "IndentColor = 11184640" + #CR$PBPrefSecure$ + "ModuleColor = 0" + #CR$ + "SelectionRepeatColor = 5746176" + #CR$ + "PlainBackground = 14680063" + #CR$PBPrefSecure$ + "EditorFontName = Consolas" + #CR$ + "EditorFontSize = 10";; ===============================================================================; 2. PUREBASIC GRAMMAR & LEXER CONSTANTS; ===============================================================================;#Space        = 32#Space$       = Chr(#Space)#DOUBLEQUOTE  = 34#DOUBLEQUOTE$ = Chr(#DOUBLEQUOTE)#SIMPLEQUOTE  = 39;; PureBasic mathematical, bitwise, and logical operator symbols:#PBOperatorAsSign$ = "+-/*<>=~|!&%@";; #PBBVariable is the only element type subdivided into scope species and container subspecies:#PBBLocalVariables$     = "Define,Shared,Static,Protected"#PBBVariableSpecies$    = "Global,Threaded" + "," + #PBBLocalVariables$#PBBVariableSubSpecies$ = "NewList,NewMap,Dim";; PureBasic keywords introducing a structural or callable element declaration:#PBElementDeclarators$  = "Procedure,ProcedureC,ProcedureDLL,ProcedureCDLL,Declare,DeclareC,DeclareDLL,DeclareCDLL,Structure,Macro,Enumeration,EnumerationBinary,Interface,Module,DeclareModule,Import,ImportC";; PureBasic keywords introducing a variable or container declaration:Global PBAreaDeclarator_LCase$ = "," + LCase(#PBBVariableSpecies$) + ","#PBVariableDeclarators$        = "," + #PBBVariableSpecies$ + "," + #PBBVariableSubSpecies$ + ",ReDim,";; PureBasic keywords and symbols that can precede a variable name or an expression:#PBTestOperators$               = ",If,ElseIf,While,Until,Select,Case,Default,CompilerIf,CompilerElseIf,CompilerSelect,CompilerCase,"#PBOperatorAsWord$              = #PBTestOperators$ + "To,Step,And,Or,Xor,Not,ProcedureReturn,Debug,With,For,ForEach,CompilerIf,CompilerElseIf,CompilerSelect,CompilerCase,Array,List,Map,Read,Data,";; PureBasic symbols that delimit variables and expressions:;#PBEndOfSegmentedLine$ = #TAB$ + "+" + #TAB$ + "," + #TAB$ + "|" + #TAB$ + "and" + #TAB$ + "or" + #TAB$ + "xor" + #TAB$;; Fundamental native types and built-in pseudo-structures (\i, \c, \s, etc.):#PBNativeTypes$ = "Byte,Ascii,Character,Word,Unicode,Long,Integer,Quad,Float,Double,String";; Primitive PureBasic data types (both single-letter suffixes and full keyword aliases):#PBPrimitiveTypeTokens$ = "b,a,c,w,u,l,i,q,f,d,s," + #PBNativeTypes$;; Pseudo-types reserved for Import and Prototype parameter declarations:#PBPseudoTypes$ = "p-ascii,p-utf8,p-unicode,p-bstr,p-variant";; Container qualifiers used in procedure and prototype signatures:#PBParamContainers$ = "Array,List,Map";; Predefined built-in structures in PureBasic (Windows API and runtime):#PBPredefinedStructures$ = "Point,Rect,String,Charrange,Pointl,Rectl,Msg,Guithreadinfo,Windowplacement,Size," +                           "Sizel,Guid,Filetime,Systemtime,Minmaxinfo,Bitmap,Bitmapinfo,Logfont,Logbrush,Paintstruct," +                           "Textmetric,Wndclassex,Notifyicondata,Openfilename,Pointf,Rectf,Points,Small_rect,Xform," +                           "Monitorinfo,Scrollbarinfo,Menubarinfo,Comboboxinfo,Tcitem,Tvitem,Lvitem,Lvcolumn,Headeritem," +                           "Toolinfo,Tbbutton,Focus,Dropfiles,Osversioninfo,Osversioninfoex,Security_attributes,Startupinfo," +                           "Process_information,Overlapped,Rgbquad,Bitmapinfoheader,Bitmapfileheader,Iconinfo,Cursorinfo," +                           "Devmode,Docinfo,Shfileinfo,Menuiteminfo,Nmhdr,Tooltiptext,Rebarbandinfo,Lvhittestinfo,Tvhittestinfo," +                           "Tvinsertstruct";; Native container manipulation functions used for snippet type inference:#PBB_ListFunctions  = ",addelement,insertelement,deleteelement,nextelement,previouselement,firstelement,lastelement,clearlist," +                      "copylist,freelist,listsize,selectelement,changecurrentelement,randomizelist,sortlist,sortstructuredlist," +                      "resetlist,listindex,mergelists,moveelement,swapelements,pushlistposition,poplistposition,"#PBB_MapFunctions   = ",addmapelement,deletemapelement,clearmap,copymap,freemap,mapsize,findmapelement,nextmapelement," +                      "previousmapelement,resetmap,pushmapposition,popmapposition,mapkey,"#PBB_ArrayFunctions = ",arraysize,copyarray,freearray,sortarray,sortstructuredarray,";Enumeration CodeLineContextEnum  #CodeCtx_Code = 0  #CodeCtx_Comment  #CodeCtx_QuoteEndEnumeration;; ===============================================================================; 3. CODE EXPLORATION & ELEMENT MODEL; ===============================================================================;#OutOfElementsName = "OutOfElements";Enumeration PBBTypes  #PBBTypeOrVar         = -3  #PBBStructOrInterface = -2  #PBBNoType            = 0  #PBBProcedure  #PBBMacro  #PBBEnumeration  #PBBStructure  #PBBInterface  #PBBModule  #PBBLabel  #PBBConstant  #PBBVariable  #PBBImport  #PBBImported            ; Imported functions or variables.  #EndEnumPBBElementTypes ; Marks the end of element types displayed in dedicated list panels.  #PBBField               ; Structure field or interface method.  #PBBNativeFunction      ; Native PureBasic or OS API function.  #PBBNativeKeyWord       ; Reserved/unused.  #PBBBasicKeyword        ; Core Basic language keywords (While, Wend, If, EndIf, etc.).  #EndEnumPBBTypes        ; Marks the end of colorized element types.  #PBBNotAnElement  #PBBWith  #PBBDeclareEndEnumeration;; Assign a display/internal name to each element type:Define TempVar_List$ = "Procedure,Macro,Enumeration,Structure,Interface,Module,Label,Constant,Variable,Import,Imported,,Field,PBNativeFunction,PBNativeKeyword,PBBasicKeyword,,,With,Declare";; Populate the PBBTypeNames$() lookup array up to #PBBDeclare:Global Dim PBBTypeNames$(#PBBDeclare)Define TempVar_Counter.iFor TempVar_Counter = #PBBProcedure To #PBBDeclare  PBBTypeNames$(TempVar_Counter) = StringField(TempVar_List$, TempVar_Counter, ",")Next;; Count of referenced ("used") elements per element type:Global Dim ListOfUsedElementsNbr(#EndEnumPBBElementTypes - 1);; Syntax highlighting color assigned to each element type:Global Dim ListOfAllElementsColor(#EndEnumPBBTypes - 1);Enumeration ListCompletionStateEnum ; Display state of each element list panel.  #ListCompletion_UnPrinted  #ListCompletion_PrintedEndEnumeration;; Tracks whether the list for a given element type has already been rendered in its panel:Global Dim ListCompletion(#EndEnumPBBElementTypes - 1);Enumeration ExplorationStateEnum  #ExplorationState_Pending = 1  #ExplorationState_Completed  #ExplorationState_MustRestart  #ExplorationState_ErrorEndEnumeration;Global ExplorationState = #ExplorationState_MustRestart;Enumeration PBB_PriorityMode ; Execution mode for background exploration tasks.  #WorkInBackGround  #FinishCompletionNowEndEnumeration;; Structure of 'ElementList()', storing all indexed elements across the examined source files:Structure Elements  FixedID.l  Name.s                   ; Name of the element (including '.Type' and '()' suffixes when applicable).  PurifiedName.s           ; Lowercase root identifier stripped of '.Type' and '()' suffixes.  Type.l                   ; Element type constant (#PBBProcedure, #PBBStructure, #PBBConstant, #PBBVariable, etc.).  VarDotType_LCase.s       ; For variables and fields: lowercase dot-type without leading dot (e.g., "s", "i", "mystruct").  VarDotModule_LCase.s     ; For variables and fields: lowercase module prefix when typed as '.Mod::MyStruct', or "".  VarAddedDotType.b        ; #True if an untyped variable or field received the default ".i" dot-type.  VariableSpecie.s         ; For variables only: scope species (Global, Threaded, Protected, Static, Shared, or Define).  VariableSubSpecie.s      ; For variables and fields: container subspecies (List, Array, Map, or Var).  HasParentheses.b         ; 1 for procedures, arrays, lists, maps, and parameterized macros; 0 otherwise.  FileName.s               ; Full path to the source file hosting the primary declaration.  Declaration.s            ; Full declaration statement text (e.g., "Procedure IncreaseCharPointer(*Pointer)").  LocalVarContainer.l      ; Enclosing Procedure/Macro FixedID (local variables), Structure/Interface FixedID (#PBBField),                           ; Enumeration FixedID (#PBBConstant), or 0 otherwise.  EnclosingModuleID.l      ; FixedID of the enclosing #PBBModule element (-1 if global scope).  IsDeclareModule.b        ; #True if declared within 'DeclareModule ... EndDeclareModule', #False otherwise.  HasUseModule.b           ; For #PBBModule only: #True if referenced by a 'UseModule' or 'UnuseModule' directive.  Continued.s              ; Additional declaration locations (multi-part Enumerations, DeclareModule/Module pairs,                           ; 'Declare' headers, multi-procedure Protected/Shared variables, or duplicate fields).                           ; Serialized from CED_Structure:                           ;   Filename.s        - Source file hosting the secondary declaration.                           ;   StartingPos.l     - 1-based start offset of the declaration.                           ;   EndingPos.l       - 1-based end offset of the declaration.                           ;   Declaration.s     - Declaration statement text.                           ;   DirectContainer.l - Enclosing container FixedID, or -1 if outside a procedure.                           ;   SharedDotType.s   - For "Shared" variables only: "None" or the explicit dot-type.                           ; CAUTION: \Continued stores only secondary declarations, never the primary one.                           ; For procedures, it stores only "Declare" headers, whereas \StartingPos and \EndingPos                           ; hold the actual procedure body coordinates.  StartingPos.l            ; 1-based start offset of the element definition in FileName.  EndingPos.l              ; 1-based end offset of the element definition (e.g., end of "EndProcedure").  Used.b                   ; #True if the element is reachable from main-scope code through the call graph.  OOE_UsagePos.s           ; FileName and 1-based offset of the first main-scope reference ("File,Pos#CR$").  UsageParents.s           ; Slash-delimited FixedIDs of elements referencing this element ("/ID1/ID2/").                           ; NOTE: if a parent references a child, but the parent itself is unused,                           ;   the child is not marked as used (\Used remains #False).  UsageChildren.s          ; Slash-delimited FixedIDs of elements referenced by this element ("/ID1/ID2/").  Parameters.s             ; For Procedures, Declarations, and Macros: tab-bounded parameter list ("#TAB$Arg1#TAB$Arg2.i#TAB$").  MacroTokens.s            ; For Macros only: captured body tokens serialized as "TokenName#TAB$TID#CR$" lines.  MacroVirtualPos.i        ; For Macros only: 1-based position of the macro in the virtual whole-project buffer.  Value.s                  ; For Constants only: evaluated numeric or quoted string value (or "UnResolved").  Comment.s                ; Trailing declaration comment (displayed for single-line elements such as constants).EndStructure;Global NewList ElementList.Elements();Global NewMap ElementMapIndex.s()          ; Fast O(1) lookup map indexing elements by their purified name.Global NewMap ParamMapIndex.s()            ; Maps purified formal parameter names to their enclosing Procedure/Macro FixedID.Global NewMap PBB_CompilerGuardSymbols.b() ; Tracks lowercase root names (#const or Defined() targets) tested in CompilerIf/CompilerSelect.Global NewMap PBB_Stage1Constants.s()      ; Temporary Stage-1 map resolving upstream '#Const = Expr' values during CompleteListOfFiles().Global PBB_HasUndefineMacro.b              ; #True once OnePass encounters at least one 'UndefineMacro' directive in the project.;; File cache status constants:Enumeration ValuesForCheckFileUpdating  #FileIsUpdated  #FileWasUpToDate  #FileMustBeUpdated  #FileDoesntExist  #FileHasBeenDeletedEndEnumeration;; ===============================================================================; 4. SEARCH ENGINE & NAVIGATION HISTORY; ===============================================================================;EnumerationBinary TypeOfSearchEnum  #PBBNoSearch              = $0   ; Idle search state. Signals that no search operation is queued or currently in progress.  #PBBSearchExact           = $1   ; Performs an exact name lookup.  #PBBSearchPrefix          = $2   ; Extends search to all elements whose name starts with '*SearchParam\ElementName$'.  #PBBUserWillChoose        = $4   ; Displays a popup menu when multiple candidates or multiple procedure scopes exist.  #PBBRefreshSearch         = $8   ; Silently re-evaluates the active search against updated in-memory buffers without prompts unless disambiguation fails.  #PBBSearchInAllProcedures = $10  ; Expands local variable matching across every procedure boundary while strictly rejecting global-scope symbols.  #PBBSearchRawText         = $20  ; Bypasses semantic AST analysis to execute a literal purified text search across all project files.  #PBBSearchFromIDE         = $40  ; Marks a transient search triggered externally from the PureBasic IDE (startup or pipe).EndEnumeration;#PBBNotFound = -1#PBBFound    =  1;Enumeration PBBSearchButtonModes  #PBBSearchBtn_Search  #PBBSearchBtn_LookUpEndEnumeration;; EXPRESSION SEARCHES; The fields in the following structure serve two purposes:; A) Configure how an expression search across the source code must be conducted.; B) Return detailed metadata about the resolved target.Structure SearchDetails  ElementName$              ; Complete display name, such as "MyList.s()".  ElementPurifiedName$      ; Lowercase purified name, such as "mylist" for "MyList.s()".  TypeOfElement.i           ; Element category constant (e.g., #PBBProcedure or #PBBVariable).  FixedID.i                 ; O(1) index of the resolved element in ElementFixedIndexes() / ElementList().                            ; STRICT USAGE LIMITATION (LIST MODE ONLY):                            ; - This field is ONLY populated when ExplorationState = #ExplorationState_Completed                            ;   and the search targets a single concrete element registered in ElementList().                            ; - In Text Mode (while background AST exploration is still running), or when the target                            ;   is a formal parameter ("Param"), an implicit variable, a native PureBasic function/keyword,                            ;   a raw text search, or a synthetic multi-scope group ("AllProcedures", "AllStructures", etc.),                            ;   FixedID MUST remain 0. All consumers must therefore fall back to text/contextual                            ;   resolution whenever FixedID = 0.  VarDotType$               ; Explicit type or structure name without leading dot (e.g., "string", "i", or "MyStruct").  ElementSpecies$           ; Variable scope declarator (e.g., "Global", "Threaded", "Protected", "Shared", "Define", "Param").  ElementSubSpecies$        ; Container category: "Map", "List", "Array", or "Var".  ParentTypeAndName$        ; Type and name of the enclosing structure/interface for a field (#PBBField),                            ; or of the encompassing container (Procedure, Macro, Enumeration) for the element.                            ; Format: TypeName + #Space$ + ElementName.  ModuleName$               ; Enclosing Module or DeclareModule name (e.g., "ValidationModule")                            ; when the element is defined within a module scope. Empty if in global scope.  HasParentheses.i          ; -1 -> Unknown whether the element has parentheses.                            ;  1 -> The element has or must have parentheses.                            ;  0 -> The element does not have or must not have parentheses.  StartingContextLimit.i    ; For local variables, 1-based starting position of the encompassing procedure or macro.  EndingContextLimit.i      ; For local variables, 1-based ending position of the encompassing procedure or macro.  ElementPosition.i         ; 1-based character position of the element's declaration or inspected occurrence.  ElementFile$              ; Full disk path to the source file containing ElementPosition.  DontCheckPosition.b       ; #True when expanding a search across all scopes/containers of the project.  MultipleResults.i         ; Total number of concrete homonyms/scopes across the project (drives the "LookUp (N)" button).  OtherScopesCount.i        ; Number of remaining scopes not currently displayed in FoundInFiles (drives the footer link).  SearchPurifiedOnly.b      ; #True to perform a raw identifier search without checking VarDotType$, HasParentheses,                            ; or local variable scope boundaries.  SearchInQuotes.b          ; #True to extend the search to string literals inside quotes.  SearchInCom.b             ; #True to extend the search to code comments.  SearchInDeadZones.b       ; #True to extend the search into inactive CompilerIf/CompilerSelect zones and excluded files.  InDeadZone.b              ; #True when the search originated from an inactive CompilerIf/CompilerSelect zone.  NotAnElement.b            ; #True when syntax analysis proves ElementName$ is a composite expression rather than an element.EndStructure;#PBB_MaxCompilerDepth = 32;Enumeration CompilerTriState  #Cond_Undetermined = -1  #Cond_False        = 0  #Cond_True         = 1EndEnumeration;Structure DeadZoneStruct  StartingPos.l ; 1-based inclusive start offset of an inactive conditional compilation zone.  EndingPos.l   ; 1-based inclusive end offset of an inactive conditional compilation zone.EndStructure;Structure CompilerStackLevel  IsSelect.b      ; #True for CompilerSelect..CompilerEndSelect, #False for CompilerIf..CompilerEndIf.  ParentActive.b  ; #True when all enclosing outer blocks are active (or undetermined).  BranchActive.b  ; #True when the current branch is active (or undetermined), #False when dead.  HasMatched.b    ; #Cond_True once a branch matched, #Cond_Undetermined if an undetermined test occurred, #Cond_False otherwise.  SelectVal.s     ; Canonical evaluated target of CompilerSelect ("123" or Chr(34)+"abc"+Chr(34)), or "" if undetermined.EndStructure;Global PBB_ProjectDebugger = 1 ; Resolved from main .pbp / .pb IDE options (1 unless DisableDebugger / debug="0").Global PBB_ProjectThread   = 0 ; Resolved from main .pbp / .pb IDE options (1 when EnableThread / thread="1").;; Navigation history and hyperlinks for the 'Details' and 'Found in...' panels:Structure SearchMemory  Search_Details.SearchDetails  Search_DetailScrollPos.Point  Search_FoundInScrollPos.PointEndStructure;Global NewList ListOfSearches.SearchMemory();Structure DetailPanelContextStruct  FileName$  TypeOfElement.i  ElementFixedID.i  EnclosingModuleID.i  ModuleName$  ElementStartingPos.i  ElementEndingPos.i  EndIntroPos.iEndStructure;Global DetailPanelContext.DetailPanelContextStruct;Structure DetailLinkStruct  StartOffset.i  EndOffset.i  ForceUserChoice.b  TargetDetails.SearchDetailsEndStructure;Global NewList DetailPanelLinks.DetailLinkStruct();; ===============================================================================; 5. UI SPECIAL SYMBOLS, FONTS & RICHEDIT FORMATTING; ===============================================================================;; Standard arrow cursor displayed over RichEdit gadgets:Global PBBDefaultCursor = LoadCursor_(0, #IDC_ARROW);; Fonts and style descriptors used across PBBrowser windows and EditorGadgets:Global PBBAllGadgetsFontGlobal PBBTitleFontGlobal PBBProgressLegendFontGlobal PBBBRefreshFontGlobal PBBPanelsDefaultFontStyle$Global PBBCodeFontStyle$;; Special formatting and marker characters used in result panels:#NonBreakableSpace     = 160                    ; Improves line-break behavior in result panels and marks file name positions in results.#NonBreakableSpace$    = Chr(#NonBreakableSpace)#SpecialSpace$         = Chr(8239)              ; Narrow no-break space separating a searched expression from its type, e.g., MyProcedure#SpecialSpace$(Procedure).#ThisPlaceChar$        = Chr(10157)             ; "➭" — Placed after 'Set', 'Param', and 'Arg' tags in the 'Found in...' panel.#ItsHereChar$          = Chr(9655)              ; "▷" — Hollow right-pointing triangle placed after an element name in the 'Found in...' panel to mark its exact occurrence.#RefreshSymbol$        = Chr(10227)             ; "⟳" — Clockwise open circle arrow displayed on the 'Refresh' button.#HamburgerMenuSymbol$  = Chr(9776)              ; "☰" — Displayed on the context menu button of result panels.#BulletChar$           = Chr(8226)              ; "•" — Bullet character used in result panels.#PBBJoker$             = Chr(8230)              ; "…" — Ellipsis used as a wildcard when searching for an incomplete expression.#SpecialPoint$         = Chr($2024)#PBB_SnippetPosMarker$ = "/§Pos" + Chr($2024) + "/" ; Marks the target segment position within full code buffers.;; Navigation arrow buttons embedded in result panels:#PBBRTFMarker$        = "PBBMark_:"       ; Prefix identifying embedded button images inside RichEdit gadgets.#PBBLeftArrowMarker$  = "Previous"        ; Internal identifier for the '<<' navigation button.#PBBRightArrowMarker$ = "Next"            ; Internal identifier for the '>>' navigation button.#PBBLeftArrow$        = Chr(9668)         ; "◄" — Fallback character when the OS does not support embedded images in RichEdit controls.#PBBRightArrow$       = Chr(9658)         ; "►" — Fallback character when the OS does not support embedded images in RichEdit controls.#PBBArrowsFontStyle$  = "Bold,Size(12)"   ; Font style applied to fallback arrow characters.;#PBBFoldClosed$        = Chr($25B6) ; "▶" — Collapsed section or sub-section header in Variables panel.#PBBFoldOpen$          = Chr($25BC) ; "▼" — Expanded section or sub-section header in Variables panel.#PBB_InactiveZoneColor = $4646DC    ; Softened red (RGB 220, 70, 70) for inactive CompilerIf notices in light and dark modes.;Global CharButtonsIf OSVersion() <= #PB_OS_Windows_Server_2008_R2  ; Windows 7 and earlier versions cannot display embedded images inside RichEdit controls;  ; fall back to #PBBLeftArrow$ and #PBBRightArrow$ text characters instead.  CharButtons = #TrueElse  CharButtons = #FalseEndIf;; ===============================================================================; 6. UI PANELS, MENUS & WINDOW GADGETS; ===============================================================================;; Panel indices across PBBrowser's PanelGadgets:; Panel indices across PBBrowser's PanelGadgets:Enumeration PBBPanels  ; MainPBBPanel  #FilePBBPanel  #ListPBBPanel  #DetailPBBPanel  #FoundInFilesPBBPanel  ;  ; ListPBBPanel  #ProcPBBPanel  #MacroPBBPanel  #StructurePBBPanel  #EnumPBBPanel  #ConstantePBBPanel  #VariablePBBPanel  #LabelPBBPanel  #InterfacePBBPanel  #ModulePBBPanel  #ImportPBBPanel  #ImportedPBBPanel  #EndEnumPBBPanelsEndEnumeration;; Assign an internal name to each panel:Global Dim PBBPanelNames$(#EndEnumPBBPanels - 1)TempVar_List$ = "Files,Lists,Details,FoundIn,Procedures,Macros,Structures,Enumerations,Constants,Variables,Labels,Interfaces,Modules,Import,Imported"For TempVar_Counter = #FilePBBPanel To (#EndEnumPBBPanels - 1)  PBBPanelNames$(TempVar_Counter) = StringField(TempVar_List$, TempVar_Counter + 1, ",")Next;; Panel tab indices, hosting PanelGadget IDs, and associated RichEdit gadget IDs:Global Dim NoPBBPanel(#EndEnumPBBPanels - 1)Global Dim NoGadgetPBBPanel(#EndEnumPBBPanels - 1)Global Dim NoREGadgetOfPBBPanel(#EndEnumPBBPanels - 1);; Maps each panel index to the element type it displays (#PBBNotAnElement for non-list panels):Global Dim TypeElementOfPBBPanel(#EndEnumPBBPanels - 1)TypeElementOfPBBPanel(#FilePBBPanel)         = #PBBNotAnElementTypeElementOfPBBPanel(#ListPBBPanel)         = #PBBNotAnElementTypeElementOfPBBPanel(#DetailPBBPanel)       = #PBBNotAnElementTypeElementOfPBBPanel(#FoundInFilesPBBPanel) = #PBBNotAnElementTypeElementOfPBBPanel(#ProcPBBPanel)         = #PBBProcedureTypeElementOfPBBPanel(#MacroPBBPanel)        = #PBBMacroTypeElementOfPBBPanel(#StructurePBBPanel)    = #PBBStructureTypeElementOfPBBPanel(#EnumPBBPanel)         = #PBBEnumerationTypeElementOfPBBPanel(#InterfacePBBPanel)    = #PBBInterfaceTypeElementOfPBBPanel(#LabelPBBPanel)        = #PBBLabelTypeElementOfPBBPanel(#ConstantePBBPanel)    = #PBBConstantTypeElementOfPBBPanel(#VariablePBBPanel)     = #PBBVariableTypeElementOfPBBPanel(#ModulePBBPanel)       = #PBBModuleTypeElementOfPBBPanel(#ImportPBBPanel)       = #PBBImportTypeElementOfPBBPanel(#ImportedPBBPanel)     = #PBBImported;; Keyboard shortcut and context menu item identifiers:Enumeration PBB_Menus  #PBBMenu_Return  #PBBMenu_Escape  #PBBMenu_Find  #PBBMenu_THAT  #PBBMenu_Prefs  #PBBMenu_Up  #PBBMenu_Down  #PBBMenu_PageUp  #PBBMenu_PageDown  #PBBMenu_SetShortcut  #PBBMenu_NextPanel  #PBBMenu_PreviousPanel  #PBBMenu_NextPage  #PBBMenu_PreviousPage  #PBBMenu_PasteEndEnumeration;Enumeration REMenuItems  #REM_ZoomIn = 50  #REM_ZoomOut  #REM_ZoomReset  #REM_FindInPannel  #REM_CopyAll  #REM_SaveAsText  #REM_SaveAsRTFEndEnumeration;; Base ID offsets preventing collisions between built-in keyboard shortcuts,; dynamic search-result popup items, and user-configured tool shortcuts:#PBBMenu_SearchResultsOffset = 100#PBBMenu_CommandOffset       = 200;; Main window gadget, menu, and resource handles:Structure PBBGadgets  PBBWindow.i  AdrTitle.i  Adr_gadget.i  BChangeAdresse.i  SearchedExpressionTitle.i  SearchedExpression_gadget.i  ExpressionDetails.i  BSearchExpression.i  BSearchPlus.i  GLine.i  TProgressBar.i  EProgressBar.i  BStats.i  ;  MainPanelGadget.i  ListsPGadget.i  BAbout.i  BStick.i  BLanguage.i  BQuit.i  BRefresh.i  BREMenu.i  ;  REMenu.i  SearchResultMenu.i  IWhiteOver.i  Disabled.i  Menu.i  ToolTip.iEndStructure;Global GPBBGadgets.PBBGadgets;; Find/Replace dialog gadget handles and layout metrics:Structure _FR_Gadgets  Window.i  SearchLabel.i  SearchString.i  SearchActionButton.i  Scopes.i  ReplaceCheck.i  ReplaceString.i  ReplaceActionButton.i  ReplaceNote.i  MatchExact.i  MatchStartsWith.i  MatchContains.i  IgnoreComments.i  IgnoreStrings.i  ;  InternalMargin.i  ExternalMargin.i  ButtonWidth.i  ButtonHeight.i  ;  ToolTip.iEndStructure;Global FR_Gadgets._FR_GadgetsFR_Gadgets\Window = #PB_Ignore;; ===============================================================================; 7. EMBEDDED BINARY RESOURCES & STATIC DATASECTIONS; ===============================================================================;; Files embedded in the executable and extracted to the data folder on first launch:IncludePath  "..\Images";DataSection  ;  BLogo:  IncludeBinary "PBBrowserLogo.png"  BLogoEnd:  ;  BNext:  IncludeBinary "Next.jpg"  BNextEnd:  ;  BPrevious:  IncludeBinary "Previous.jpg"  BPreviousEnd:  ;  BNoNext:  IncludeBinary "NoNext.jpg"  BNoNextEnd:  ;  BNoPrevious:  IncludeBinary "NoPrevious.jpg"  BNoPreviousEnd:  ;  BDarkNext:  IncludeBinary "DarkNext.jpg"  BDarkNextEnd:  ;  BDarkPrevious:  IncludeBinary "DarkPrevious.jpg"  BDarkPreviousEnd:  ;  BDarkNoNext:  IncludeBinary "DarkNoNext.jpg"  BDarkNoNextEnd:  ;  BDarkNoPrevious:  IncludeBinary "DarkNoPrevious.jpg"  BDarkNoPreviousEnd:  ;  IncludePath  "..\Catalogs"  ;  BCatalogFR:  IncludeBinary "Francais\PBBrowser.catalog"  BCatalogFREnd:  ;  BIntroFR:  IncludeBinary "Francais\IntroPBBrowser.rtf"  BIntroFREnd:  ;  BCatalogEN:  IncludeBinary "English\PBBrowser.catalog"  BCatalogENEnd:  ;  BIntroEN:  IncludeBinary "English\IntroPBBrowser.rtf"  BIntroENEnd:  ;  BCatalogIT:  IncludeBinary "Italiano\PBBrowser.catalog"  BCatalogITEnd:  ;  BIntroIT:  IncludeBinary "Italiano\IntroPBBrowser.rtf"  BIntroITEnd:  ;  BCatalogRU:  IncludeBinary "Russian\PBBrowser.catalog"  BCatalogRUEnd:  ;  BIntroRU:  IncludeBinary "Russian\IntroPBBrowser.rtf"  BIntroRUEnd:  ;  BCatalogES:  IncludeBinary "Espanol\PBBrowser.catalog"  BCatalogESEnd:  ;  BIntroES:  IncludeBinary "Espanol\IntroPBBrowser.rtf"  BIntroESEnd:  ;  BCatalogDE:  IncludeBinary "Deutsch\PBBrowser.catalog"  BCatalogDEEnd:  ;  BIntroDE:  IncludeBinary "Deutsch\IntroPBBrowser.rtf"  BIntroDEEnd:  ;  IncludePath  ".."  ;  PBFunction:  IncludeBinary "PBFunctionList.Data"  PBFunctionEnd:  ;  APIFunction:  IncludeBinary "APIFunctionListing.txt"  APIFunctionEnd:  ;EndDataSection;; Core PureBasic language keywords (stored inline rather than in an external file); and COM interface identifiers used to read PureBasic's .chm help archives:DataSection  PBBasicKeyWords:  Data.s "And", "Array", "As", "Align", "Break", "CallDebugger", "Case", "CompilerCase", "CompilerDefault", "CompilerElse", "CompilerElseIf", "CompilerEndIf", "CompilerEndSelect"  Data.s "CompilerError", "CompilerIf", "CompilerSelect", "CompilerWarning", "Continue", "Data", "DataSection", "EndDataSection", "Debug", "DebugLevel", "Declare", "DeclareC"  Data.s "DeclareCDLL", "DeclareDLL", "Default", "Define", "Dim", "DisableASM", "DisableDebugger", "DisableExplicit", "DeclareModule", "Else", "ElseIf", "EnableASM"  Data.s "EnableDebugger", "EnableExplicit", "End", "EndEnumeration", "EndHeaderSection", "EndIf", "EndImport", "EndInterface", "EndMacro", "EndProcedure", "EndDeclareModule", "EndModule"  Data.s "EndSelect", "EndStructure", "EndStructureUnion", "EndWith", "Enumeration", "EnumerationBinary", "Extends", "FakeReturn", "For", "Next", "ForEach"  Data.s "ForEver", "Global", "Gosub", "Goto", "HeaderSection", "If", "Import", "ImportC", "IncludeBinary", "IncludeFile", "IncludePath", "Interface", "List", "Macro", "Map", "MacroExpandedCount"  Data.s "Module", "NewList", "NewMap", "Not", "Or", "Procedure", "ProcedureC", "ProcedureCDLL", "ProcedureDLL", "ProcedureReturn", "Protected", "Prototype"  Data.s "PrototypeC", "Read", "ReDim", "Repeat", "Until", "Restore", "Return", "Runtime", "Select", "Shared", "Static", "Step", "Structure", "StructureUnion"  Data.s "Swap", "Threaded", "To", "Wend", "While", "With", "XIncludeFile", "XOr", "UseModule", "UnuseModule", "UndefineMacro"  Data.s "EndPBBasicKeyWords"  ;  ; COM CLSID and IID for IStorage decompression of .chm help files:  CLSID_ITStorage:    Data.l $5D02926A    Data.w $212E, $11D0    Data.b $9D, $F9, $00, $A0, $C9, $22, $E6, $EC  IID_ITStorage:    Data.l $88CC31DE    Data.w $27AB, $11D0    Data.b $9D, $F9, $00, $A0, $C9, $22, $E6, $ECEndDataSection; IDE Options = PureBasic 6.40 (Windows - x64); CursorPosition = 661; FirstLine = 654; EnableXP; DPIAware; UseMainFile = ..\..\PBBrowser.pb