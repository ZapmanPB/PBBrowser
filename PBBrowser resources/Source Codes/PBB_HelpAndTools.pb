;***********************************************************************;;                            HelpAndTools.pb;                       Part of PBBrowser project;                     Zapman - Dec 2024 -> Nov 2026;;     Set of functions to display the 'Help and Tools' window and to;           manage the tool commands and their shortcuts.;;***********************************************************************;Prototype.i ProcedureWithoutArguments();Prototype.s ProcedureWithArguments(Arg$);Structure CommandDetails  CommandName$  CommandShortCut.i  CommandNo.i  Commandtype.i  CommandDescription$  CommandDontShow.i  CommandSimpleProcAddr.ProcedureWithoutArguments  CommandWithArgProcAdr.ProcedureWithArgumentsEndStructure;Global NewList CommandList.CommandDetails();Procedure.s ComputePrefFromCommandName(CommandName$)  Protected *Char.Character  ;  ; Role: Normalizes 'CommandName$' into an ASCII alphanumeric/underscore key name  ;       suitable for reading and writing entries in the preferences file.  ;  CommandName$ = ReplaceString(CommandName$, "InCatalog:", "")  While FindString(CommandName$, "  ")    CommandName$ = ReplaceString(CommandName$, "  ", " ")  Wend  CommandName$ = ReplaceString(Trim(CommandName$), " ", "_")  CommandName$ = RemoveAccents(CommandName$)  ;  ; Replace any non-alphanumeric character (other than '_') in place without heap allocations  *Char = @CommandName$  While *Char\c <> 0    If *Char\c <> '_' And       (*Char\c < '0' Or        (*Char\c > '9' And *Char\c < 'A') Or        (*Char\c > 'Z' And *Char\c < 'a') Or        *Char\c > 'z')      *Char\c = '_'    EndIf    *Char + SizeOf(Character)  Wend  ;  ProcedureReturn CommandName$EndProcedure;Procedure.s ResolveCatalogText(RawText$)  ;  ; Role: Translates 'RawText$' via the active language catalog when prefixed with "InCatalog:",  ;       or returns it unchanged otherwise.  ;  If Left(RawText$, 10) = "InCatalog:"    ProcedureReturn GetTextFromCatalogPB(Trim(Mid(RawText$, 11)))  EndIf  ProcedureReturn RawText$EndProcedure;Procedure AddCommandToList(*CDetails.CommandDetails)  Static cpt  Protected PrefBaseName$  ;  ; Role: Appends a tool command definition to CommandList(), assigns it a sequential CommandNo,  ;       and restores its persisted shortcut and menu visibility flags from preferences.  ;  If *CDetails And *CDetails\CommandName$    cpt + 1    ;    AddElement(CommandList())    CopyStructure(*CDetails, @CommandList(), CommandDetails)    CommandList()\CommandNo = cpt    ;    If OpenPreferencesWithPatience(PBBrowserPrefile$)      PrefBaseName$                 = ComputePrefFromCommandName(CommandList()\CommandName$)      CommandList()\CommandShortCut = ReadPreferenceInteger(PrefBaseName$ + "_Shortcut", *CDetails\CommandShortCut)      CommandList()\CommandDontShow = ReadPreferenceInteger(PrefBaseName$ + "_DontShow", *CDetails\CommandDontShow)      ClosePreferences()    EndIf  EndIf  ;  ProcedureReturn cptEndProcedure;Procedure GetCommandDetails(CommandName$)  Protected TargetName_LCase$  ;  ; Role: Positions CommandList() on the entry matching 'CommandName$' (case-insensitive)  ;       and returns its element pointer, or 0 if not found.  ;  TargetName_LCase$ = LCase(CommandName$)  If ListIndex(CommandList()) < 0 Or LCase(CommandList()\CommandName$) <> TargetName_LCase$    ForEach CommandList()      If LCase(CommandList()\CommandName$) = TargetName_LCase$        Break      EndIf    Next  EndIf  ;  If ListIndex(CommandList()) >= 0 And LCase(CommandList()\CommandName$) = TargetName_LCase$    ProcedureReturn @CommandList()  Else    AlertInPBBWindow("Program error in 'GetCommandDetails()':" + #CR$ +                     "An unknown CommandName$ was requested:" + #CR$ + "'" + CommandName$ + "'")    ProcedureReturn 0  EndIfEndProcedure;Procedure.s GetCommandName(CommandNo)  ;  ; Role: Positions CommandList() on 'CommandNo' and returns its raw CommandName$,  ;       or an error string if 'CommandNo' is invalid.  ;  If ListIndex(CommandList()) < 0 Or CommandList()\CommandNo <> CommandNo    ForEach CommandList()      If CommandList()\CommandNo = CommandNo        Break      EndIf    Next  EndIf  ;  If CommandNo > 0 And ListIndex(CommandList()) >= 0 And CommandList()\CommandNo = CommandNo    ProcedureReturn CommandList()\CommandName$  Else    ProcedureReturn "Error in GetCommandName() parameter: '" + Str(CommandNo) + "' isn't a valid command number."  EndIfEndProcedure;Procedure.s GetTranslatedCommandName(CommandeNo)  ;  ; Role: Returns the localized display title of the command identified by 'CommandeNo'.  ;  ProcedureReturn ResolveCatalogText(GetCommandName(CommandeNo))EndProcedure;Procedure.s GetTranslatedCommandDescription(CommandeNo)  ;  ; Role: Returns the localized description text of the command identified by 'CommandeNo'.  ;  GetCommandName(CommandeNo)  If ListIndex(CommandList()) >= 0 And CommandList()\CommandNo = CommandeNo    ProcedureReturn ResolveCatalogText(CommandList()\CommandDescription$)  EndIf  ProcedureReturn ""EndProcedure;Procedure GetCommandNo(CommandName$)  ;  ; Role: Returns the 1-based CommandNo associated with 'CommandName$', or 0 if not found.  ;  If GetCommandDetails(CommandName$)    ProcedureReturn CommandList()\CommandNo  EndIf  ProcedureReturn 0EndProcedure;Procedure GetCommandShortCut(CommandeNo)  ;  ; Role: Returns the keyboard shortcut assigned to 'CommandeNo', or 0 if none.  ;  GetCommandName(CommandeNo)  If ListIndex(CommandList()) >= 0 And CommandList()\CommandNo = CommandeNo    ProcedureReturn CommandList()\CommandShortCut  EndIf  ProcedureReturn 0EndProcedure;Procedure GetCommandDontShow(CommandeNo)  ;  ; Role: Returns the 'DontShow' menu visibility flag of 'CommandeNo'.  ;  GetCommandName(CommandeNo)  If ListIndex(CommandList()) >= 0 And CommandList()\CommandNo = CommandeNo    ProcedureReturn CommandList()\CommandDontShow  EndIf  ProcedureReturn 0EndProcedure;Procedure SaveCommandPref(CommandeNo, Suffix$, Value)  ;  ; Role: Persists an integer preference entry ('_Shortcut' or '_DontShow') for the active command.  ;  If ListIndex(CommandList()) >= 0 And CommandList()\CommandNo = CommandeNo    If OpenPreferencesWithPatience(PBBrowserPrefile$)      WritePreferenceInteger(ComputePrefFromCommandName(CommandList()\CommandName$) + Suffix$, Value)      ClosePreferences()    EndIf  EndIfEndProcedure;Procedure SetCommandShortCut(CommandeNo, ShortCut)  ;  ; Role: Updates the keyboard shortcut of 'CommandeNo' in memory and saves it to preferences.  ;  GetCommandName(CommandeNo)  If ListIndex(CommandList()) >= 0 And CommandList()\CommandNo = CommandeNo    CommandList()\CommandShortCut = ShortCut    SaveCommandPref(CommandeNo, "_Shortcut", ShortCut)  EndIfEndProcedure;Procedure SetCommandDontShow(CommandeNo, XDontShow)  ;  ; Role: Updates the 'DontShow' menu flag of 'CommandeNo' in memory and saves it to preferences.  ;  GetCommandName(CommandeNo)  If ListIndex(CommandList()) >= 0 And CommandList()\CommandNo = CommandeNo    CommandList()\CommandDontShow = XDontShow    SaveCommandPref(CommandeNo, "_DontShow", XDontShow)  EndIfEndProcedure;Procedure.s ExecCommandProc(Arg$ = "")  ;  ; Role: Invokes the callback procedure of the currently selected command in CommandList().  ;  If ListIndex(CommandList()) < 0    ProcedureReturn ""  EndIf  ;  If CommandList()\Commandtype = 1 And CommandList()\CommandSimpleProcAddr <> 0    ProcedureReturn Str(CommandList()\CommandSimpleProcAddr())  ElseIf CommandList()\Commandtype = 2 And CommandList()\CommandWithArgProcAdr <> 0    ProcedureReturn CommandList()\CommandWithArgProcAdr(Arg$)  Else    AlertInPBBWindow("Bad parameter for ExecCommandProc(). CommandName$ = " + CommandList()\CommandName$)    ProcedureReturn ""  EndIfEndProcedure;Procedure.s ExecCommandProcFromName(CommandName$, Arg$ = "")  ;  ; Role: Selects 'CommandName$' in CommandList() and executes its callback procedure.  ;  If GetCommandDetails(CommandName$)    ProcedureReturn ExecCommandProc(Arg$)  EndIf  ProcedureReturn ""EndProcedure;Procedure.s ExecCommandProcFromNo(CommandNo, Arg$ = "")  ;  ; Role: Selects 'CommandNo' in CommandList() and executes its callback procedure directly.  ;  GetCommandName(CommandNo)  If ListIndex(CommandList()) >= 0 And CommandList()\CommandNo = CommandNo    ProcedureReturn ExecCommandProc(Arg$)  EndIf  ProcedureReturn ""EndProcedure;; *******************************************************************************;;              Tips, Help and Tools (THAT) window & shortcut management;; *******************************************************************************;Structure THATGadgetsStruct  WTHAT.i  ; Layout parameters:  Margins.i  ButtonHeight.i  TitleHeight.i  TipsList$  HelpList$  ToolsList$  ;  IWhiteOver.i  ;  ; Gadget numbers:  TipsListTitle.i  TipsList.i  HelpListTitle.i  HelpList.i  ToolsListTitle.i  ToolsList.i  EExplanations.i  BExecute.i  BShortcut.i  TitleShortcut.i  Shortcut.i  XDontShow.i  BCopy.i  BQuit.i  ;EndStructure;Define THATGadgets.THATGadgetsStruct;Procedure HideTHATToolControls(HideState)  Shared THATGadgets.THATGadgetsStruct  ;  ; Role: Shows or hides the 5 tool-specific controls (shortcut display/assignment,  ;       menu visibility checkbox, and execute button) in the THAT window.  ;  HideGadget(THATGadgets\Shortcut, HideState)  HideGadget(THATGadgets\TitleShortcut, HideState)  HideGadget(THATGadgets\BShortcut, HideState)  HideGadget(THATGadgets\XDontShow, HideState)  HideGadget(THATGadgets\BExecute, HideState)EndProcedure;Procedure ExecCommandFromTHATWindow(NoLine)  Shared THATGadgets.THATGadgetsStruct  ;  ; Role: Masks and disables the THAT window while running tool command 'NoLine',  ;       then restores window interactivity and focus upon completion.  ;  HideGadget(THATGadgets\IWhiteOver, #False)  DisableWindow(THATGadgets\WTHAT, #True)  ;  ExecCommandProcFromNo(NoLine)  ;  DisableWindow(THATGadgets\WTHAT, #False)  HideGadget(THATGadgets\IWhiteOver, #True)  SetActiveWindow(THATGadgets\WTHAT)EndProcedure;Procedure ExecCommandFromPBBWindow(NoLine)  ;  ; Role: Disables the main PBBrowser window while running tool command 'NoLine',  ;       then re-enables it upon completion.  ;  DisablePBBWindow()  ExecCommandProcFromNo(NoLine)  EnablePBBWindow()EndProcedure;Procedure SetPBBShortcut()  Shared THATGadgets.THATGadgetsStruct  Protected ShortCutsList$, TitleName$  Protected CSGadgetNames.CSCTitleAndButtons  Protected NoLine, SC, MSC  ;  ; Role: Opens the shortcut capture dialog for the currently selected tool command,  ;       preventing collisions with reserved PBBrowser shortcuts and other tools,  ;       and updates both the THAT window and main PBBrowser window shortcut bindings.  ;  NoLine = GetGadgetState(THATGadgets\ToolsList) + 1  If NoLine > 0    HideGadget(THATGadgets\IWhiteOver, #False)    DisableWindow(THATGadgets\WTHAT, #True)    ;    ; Collect shortcuts already assigned to all other registered tools using uniform #CR$ delimiters    ForEach CommandList()      If CommandList()\CommandNo <> NoLine And CommandList()\CommandShortCut        ShortCutsList$ + GetTranslatedCommandName(CommandList()\CommandNo) + " = " + ComputeShortcutString(CommandList()\CommandShortCut) + #CR$      EndIf    Next    ;    TitleName$ = GetTranslatedCommandName(NoLine)    InitButtonsNamesForCaptureSC(CSGadgetNames.CSCTitleAndButtons)    CSGadgetNames\CaptureShortCutsTitle$ = GetTextFromCatalogPB("CaptureShortCutsTitleFor") + " " + TitleName$    MSC = GetCommandShortCut(NoLine)    CSGadgetNames\DefaultShortCut$ = ComputeShortcutString(MSC)    ;    ; Append native PBBrowser shortcuts matching exact AT_StringShort key tokens ('+', ADD, -, SUB)    ShortCutsList$ + "CloseThisWindow = ESC" + #CR$ + "ExecFind = RET" + #CR$    ShortCutsList$ + "OpenTipsHelpAndTools = CTRL + I" + #CR$    ShortCutsList$ + "Copy = CTRL + C" + #CR$ + "PasteAndSearch = CTRL + V" + #CR$    ShortCutsList$ + "FindSelectedExpression = CTRL + Q" + #CR$    ShortCutsList$ + "FindInPanel = CTRL + F" + #CR$ + "SaveAsRTF = CTRL + R" + #CR$    ShortCutsList$ + "SetShortcut / SaveAsText = CTRL + S" + #CR$    ShortCutsList$ + "ZoomIn = CTRL + '+'" + #CR$ + "ZoomIn (Numpad) = CTRL + ADD" + #CR$    ShortCutsList$ + "ZoomOut = CTRL + -" + #CR$ + "ZoomOut (Numpad) = CTRL + SUB" + #CR$ + "ZoomDefault = CTRL + 0" + #CR$    ShortCutsList$ + "ScrollUp = UP" + #CR$ + "ScrollDown = DOWN" + #CR$    ShortCutsList$ + "ScrollPageUp = PAGEUP" + #CR$ + "ScrollPageDown = PAGEDOWN" + #CR$    ShortCutsList$ + "PreviousPage = LEFT" + #CR$ + "NextPage = RIGHT" + #CR$    ShortCutsList$ + "PreviousPanel = SHIFT + TAB" + #CR$ + "NextPanel = TAB" + #CR$    ;    SC = CaptureShortCut(ShortCutsList$, CSGadgetNames)    If SC > -1      SetCommandShortCut(NoLine, SC)      If MSC        RemoveKeyboardShortcut(THATGadgets\WTHAT, MSC)        If IsWindow(GPBBGadgets\PBBWindow)          RemoveKeyboardShortcut(GPBBGadgets\PBBWindow, MSC)        EndIf      EndIf      If SC > 0        AddKeyboardShortcut(THATGadgets\WTHAT, SC, NoLine + #PBBMenu_CommandOffset)      EndIf    EndIf    ;    DisableWindow(THATGadgets\WTHAT, #False)    HideGadget(THATGadgets\IWhiteOver, #True)  EndIfEndProcedure;Procedure.s AddNormalColorToTextStyle(FontStyle$)  ;  ; Role: Completes a TOM font style descriptor string with explicit default color and zeroed  ;       typographic attributes (Bold, Italic, Underline, Strikethrough) wherever omitted.  ;  If FindString(FontStyle$, "ForeColor") = 0    FontStyle$ + ",ForeColor(" + Str(GetValueFromPB_PrefFile("NormalTextColor")) + ")"  EndIf  If FindString(FontStyle$, "Bold") = 0    FontStyle$ + ",Bold(0)"  EndIf  If FindString(FontStyle$, "Italic") = 0    FontStyle$ + ",Italic(0)"  EndIf  If FindString(FontStyle$, "Underline") = 0    FontStyle$ + ",Underline(0)"  EndIf  If FindString(LCase(FontStyle$), "strikethrough") = 0    FontStyle$ + ",Strikethrough(0)"  EndIf  ProcedureReturn FontStyle$EndProcedure;Procedure ResizeGadgetsTHAT()  Shared THATGadgets.THATGadgetsStruct  Protected FormWindowWidth, FormWindowHeight, LShift, HLists, HL1, WLists, LowBPos, SCLowPos, HLM, TW, PCA  ;  ; Role: Recomputes and applies positions and dimensions for all gadgets in the THAT window,  ;       adapting the right-hand explanation pane height when tool controls are visible.  ;  FormWindowWidth  = WindowWidth(THATGadgets\WTHAT)  FormWindowHeight = WindowHeight(THATGadgets\WTHAT)  LShift           = FormWindowWidth / 2.6  HLists           = (FormWindowHeight - 3 * THATGadgets\Margins - 3 * THATGadgets\TitleHeight) / 3  WLists           = LShift - THATGadgets\Margins / 2 - THATGadgets\Margins  HL1              = HLists / 2  ;  LowBPos  = FormWindowHeight - THATGadgets\ButtonHeight - THATGadgets\Margins + 2  SCLowPos = LowBPos - THATGadgets\ButtonHeight * 2 - THATGadgets\Margins * 2 + 6  ;  ResizeGadget(THATGadgets\TipsListTitle, #PB_Ignore, #PB_Ignore, WLists, #PB_Ignore)  ResizeGadget(THATGadgets\TipsList, #PB_Ignore, #PB_Ignore, WLists, HL1)  ;  ResizeGadget(THATGadgets\HelpListTitle, #PB_Ignore, HL1 + THATGadgets\Margins + THATGadgets\TitleHeight - 1, WLists, #PB_Ignore)  ResizeGadget(THATGadgets\HelpList, #PB_Ignore, HL1 + THATGadgets\Margins + THATGadgets\TitleHeight * 2, WLists, HLists)  ;  ResizeGadget(THATGadgets\ToolsListTitle, #PB_Ignore, HL1 + HLists + THATGadgets\Margins * 2 + THATGadgets\TitleHeight * 2 - 1, WLists, #PB_Ignore)  ResizeGadget(THATGadgets\ToolsList, #PB_Ignore, HL1 + HLists + THATGadgets\Margins * 2 + THATGadgets\TitleHeight * 3, WLists,               FormWindowHeight - HL1 - HLists - THATGadgets\Margins * 3 - THATGadgets\TitleHeight * 3)  ;  If GetGadgetState(THATGadgets\ToolsList) > -1    HLM = (THATGadgets\ButtonHeight + THATGadgets\Margins) * 3 + THATGadgets\Margins - 2  Else    HLM = (THATGadgets\ButtonHeight + THATGadgets\Margins) + THATGadgets\Margins - 2  EndIf  ResizeGadget(THATGadgets\EExplanations, LShift + THATGadgets\Margins / 2, THATGadgets\Margins,               FormWindowWidth - LShift - THATGadgets\Margins / 2 - THATGadgets\Margins, FormWindowHeight - HLM - THATGadgets\Margins)  ;  If GetGadgetState(THATGadgets\ToolsList) > -1 And GetGadgetText(THATGadgets\Shortcut) <> ""    TW  = GetTextWidthPix(THATGadgets\Shortcut, GetGadgetText(THATGadgets\Shortcut))    PCA = TW + THATGadgets\Margins    HideGadget(THATGadgets\Shortcut, #False)    SetGadgetText(THATGadgets\BShortcut, GetTextFromCatalogPB("Change"))  Else    TW  = 10    PCA = 0    HideGadget(THATGadgets\Shortcut, #True)    SetGadgetText(THATGadgets\BShortcut, GetTextFromCatalogPB("Assign"))  EndIf  ResizeGadget(THATGadgets\TitleShortcut, LShift + THATGadgets\Margins / 2, SCLowPos + 3, #PB_Ignore, #PB_Ignore)  ResizeGadget(THATGadgets\Shortcut, LShift + THATGadgets\Margins / 2 + GadgetWidth(THATGadgets\TitleShortcut) + THATGadgets\Margins, SCLowPos + 6, TW, #PB_Ignore)  ResizeGadget(THATGadgets\BShortcut, LShift + THATGadgets\Margins / 2 + GadgetWidth(THATGadgets\TitleShortcut) + PCA + THATGadgets\Margins, SCLowPos, #PB_Ignore, #PB_Ignore)  ;  ResizeGadget(THATGadgets\XDontShow, LShift + THATGadgets\Margins / 2, SCLowPos + THATGadgets\ButtonHeight, #PB_Ignore, #PB_Ignore)  ;  ResizeGadget(THATGadgets\BExecute, LShift + THATGadgets\Margins / 2, LowBPos, #PB_Ignore, #PB_Ignore)  ResizeGadget(THATGadgets\BQuit, FormWindowWidth - GadgetWidth(THATGadgets\BQuit) - THATGadgets\Margins, LowBPos, #PB_Ignore, #PB_Ignore)  ResizeGadget(THATGadgets\BCopy, FormWindowWidth - GadgetWidth(THATGadgets\BCopy) - GadgetWidth(THATGadgets\BQuit) - 2 * THATGadgets\Margins, LowBPos, #PB_Ignore, #PB_Ignore)  ;  ; Recreate or resize the translucent overlay matching the updated window dimensions  THATGadgets\IWhiteOver = WhiteBoxOverWindow(THATGadgets\WTHAT)EndProcedure;#FromCommandList$ = "FromCommandList";Procedure FillTHATReGadget(ReGadget, TextList$, NoLine, SButton, XDontShow)  Protected LName$, TitleName$, InfoText$, ExText$, ExLine$, LocalFontStyle$  Protected p, mp, ep  ;  ; Role: Retrieves the help topic or tool description at 1-based index 'NoLine' from the catalog  ;       or CommandList(), renders it (RTF or styled plain text) into 'ReGadget', and updates tool states.  ;  If NoLine > 0    If TextList$ = #FromCommandList$      TitleName$ = GetTranslatedCommandName(NoLine)      InfoText$  = GetTranslatedCommandDescription(NoLine)      SetGadgetText(SButton, ComputeShortcutString(GetCommandShortCut(NoLine)))      SetGadgetState(XDontShow, GetCommandDontShow(NoLine))    Else      ; Catalog entries follow the naming pair convention: '<Topic>Title' for the heading and '<Topic>Ex' for the body      LName$ = StringField(TextList$, NoLine, ",")      If LName$        TitleName$ = GetTextFromCatalogPB(LName$)        InfoText$  = GetTextFromCatalogPB(ReplaceString(LName$, "Title", "Ex"))      EndIf    EndIf    ;    ; Derive the complete font descriptor locally so future theme switches recompute ForeColor cleanly    LocalFontStyle$ = AddNormalColorToTextStyle(PBBPanelsDefaultFontStyle$)    ;    If TitleName$      PBB_SuspendRedraw(ReGadget, #True)      ;      If @InfoText$ And (PeekC(@InfoText$) = #RTF_Marker Or Left(InfoText$, 2) = "{\")        TOM_InsertText(ReGadget, InfoText$, 0, -1)        TOM_SetFontStyles(ReGadget, LocalFontStyle$, 0, -1)      Else        ; Normalize all line breaks to single #CR$ so PureBasic string offsets match RichEdit/TOM character positions 1:1        InfoText$ = ReplaceString(ReplaceString(InfoText$, #CRLF$, #CR$), #LF$, #CR$)        ExText$   = TitleName$ + #CR$ + InfoText$        TOM_InsertText(ReGadget, ReplaceString(ExText$, #CR$, #CRLF$), 0, -1)        TOM_ResetFontStyles(ReGadget, 0, -1)        TOM_SetFontStyles(ReGadget, LocalFontStyle$, 0, -1)        TOM_SetParaStyles(ReGadget, "LeftIndent(6), RightIndent(6), SpaceAfter(2), Align(Justify)", 0, Len(ExText$))        ;        p = 0        Repeat          mp = p + 1          p  = FindString(ExText$, #CR$, mp)          ep = p          If ep = 0 And mp < Len(ExText$)            ep = Len(ExText$) + 1          EndIf          ExLine$ = Mid(ExText$, mp, ep - mp)          If mp = 1            TOM_SetFontStyles(ReGadget, "ForeColor(" + GetPBBStringParameter("PBBSetValueColor") + "), Bold", mp - 1, ep)            TOM_SetParaStyles(ReGadget, "SpaceAfter(6)", mp - 1, ep)          ElseIf Left(ExLine$, 2) = "• "            ; Apply hanging indentation to bulleted items            TOM_SetParaStyles(ReGadget, "LeftIndent(15), FirstLineIndent(-8)", mp - 1, ep)          EndIf        Until p = 0      EndIf      TOM_SetSelectionPos(ReGadget, 0, 0)      PBB_SuspendRedraw(ReGadget, #False)    EndIf  EndIfEndProcedure;Procedure FillListGadget(NoGadget, TextList$)  Protected NoLine  Protected LName$  ;  ; Role: Populates 'NoGadget' with localized item titles either from CommandList()  ;       (when TextList$ = #FromCommandList$) or from a comma-separated list of catalog keys.  ;  If TextList$ = #FromCommandList$    ForEach CommandList()      AddGadgetItem(NoGadget, -1, GetTranslatedCommandName(CommandList()\CommandNo))    Next  Else    Repeat      NoLine + 1      LName$ = StringField(TextList$, NoLine, ",")      If LName$        AddGadgetItem(NoGadget, -1, GetTextFromCatalogPB(LName$))      EndIf    Until LName$ = ""  EndIfEndProcedure;Procedure SetUpExplanationContent(EventMenu)  Shared THATGadgets.THATGadgetsStruct  Protected ListGadget, NoLine, HopCount  Protected Nlist$  ;  ; Role: Synchronizes single-item selection across the three category ListViewGadgets  ;       (handling cyclic Up/Down keyboard navigation) and refreshes the explanation pane.  ;  ListGadget = GetActiveGadget()  If ListGadget <> THATGadgets\TipsList And ListGadget <> THATGadgets\HelpList And ListGadget <> THATGadgets\ToolsList    If GetGadgetState(THATGadgets\TipsList) > -1      ListGadget = THATGadgets\TipsList    ElseIf GetGadgetState(THATGadgets\HelpList) > -1      ListGadget = THATGadgets\HelpList    ElseIf GetGadgetState(THATGadgets\ToolsList) > -1      ListGadget = THATGadgets\ToolsList    Else      ListGadget = THATGadgets\TipsList    EndIf  EndIf  ;  NoLine = GetGadgetState(ListGadget)  If EventMenu = #PBBMenu_Down : NoLine + 1 : EndIf  If EventMenu = #PBBMenu_Up   : NoLine - 1 : EndIf  ;  ; Wrap selection seamlessly into the next non-empty ListViewGadget when crossing top or bottom boundaries  If NoLine < 0    Repeat      HopCount + 1      If ListGadget = THATGadgets\TipsList      : ListGadget = THATGadgets\ToolsList      ElseIf ListGadget = THATGadgets\HelpList  : ListGadget = THATGadgets\TipsList      ElseIf ListGadget = THATGadgets\ToolsList : ListGadget = THATGadgets\HelpList      EndIf      NoLine = CountGadgetItems(ListGadget) - 1    Until NoLine >= 0 Or HopCount >= 3  ElseIf NoLine > CountGadgetItems(ListGadget) - 1    Repeat      HopCount + 1      If ListGadget = THATGadgets\TipsList      : ListGadget = THATGadgets\HelpList      ElseIf ListGadget = THATGadgets\HelpList  : ListGadget = THATGadgets\ToolsList      ElseIf ListGadget = THATGadgets\ToolsList : ListGadget = THATGadgets\TipsList      EndIf      NoLine = 0    Until CountGadgetItems(ListGadget) > 0 Or HopCount >= 3  EndIf  ;  SetActiveGadget(ListGadget)  SetGadgetState(THATGadgets\TipsList, -1)  SetGadgetState(THATGadgets\HelpList, -1)  SetGadgetState(THATGadgets\ToolsList, -1)  SetGadgetState(ListGadget, NoLine)  ;  HideTHATToolControls(Bool(ListGadget <> THATGadgets\ToolsList))  If ListGadget = THATGadgets\ToolsList    Nlist$ = THATGadgets\ToolsList$  ElseIf ListGadget = THATGadgets\TipsList    Nlist$ = THATGadgets\TipsList$  Else    Nlist$ = THATGadgets\HelpList$  EndIf  ;  FillTHATReGadget(THATGadgets\EExplanations, Nlist$, NoLine + 1, THATGadgets\Shortcut, THATGadgets\XDontShow)  ResizeGadgetsTHAT()EndProcedure;Macro SetUpListGadget(TGadget, LGadget, GadgetTitleName, LText)  ;  ; Role: Creates a titled ListViewGadget pair and populates its entries from 'LText'.  ;  TGadget = TextGadget(#PB_Any, THATGadgets\Margins, 0, 1, 18, GetTextFromCatalogPB(GadgetTitleName))  LGadget = ListViewGadget(#PB_Any, THATGadgets\Margins, THATGadgets\TitleHeight, 1, 1)  FillListGadget(LGadget, LText)EndMacro;Macro FontAndColorForTitles(TGadget)  ;  ; Role: Applies the theme-aware section title font and foreground color to 'TGadget'.  ;  SetGadgetColorEx(TGadget, #PB_Gadget_FrontColor, GetPBBNumParameter("PBBTitleColor"))  SetGadgetFont(TGadget, PBBTitleFont)EndMacro;Procedure THATProc()  Shared THATGadgets.THATGadgetsStruct  Protected Wwidth = 600, Wheight = 410  Protected WParam, ParentWindowID, OX, OY, NoLine, CaretHidden  Protected event, EventMenu, EventGadget  Protected GadgetList$  ;  ; Role: Opens and runs the modal 'Tips, Help And Tools' (THAT) window event loop.  ;  THATGadgets\Margins      = 8  THATGadgets\ButtonHeight = 24  THATGadgets\TitleHeight  = 18  ParentWindowID           = ComputeWinOrigins(@OX, @OY, Wwidth, Wheight, GPBBGadgets\PBBWindow)  WParam                   = #PB_Window_Invisible | #PB_Window_MinimizeGadget | #PB_Window_MaximizeGadget | #PB_Window_SystemMenu | #PB_Window_SizeGadget | #PB_Window_TitleBar  THATGadgets\WTHAT        = OpenWindow(#PB_Any, OX, OY, Wwidth, Wheight, GetTextFromCatalogPB("ToolsWindowTitle"), WParam, ParentWindowID)  If THATGadgets\WTHAT    ApplyDarkModeToWindow(THATGadgets\WTHAT)    WindowBounds(THATGadgets\WTHAT, 480, 400, #PB_Ignore, #PB_Ignore)    StickyWindow(THATGadgets\WTHAT, 1)    ;    THATGadgets\TipsList$  = "PBShortCutsTitle,SearchLimitsTitle,CreateToolsTitle"    THATGadgets\HelpList$  = "AboutPBBrowserTitle,MainFileTitle,ChangeMainFileTitle,SearchLaunchTitle,SearchModTitle,NavigationTitle"    THATGadgets\ToolsList$ = #FromCommandList$    ;    SetUpListGadget(THATGadgets\TipsListTitle, THATGadgets\TipsList, "TipsListTitle", THATGadgets\TipsList$)    SetUpListGadget(THATGadgets\HelpListTitle, THATGadgets\HelpList, "HelpListTitle", THATGadgets\HelpList$)    SetUpListGadget(THATGadgets\ToolsListTitle, THATGadgets\ToolsList, "ToolsListTitle", THATGadgets\ToolsList$)    ;    THATGadgets\EExplanations = EditorGadget(#PB_Any, 1, 1, 1, 1, #PB_Editor_WordWrap | #PB_Editor_ReadOnly)    SendMessage_(GadgetID(THATGadgets\EExplanations), #EM_SETTEXTMODE, #TM_RICHTEXT, 0)    ;    THATGadgets\TitleShortcut = TextGadget(#PB_Any, 1, 1, 60, THATGadgets\ButtonHeight, GetTextFromCatalogPB("Shortcut") + ":")    THATGadgets\Shortcut      = TextGadget(#PB_Any, 1, 1, 80, THATGadgets\ButtonHeight, "")    THATGadgets\BShortcut     = ButtonGadget(#PB_Any, 1, 1, 70, THATGadgets\ButtonHeight, GetTextFromCatalogPB("Change"))    THATGadgets\XDontShow     = CheckBoxGadget(#PB_Any, 1, 1, 260, THATGadgets\ButtonHeight, GetTextFromCatalogPB("DontShowInMenu"))    THATGadgets\BExecute      = ButtonGadget(#PB_Any, 1, 1, 70, THATGadgets\ButtonHeight, GetTextFromCatalogPB("Execute"))    THATGadgets\BQuit         = ButtonGadget(#PB_Any, 1, 1, 80, THATGadgets\ButtonHeight, GetTextFromCatalogPB("Quit"), #PB_Button_Default)    THATGadgets\BCopy         = ButtonGadget(#PB_Any, 1, 1, 80, THATGadgets\ButtonHeight, GetTextFromCatalogPB("Copy"))    HideTHATToolControls(#True)    ;    AddKeyboardShortcut(THATGadgets\WTHAT, #PB_Shortcut_Return, #PBBMenu_Return)    AddKeyboardShortcut(THATGadgets\WTHAT, #PB_Shortcut_Escape, #PBBMenu_Return)    AddKeyboardShortcut(THATGadgets\WTHAT, #PB_Shortcut_Control | #PB_Shortcut_S, #PBBMenu_SetShortcut)    AddKeyboardShortcut(THATGadgets\WTHAT, #PB_Shortcut_Up, #PBBMenu_Up)    AddKeyboardShortcut(THATGadgets\WTHAT, #PB_Shortcut_Down, #PBBMenu_Down)    ForEach CommandList()      If CommandList()\CommandShortCut        AddKeyboardShortcut(THATGadgets\WTHAT, CommandList()\CommandShortCut, CommandList()\CommandNo + #PBBMenu_CommandOffset)      EndIf    Next    ;    ; Explicitly assemble all gadget IDs for batch font and theme color application    GadgetList$ = Str(THATGadgets\TipsListTitle)  + "," + Str(THATGadgets\TipsList)      + "," +                  Str(THATGadgets\HelpListTitle)  + "," + Str(THATGadgets\HelpList)      + "," +                  Str(THATGadgets\ToolsListTitle) + "," + Str(THATGadgets\ToolsList)     + "," +                  Str(THATGadgets\EExplanations)  + "," + Str(THATGadgets\BExecute)      + "," +                  Str(THATGadgets\BShortcut)      + "," + Str(THATGadgets\TitleShortcut) + "," +                  Str(THATGadgets\Shortcut)       + "," + Str(THATGadgets\XDontShow)     + "," +                  Str(THATGadgets\BCopy)          + "," + Str(THATGadgets\BQuit)         + ","    ;    ApplyFontToGadgetList(GadgetList$)    SetGadgetsColorsFromTheme(THATGadgets\WTHAT, InterfaceColorPresets(), GadgetList$)    ;    FontAndColorForTitles(THATGadgets\TipsListTitle)    FontAndColorForTitles(THATGadgets\HelpListTitle)    FontAndColorForTitles(THATGadgets\ToolsListTitle)    SetGadgetColorEx(THATGadgets\EExplanations, #PB_Gadget_BackColor, GetValueFromPB_PrefFile("BackgroundColor"))    ;    ResizeGadgetsTHAT()    BindEvent(#PB_Event_SizeWindow, @ResizeGadgetsTHAT(), THATGadgets\WTHAT)    ClearKeyboardBuffer(THATGadgets\WTHAT)    FillTHATReGadget(THATGadgets\EExplanations, "AboutTHATTitle", 1, THATGadgets\Shortcut, THATGadgets\XDontShow)    ;    HideWindow(THATGadgets\WTHAT, #False)    ;    Repeat      event = WaitWindowEvent()      If EventWindow() <> THATGadgets\WTHAT        SetActiveWindow(THATGadgets\WTHAT)      Else        If GetActiveGadget() = THATGadgets\EExplanations          ; Hide the blinking RichEdit caret on focus/click events while preserving mouse text selection and Ctrl+C          If CaretHidden = #False Or event = #WM_LBUTTONDOWN Or event = #WM_LBUTTONUP Or event = #PB_Event_Gadget            HideCaret_(GadgetID(THATGadgets\EExplanations))            CaretHidden = #True          EndIf        Else          CaretHidden = #False        EndIf        ;        If event = #PB_Event_CloseWindow          Break        ElseIf event = #PB_Event_Menu          EventMenu = EventMenu()          If EventMenu = #PBBMenu_Return            Break          ElseIf EventMenu = #PBBMenu_Up Or EventMenu = #PBBMenu_Down            SetUpExplanationContent(EventMenu)          ElseIf EventMenu = #PBBMenu_SetShortcut            If GetGadgetState(THATGadgets\ToolsList) > -1              SetPBBShortcut()              SetUpExplanationContent(0)            EndIf          ElseIf EventMenu > #PBBMenu_CommandOffset            ExecCommandFromTHATWindow(EventMenu - #PBBMenu_CommandOffset)          EndIf        ElseIf event = #PB_Event_Gadget          EventGadget = EventGadget()          If EventGadget = THATGadgets\BQuit            Break          ElseIf EventGadget = THATGadgets\BCopy            TOM_Copy(THATGadgets\EExplanations, 0, -1)          ElseIf EventGadget = THATGadgets\TipsList Or EventGadget = THATGadgets\HelpList Or EventGadget = THATGadgets\ToolsList            SetUpExplanationContent(0)          ElseIf EventGadget = THATGadgets\XDontShow            NoLine = GetGadgetState(THATGadgets\ToolsList) + 1            If NoLine > 0              SetCommandDontShow(NoLine, GetGadgetState(THATGadgets\XDontShow))            EndIf          ElseIf EventGadget = THATGadgets\BShortcut            SetPBBShortcut()            SetUpExplanationContent(0)          ElseIf EventGadget = THATGadgets\BExecute            NoLine = GetGadgetState(THATGadgets\ToolsList) + 1            If NoLine > 0              ExecCommandFromTHATWindow(NoLine)            EndIf          EndIf        EndIf      EndIf    ForEver    ;    UnbindEvent(#PB_Event_SizeWindow, @ResizeGadgetsTHAT(), THATGadgets\WTHAT)    ClearKeyboardBuffer(THATGadgets\WTHAT)    CloseWindow(THATGadgets\WTHAT)    ProcedureReturn #True  EndIfEndProcedure; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 386; FirstLine = 365; Folding = -----; EnableXP; DPIAware; UseMainFile = ..\..\PBBrowser.pb