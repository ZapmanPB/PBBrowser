; *******************************************************************************;;                             Initializing PBBrowser;;      Command-line parsing, single-instance IPC, embedded resource extraction,;     source file caching, PureBasic compiler dictionaries, and user preferences.;;   NOTE: Additional modules are included at specific stages of initialization.;         Search for ";- INCLUDEFILE MENTIONS" to locate them.;; *******************************************************************************;; ===============================================================================; 1. CORE INCLUDES & DIAGNOSTIC PROFILING; ===============================================================================;- INCLUDEFILE MENTIONS;XIncludeFile "PBB_ChooseLanguage.pb" ; "Choose your language" dialog management.XIncludeFile "PBB_GetOpenProject.pb" ; Detection of projects currently open in the PureBasic IDE.XIncludeFile "PBB_FindInPBCode.pb"   ; Low-level helpers for searching inside PureBasic code.;CompilerIf #PB_Compiler_Debugger  #PBBReport = 0CompilerElse  #PBBReport = 0CompilerEndIf;CompilerIf #PBBReport  EnumerationBinary OPDMode    #OPDInitializationTiming = 1    #OPDElementCreation    #OPDOnePassTiming    #OPDFollowsTokens    #OPDFollowsSeparators    #OPDFollowsComments    #OPDIndicatesFile    #OPDIndicatesUsageDetection    #OPDFollowBuildLayout    #OPDFollowGetEncompassing    #OPDFillFoundInTiming    #OPDBuildOutExternalProcedureTiming    ;    #OPDFollowSearchAndIdentification  EndEnumeration  Global OPDMod = #OPDFollowsTokens | #OPDFollowsSeparators | #OPDIndicatesFile | #OPDElementCreation | #OPDIndicatesUsageDetection  OPDMod = #OPDBuildOutExternalProcedureTiming | #OPDFillFoundInTiming  OPDMod = #OPDOnePassTiming  ;  Global OPDTokenLine$  ;  Procedure OPDReport(ToReport$)    ;    ; Role: Outputs diagnostic trace messages to the debugger console.    ;    Debug ToReport$  EndProcedure  ;  XIncludeFile "Zapman libraries\UsePerformanceTimers.pbi"  TicksHQ()  InitAllTimers()  Global NoTimer = 1CompilerEndIf;; ===============================================================================; 2. IDE LAUNCH ARGUMENTS, INITIAL PREFERENCES & LANGUAGE CATALOG; ===============================================================================;- Retrieve IDE launch arguments;{CompilerIf #PBBReport  If OPDMod & #OPDInitializationTiming    StartTimer(NoTimer, "Read data from IDE")  EndIfCompilerEndIf;Procedure.s ReadDataFromIDE()  ;  ; Role: Parses command-line arguments passed by the PureBasic IDE Tools menu  ;       (or via drag-and-drop / shortcut switches) and initializes data paths.  ; Output: Returns the raw '%SELECTION' coordinate string if provided.  ;  Protected nl = 0, PBSelection$, SAppArgument$, Ext$, PBBPortableMode  ;  Repeat    SAppArgument$ = Trim(ProgramParameter())    ; Optional "\PORTABLE" or "/PORTABLE" switch anywhere on the command line:    If FindString(LCase(SAppArgument$), "\portable") Or FindString(LCase(SAppArgument$), "/portable")      PBBPortableMode = 1    Else      nl + 1      If SAppArgument$        If nl = 1          ; Argument 1 ("%HOME"): PureBasic installation directory, unless a source/project          ; file was dropped directly onto PBBrowser.exe or passed as a single CLI argument:          Ext$ = LCase(GetExtensionPart(SAppArgument$))          If Ext$ = "pb" Or Ext$ = "pbi" Or Ext$ = "pbp"            PBBFicPrincipalPB$ = SAppArgument$            Break          Else            PureBasicProgAddr$ = SAppArgument$ + "PureBasic.exe"          EndIf        ElseIf nl = 2 ; Argument 2 ("%WORD"): word under the cursor in the PureBasic IDE.          PBUnderCursor$ = SAppArgument$        ElseIf nl = 3 ; Argument 3 ("%SELECTION"): selection bounding coordinates (l1xc1xl2xc2).          PBSelection$ = SAppArgument$        ElseIf nl = 4 ; Argument 4 ("%CURSOR"): cursor coordinates (unused).        ElseIf nl = 5 ; Argument 5 ("%FILE"): saved file currently open in the PureBasic IDE.          PBBFicPrincipalPB$ = SAppArgument$        Else          ; Argument 6 ("%TEMPFILE"): unsaved temporary buffer fallback when "%FILE" is empty.          If PBBFicPrincipalPB$ = ""            PBBFicPrincipalPB$ = SAppArgument$          EndIf        EndIf      EndIf    EndIf  Until nl > 10  ;  PBBEditorSourceFile$ = PBBFicPrincipalPB$  ;  If #PBBPortableMode Or PBBPortableMode    MyAppDataFolder$ = GetCurrentApplicationPath() + #NomProg + "_Data" + "\"  Else    MyAppDataFolder$ = GetSystemFolder(#CSIDL_COMMON_APPDATA) + "\" + #NomProg + "\"  EndIf  ;  PBBrowserPrefile$ = MyAppDataFolder$ + #NomProg + ".prefs"  ;  ProcedureReturn PBSelection$EndProcedure;Define PBSelection$ = ReadDataFromIDE();};;- Read initial preferences and initialize the language catalog;{CompilerIf #PBBReport  If OPDMod & #OPDInitializationTiming    ReapTimer(NoTimer)    NoTimer + 1    StartTimer(NoTimer, "Read preferences and GetTextFromCatalog()")  EndIfCompilerEndIf;Global PBBLanguageFolder$If OpenPreferencesWithPatience(PBBrowserPrefile$)  PBBFirstLaunch     = 0  PBBLanguageFolder$ = ReadPreferenceString("PBBLanguageFolder", "")  ; Fall back to the last stored main file or PureBasic executable path when omitted from the command line:  If PBBFicPrincipalPB$ = ""    PBBFicPrincipalPB$ = ReadPreferenceString("FicPrincipalPB", "")  EndIf  If PureBasicProgAddr$ = ""    PureBasicProgAddr$ = ReadPreferenceString("PureBasicProgAdr", "")  EndIf  ClosePreferences()Else  ; First launch: create the data directory tree and an empty preferences file.  CreatePathFolders(PBBrowserPrefile$)  If CreatePreferences(PBBrowserPrefile$)    ClosePreferences()  EndIf  PBBFirstLaunch = 1EndIf;; Load color presets early so first-launch dialogs (ChooseLanguage, ChoosePBVersion) have an active themeGetColorThemesFromPreferences(PBBrowserPrefile$);Declare UpdateAppDataFolder(Force = 0);If PBBLanguageFolder$ = ""  ; Extract embedded catalogs before opening the language selector on first launch  UpdateAppDataFolder()  PBBLanguageFolder$ = ChooseLanguage(MyAppDataFolder$ + "Catalogs\")  If OpenPreferencesWithPatience(PBBrowserPrefile$)    WritePreferenceString("PBBLanguageFolder", PBBLanguageFolder$)    ClosePreferences()  Else    MessageRequester("Ooops!", "Unable to create 'preferences' file!")    End  EndIfEndIf;Procedure.s GetTextFromCatalogPB(SName$)  ;  ; Role: Retrieves a localized message from 'PBBrowser.catalog', automatically refreshing  ;       stale catalog files from embedded binaries on version upgrades or missing files.  ;  Static alreadyForced  ;  Protected NText$ = GetTextFromCatalog(SName$, "", Bool(alreadyForced = 0))  ;  If alreadyForced = 0 And NText$ = "MissingMention"    ; On the first missing key (e.g., after upgrading PBBrowser with newly added catalog entries),    ; overwrite AppData catalogs from the executable's embedded binaries and reload once:    UpdateAppDataFolder(1)    GetTextFromCatalog("", PBBLanguageFolder$ + "PBBrowser.catalog")    NText$        = GetTextFromCatalog(SName$)    alreadyForced = 1  ElseIf NText$ = "MissingFile"    PBBLanguageFolder$ = ChooseLanguage(MyAppDataFolder$ + "Catalogs\")    If OpenPreferencesWithPatience(PBBrowserPrefile$)      WritePreferenceString("PBBLanguageFolder", PBBLanguageFolder$)      ClosePreferences()    EndIf    GetTextFromCatalog("", PBBLanguageFolder$ + "PBBrowser.catalog")    NText$ = GetTextFromCatalog(SName$)  EndIf  ;  ProcedureReturn NText$EndProcedure;; Bind the active language catalog file path for subsequent GetTextFromCatalogPB() calls:GetTextFromCatalog("", PBBLanguageFolder$ + "PBBrowser.catalog");};; ===============================================================================; 3. SHARED UI & PREFERENCE HELPERS; ===============================================================================;- Shared UI and preference helpers;{CompilerIf #PBBReport  If OPDMod & #OPDInitializationTiming    ReapTimer(NoTimer)    NoTimer + 1    StartTimer(NoTimer, "Various procedures")  EndIfCompilerEndIf;Procedure PBB_SuspendRedraw(gadget.i, YesNo = #True)  ;  ; Role: Suspends or restores RichEdit gadget redrawing and toggles its read-only state  ;       so bulk text/RTF updates can proceed without visual flicker or unwanted scrolling.  ;  Protected Redraw = Bool(YesNo = 0)  ;  If IsGadget(gadget)    SendMessage_(GadgetID(gadget), #WM_SETREDRAW, Redraw, 0)    If Redraw = #False      ; Temporarily unlock read-only protection while content is being modified:      SendMessage_(GadgetID(gadget), #EM_SETREADONLY, #False, 0)    Else      RedrawWindow_(GadgetID(gadget), 0, 0, #RDW_ERASE | #RDW_INVALIDATE | #RDW_UPDATENOW)      SendMessage_(GadgetID(gadget), #EM_SETREADONLY, #True, 0)    EndIf  EndIfEndProcedure;Procedure DisablePBBWindow()  ;  ; Role: Disables the main PBBrowser window (with reference counting and a dimmed overlay)  ;       while a modal dialog or secondary window is active.  ;  If IsWindow(GPBBGadgets\PBBWindow)    If GPBBGadgets\Disabled = 0      If Not IsGadget(GPBBGadgets\IWhiteOver)        GPBBGadgets\IWhiteOver = WhiteBoxOverWindow(GPBBGadgets\PBBWindow)      EndIf      SetWindowPos_(GadgetID(GPBBGadgets\IWhiteOver), #HWND_TOP, 0, 0, 0, 0, #SWP_NOMOVE | #SWP_NOSIZE | #SWP_NOACTIVATE)      HideGadget(GPBBGadgets\IWhiteOver, #False)      DisableWindow(GPBBGadgets\PBBWindow, #True)    EndIf    GPBBGadgets\Disabled + 1  EndIfEndProcedure;Procedure EnablePBBWindow()  ;  ; Role: Decrements the disable counter and re-enables the main PBBrowser window  ;       once all nested modal dialogs have closed.  ;  If IsWindow(GPBBGadgets\PBBWindow)    GPBBGadgets\Disabled - 1    If GPBBGadgets\Disabled < 1      GPBBGadgets\Disabled = 0      DisableWindow(GPBBGadgets\PBBWindow, #False)      If IsGadget(GPBBGadgets\IWhiteOver)        HideGadget(GPBBGadgets\IWhiteOver, #True)      EndIf    EndIf    SetActiveWindow(GPBBGadgets\PBBWindow)  EndIfEndProcedure;Procedure AlertInPBBWindow(AlertText$, Title$ = "", WSticky = 1, WhiteBackGround = 0, Txtleft = 0, FixedWidth = 0, TabList$ = "", YesNoCancel = #AW_AlertOnly, ParentWindow = 0)  ;  ; Role: Displays a modal Alert() dialog over the disabled main PBBrowser window  ;       and restores the main window state upon dismissal.  ;  If ParentWindow = 0    ParentWindow = GPBBGadgets\PBBWindow  EndIf  DisablePBBWindow()  Protected Ret = Alert(AlertText$, Title$, WSticky, WhiteBackGround, Txtleft, FixedWidth, TabList$, YesNoCancel, ParentWindow)  EnablePBBWindow()  ProcedureReturn RetEndProcedure;Procedure.s ReadStrPrefValue(ValueName$, Alternative$ = "")  ;  ; Role: Reads a string setting from the preferences file, initializing it with  ;       'Alternative$' if missing or empty.  ;  Protected Value$ = ""  ;  If OpenPreferencesWithPatience(PBBrowserPrefile$)    Value$ = ReadPreferenceString(ValueName$, "")    If Value$ = "" And Alternative$      Value$ = Alternative$      WritePreferenceString(ValueName$, Value$)    EndIf    ClosePreferences()  Else    Value$ = Alternative$  EndIf  ;  ProcedureReturn Value$EndProcedure;};; ===============================================================================; 4. SOURCE FILE CACHE & COMPILATION SEQUENCE STRUCTURES; ===============================================================================;- Source file cache and compilation sequence;{Structure FileListingStruct  ; Core identity and in-memory content cache fields:  FileName$                                   ; Full physical path acting as the unique file identifier across the project.  FileContentInList.String                    ; Normalized source code cached in RAM (tabs expanded, LF stripped).  FileLCaseContentInList.String               ; Lowercase counterpart used for fast case-insensitive scans via FindInPBPointedCode().  FileLastMod.i                               ; Last-modified disk timestamp used by UpdateOneFileInMemory() to detect external edits.  List DeadZones.DeadZoneStruct()             ; Sorted non-overlapping [StartingPos, EndingPos] spans of inactive CompilerIf/CompilerSelect zones.  ExcludedByCompilerIf.b                      ; #True when the file is only referenced inside inactive CompilerIf/CompilerSelect branches.  OnePassStarted.b                            ; #True once OnePass has purged Stage-1 provisional DeadZones() and begun indexing this file.  OnePassResumePos.i                          ; 1-based resume offset across PBB_CompilationSequence() splits when fast-forwarding past IncludeFile.  OnePassCDepth.i                             ; Per-file conditional compilation nesting depth preserved across IncludeFile boundaries.  Array OnePassCStack.CompilerStackLevel(#PBB_MaxCompilerDepth) ; Per-file CompilerIf/CompilerSelect tri-state stack.  ;  ; Inclusion tree and virtual whole-project coordinate fields:  ParentFileName.s                            ; Full path of the parent file whose IncludeFile directive brought this file into the tree.  PosInParent.i                               ; 1-based character offset of the IncludeFile directive inside the parent file.  IsActiveInTree.i                            ; #True while the file belongs to the current project or inclusion tree.  TotalVirtualSize.i                          ; Combined character size of this file plus all nested files it includes.  PosInVirtualFile.i                          ; 1-based starting offset within the flattened virtual project buffer.EndStructure;Global NewList PBB_FileListing.FileListingStruct()Global NewList PBB_BinaryFileListing.FileListingStruct();Structure ElementContentStruct  EC_FSource$  EC_LCase.i  EC_StartingPos.i  EC_Content.StringEndStructure;NewList ElementContentListing.ElementContentStruct();Procedure EraseObsoleteElementsContents(FileName$)  ;  ; Role: Purges all cached element code excerpts associated with 'FileName$'  ;       whenever the file is reloaded into memory.  ;  Shared ElementContentListing()  ;  ForEach ElementContentListing()    If ElementContentListing()\EC_FSource$ = FileName$      DeleteElement(ElementContentListing())    EndIf  NextEndProcedure;;Procedure IsFileInMemory(FileName$)  ;  ; Role: Checks whether 'FileName$' is already cached in PBB_FileListing()  ;       and positions PBB_FileListing() on the matching entry.  ; Note: Disk existence and modification checks are handled separately by  ;       UpdateAllFilesInMemory(), UpdateOneFileInMemory(), and ReadCodeFromFile().  ;  If FileName$ And ListSize(PBB_FileListing())    If ListIndex(PBB_FileListing()) <> -1 And PBB_FileListing()\FileName$ = FileName$      ProcedureReturn #True    EndIf    ForEach PBB_FileListing()      If PBB_FileListing()\FileName$ = FileName$        ProcedureReturn #True      EndIf    Next  EndIf  ProcedureReturn #FalseEndProcedure;Global PBBTabSpaces$ = "  " ; Tab replacement spaces synchronized with 'TabLength' from PureBasic.prefs.;Procedure ReadCodeFromFile(FileName$, *Receptacle.String)  ;  ; Role: Reads a source file from disk into '*Receptacle', expanding tabs to two spaces  ;       and normalizing all line breaks (#CRLF$ and standalone #LF$) to #CR$.  ;  Protected Result = #True, Content$  ;  If FileSize(FileName$) = -1    AlertInPBBWindow(GetTextFromCatalogPB("ErrorWithFile") + " " + FileName$)    Result = #False  Else    Content$      = ReplaceString(ReplaceString(FileToText(FileName$, #PB_UTF8, 1), #TAB$, PBBTabSpaces$), #CR$ + #LF$, #CR$)    *Receptacle\s = ReplaceString(Content$, #LF$, #CR$)    If Len(*Receptacle\s) = 0 And FileSize(FileName$) > 2      AlertInPBBWindow(GetTextFromCatalogPB("ErrorWithFile") + " " + FileName$)      Result = #False    EndIf  EndIf  ProcedureReturn ResultEndProcedure;Procedure GetPointedCodeFromFile(FileName$, ReturnLCase = #False)  ;  ; Role: Returns a persistent pointer to the normal or lowercase String buffer of 'FileName$'  ;       stored in PBB_FileListing(), loading and caching the file from disk on first request.  ; Output: Pointer to PBB_FileListing()\FileContentInList (or \FileLCaseContentInList),  ;         avoiding string duplication in callers; returns 0 on failure.  ;  If FileName$ = ""    ProcedureReturn 0  EndIf  ;  If IsFileInMemory(FileName$) = #False    AddElement(PBB_FileListing())    If ReadCodeFromFile(FileName$, PBB_FileListing()\FileContentInList) = #False      DeleteElement(PBB_FileListing())      ProcedureReturn 0    EndIf    PBB_FileListing()\PosInParent                          = -1    PBB_FileListing()\FileName$                            = FileName$    PBB_FileListing()\FileLastMod                          = GetFileDate(FileName$, #PB_Date_Modified)    PBB_FileListing()\FileLCaseContentInList\s             = LCase(PBB_FileListing()\FileContentInList\s)    EraseObsoleteElementsContents(FileName$)  EndIf  ;  If ReturnLCase    ProcedureReturn @PBB_FileListing()\FileLCaseContentInList  EndIf  ProcedureReturn @PBB_FileListing()\FileContentInListEndProcedure;Procedure GetPointedElementContentFromFile(FSource$, ElementStartingPos, ElementEndingPos, ReturnLCase = #False)  ;  ; Role: Extracts and caches the code slice [ElementStartingPos .. ElementEndingPos]  ;       from 'FSource$' inside ElementContentListing(), returning a persistent String pointer.  ;  Shared ElementContentListing()  Protected *SPointer.String, LS, Found = 0  ;  ForEach ElementContentListing()    If ElementContentListing()\EC_FSource$ = FSource$ And ElementContentListing()\EC_StartingPos = ElementStartingPos And ElementContentListing()\EC_LCase = ReturnLCase      Found = 1      Break    EndIf  Next  ;  If Found = 0    AddElement(ElementContentListing())    ElementContentListing()\EC_FSource$     = FSource$    ElementContentListing()\EC_LCase        = ReturnLCase    ElementContentListing()\EC_StartingPos  = ElementStartingPos    *SPointer = GetPointedCodeFromFile(FSource$, ReturnLCase)    If *SPointer      LS = Len(*SPointer\s)      If ElementStartingPos >= 1 And ElementEndingPos >= ElementStartingPos And ElementEndingPos <= LS + 1        ElementContentListing()\EC_Content\s = FastMid(*SPointer\s, ElementStartingPos, ElementEndingPos - ElementStartingPos)      Else        ElementContentListing()\EC_Content\s = "Error"      EndIf    EndIf  EndIf  ProcedureReturn ElementContentListing()\EC_ContentEndProcedure;Structure CompileSegmentStruct  ; --- ARCHITECTURE NOTE ---  ; Represents a contiguous slice of code ordered strictly as the PureBasic compiler reads it.  ; Because an IncludeFile / XIncludeFile directive splits a physical file into "before include",  ; "included file(s)", and "after include", scanning physical files end-to-end would corrupt  ; variable scope and macro visibility rules. Iterating linearly over PBB_CompilationSequence()  ; processes every segment in exact compilation order without recursive tree traversal.  FileName$          ; Full path of the physical file hosting this segment.  LocalStartPos.i    ; 1-based start offset of this segment inside FileName$.  LocalEndPos.i      ; 1-based end offset of this segment inside FileName$.  VirtualStartPos.i  ; 1-based absolute offset of this segment within the flattened project.  SegmentIsExplored.iEndStructure;Global NewList PBB_CompilationSequence.CompileSegmentStruct();Procedure.s GetFullPathFromFileName(FNameWithoutPath$, List TargetList.FileListingStruct())  ;  ; Role: Resolves a short filename (without path) to its full path by scanning 'TargetList()'  ;       while preserving the caller's current list position.  ;  Protected FullPath$ = ""  ;  PushListPosition(TargetList())  ForEach TargetList()    If GetFilePart(TargetList()\FileName$) = FNameWithoutPath$      FullPath$ = TargetList()\FileName$      Break    EndIf  Next  PopListPosition(TargetList())  ;  ProcedureReturn FullPath$EndProcedure;};; ===============================================================================; 5. PUREBASIC EXECUTABLE RESOLUTION; ===============================================================================;- Locate PureBasic.exe and set PureBasicProgAddr$;{CompilerIf #PBBReport  If OPDMod & #OPDInitializationTiming    ReapTimer(NoTimer)    NoTimer + 1    StartTimer(NoTimer, "SetPureBasicProgAddr()")  EndIfCompilerEndIf;Structure PBFilesAndDates  ExeFName$  ExeDate.qEndStructure;Procedure.s FindInDirectory(directory.s, FindWhat$, Filters$ = "", Excluded$ = "")  ;  ; Role: Recursively searches 'directory' for files matching 'FindWhat$' (case-insensitive),  ;       skipping subdirectories matching 'Excluded$' and restricting traversal to 'Filters$' if set.  ; Output: #CR$-delimited list of matching full file paths.  ;  Protected PBFileListing$, file.s, pExcluded$, pFilter$  Protected directoryid, cont, DirType, exclude, include, nl  ;  If directory    If Right(directory, 1) <> "\"      directory + "\"    EndIf    FindWhat$   = LCase(FindWhat$)    directoryid = ExamineDirectory(#PB_Any, directory, "")    If directoryid      cont = 1      Repeat        If NextDirectoryEntry(directoryid)          DirType = DirectoryEntryType(directoryid)          file    = DirectoryEntryName(directoryid)          Select DirType            Case #PB_DirectoryEntry_File              If LCase(file) = FindWhat$                PBFileListing$ + directory + file + #CR$              EndIf            Case #PB_DirectoryEntry_Directory              If file And file <> "." And file <> ".."                exclude = 0                If Excluded$                  nl = 1                  Repeat                    pExcluded$ = StringField(Excluded$, nl, ",")                    If pExcluded$ And FindString(LCase(directory + file), LCase(pExcluded$))                      exclude = 1                      Break                    EndIf                    nl + 1                  Until pExcluded$ = ""                EndIf                If exclude = 0                  If Filters$ = ""                    include = 1                  Else                    include = 0                    nl      = 1                    Repeat                      pFilter$ = StringField(Filters$, nl, ",")                      If pFilter$ And FindString(LCase(directory + file), LCase(pFilter$))                        include = 1                        Break                      EndIf                      nl + 1                    Until pFilter$ = ""                  EndIf                  If include                    PBFileListing$ + FindInDirectory(directory + file + "\", FindWhat$, Filters$, Excluded$)                  EndIf                EndIf              EndIf          EndSelect        Else          cont = 0        EndIf      Until cont = 0 ; End directory entries loop      FinishDirectory(directoryid)    EndIf  EndIf  ProcedureReturn PBFileListing$EndProcedure;Procedure.s ChoosePBVersion(noms$)  ;  ; Role: Displays a modal list dialog prompting the user to select which PureBasic.exe  ;       installation to bind when multiple versions are installed.  ;  Protected.i SWindow, OX, OY, BList, nbNoms, button, event, i, TXG  Protected.s GadgetList$, choice$  Protected WWidth = 500, WHeight = 280  ;  Protected ParentWindowID = ComputeWinOrigins(@OX, @OY, WWidth, WHeight, GPBBGadgets\PBBWindow)  SWindow = OpenWindow(#PB_Any, OX, OY, WWidth, WHeight, GetTextFromCatalogPB("UpdatePBExeTitle"), #PB_Window_SystemMenu, ParentWindowID)  If SWindow    ApplyDarkModeToWindow(SWindow)    StickyWindow(SWindow, 1)    TXG = TextGadget(#PB_Any, 10, 10, WindowWidth(SWindow) - 20, 80, GetTextFromCatalogPB("ManyVersionsOfPB"), #PB_Text_Center)    GadgetList$ + Str(TXG) + ","    BList = ListViewGadget(#PB_Any, 10, 90, WindowWidth(SWindow) - 20, WindowHeight(SWindow) - 140)    GadgetList$ + Str(BList) + ","    button = ButtonGadget(#PB_Any, WindowWidth(SWindow) / 2 - 50, WindowHeight(SWindow) - 35, 100, 25, GetTextFromCatalogPB("Choose"))    GadgetList$ + Str(button) + ","    ;    nbNoms = CountString(noms$, #CR$) + 1    For i = 1 To nbNoms      AddGadgetItem(BList, -1, StringField(noms$, i, #CR$))    Next    ; Preselect the most recent installation (placed last in the sorted list):    SetGadgetState(BList, nbNoms - 1)    AddKeyboardShortcut(SWindow, #PB_Shortcut_Return, 1)    SetActiveGadget(BList)    SetFontAndGadgetsColors(SWindow, InterfaceColorPresets(), GadgetList$)    ;    Repeat      event = WaitWindowEvent()      If EventWindow() <> SWindow        SetActiveWindow(SWindow)      ElseIf (event = #PB_Event_Gadget And EventGadget() = button) Or event = #PB_Event_Menu Or event = #PB_Event_CloseWindow        choice$ = GetGadgetItemText(BList, GetGadgetState(BList))        Break      EndIf    ForEver    ;    CloseWindow(SWindow)  EndIf  ;  ProcedureReturn choice$EndProcedure;Procedure UpDatePureBasicExeAdr(Choose = 0)  ;  ; Role: Scans both 64-bit and 32-bit Program Files directories for 'PureBasic.exe',  ;       sorts multiple installations by modification date, and updates PureBasicProgAddr$.  ;  Protected ProgFolder$, Excluded$, Filters$, PBFileListing$, ListSize, i, p  Protected NewList PBFiles.PBFilesAndDates()  ;  ProgFolder$ = GetSystemFolder(#CSIDL_PROGRAM_FILES)  Excluded$   = "Adobe,OpenOffice,Explorer,Windows,Microsoft,Intel,Google,Chrome,DropBox,System,Languages,Catalogs,\SDK,\res\,Example,resources,Common"  Filters$    = "PB,Pure,Basic,Fantaisie,Dev,Soft,pers,home,vers"  PBFileListing$ = FindInDirectory(ProgFolder$ + "\", "PureBasic.exe", Filters$, Excluded$)  ;  ; #CSIDL_PROGRAM_FILES may resolve to either "Program Files" or "Program Files (x86)"; scan the counterpart as well:  If FindString(ProgFolder$, "(")    ProgFolder$ = Trim(Left(ProgFolder$, FindString(ProgFolder$, "(") - 1))  Else    ProgFolder$ + " (x86)"  EndIf  PBFileListing$ + FindInDirectory(ProgFolder$ + "\", "PureBasic.exe", Filters$, Excluded$)  ;  If CountString(PBFileListing$, #CR$) > 1    ListSize = CountString(PBFileListing$, #CR$)    For i = 1 To ListSize      AddElement(PBFiles())      PBFiles()\ExeFName$ = StringField(PBFileListing$, i, #CR$)      ; Subtract path length from timestamp so shorter canonical install paths sort last on ties:      PBFiles()\ExeDate   = GetFileDate(PBFiles()\ExeFName$, #PB_Date_Modified) - Len(PBFiles()\ExeFName$)    Next    ;    SortStructuredList(PBFiles(), #PB_Sort_Ascending, OffsetOf(PBFilesAndDates\ExeDate), TypeOf(PBFilesAndDates\ExeDate))    PBFileListing$ = ""    ForEach PBFiles()      PBFileListing$ + PBFiles()\ExeFName$ + #CR$    Next    PBFileListing$ = Left(PBFileListing$, Len(PBFileListing$) - 1)    ;    If Choose      PureBasicProgAddr$ = ChoosePBVersion(PBFileListing$)    Else      p                  = ReverseFindString(PBFileListing$, #CR$)      PureBasicProgAddr$ = Mid(PBFileListing$, p + 1)    EndIf  Else    PureBasicProgAddr$ = Trim(PBFileListing$, #CR$)  EndIf  ;  If PureBasicProgAddr$ And OpenPreferencesWithPatience(PBBrowserPrefile$)    WritePreferenceString("PureBasicProgAdr", PureBasicProgAddr$)    ClosePreferences()  EndIfEndProcedure;Procedure ChoosePureBasicExeAdr()  ;  ; Role: Opens the interactive PureBasic.exe version selector.  ;  UpDatePureBasicExeAdr(1)EndProcedure;Procedure SetPureBasicProgAddr()  ;  ; Role: Ensures PureBasicProgAddr$ points to a valid PureBasic.exe binary using progressive  ;       fallbacks (Program Files scan, #PB_Compiler_Home, running process, or file requester)  ;       and persists the resolved path in preferences.  ;  Protected PrefPureBasicProgAddr$  ;  If FileSize(PureBasicProgAddr$) < 2    UpDatePureBasicExeAdr()  EndIf  If FileSize(PureBasicProgAddr$) < 2    PureBasicProgAddr$ = #PB_Compiler_Home + "PureBasic.exe"  EndIf  If FileSize(PureBasicProgAddr$) < 2    PureBasicProgAddr$ = GetCurrentRunningPBExePath()  EndIf  If FileSize(PureBasicProgAddr$) < 2    Alert(GetTextFromCatalogPB("UnableToFindPB"))    PureBasicProgAddr$ = OpenFileRequester(GetTextFromCatalogPB("ShowPBPath"), GetSystemFolder(#CSIDL_PROGRAM_FILES) + "\PureBasic.exe", "PureBasic.exe", 0)  EndIf  ;  If FileSize(PureBasicProgAddr$) > 2 And OpenPreferencesWithPatience(PBBrowserPrefile$)    PrefPureBasicProgAddr$ = ReadPreferenceString("PureBasicProgAdr", "")    If PrefPureBasicProgAddr$ = "" Or FileSize(PrefPureBasicProgAddr$) < 2      WritePreferenceString("PureBasicProgAdr", ReplaceString(PureBasicProgAddr$, #DOUBLEQUOTE$, ""))    EndIf    ClosePreferences()  EndIfEndProcedure;SetPureBasicProgAddr();};; ===============================================================================; 6. IDE CURSOR/SELECTION PARSING & SINGLE-INSTANCE IPC; ===============================================================================;- Parse IDE selection and cursor context;{CompilerIf #PBBReport  If OPDMod & #OPDInitializationTiming    ReapTimer(NoTimer)    NoTimer + 1    StartTimer(NoTimer, "ExamineReceivedData() / SendDataToOtherInstance()")  EndIfCompilerEndIf;Procedure RecognizePointer(*StringAddress, VarPos)  ;  ; Role: Determines whether an expression starting at or right after '*' is a pointer  ;       variable rather than a multiplication operand.  ; Prerequisites: 'VarPos' (1-based) must point ON or IMMEDIATELY AFTER the '*' character.  ;  Protected pTest, PrecedingWord$  Protected *Char.Character, *CharTest.Character, *WordEnd  ;  If *StringAddress = #Null Or VarPos < 1    ProcedureReturn #False  EndIf  ;  *Char = *StringAddress + ((VarPos - 1) * SizeOf(Character))  If *Char\c <> '*'    *Char - SizeOf(Character)    If *Char < *StringAddress Or *Char\c <> '*'      ProcedureReturn #False    EndIf  EndIf  ;  *Char + SizeOf(Character)  If IsPBSeparator(*Char\c)    ; A separator right after '*' rules out a pointer identifier:    ProcedureReturn #False  EndIf  *Char - SizeOf(Character)  ;  ; Rewind to the first non-whitespace character preceding '*':  Repeat    *Char - SizeOf(Character)    If *Char >= *StringAddress      If *Char\c <> #Space And *Char\c <> #TAB And *Char\c <> #NonBreakableSpace        Break      EndIf    Else      ProcedureReturn #True    EndIf  Until *Char\c = 0  ;  ; At the start of a line or colon-separated statement segment, '*' always introduces a pointer:  If *Char\c = 0 Or *Char\c = ':' Or *Char\c = #CR Or *Char\c = #LF    ProcedureReturn #True  EndIf  ;  Select *Char\c    Case ')', ']', '"', '.', Asc("'"), '0' To '9'      ; Expression closers, literals, decimals, or digits preceding '*' indicate multiplication:      ProcedureReturn #False    Case '=', '+', '-', '/', '*', '<', '>', '\', '(', '[', ',', ':', '|', '&', '~', '%', '!', '@', '?', '^'      ; Operators, delimiters, and opening brackets preceding '*' indicate a pointer:      ProcedureReturn #True  EndSelect  ;  ; Extract the preceding keyword (skipping optional '.Type' suffixes such as "Protected.i *Ptr"):  *WordEnd = *Char  Repeat    *Char - SizeOf(Character)    If *Char < *StringAddress      Break    EndIf    If IsPBSeparator(*Char\c)      If *Char\c = #Space Or *Char\c = #NonBreakableSpace        *CharTest = *Char        While *CharTest > *StringAddress And (*CharTest\c = #Space Or *CharTest\c = #NonBreakableSpace)          *CharTest - SizeOf(Character)        Wend        If *CharTest\c = '.'          *Char = *CharTest        EndIf      EndIf      If *Char\c = '.'        *CharTest = *Char - SizeOf(Character)        While *CharTest > *StringAddress And (*CharTest\c = #Space Or *CharTest\c = #NonBreakableSpace)          *CharTest - SizeOf(Character)        Wend        *WordEnd = *CharTest        *Char    = *CharTest + SizeOf(Character)      Else        Break      EndIf    EndIf  Until *Char\c = 0  ;  pTest = (*WordEnd - *Char) / SizeOf(Character)  If pTest > 0    PrecedingWord$ = LCase(PeekS(*Char + SizeOf(Character), pTest))  EndIf  ;  If PrecedingWord$ And FindString(LCase(",Swap," + #PBVariableDeclarators$ + #PBOperatorAsWord$), "," + PrecedingWord$ + ",")    ProcedureReturn #True  EndIf  ;  ProcedureReturn #FalseEndProcedure;Procedure ExamineReceivedData(PBSelection$)  ;  ; Role: Resolves the exact expression and 1-based character offset (PBUnderCursor$, PBUnderCursorPos)  ;       from the IDE '%SELECTION' bounding coordinates ("l1xc1xl2xc2"), supporting single-line  ;       and multi-line selections, accented identifiers, and leading '#' or '*' prefixes.  ;  Protected c1, c2, l1, l2, CurLineS, CurLineE, EmptySelection, PrevChar, IsPointer  Protected *FileContent.String  Protected *Ptr.Character, *PtrS.Character, *StartOfl1.Character, *StartOfl2.Character, *EndOfl2.Character  ;  If PBSelection$ = "" : ProcedureReturn : EndIf  ;  ; Convert 1-based IDE coordinates (l1 x c1 x l2 x c2) to 0-based offsets:  l1 = Val(StringField(PBSelection$, 1, "x")) - 1  c1 = Val(StringField(PBSelection$, 2, "x")) - 1  l2 = Val(StringField(PBSelection$, 3, "x")) - 1  c2 = Val(StringField(PBSelection$, 4, "x")) - 1  ;  ; Normalize selection direction while keeping each column paired with its own line:  If l1 > l2    Swap l1, l2    Swap c1, c2  ElseIf l1 = l2 And c1 > c2    Swap c1, c2  EndIf  ;  *FileContent = GetPointedCodeFromFile(PBBFicPrincipalPB$)  If *FileContent = #Null Or *FileContent\s = ""    ProcedureReturn  EndIf  ;  EmptySelection = Bool(c1 = c2 And l1 = l2)  ;  ; Locate the start of line l1:  *Ptr = @*FileContent\s  If l1    While *Ptr\c      If *Ptr\c = #CR        CurLineS + 1        If CurLineS = l1          Break        EndIf      EndIf      *Ptr + SizeOf(Character)    Wend    *Ptr + SizeOf(Character)  EndIf  ;  CurLineE   = CurLineS  *StartOfl2 = *Ptr  *PtrS      = *Ptr  ;  ; Locate the start and end of line l2 (identical to l1 on single-line selections):  While *Ptr\c    If *Ptr\c = #CR      CurLineE + 1      If CurLineE > l2        Break      Else        *StartOfl2 = *Ptr + SizeOf(Character)      EndIf    EndIf    *Ptr + SizeOf(Character)  Wend  ;  *StartOfl1 = *PtrS  *EndOfl2   = *Ptr  ;  If PBUnderCursor$ And EmptySelection    c1 - Len(PBUnderCursor$)    c2 + Len(PBUnderCursor$)  EndIf  ;  *PtrS + c1 * SizeOf(Character)  If *PtrS < *StartOfl1 : *PtrS = *StartOfl1 : EndIf  If *PtrS > *EndOfl2   : *PtrS = *EndOfl2   : EndIf  *Ptr = *StartOfl2 + c2 * SizeOf(Character)  If *Ptr > *EndOfl2    : *Ptr = *EndOfl2    : EndIf  ;  If Not EmptySelection    PBUnderCursor$ = RTrim(PeekS(*PtrS, (*Ptr - *PtrS) / SizeOf(Character)))    While PBUnderCursor$ And Left(PBUnderCursor$, 1) = " "      PBUnderCursor$ = FastMid(PBUnderCursor$, 2)      *PtrS + SizeOf(Character)    Wend    PBUnderCursorPos = ((*PtrS - @*FileContent\s) / SizeOf(Character)) + 1  Else    If PBUnderCursor$      ; Locate the ASCII word fragment sent by the IDE (extending to EOL if leading tabs shifted columns):      c2 = FindString(PeekS(*PtrS, (*Ptr - *PtrS) / SizeOf(Character)), PBUnderCursor$)      If c2 = 0        c2 = FindString(PeekS(*PtrS, (*EndOfl2 - *PtrS) / SizeOf(Character)), PBUnderCursor$)      EndIf      If c2 = 0 : ProcedureReturn : EndIf      *PtrS + (c2 - 1) * SizeOf(Character)    ElseIf *PtrS >= *EndOfl2 Or IsPBSeparator(*PtrS\c)      ; Empty %WORD: step back if the cursor sits right after an accented identifier character, or abort on whitespace:      If *PtrS > *StartOfl1 And IsPBSeparator(PeekC(*PtrS - SizeOf(Character))) = #False        *PtrS - SizeOf(Character)      Else        ProcedureReturn      EndIf    EndIf    ; Expand across contiguous non-separator characters to capture full accented identifiers:    While *PtrS > *StartOfl1 And IsPBSeparator(PeekC(*PtrS - SizeOf(Character))) = #False      *PtrS - SizeOf(Character)    Wend    *Ptr = *PtrS    While *Ptr < *EndOfl2 And IsPBSeparator(*Ptr\c) = #False      *Ptr + SizeOf(Character)    Wend    PBUnderCursor$   = PeekS(*PtrS, (*Ptr - *PtrS) / SizeOf(Character))    PBUnderCursorPos = ((*PtrS - @*FileContent\s) / SizeOf(Character)) + 1  EndIf  ;  ; Re-attach a leading constant '#' or pointer '*' prefix if immediately adjacent:  If *PtrS\c <> '#' And *PtrS\c <> '*' And *PtrS > @*FileContent\s    *PtrS - SizeOf(Character)  EndIf  ;  If *PtrS\c = '#' And Left(PBUnderCursor$, 1) <> "#"    PBUnderCursor$ = "#" + PBUnderCursor$    PBUnderCursorPos - 1  ElseIf *PtrS\c = '*' And Left(PBUnderCursor$, 1) <> "*"    c1 = ((*PtrS - @*FileContent\s) / SizeOf(Character)) + 1    If CheckCodeLineContext(*FileContent, c1, #True) = #CodeCtx_Code      IsPointer = RecognizePointer(@*FileContent\s, c1)    ElseIf *PtrS <= *StartOfl1      IsPointer = #True    Else      PrevChar  = PeekC(*PtrS - SizeOf(Character))      IsPointer = Bool(IsPBSeparator(PrevChar) And PrevChar <> ')' And PrevChar <> ']' And PrevChar <> '.')    EndIf    If IsPointer      PBUnderCursor$ = "*" + PBUnderCursor$      PBUnderCursorPos - 1    EndIf  EndIf  ;  PBUnderCursor$ = ReplaceString(PBUnderCursor$, #CR$, " ")EndProcedure;ExamineReceivedData(PBSelection$);};;- Forward data to an existing instance or start the IPC pipe listener;{Procedure SendDataToOtherInstance()  ;  ; Role: Enforces single-instance execution via a named Windows pipe. If another PBBrowser  ;       instance is already running, forwards the resolved IDE parameters to it and exits;  ;       otherwise starts listening for incoming pipe messages.  ;  If CheckForOtherInstance(PureBasicProgAddr$ + #CR$ + PBUnderCursor$ + #CR$ + PBBFicPrincipalPB$ + #CR$ + Str(PBUnderCursorPos) + #CR$, #NomProg)    If #PB_Compiler_Debugger      PlaySound_("SystemExclamation", 0, #SND_ALIAS | #SND_ASYNC)      Debug "PBBrowser is already running as a standalone instance."    EndIf    End  Else    ListenForPipeMessages()  EndIfEndProcedure;SendDataToOtherInstance();; Persist the active main file path once confirmed as the primary running instance:If OpenPreferencesWithPatience(PBBrowserPrefile$)  WritePreferenceString("FicPrincipalPB", PBBFicPrincipalPB$)  ClosePreferences()EndIf;};; ===============================================================================; 7. APPDATA RESOURCE EXTRACTION & COMPILER VERSION CHECK; ===============================================================================;- UpdateAppDataFolder and compiler version synchronization;{CompilerIf #PBBReport  If OPDMod & #OPDInitializationTiming    ReapTimer(NoTimer)    NoTimer + 1    StartTimer(NoTimer, "UpdateAppDataFolder() & PB Version")  EndIfCompilerEndIf;Procedure ExtractData(dataStart, dataEnd, outputPath$, Force = #True)  ;  ; Role: Writes an embedded DataSection binary block [dataStart .. dataEnd] to 'outputPath$'  ;       when 'Force' is non-zero, when running under the IDE debugger, or when the file is missing.  ;  outputPath$ = ReplaceString(outputPath$, "/", "\")  If Force Or #PB_Compiler_Debugger Or FileSize(outputPath$) < 2    CreatePathFolders(outputPath$)    If CreateFile(0, outputPath$)      WriteData(0, dataStart, dataEnd - dataStart)      CloseFile(0)    Else      Protected Message$ = "Unable to create AppData file!" + #CR$ +                           "(Procedure " + #DOUBLEQUOTE$ + "ExtractData" + #DOUBLEQUOTE$ + " in PBBrowserInitialize.pb)" + #CR$ +                           "Filename: " + #DOUBLEQUOTE$ + outputPath$ + #DOUBLEQUOTE$ + "."      MessageRequester("Ooops!", Message$)    EndIf  EndIfEndProcedure;Procedure UpdateAppDataFolder(Force = 0)  ;  ; Role: Populates 'MyAppDataFolder$' from the executable's embedded DataSections.  ;       - Under the IDE debugger (#PB_Compiler_Debugger), resources are always refreshed from source assets.  ;       - In standalone .exe mode, existing files are preserved (protecting user catalog edits) unless  ;         missing or explicitly refreshed via 'Force = 1' when a new catalog key is missing.  ;  ExtractData(?BLogo,           ?BLogoEnd,           MyAppDataFolder$ + "Images\PBBrowserLogo.png",              #False)  ExtractData(?BNext,           ?BNextEnd,           MyAppDataFolder$ + "Next.jpg",                              #False)  ExtractData(?BPrevious,       ?BPreviousEnd,       MyAppDataFolder$ + "Previous.jpg",                          #False)  ExtractData(?BNoNext,         ?BNoNextEnd,         MyAppDataFolder$ + "NoNext.jpg",                            #False)  ExtractData(?BNoPrevious,     ?BNoPreviousEnd,     MyAppDataFolder$ + "NoPrevious.jpg",                        #False)  ExtractData(?BDarkNext,       ?BDarkNextEnd,       MyAppDataFolder$ + "DarkNext.jpg",                          #False)  ExtractData(?BDarkPrevious,   ?BDarkPreviousEnd,   MyAppDataFolder$ + "DarkPrevious.jpg",                      #False)  ExtractData(?BDarkNoNext,     ?BDarkNoNextEnd,     MyAppDataFolder$ + "DarkNoNext.jpg",                        #False)  ExtractData(?BDarkNoPrevious, ?BDarkNoPreviousEnd, MyAppDataFolder$ + "DarkNoPrevious.jpg",                    #False)  ;  ExtractData(?BCatalogFR,      ?BCatalogFREnd,      MyAppDataFolder$ + "Catalogs\Francais\PBBrowser.catalog",   Force)  ExtractData(?BIntroFR,        ?BIntroFREnd,        MyAppDataFolder$ + "Catalogs\Francais\IntroPBBrowser.rtf",  Force)  ExtractData(?BCatalogEN,      ?BCatalogENEnd,      MyAppDataFolder$ + "Catalogs\English\PBBrowser.catalog",    Force)  ExtractData(?BIntroEN,        ?BIntroENEnd,        MyAppDataFolder$ + "Catalogs\English\IntroPBBrowser.rtf",   Force)  ExtractData(?BCatalogIT,      ?BCatalogITEnd,      MyAppDataFolder$ + "Catalogs\Italiano\PBBrowser.catalog",   Force)  ExtractData(?BIntroIT,        ?BIntroITEnd,        MyAppDataFolder$ + "Catalogs\Italiano\IntroPBBrowser.rtf",  Force)  ExtractData(?BCatalogRU,      ?BCatalogRUEnd,      MyAppDataFolder$ + "Catalogs\Russian\PBBrowser.catalog",    Force)  ExtractData(?BIntroRU,        ?BIntroRUEnd,        MyAppDataFolder$ + "Catalogs\Russian\IntroPBBrowser.rtf",   Force)  ExtractData(?BCatalogES,      ?BCatalogESEnd,      MyAppDataFolder$ + "Catalogs\Espanol\PBBrowser.catalog",    Force)  ExtractData(?BIntroES,        ?BIntroESEnd,        MyAppDataFolder$ + "Catalogs\Espanol\IntroPBBrowser.rtf",   Force)  ExtractData(?BCatalogDE,      ?BCatalogDEEnd,      MyAppDataFolder$ + "Catalogs\Deutsch\PBBrowser.catalog",    Force)  ExtractData(?BIntroDE,        ?BIntroDEEnd,        MyAppDataFolder$ + "Catalogs\Deutsch\IntroPBBrowser.rtf",   Force)  ;  ExtractData(?PBFunction,      ?PBFunctionEnd,      MyAppDataFolder$ + "PBFunctionList.Data",                   #False)  ExtractData(?APIFunction,     ?APIFunctionEnd,     MyAppDataFolder$ + "APIFunctionListing.txt",                #False)EndProcedure;UpdateAppDataFolder();Procedure.s GetPureBasicProgVersionFromCompiler()  ;  ; Role: Queries 'pbcompiler.exe --version' silently and returns its version and architecture banner.  ;  Protected CompilerPath$   = GetPathPart(PureBasicProgAddr$) + "Compilers" + #PS$ + "pbcompiler.exe"  Protected CompilerOutput$ = ""  Protected CompilerProcess.i  ;  If FileSize(CompilerPath$) < 2    ProcedureReturn ""  EndIf  ;  CompilerProcess = RunProgram(CompilerPath$, "--version", "", #PB_Program_Open | #PB_Program_Read | #PB_Program_Hide)  If CompilerProcess    While ProgramRunning(CompilerProcess)      If AvailableProgramOutput(CompilerProcess)        CompilerOutput$ + ReadProgramString(CompilerProcess)      EndIf    Wend    CloseProgram(CompilerProcess)  EndIf  ;  ProcedureReturn CompilerOutput$EndProcedure;Procedure.i CheckAndUpdatePBVersionInPref(CurrentVersion$)  ;  ; Role: Compares 'CurrentVersion$' against the stored 'PureBasicProgVersion' preference  ;       and updates the preference immediately on change so language caches are rebuilt.  ; Output: Returns #True if the cached version already matched, #False otherwise.  ;  Protected SavedVersion$ = ""  Protected MatchFound.i  = #False  ;  If CurrentVersion$ And OpenPreferencesWithPatience(PBBrowserPrefile$)    SavedVersion$ = ReadPreferenceString("PureBasicProgVersion", "")    If SavedVersion$ = CurrentVersion$      MatchFound = #True    Else      WritePreferenceString("PureBasicProgVersion", CurrentVersion$)    EndIf    ClosePreferences()  EndIf  ;  ProcedureReturn MatchFoundEndProcedure;Global IsLastPBVersion = CheckAndUpdatePBVersionInPref(GetPureBasicProgVersionFromCompiler());};; ===============================================================================; 8. PUREBASIC LANGUAGE DICTIONARIES & CHM HELP INDEX; ===============================================================================;   Global lookup maps (lowercase key -> canonical case or metadata pointer);   assisting lexical analysis, syntax coloring, and context-sensitive help.;- PureBasic language keyword, function, type, and constant maps;{CompilerIf #PBBReport  If OPDMod & #OPDInitializationTiming    ReapTimer(NoTimer)    NoTimer + 1    StartTimer(NoTimer, "PopulateMaps")  EndIfCompilerEndIf;Macro FetchCompilerLine(ProcessObj, TargetString, TimeoutMs, StatusFlag, TimerVar)  ;  ; Role: Reads a single output line from a standby compiler process with a per-line inactivity timeout,  ;       yielding CPU slices while waiting to avoid pipe deadlocks or 100% core usage.  ;  TargetString = ""  TimerVar     = ElapsedMilliseconds()  While ProgramRunning(ProcessObj)    If AvailableProgramOutput(ProcessObj)      TargetString = ReadProgramString(ProcessObj)      Break    Else      If ElapsedMilliseconds() - TimerVar > TimeoutMs        StatusFlag = #False        Break      EndIf      Delay(1)    EndIf  WendEndMacro;Procedure ExtractCompilerData(Command$, FilePath$)  ;  ; Role: Spawns 'pbcompiler.exe /STANDBY', issues 'Command$' (e.g., FUNCTIONLIST or CONSTANTLIST),  ;       and streams the resulting dictionary to 'FilePath$' under per-line and total timeouts.  ;  Protected CompilerPath$ = GetPathPart(PureBasicProgAddr$) + "Compilers" + #PS$ + "pbcompiler.exe"  Protected CompilerProcess, FileID, StartTime, TotalStartTime  Protected CurrentLine$  Protected Result = #True  ;  CompilerProcess = RunProgram(CompilerPath$, "/STANDBY", "", #PB_Program_Open | #PB_Program_Read | #PB_Program_Write | #PB_Program_Hide)  If CompilerProcess = 0    Alert("CRITICAL: Cannot launch the compiler process." + #CR$ + "Actual address: " + CompilerPath$)    ProcedureReturn #False  EndIf  ;  TotalStartTime = ElapsedMilliseconds()  ;  While ProgramRunning(CompilerProcess)    FetchCompilerLine(CompilerProcess, CurrentLine$, 500, Result, StartTime)    If CurrentLine$ = "READY" Or Result = #False : Break : EndIf  Wend  ;  WriteProgramStringN(CompilerProcess, Command$)  ;  While ProgramRunning(CompilerProcess)    FetchCompilerLine(CompilerProcess, CurrentLine$, 500, Result, StartTime)    If CurrentLine$ = "READY" Or CurrentLine$ = "OUTPUT" + #TAB$ + "COMPLETE" Or Result = #False : Break : EndIf    ;    If FileID = 0      FileID = CreateFile(#PB_Any, FilePath$)      If FileID = 0 : Result = #False : Break : EndIf    EndIf    WriteStringN(FileID, CurrentLine$)    ;    If ElapsedMilliseconds() - TotalStartTime > 2000 : Result = #False : Break : EndIf  Wend  ;  WriteProgramStringN(CompilerProcess, "QUIT")  CloseProgram(CompilerProcess)  ;  If FileID <> 0    CloseFile(FileID)    If Result = #False      DeleteFile(FilePath$)    EndIf  EndIf  ;  ProcedureReturn ResultEndProcedure;; --------- Core Basic keywords (If, EndIf, While, Wend, etc.) ----------;Global NewMap PBBasicKeywordMap.s();Procedure PopulatePBBasicKeywordMap()  ;  ; Role: Populates PBBasicKeywordMap() from the embedded PBBasicKeyWords DataSection.  ;  Protected PBBasicKeyword$  ;  Restore PBBasicKeyWords  Repeat    Read.s PBBasicKeyword$    If PBBasicKeyword$ And PBBasicKeyword$ <> "EndPBBasicKeyWords"      PBBasicKeywordMap(LCase(PBBasicKeyword$)) = PBBasicKeyword$    EndIf  Until PBBasicKeyword$ = "EndPBBasicKeyWords"EndProcedure;PopulatePBBasicKeywordMap();; --------- Native PureBasic functions & CHM documentation index ---------;Macro FunctionListAddrAlternative  ;  ; Role: Default path to the native function and help index cache file.  ;  MyAppDataFolder$ + "PBFunctionList.Data"EndMacro;#PBB_KeywordDataMarker$ = "*Keyword*";; Custom COM interfaces declaring explicit 32-bit '.l' HRESULT return types so negative; error codes are properly sign-extended on both x86 and x64:Interface PBB_IITStorage Extends IUnknown  StgCreateDocfile.l(*pwcsName, grfMode.l, reserved.l, *ppstgOpen)  StgCreateDocfileOnILockBytes.l(*plkbyt, grfMode.l, reserved.l, *ppstgOpen)  StgIsStorageFile.l(*pwcsName)  StgIsStorageILockBytes.l(*plkbyt)  StgOpenStorage.l(*pwcsName, *pstgPriority, grfMode.l, *snbExclude, reserved.l, *ppstgOpen)  StgOpenStorageOnILockBytes.l(*plkbyt, *pstgPriority, grfMode.l, *snbExclude, reserved.l, *ppstgOpen)  StgSetTimes.l(*lpszName, *pctime, *patime, *pmtime)  SetControlData.l(*pControlData)  DefaultControlData.l(*ppControlData)  Compact.l(*pwcsName, iLev.l)EndInterface;Interface PBB_IStorage Extends IUnknown  CreateStream.l(*pwcsName, grfMode.l, reserved1.l, reserved2.l, *ppstm)  OpenStream.l(*pwcsName, *reserved1, grfMode.l, reserved2.l, *ppstm)EndInterface;Interface PBB_IStream Extends IUnknown  Read.l(*pv, cb.l, *pcbRead)  Write.l(*pv, cb.l, *pcbWritten)EndInterface;Structure FunctListStruct  FunctionSignature.s  FunctionDescription.sEndStructure;Global NewList PBNativeFunctionList.FunctListStruct()Global NewMap  *PBNativeFunctions.FunctListStruct()Global NewMap  PBNativeFunctions.s()Global NewMap  PBHelpPaths.s();Procedure ExtractCHMHelpIndex(ChmFilePath$, Map ChmPaths.s())  ;  ; Role: Streams 'Index.hhk' directly in memory from 'PureBasic.chm' through the Windows  ;       ITStorage COM interface (itss.dll) and maps lowercase function and keyword identifiers  ;       to their target HTML documentation paths (including shared Reference/ pages and anchors).  ;  Protected *ITStorage.PBB_IITStorage, *Storage.PBB_IStorage, *Stream.PBB_IStream  Protected *Chunk, *Buf, *NewBuf, *Cur.Ascii, *Limit.Ascii, *End.Ascii, *ValStart.Ascii  Protected StreamName$, AttrName$, EntryName$, LocalPath$, Key$  Protected TotalBytes.i, BufCap.i, IsGenericPath.i  Protected hr.l, CoInitHr.l, BytesRead.l  ;  ClearMap(ChmPaths())  If FileSize(ChmFilePath$) < 64    ProcedureReturn #False  EndIf  ;  CoInitHr = CoInitialize_(0)  hr       = CoCreateInstance_(?CLSID_ITStorage, 0, 1, ?IID_ITStorage, @*ITStorage)  If hr >= 0 And *ITStorage    ; Attempt STGM_SHARE_DENY_WRITE ($20), falling back to STGM_SHARE_DENY_NONE ($40) if PureBasic.chm is open in hh.exe:    hr = *ITStorage\StgOpenStorage(@ChmFilePath$, 0, $20, 0, 0, @*Storage)    If hr < 0      hr = *ITStorage\StgOpenStorage(@ChmFilePath$, 0, $40, 0, 0, @*Storage)    EndIf    If hr >= 0 And *Storage      ; Sub-streams inside compound ITSS storages require STGM_SHARE_EXCLUSIVE ($10):      StreamName$ = "Index.hhk"      hr = *Storage\OpenStream(@StreamName$, 0, $10, 0, @*Stream)      If hr < 0        StreamName$ = "/Index.hhk"        hr = *Storage\OpenStream(@StreamName$, 0, $10, 0, @*Stream)      EndIf      If hr >= 0 And *Stream        *Chunk = AllocateMemory(65536)        BufCap = 65536        *Buf   = AllocateMemory(BufCap)        If *Chunk And *Buf          ; Read across S_OK (0) and S_FALSE (1) until BytesRead reaches 0 so the final partial chunk is retained:          Repeat            BytesRead = 0            hr        = *Stream\Read(*Chunk, 65536, @BytesRead)            If hr < 0 Or BytesRead <= 0              Break            EndIf            If TotalBytes + BytesRead > BufCap              BufCap  = (TotalBytes + BytesRead) * 2              *NewBuf = ReAllocateMemory(*Buf, BufCap)              If *NewBuf = 0                Break              EndIf              *Buf = *NewBuf            EndIf            CopyMemory(*Chunk, *Buf + TotalBytes, BytesRead)            TotalBytes + BytesRead          ForEver        EndIf        If *Chunk          FreeMemory(*Chunk)        EndIf        *Stream\Release()      EndIf      *Storage\Release()    EndIf    *ITStorage\Release()  EndIf  ; Balance CoInitialize_ only when it succeeded (S_OK or S_FALSE), ignoring RPC_E_CHANGED_MODE:  If CoInitHr >= 0    CoUninitialize_()  EndIf  ;  ; Parse HTML Help '<OBJECT type="text/sitemap">' blocks directly in the ASCII buffer:  If *Buf    If TotalBytes > 12      *Cur   = *Buf      *End   = *Buf + TotalBytes      *Limit = *End - 8      While *Cur <= *Limit        If *Cur\a = '<'          If (PeekA(*Cur + 1) | 32) = 'p' And (PeekA(*Cur + 2) | 32) = 'a' And (PeekA(*Cur + 3) | 32) = 'r'            *Cur + 4            While *Cur <= *Limit And *Cur\a <> '>'              If (*Cur\a | 32) = 'n' And (PeekA(*Cur + 1) | 32) = 'a' And (PeekA(*Cur + 2) | 32) = 'm' And                 (PeekA(*Cur + 3) | 32) = 'e' And PeekA(*Cur + 4) = '=' And PeekA(*Cur + 5) = '"'                *Cur + 6                *ValStart = *Cur                While *Cur < *End And *Cur\a <> '"'                  *Cur + 1                Wend                AttrName$ = LCase(PeekS(*ValStart, *Cur - *ValStart, #PB_Ascii))                While *Cur <= *Limit And *Cur\a <> '>'                  If (*Cur\a | 32) = 'v' And (PeekA(*Cur + 1) | 32) = 'a' And (PeekA(*Cur + 2) | 32) = 'l' And                     (PeekA(*Cur + 3) | 32) = 'u' And (PeekA(*Cur + 4) | 32) = 'e' And PeekA(*Cur + 5) = '=' And PeekA(*Cur + 6) = '"'                    *Cur + 7                    *ValStart = *Cur                    While *Cur < *End And *Cur\a <> '"'                      *Cur + 1                    Wend                    If AttrName$ = "name"                      EntryName$ = PeekS(*ValStart, *Cur - *ValStart, #PB_Ascii)                    ElseIf AttrName$ = "local"                      LocalPath$ = PeekS(*ValStart, *Cur - *ValStart, #PB_Ascii)                    EndIf                    Break                  EndIf                  *Cur + 1                Wend                Break              EndIf              *Cur + 1            Wend          ElseIf PeekA(*Cur + 1) = '/' And (PeekA(*Cur + 2) | 32) = 'o' And (PeekA(*Cur + 3) | 32) = 'b'            EntryName$ = Trim(EntryName$)            ; Strip trailing parentheses on single-token identifiers while avoiding prose topics like 'Map (Library)':            If FindString(EntryName$, " ") = 0 And FindString(EntryName$, "(")              EntryName$ = StringField(EntryName$, 1, "(")            EndIf            Key$       = LCase(EntryName$)            LocalPath$ = LTrim(ReplaceString(Trim(LocalPath$), "\", "/"), "/")            If Key$ <> "" And LocalPath$ <> ""              ; Prioritize dedicated library pages over generic Reference/ or library index.html overview pages:              IsGenericPath = Bool(Left(LCase(LocalPath$), 10) = "reference/" Or Right(LCase(LocalPath$), 11) = "/index.html")              If FindMapElement(ChmPaths(), Key$) = 0                ChmPaths(Key$) = LocalPath$              ElseIf IsGenericPath = #False And (Left(LCase(ChmPaths()), 10) = "reference/" Or Right(LCase(ChmPaths()), 11) = "/index.html")                ChmPaths(Key$) = LocalPath$              ElseIf Right(LCase(ChmPaths()), 11) = "/index.html" And Right(LCase(LocalPath$), 11) <> "/index.html"                ChmPaths(Key$) = LocalPath$              EndIf            EndIf            EntryName$ = ""            LocalPath$ = ""          EndIf        EndIf        *Cur + 1      Wend ; End HTML Help buffer scan    EndIf    FreeMemory(*Buf)  EndIf  ;  ProcedureReturn Bool(MapSize(ChmPaths()) > 0)EndProcedure;Procedure UpdatePBNativeFunctionList(Confirm = 1)  ;  ; Role: Builds the unified 'PBFunctionList.Data' cache combining compiler function signatures  ;       and Basic keywords with their HTML documentation paths extracted from 'PureBasic.chm'.  ;       Also updates 'PBBrowser resources\PBFunctionList.Data' when running under the IDE debugger.  ;  Protected PBFunctionListAddr$ = ReadStrPrefValue("PBFunctionListAdr", FunctionListAddrAlternative)  Protected CompilerPath$       = GetPathPart(PureBasicProgAddr$) + "Compilers" + #PS$ + "pbcompiler.exe"  Protected TempFile$           = MyAppDataFolder$ + "PBFunctionList.tmp"  Protected RawLine$, Signature$, Description$, NameOnly$, HelpPath$, Keyword$, FallbackKey$  Protected InFile.i, OutFile.i, SepPos.i, WrittenCount.i  Protected NewMap ChmPaths.s()  ;  ; On standalone machines without PureBasic installed, skip silent compiler extraction:  If Confirm = 0 And FileSize(CompilerPath$) < 2    ProcedureReturn #False  EndIf  ;  If ExtractCompilerData("FUNCTIONLIST", TempFile$)    ExtractCHMHelpIndex(GetPathPart(PureBasicProgAddr$) + "PureBasic.chm", ChmPaths())    ;    InFile = ReadFileWithPatience(#PB_Any, TempFile$)    If InFile      ReadStringFormat(InFile)      OutFile = CreateFile(#PB_Any, PBFunctionListAddr$, #PB_UTF8)      If OutFile        ; 1. Write native and compiler functions with their resolved CHM paths:        While Not Eof(InFile)          RawLine$ = ReadString(InFile, #PB_UTF8)          SepPos   = FindString(RawLine$, " - ")          If SepPos > 1            Signature$   = Trim(Left(RawLine$, SepPos - 1))            Description$ = Trim(Mid(RawLine$, SepPos + 3))            NameOnly$    = LCase(Trim(StringField(Signature$, 1, "(")))            If NameOnly$ <> ""              If FindMapElement(ChmPaths(), NameOnly$)                HelpPath$ = ChmPaths()              Else                HelpPath$ = ""              EndIf              WriteStringN(OutFile, Signature$ + #TAB$ + Description$ + #TAB$ + HelpPath$)              WrittenCount + 1            EndIf          EndIf        Wend        ;        ; 2. Append Basic keywords from PBBasicKeyWords with parent-topic fallback for secondary keywords omitted from Index.hhk:        If WrittenCount > 0          Restore PBBasicKeyWords          Repeat            Read.s Keyword$            If Keyword$ = "EndPBBasicKeyWords"              Break            EndIf            NameOnly$ = LCase(Keyword$)            HelpPath$ = ""            If FindMapElement(ChmPaths(), NameOnly$)              HelpPath$ = ChmPaths()            Else              FallbackKey$ = ""              Select NameOnly$                Case "align"                  FallbackKey$ = "structure"                Case "as", "importc", "endimport"                  FallbackKey$ = "import"                Case "compilerelseif", "compilerwarning", "compilerelse", "compilerendif",                     "compilercase", "compilerdefault", "compilerendselect", "compilererror"                  FallbackKey$ = "compilerif"                Case "declarec", "declarecdll", "declaredll"                  FallbackKey$ = "declare"                Case "enumerationbinary", "endenumeration"                  FallbackKey$ = "enumeration"                Case "includebinary", "includepath", "xincludefile"                  FallbackKey$ = "includefile"                Case "macroexpandedcount", "undefinemacro", "endmacro"                  FallbackKey$ = "macro"                Case "procedurec", "procedurecdll", "proceduredll"                  FallbackKey$ = "procedure"                Case "prototypec"                  FallbackKey$ = "prototype"              EndSelect              If FallbackKey$ <> "" And FindMapElement(ChmPaths(), FallbackKey$)                HelpPath$ = ChmPaths()              EndIf            EndIf            WriteStringN(OutFile, Keyword$ + #TAB$ + #PBB_KeywordDataMarker$ + #TAB$ + HelpPath$)          ForEver        EndIf        CloseFile(OutFile)      EndIf      CloseFile(InFile)    EndIf    DeleteFile(TempFile$)    ;    If WrittenCount > 0      CompilerIf #PB_Compiler_Debugger        If FileSize(#PB_Compiler_FilePath + "..\PBFunctionList.Data") >= 0          CopyFile(PBFunctionListAddr$, #PB_Compiler_FilePath + "..\PBFunctionList.Data")        EndIf      CompilerEndIf      If Confirm <> 0        Alert(GetTextFromCatalogPB("FunctionsUpdateDone"))      EndIf      ProcedureReturn #True    EndIf  EndIf  ;  ProcedureReturn #FalseEndProcedure;Procedure PopulatePBNativeFunctionMap()  ;  ; Role: Coordinates version checks, automatic cache format upgrades, and single-pass  ;       population of PBNativeFunctionList(), *PBNativeFunctions(), PBNativeFunctions(),  ;       and PBHelpPaths() (covering both native functions and Basic keywords).  ;  Protected PBFunctionListAddr$ = ReadStrPrefValue("PBFunctionListAdr", FunctionListAddrAlternative)  Protected FunctionLine$, Field1$, Field2$, Field3$, NameOnly$, Key$  Protected noFile.i, Attempt.i, KeywordLoaded.i  ;  If FileSize(PBFunctionListAddr$) < 2 Or Not IsLastPBVersion    UpdatePBNativeFunctionList(#False)  EndIf  ;  For Attempt = 1 To 2    KeywordLoaded = #False    If FileSize(PBFunctionListAddr$) > 1      noFile = ReadFileWithPatience(#PB_Any, PBFunctionListAddr$)      If noFile        ReadStringFormat(noFile)        ClearList(PBNativeFunctionList())        ClearMap(PBNativeFunctions())        ClearMap(*PBNativeFunctions())        ClearMap(PBHelpPaths())        ;        While Not Eof(noFile)          FunctionLine$ = ReadString(noFile, #PB_UTF8)          If FindString(FunctionLine$, #TAB$)            Field1$ = StringField(FunctionLine$, 1, #TAB$)            Field2$ = StringField(FunctionLine$, 2, #TAB$)            Field3$ = StringField(FunctionLine$, 3, #TAB$)            If Field2$ = #PBB_KeywordDataMarker$              KeywordLoaded = #True              Key$          = LCase(Trim(Field1$))              If Key$ <> "" And Field3$ <> ""                PBHelpPaths(Key$) = Field3$              EndIf            Else              AddElement(PBNativeFunctionList())              PBNativeFunctionList()\FunctionSignature   = Field1$              PBNativeFunctionList()\FunctionDescription = Field2$              NameOnly$ = Trim(StringField(Field1$, 1, "("))              If NameOnly$ <> ""                Key$                     = LCase(NameOnly$)                *PBNativeFunctions(Key$) = @PBNativeFunctionList()                PBNativeFunctions(Key$)  = NameOnly$                If Field3$ <> ""                  PBHelpPaths(Key$) = Field3$                EndIf              EndIf            EndIf          EndIf        Wend        CloseFile(noFile)      EndIf    EndIf    ;    ; Exit once both native functions and keyword help entries are loaded; otherwise upgrade legacy cache once:    If (ListSize(PBNativeFunctionList()) > 0 And KeywordLoaded) Or Attempt = 2      Break    EndIf    If UpdatePBNativeFunctionList(#False) = #False      ExtractData(?PBFunction, ?PBFunctionEnd, PBFunctionListAddr$)    EndIf  NextEndProcedure;PopulatePBNativeFunctionMap();; --------- Native types, pseudo-types, containers & structures ---------;Global NewMap PBBasicNativeTypes.s();Procedure PopulatePBBasicNativeTypesMap()  ;  ; Role: Populates PBBasicNativeTypes() with PureBasic primitive types, pseudo-types,  ;       container qualifiers, and predefined OS/runtime structures.  ;  Protected FullList$ = #PBPrimitiveTypeTokens$ + "," + #PBPseudoTypes$ + "," + #PBParamContainers$ + "," + #PBPredefinedStructures$  Protected Index = 1, Keyword$  ;  ClearMap(PBBasicNativeTypes())  Repeat    Keyword$ = StringField(FullList$, Index, ",")    If Keyword$ = ""      Break    EndIf    PBBasicNativeTypes(LCase(Keyword$)) = Keyword$    Index + 1  ForEverEndProcedure;PopulatePBBasicNativeTypesMap();; --------- Block declarators (Procedure, Macro, Structure...) ----------;Global NewMap PB_BlockDeclarators.s();Procedure PopulatePBBlockDeclarators()  ;  ; Role: Populates PB_BlockDeclarators() from #PBElementDeclarators$.  ;  Protected Index, Declarator$  ;  Repeat    Index + 1    Declarator$ = StringField(#PBElementDeclarators$, Index, ",")    If Declarator$      PB_BlockDeclarators(LCase(Declarator$)) = Declarator$    EndIf  Until Declarator$ = ""EndProcedure;PopulatePBBlockDeclarators();; --------- Variable declarators (Global, Protected, Define...) ---------;Global NewMap PB_VariableDeclarators.s();Procedure PopulatePBVariableDeclarators()  ;  ; Role: Populates PB_VariableDeclarators() from #PBVariableDeclarators$.  ;  Protected Index, Declarator$  Protected PBVariableDeclarators$ = Trim(#PBVariableDeclarators$, ",")  ;  Repeat    Index + 1    Declarator$ = StringField(PBVariableDeclarators$, Index, ",")    If Declarator$      PB_VariableDeclarators(LCase(Declarator$)) = Declarator$    EndIf  Until Declarator$ = ""EndProcedure;PopulatePBVariableDeclarators();; --------- OS API functions natively supported by PureBasic ------------;Global NewMap PBAPIFunctions.s();Procedure UpDateAPIFunctionList()  ;  ; Role: Copies 'Compilers\APIFunctionListing.txt' to 'MyAppDataFolder$' when a newer  ;       version is available in the PureBasic installation directory.  ;  Protected FtKWSrce$  = GetPathPart(PureBasicProgAddr$) + "Compilers\APIFunctionListing.txt"  Protected LocalDest$ = MyAppDataFolder$ + "APIFunctionListing.txt"  ;  If FileSize(FtKWSrce$) > 2    If FileSize(LocalDest$) <= 0 Or GetFileDate(FtKWSrce$, #PB_Date_Modified) > GetFileDate(LocalDest$, #PB_Date_Modified)      CopyFile(FtKWSrce$, LocalDest$)    EndIf  EndIfEndProcedure;Procedure PopulatePBAPIFunctionsMap()  ;  ; Role: Refreshes the local 'APIFunctionListing.txt' cache and loads all OS API  ;       function names (such as AppendMenu_(), GetWindow_(), etc.) into PBAPIFunctions().  ;  Protected LocalDest$ = MyAppDataFolder$ + "APIFunctionListing.txt"  Protected RawData$, Line$, CleanName$  Protected LineIndex, TotalLines  ;  UpDateAPIFunctionList()  If FileSize(LocalDest$) > 2    ClearMap(PBAPIFunctions())    RawData$   = FileToText(LocalDest$)    TotalLines = CountString(RawData$, #CR$) + 1    For LineIndex = 1 To TotalLines      Line$ = Trim(StringField(RawData$, LineIndex, #CR$), #LF$)      If Line$        CleanName$ = RemoveString(Line$, "()")        PBAPIFunctions(LCase(CleanName$)) = CleanName$      EndIf    Next  EndIfEndProcedure;;PopulatePBAPIFunctionsMap();; --------- Native PureBasic constants (#PB_Any, #Null, etc.) -----------;Macro ConstantListAddrAlternative  ;  ; Role: Default path to the native PureBasic constants cache file.  ;  MyAppDataFolder$ + "PBConstantes.Data"EndMacro;Procedure.i UpdatePBNativeConstantList(Confirm = 1)  ;  ; Role: Extracts the PureBasic native constant list via the compiler into 'PBConstantes.Data'.  ;  Protected PBConstantListAddr$ = ReadStrPrefValue("PBConstantListAdr", ConstantListAddrAlternative)  ;  If ExtractCompilerData("CONSTANTLIST", PBConstantListAddr$)    If Confirm <> 0      Alert(GetTextFromCatalogPB("ConstantsUpdateDone"))    EndIf    ProcedureReturn #True  EndIfEndProcedure;Structure ConstListStruct  ConstantName.s  ConstantName_UCase.s  ConstantType.i  ConstantValueStr.s  ConstantValueInt.i  ConstantValueFloat.fEndStructure;Global NewList PBNativeConstantList.ConstListStruct()Global NewMap  *PBNativeConstantMap.ConstListStruct()Global NewMap  PBNativeConstantMap.s();Procedure PopulatePBNativeConstantMap()  ;  ; Role: Loads 'PBConstantes.Data' (regenerating it via the compiler if missing or outdated)  ;       and populates PBNativeConstantList(), *PBNativeConstantMap(), and PBNativeConstantMap().  ;  Protected PBConstantListAddr$ = ReadStrPrefValue("PBConstantListAdr", ConstantListAddrAlternative)  Protected ConstantLine$  Protected noFile.i  ;  If FileSize(PBConstantListAddr$) < 2 Or Not IsLastPBVersion    UpdatePBNativeConstantList(#False)  EndIf  ;  If FileSize(PBConstantListAddr$) > 1    noFile = ReadFileWithPatience(#PB_Any, PBConstantListAddr$)    If noFile      ClearList(PBNativeConstantList())      ClearMap(*PBNativeConstantMap())      ClearMap(PBNativeConstantMap())      ;      While Not Eof(noFile)        ConstantLine$ = ReadString(noFile)        If StringField(ConstantLine$, 2, #TAB$)          AddElement(PBNativeConstantList())          PBNativeConstantList()\ConstantName       = "#" + StringField(ConstantLine$, 2, #TAB$)          PBNativeConstantList()\ConstantName_UCase = UCase(PBNativeConstantList()\ConstantName)          PBNativeConstantList()\ConstantType       = Val(StringField(ConstantLine$, 1, #TAB$))          ;          If PBNativeConstantList()\ConstantType = 0            PBNativeConstantList()\ConstantValueInt   = Val(StringField(ConstantLine$, 3, #TAB$))          ElseIf PBNativeConstantList()\ConstantType = 1            PBNativeConstantList()\ConstantValueFloat = ValF(StringField(ConstantLine$, 3, #TAB$))          ElseIf PBNativeConstantList()\ConstantType = 2            PBNativeConstantList()\ConstantValueStr   = StringField(ConstantLine$, 3, #TAB$)          EndIf          ;          *PBNativeConstantMap(PBNativeConstantList()\ConstantName_UCase) = @PBNativeConstantList()          PBNativeConstantMap(PBNativeConstantList()\ConstantName_UCase)  = PBNativeConstantList()\ConstantName        EndIf      Wend      CloseFile(noFile)    EndIf  EndIfEndProcedure;PopulatePBNativeConstantMap();};; ===============================================================================; 9. USER PREFERENCES, FONTS & SYNTAX COLORS; ===============================================================================;- PureBasic IDE preferences and color themes;{CompilerIf #PBBReport  If OPDMod & #OPDInitializationTiming    ReapTimer(NoTimer)    NoTimer + 1    StartTimer(NoTimer, "Preferences, fonts & colors")  EndIfCompilerEndIf;Procedure.s GetPureBasicPrefAdress()  ;  ; Role: Locates 'PureBasic.prefs' (checking portable IDE directory first, then standard  ;       AppData folders) so PBBrowser can read IDE syntax colors and register its custom tool.  ;  Protected itemid, PBPrefAddr$  ;  If FileSize(GetPathPart(PureBasicProgAddr$) + "PureBasic.prefs") > 1    PBPrefAddr$ = GetPathPart(PureBasicProgAddr$) + "PureBasic.prefs"  Else    If SHGetSpecialFolderLocation_(0, #CSIDL_APPDATA, @itemid) = #NOERROR      PBPrefAddr$ = Space(#MAX_PATH)      SHGetPathFromIDList_(itemid, @PBPrefAddr$)      PBPrefAddr$ = RTrim(PBPrefAddr$)    EndIf    PBPrefAddr$ + "\PureBasic\PureBasic.prefs"    If FileSize(PBPrefAddr$) < 2      PBPrefAddr$ = GetHomeDirectory() + "AppData\Roaming\PureBasic\PureBasic.prefs"    EndIf    If FileSize(PBPrefAddr$) < 2      PBPrefAddr$ = GetHomeDirectory() + "AppData\PureBasic\PureBasic.prefs"    EndIf  EndIf  ;  If FileSize(PBPrefAddr$) < 2    ProcedureReturn ""  EndIf  ProcedureReturn PBPrefAddr$EndProcedure;Procedure GetValueFromPB_PrefFile(ValueName$)  ;  ; Role: Reads an integer preference (such as syntax highlighting colors) from 'PureBasic.prefs',  ;       falling back to PBPrefSecure$ when PureBasic is not installed on the host machine.  ;  Static PBPrefile$  Protected PosInText, pf, PBPrefAddr$  ;  If PBPrefile$ = ""    PBPrefAddr$ = GetPureBasicPrefAdress()    If FileSize(PBPrefAddr$) > 2      PBPrefile$ = FileToText(PBPrefAddr$, #PB_UTF8, 1)    EndIf    If PBPrefile$ = ""      PBPrefile$ = PBPrefSecure$    EndIf  EndIf  ;  PosInText = FindString(PBPrefile$, ValueName$)  If PosInText    PosInText + Len(ValueName$)    PosInText = FindString(PBPrefile$, "=", PosInText) + 1    While Mid(PBPrefile$, PosInText, 1) = " " : PosInText + 1 : Wend    pf = PosInText    While pf <= Len(PBPrefile$) And FindString(" " + #CR$ + #LF$, Mid(PBPrefile$, pf, 1)) = 0      pf + 1    Wend    ProcedureReturn Val(Mid(PBPrefile$, PosInText, pf - PosInText))  EndIfEndProcedure;};GetColorThemesFromPreferences(PBBrowserPrefile$);};;- User-editable parameters, fonts, and element syntax colors;{Enumeration ParameterType  #PBBP_Color = 1  #PBBP_GenericNum  #PBBP_FontStyle  #PBBP_GenericStringEndEnumeration;Structure PBBParametersStruct  Name$  Value$  Type.i  Category$  DefaultValue$  ;  ; Fields managed by PBBSetParameters() in the Preferences dialog:  ColorTempValue$  LegendGadget.i  InputGadget.i  InputGadgetFont.i  StandardButtonGadget.i  TitleGadget.i  CanvasLineGadget.iEndStructure;Global NewList PBBParameters.PBBParametersStruct();Procedure UpdatePBBParameter(Name$, Value$, Type = 0, Category$ = "", DefaultValue$ = "")  ;  ; Role: Registers or updates a configuration parameter in PBBParameters().  ;  Protected Found = 0  ;  ForEach PBBParameters()    If PBBParameters()\Name$ = Name$      Found = 1      Break    EndIf  Next  If Found = 0    AddElement(PBBParameters())  EndIf  PBBParameters()\Name$  = Name$  PBBParameters()\Value$ = Value$  If Type    PBBParameters()\Type = Type  EndIf  If Category$    PBBParameters()\Category$ = Category$  EndIf  If DefaultValue$    PBBParameters()\DefaultValue$ = DefaultValue$  ElseIf PBBParameters()\DefaultValue$ = ""    PBBParameters()\DefaultValue$ = PBBParameters()\Value$  EndIfEndProcedure;Procedure.s GetPBBStringParameter(ParameterName$, DefaultParam = 0)  ;  ; Role: Returns the active (or default when 'DefaultParam' is non-zero) string value of 'ParameterName$'.  ;  ForEach PBBParameters()    If PBBParameters()\Name$ = ParameterName$      If DefaultParam        ProcedureReturn PBBParameters()\DefaultValue$      Else        ProcedureReturn PBBParameters()\Value$      EndIf    EndIf  NextEndProcedure;Procedure GetPBBNumParameter(ParameterName$, DefaultParam = 0)  ;  ; Role: Returns the active (or default) integer value of 'ParameterName$'.  ;  ProcedureReturn Val(GetPBBStringParameter(ParameterName$, DefaultParam))EndProcedure;; --- Editable parameters ---; Registration order determines display order in the Preferences window; keep categories grouped together.;; Category: PBBrowserWindowsUpdatePBBParameter("PBBAllGadgetsFont",     "Segoe UI, 9",       #PBBP_FontStyle,     "PBBrowserWindows")     ; Default UI gadget font.UpdatePBBParameter("PBBTitleFont",          "Segoe UI, 9, Bold", #PBBP_FontStyle,     "PBBrowserWindows")     ; Section header font ("Source/Project", "Expression", "Included Files").UpdatePBBParameter("PBBTitleColor",         "$939371",           #PBBP_Color,         "PBBrowserWindows")     ; Section header text color.UpdatePBBParameter("PBBUnusedElementColor", "$8C8C82",           #PBBP_Color,         "PBBrowserWindows")     ; Muted color applied to unreferenced elements.;; Category: DetailsFoundInPannelsUpdatePBBParameter("PBBElementNameColor",        "$0000B4",      #PBBP_Color,         "DetailsFoundInPannels") ; Highlighted element name color in 'Details' and 'Found in...'.UpdatePBBParameter("PBBPanelsDefaultFontStyle",  "Segoe UI, 9",  #PBBP_FontStyle,     "DetailsFoundInPannels") ; Default prose font in result panels.UpdatePBBParameter("PBB_Bullet",                 #BulletChar$,   #PBBP_GenericString, "DetailsFoundInPannels") ; Bullet prefix in 'Details' and 'Found in...'.;; Category: DetailsPannelUpdatePBBParameter("PBBElementDetailsColor", "$787878",          #PBBP_Color,         "DetailsPannel")         ; Secondary metadata color in the 'Details' panel.UpdatePBBParameter("PBBCodeFontStyle",       "Consolas, 10",     #PBBP_FontStyle,     "DetailsPannel")         ; Monospace UTF-8 code font in the 'Details' panel.;; Category: FoundInPannelUpdatePBBParameter("PBBSetValueColor",       "$006BB2",          #PBBP_Color,         "FoundInPannel")         ; Color for 'Set', 'Read', 'Ret', 'Param', and 'Poke' tags in 'Found in...'.;; --- Internal non-editable parameters (omitted from the Preferences dialog when Category$ is empty) ---UpdatePBBParameter("PBBProgressLegendFont",  "Segoe UI, 7",      #PBBP_FontStyle)                              ; Progress bar caption font.UpdatePBBParameter("PBBBRefreshFont",        "Cambria Math, 12", #PBBP_FontStyle)                              ; Refresh symbol button font.;If OpenPreferencesWithPatience(PBBrowserPrefile$)  ForEach PBBParameters()    PBBParameters()\Value$ = ReadPreferenceString(PBBParameters()\Name$, PBBParameters()\Value$)    WritePreferenceString(PBBParameters()\Name$, PBBParameters()\Value$)  Next  ClosePreferences()EndIf;; Initialize global font handles:PBBAllGadgetsFont     = FontID(LoadFontFromDescription(GetPBBStringParameter("PBBAllGadgetsFont")))PBBTitleFont          = FontID(LoadFontFromDescription(GetPBBStringParameter("PBBTitleFont")))PBBProgressLegendFont = FontID(LoadFontFromDescription(GetPBBStringParameter("PBBProgressLegendFont")))PBBBRefreshFont       = FontID(LoadFontFromDescription(GetPBBStringParameter("PBBBRefreshFont")));; Initialize syntax highlighting colors per element type; (Note: #PBBNativeKeyWord is currently unused, as native type/container keywords use #PBBBasicKeyword):ListOfAllElementsColor(#PBBProcedure)      = GetValueFromPB_PrefFile("PureKeywordColor")ListOfAllElementsColor(#PBBStructure)      = GetValueFromPB_PrefFile("StructureColor")ListOfAllElementsColor(#PBBMacro)          = GetValueFromPB_PrefFile("PureKeywordColor")ListOfAllElementsColor(#PBBEnumeration)    = GetValueFromPB_PrefFile("PureKeywordColor")ListOfAllElementsColor(#PBBInterface)      = GetValueFromPB_PrefFile("PureKeywordColor")ListOfAllElementsColor(#PBBLabel)          = GetValueFromPB_PrefFile("LabelColor")ListOfAllElementsColor(#PBBConstant)       = GetValueFromPB_PrefFile("ConstantColor")ListOfAllElementsColor(#PBBVariable)       = GetValueFromPB_PrefFile("NormalTextColor")ListOfAllElementsColor(#PBBModule)         = GetValueFromPB_PrefFile("NormalTextColor")ListOfAllElementsColor(#PBBImport)         = GetValueFromPB_PrefFile("NormalTextColor")ListOfAllElementsColor(#PBBImported)       = GetValueFromPB_PrefFile("NormalTextColor")ListOfAllElementsColor(#PBBField)          = GetValueFromPB_PrefFile("NormalTextColor")ListOfAllElementsColor(#PBBNativeFunction) = GetValueFromPB_PrefFile("PureKeywordColor")ListOfAllElementsColor(#PBBBasicKeyword)   = GetValueFromPB_PrefFile("BasicKeywordColor");; Line-break prefix used across 'Found in...' entries:Global PBB_LineBreak$ = #CR$ + GetPBBStringParameter("PBB_Bullet") + #NonBreakableSpace$;; Tab replacement spaces synchronized with 'TabLength' from PureBasic.prefs.Define PBBTabLen.i = GetValueFromPB_PrefFile("TabLength")If PBBTabLen >= 1 And PBBTabLen <= 16  PBBTabSpaces$ = Space(PBBTabLen)Else  PBBTabSpaces$ = "  "EndIf;};;- Preferences window module;- INCLUDEFILE MENTIONSXIncludeFile "PBB_PrefWindow.pb";; ===============================================================================; 10. IDE TOOL INSTALLATION & EXPRESSION EVALUATOR CONTEXT; ===============================================================================;- IDE tool installation and help utilities;- INCLUDEFILE MENTIONSXIncludeFile "PBB_AddToolToPureBasic.pb"XIncludeFile "PBB_HelpAndTools.pb";;{Procedure InstallPBBTool()  ;  ; Role: Prompts the user on first launch to register PBBrowser in the PureBasic IDE  ;       Tools menu (standard or portable installation).  ;  Protected WWidth = 400, WHeight = 183, Vpos = 10, Margins = 10, LineHeight = 30, OX, OY  Protected InstallWindow, TIntro, BYes, BLater, BPortable, BPBBPortable  Protected NewPath$, GadgetList$  ;  Protected ParentWindowID = ComputeWinOrigins(@OX, @OY, WWidth, WHeight, GPBBGadgets\PBBWindow)  InstallWindow = OpenWindow(#PB_Any, OX, OY, WWidth, WHeight, GetTextFromCatalogPB("FirstLaunch"), #PB_Window_SystemMenu, ParentWindowID)  If InstallWindow    ApplyDarkModeToWindow(InstallWindow)    StickyWindow(InstallWindow, #True)    TIntro = TextGadget(#PB_Any, Margins, Vpos + 2, WWidth - Margins * 2, 40, GetTextFromCatalogPB("ShouldInstall"), #PB_Text_Center)    GadgetList$ + Str(TIntro) + ","    Vpos + 45    BYes = ButtonGadget(#PB_Any, Margins, Vpos + 2, WWidth - Margins * 2, 25, GetTextFromCatalogPB("Yes"))    GadgetList$ + Str(BYes) + ","    Vpos + LineHeight    BLater = ButtonGadget(#PB_Any, Margins, Vpos + 2, WWidth - Margins * 2, 25, GetTextFromCatalogPB("DoLater"))    GadgetList$ + Str(BLater) + ","    Vpos + LineHeight    BPortable = ButtonGadget(#PB_Any, Margins, Vpos + 2, WWidth - Margins * 2, 25, GetTextFromCatalogPB("InstallInPortablePB"))    GadgetList$ + Str(BPortable) + ","    Vpos + LineHeight    BPBBPortable = CheckBoxGadget(#PB_Any, Margins, Vpos + 2, WWidth - Margins * 2, 25, GetTextFromCatalogPB("ConfigurePBBAsPortable"))    GadgetList$ + Str(BPBBPortable) + ","    SetFontAndGadgetsColors(InstallWindow, InterfaceColorPresets(), GadgetList$)    ;    Repeat      Select WaitWindowEvent()        Case #PB_Event_CloseWindow          Break        Case #PB_Event_Gadget          Select EventGadget()            Case BYes              InstallPBBrowserAndPrintResult(GetGadgetState(BPBBPortable))              Break            Case BPortable              NewPath$ = PathRequester(GetTextFromCatalogPB("ShowPBBrowserPath"), GetCurrentApplicationPath())              If FileSize(NewPath$ + "PureBasic.exe") > 1 And FileSize(NewPath$ + "PureBasic.prefs") > 1                PureBasicProgAddr$ = NewPath$ + "PureBasic.exe"                If OpenPreferencesWithPatience(PBBrowserPrefile$)                  WritePreferenceString("PureBasicProgAdr", ReplaceString(PureBasicProgAddr$, #DOUBLEQUOTE$, ""))                  ClosePreferences()                EndIf                InstallPBBrowserAndPrintResult(GetGadgetState(BPBBPortable))                Break              Else                AlertInPBBWindow(GetTextFromCatalogPB("ToolInstallationAborted"))                Break              EndIf            Case BLater              Break          EndSelect      EndSelect    ForEver    CloseWindow(InstallWindow)  EndIfEndProcedure;If PBBFirstLaunch And PureBasicProgAddr$ And Not IsToolalreadyInstalled("PB Browser")  InstallPBBTool()EndIf;};;CompilerIf #PBBReport  If OPDMod & #OPDInitializationTiming    ReapTimer(NoTimer)    DebugAllTimers()  EndIfCompilerEndIf;; IDE Options = PureBasic 6.40 (Windows - x64); CursorPosition = 1084; FirstLine = 206; Folding = bFQAgCAAAg; EnableXP; DPIAware; UseMainFile = ..\..\PBBrowser.pb