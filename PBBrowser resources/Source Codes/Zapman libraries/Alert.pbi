;; ****************************************************************************;;                               'Alert' library;;           An alternative to PureBasic's native MessageRequester();                  Windows only - Zapman, Nov. 2026 - 7;;          This file should be saved under the name "Alert.pbi".;;; This library is organized into five distinct sections:;; 1. 'Language settings' contains functions that manage the multilingual;    aspect of the library. Read the comment at the beginning of this section;    for more details.; 2. 'Miscellaneous functions' includes general helper functions required for;    the library's operation that may also be useful in other contexts.; 3. 'RichEdit_BasicLibrary' contains functions for managing EditorGadgets,;    such as 'RE_FindReplace()', which provides Find/Replace capabilities;    inside an EditorGadget.; 4. 'Alert library' is the main part of this file. It implements 'Alert()';    and 'AlertYesNoCancel()' as resizable, rich-text-capable alternatives;    to PureBasic's native MessageRequester() function.; 5. 'DEMO' provides a set of demonstrations for 'Alert()' and 'AlertYesNoCancel()'.;;; This library is compatible with the Zapman 'ApplyColorThemes.pbi' library,; which allows you to display your windows in 'Dark Mode' or with other color themes.;; ****************************************************************************;CompilerIf #PB_Compiler_IsMainFile  EnableExplicitCompilerEndIf;;- 1. Language settings;; All Zapman libraries are designed to be integrated into multilingual applications.; It is entirely possible to redefine the 'GetTextFromCatalog()' function in a file; that precedes this one in your 'XIncludeFile' list. That way, you can store the; translations of the texts used in your application's gadgets in your own format.; However, the functions in this section provide a simple and self-contained solution,; and if your language is not included in the list of translated languages, only a few; lines need to be added at the end of this section.;; Translations were generated from the English catalog.;Global MyLanguage$If MyLanguage$ = ""  MyLanguage$ = "EN" ; Supported language codes: "EN", "ES", "ZH", "FR", "DE", "RU", or "IT".EndIf;CompilerIf Not Defined(LanguageListStructure, #PB_Structure)  Structure LanguageListStructure    Language$    LanguageEntry$    LanguageTranslation$  EndStructure  ;  Global NewList LanguageList.LanguageListStructure()CompilerEndIf;CompilerIf Not Defined(GetTextFromCatalog, #PB_Procedure)  Procedure.s GetTextFromCatalog(SName$)    ;    ; Role: Retrieves the localized string matching 'SName$' for the active 'MyLanguage$' code.    ; Output: Localized string if found, or 'SName$' itself as fallback.    ;    ForEach LanguageList()      If LanguageList()\Language$ = MyLanguage$ And LCase(LanguageList()\LanguageEntry$) = LCase(SName$)        ProcedureReturn LanguageList()\LanguageTranslation$      EndIf    Next    ProcedureReturn SName$  EndProcedureCompilerEndIf;CompilerIf Not Defined(FillLanguageList, #PB_Procedure)  Procedure FillLanguageList(Language$, LanguageEntry$, LanguageTranslation$)    ;    ; Role: Populates 'LanguageList()' with comma-separated key/translation pairs for 'Language$'    ;       without overwriting entries that were already registered.    ;    Protected PosInList = 0, KeyWord$, Found    ;    Repeat      PosInList + 1      KeyWord$ = StringField(LanguageEntry$, PosInList, ",")      If KeyWord$ <> ""        Found = 0        ForEach LanguageList()          If LanguageList()\Language$ = Language$ And LCase(LanguageList()\LanguageEntry$) = LCase(KeyWord$)            Found = 1            Break          EndIf        Next        If Found = 0          AddElement(LanguageList())          LanguageList()\Language$            = Language$          LanguageList()\LanguageEntry$       = KeyWord$          LanguageList()\LanguageTranslation$ = StringField(LanguageTranslation$, PosInList, ",")        EndIf      EndIf    Until KeyWord$ = ""  EndProcedureCompilerEndIf;Define LanguageEntry$, LanguageTranslation$;LanguageEntry$ = "SWTitle,SWSearch,SWReplaceTitle,SWReplace,SWReplaceAll,SWCaseSensitive,"LanguageEntry$ + "SWWholeWord,SWInAllDocument,SWUnableToFind,SWReplacementMade,SWSearchFromStart,"LanguageEntry$ + "SWSearchFromEnd,Attention,Quit,Yes,No,OK,Cancel,Save,SaveAs,Copy,CopyAll,TextFile";; ------------- English list of expressions ---------------LanguageTranslation$ = "Search,Search:,Replace with:,Replace,Replace all,Case sensitive,"LanguageTranslation$ + "Whole word,In the entire document,Unable to find,replacement(s) made.,Search from the beginning?,"LanguageTranslation$ + "Search from the end?,Warning,Quit,Yes,No,OK,Cancel,Save,Save as...,Copy,Copy all,Text Files|*.txt"FillLanguageList("EN", LanguageEntry$, LanguageTranslation$);; ------------- Spanish list of expressions ---------------LanguageTranslation$ = "Buscar,Buscar:,Reemplazar por:,Reemplazar,Reemplazar todo,Sensible a mayúsculas,"LanguageTranslation$ + "Palabra completa,En todo el documento,No se pudo encontrar,reemplazo(s) realizado(s).,¿Buscar desde el principio?,"LanguageTranslation$ + "¿Buscar desde el final?,Advertencia,Salir,Sí,No,OK,Cancelar,Guardar,Guardar como...,Copiar,Copiar todo,Archivos de texto|*.txt"FillLanguageList("ES", LanguageEntry$, LanguageTranslation$);; ------------- Mandarin list of expressions --------------LanguageTranslation$ = "搜索,搜索:,替换为:,替换,全部替换,区分大小写,"LanguageTranslation$ + "整词匹配,全文搜索,无法找到,处已替换。,从开头搜索?,"LanguageTranslation$ + "从结尾搜索?,警告,退出,是,否,确定,取消,保存,另存为...,复制,全部复制,文本文件|*.txt"FillLanguageList("ZH", LanguageEntry$, LanguageTranslation$);; ------------- French list of expressions ----------------LanguageTranslation$ = "Rechercher,Chercher :,Remplacer par :,Remplacer,Tout remplacer,Respecter la casse,"LanguageTranslation$ + "Mot entier,Dans tout le document,Impossible de trouver,remplacement(s) effectué(s).,Rechercher depuis le début ?,"LanguageTranslation$ + "Rechercher depuis la fin ?,Attention,Quitter,Oui,Non,OK,Annuler,Enregistrer,Enregistrer sous...,Copier,Tout copier,Fichiers texte|*.txt"FillLanguageList("FR", LanguageEntry$, LanguageTranslation$);; ------------- German list of expressions ----------------LanguageTranslation$ = "Suchen,Suchen:,Ersetzen durch:,Ersetzen,Alle ersetzen,Groß-/Kleinschreibung beachten,"LanguageTranslation$ + "Ganzes Wort,Im gesamten Dokument,Keine Treffer für,Ersetzung(en) vorgenommen.,Von Anfang an suchen?,"LanguageTranslation$ + "Vom Ende her suchen?,Achtung,Beenden,Ja,Nein,OK,Abbrechen,Speichern,Speichern unter...,Kopieren,Alles kopieren,Textdateien|*.txt"FillLanguageList("DE", LanguageEntry$, LanguageTranslation$);; ------------- Russian list of expressions ---------------LanguageTranslation$ = "Найти,Искать:,Заменить на:,Заменить,Заменить всё,Учитывать регистр,"LanguageTranslation$ + "Целое слово,Во всём документе,Не удалось найти,замен(ы) выполнено.,Искать с начала?,"LanguageTranslation$ + "Искать с конца?,Внимание,Выйти,Да,Нет,OK,Отмена,Сохранить,Сохранить как...,Копировать,Копировать всё,Текстовые файлы|*.txt"FillLanguageList("RU", LanguageEntry$, LanguageTranslation$);; ------------- Italian list of expressions ---------------LanguageTranslation$ = "Cerca,Cerca:,Sostituisci con:,Sostituisci,Sostituisci tutto, Maiuscole/minuscole,"LanguageTranslation$ + "Parola intera,Nell'intero documento,Impossibile trovare,sostituzione(i) effettuata(e).,Cerca dall'inizio?,"LanguageTranslation$ + "Cerca dalla fine?,Attenzione,Esci,Sì,No,OK,Annulla,Salva,Salva con nome...,Copia,Copia tutto,File di testo|*.txt"FillLanguageList("IT", LanguageEntry$, LanguageTranslation$);; ------------- Add your own language here --------------; LanguageTranslation$ = "Expression1,Expression2,etc."; FillLanguageList("XX", LanguageEntry$, LanguageTranslation$) ; Replace "XX" with your language code.;; ****************************************************************************;;-                       2. Miscellaneous functions;; ****************************************************************************;Global PBBAllGadgetsFontIf PBBAllGadgetsFont = 0  PBBAllGadgetsFont = FontID(LoadFont(#PB_Any, "Segoe UI", 9))EndIf;CompilerIf Not Defined(CWO_Positioning, #PB_Enumeration)  Enumeration CWO_Positioning    #CWO_ActiveWindowPos = -1    #CWO_AbsolutePos     = -2    #CWO_MonitorPos      = -3  EndEnumerationCompilerEndIf;CompilerIf Not Defined(CWO_PositionAnchor, #PB_Enumeration)  Enumeration CWO_PositionAnchor    #CWO_Center = 0    #CWO_TopLeft    #CWO_TopRight    #CWO_BottomLeft    #CWO_BottomRight  EndEnumerationCompilerEndIf;CompilerIf Not Defined(ComputeWinOrigins, #PB_Procedure)  Procedure ComputeWinOrigins(*OX.Integer, *OY.Integer, WWidth, WHeight, ParentWindow = #CWO_ActiveWindowPos, XShiftOrPos = 0, YShiftOrPos = 0, ParentAnchor = #CWO_Center, WindowAnchor = #CWO_Center)    ;    ; Role: Computes the X and Y logical screen origins for a new window from its client dimensions    ;       (WWidth, WHeight) relative to a parent window or to the target monitor's work area,    ;       clamped so the window stays within visible work-area bounds.    ; Output: Writes computed coordinates to '*OX' and '*OY', and returns the OS HWND of 'ParentWindow'    ;         (or 0 when positioned relative to a monitor or at absolute coordinates).    ;    ; Positioning rules:    ; • If ParentWindow is a valid PureBasic window number, the new window is positioned relative    ;   to it and then shifted by XShiftOrPos and YShiftOrPos.    ; • If ParentWindow = #CWO_ActiveWindowPos and GetActiveWindow() returns a valid window number,    ;   GetActiveWindow() is used as the parent window; otherwise the main monitor is used.    ; • If ParentWindow = #CWO_AbsolutePos, XShiftOrPos and YShiftOrPos are used directly as the    ;   absolute coordinates of the new window.    ; • If ParentWindow = #CWO_MonitorPos, the position is calculated relative to the monitor    ;   containing GetActiveWindow() (or the main monitor if no PureBasic window is active).    ; • 'ParentAnchor' selects the reference point on the parent window or monitor (#CWO_Center,    ;   #CWO_TopLeft, #CWO_TopRight, #CWO_BottomLeft, or #CWO_BottomRight).    ; • 'WindowAnchor' selects the matching anchor point on the new window itself.    ; • In all cases except #CWO_AbsolutePos, 'XShiftOrPos' and 'YShiftOrPos' offset the result.    ;    Protected DesktopLeft, DesktopRight, DesktopTop, DesktopBottom    Protected ParentWindowID, MFWindow, hMonitor, TotalHeight, mi.MONITORINFO    ;    If ParentWindow = #CWO_AbsolutePos      *OX\i = XShiftOrPos      *OY\i = YShiftOrPos      ProcedureReturn 0    EndIf    ;    If ParentWindow = #CWO_ActiveWindowPos And IsWindow(GetActiveWindow())      ParentWindow = GetActiveWindow()    EndIf    ;    ; Retrieve the work-area bounds of the monitor hosting the parent (or active) window:    MFWindow = ParentWindow    If Not IsWindow(MFWindow)      MFWindow = GetActiveWindow()    EndIf    If IsWindow(MFWindow)      MFWindow = WindowID(MFWindow)    Else      MFWindow = 0    EndIf    ;    hMonitor  = MonitorFromWindow_(MFWindow, #MONITOR_DEFAULTTONEAREST)    mi\cbSize = SizeOf(MONITORINFO)    GetMonitorInfo_(hMonitor, @mi)    ;    DesktopLeft   = DesktopUnscaledX(mi\rcWork\left)    DesktopRight  = DesktopUnscaledX(mi\rcWork\right)    DesktopTop    = DesktopUnscaledY(mi\rcWork\top)    DesktopBottom = DesktopUnscaledY(mi\rcWork\bottom)    ;    ; Compute the reference point on the parent window or monitor:    If IsWindow(ParentWindow)      ParentWindowID = WindowID(ParentWindow)      *OX\i = WindowX(ParentWindow)      *OY\i = WindowY(ParentWindow)      ;      If ParentAnchor = #CWO_Center        *OX\i + WindowWidth(ParentWindow) / 2        *OY\i + WindowHeight(ParentWindow) / 2      ElseIf ParentAnchor = #CWO_TopRight        *OX\i + WindowWidth(ParentWindow)      ElseIf ParentAnchor = #CWO_BottomLeft        *OY\i + WindowHeight(ParentWindow)      ElseIf ParentAnchor = #CWO_BottomRight        *OX\i + WindowWidth(ParentWindow)        *OY\i + WindowHeight(ParentWindow)      EndIf    Else      *OX\i = DesktopLeft      *OY\i = DesktopTop      ;      If ParentAnchor = #CWO_Center        *OX\i = (DesktopLeft + DesktopRight) / 2        *OY\i = (DesktopTop + DesktopBottom) / 2      ElseIf ParentAnchor = #CWO_TopRight        *OX\i = DesktopRight      ElseIf ParentAnchor = #CWO_BottomLeft        *OY\i = DesktopBottom      ElseIf ParentAnchor = #CWO_BottomRight        *OX\i = DesktopRight        *OY\i = DesktopBottom      EndIf    EndIf    ;    ; Account for the title bar and horizontal frame borders added by OpenWindow() around WHeight:    TotalHeight = WHeight + DesktopUnscaledY(GetSystemMetrics_(#SM_CYCAPTION) + GetSystemMetrics_(#SM_CYSIZEFRAME) * 2)    If WindowAnchor = #CWO_Center      *OX\i - WWidth / 2      *OY\i - TotalHeight / 2    ElseIf WindowAnchor = #CWO_TopRight      *OX\i - WWidth    ElseIf WindowAnchor = #CWO_BottomLeft      *OY\i - TotalHeight    ElseIf WindowAnchor = #CWO_BottomRight      *OX\i - WWidth      *OY\i - TotalHeight    EndIf    ;    ; Apply caller offset and clamp to the monitor work area (checking right/bottom before left/top    ; so the title bar remains reachable even if the window exceeds small screen dimensions):    *OX\i + XShiftOrPos    *OY\i + YShiftOrPos    If *OX\i + WWidth > DesktopRight      *OX\i = DesktopRight - WWidth - 10    EndIf    If *OX\i < DesktopLeft      *OX\i = DesktopLeft + 10    EndIf    If *OY\i + TotalHeight > DesktopBottom      *OY\i = DesktopBottom - TotalHeight - 10    EndIf    If *OY\i < DesktopTop      *OY\i = DesktopTop + 10    EndIf    ;    ProcedureReturn ParentWindowID  EndProcedureCompilerEndIf;CompilerIf Not Defined(ApplyFontToGadgetList, #PB_Procedure)  Procedure ApplyFontToGadgetList(GadgetList$)    ;    ; Role: Applies the shared UI font 'PBBAllGadgetsFont' to every valid PureBasic gadget ID    ;       listed in the comma-separated 'GadgetList$' string.    ;    Protected PosInGadgetList = 1, Field$, Gadget    ;    Field$ = Trim(StringField(GadgetList$, PosInGadgetList, ","))    While Field$ <> ""      Gadget = Val(Field$)      If IsGadget(Gadget)        SetGadgetFont(Gadget, PBBAllGadgetsFont)      EndIf      PosInGadgetList + 1      Field$ = Trim(StringField(GadgetList$, PosInGadgetList, ","))    Wend  EndProcedureCompilerEndIf;CompilerIf Not Defined(ClearKeyboardBuffer, #PB_Procedure)  Procedure ClearKeyboardBuffer(WindowNum = #PB_Default)    ;    ; Role: Flushes pending PureBasic events and Win32 keyboard messages, and waits until    ;       any currently held keys are released so keystrokes do not leak across modal dialogs.    ;    Protected msg.MSG    Protected Dim keystate.a(255)    Protected i    ;    If WindowNum <> #PB_Default And IsWindow(WindowNum)      While WindowEvent() : Wend    EndIf    While PeekMessage_(@msg, 0, #WM_KEYFIRST, #WM_KEYLAST, #PM_REMOVE)    Wend    ;    GetKeyboardState_(@keystate(0))    For i = 1 To 255      If keystate(i) & $80        While GetAsyncKeyState_(i) & $8000          Delay(1)          While PeekMessage_(@msg, 0, #WM_KEYFIRST, #WM_KEYLAST, #PM_REMOVE)          Wend        Wend      EndIf    Next i  EndProcedureCompilerEndIf;CompilerIf Not Defined(GetTextSurfPix, #PB_Procedure)  Procedure GetTextSurfPix(Gadget, Text$, *Width.Double, *Height.Double)    ;    ; Role: Measures the logical (DPI-unscaled) single-line width and height of 'Text$'    ;       when rendered with the font currently assigned to 'Gadget'.    ;    Protected Font, Image    ;    If *Width  : *Width\d  = 0 : EndIf    If *Height : *Height\d = 0 : EndIf    If IsGadget(Gadget)      Font  = GetGadgetFont(Gadget)      Image = CreateImage(#PB_Any, 1, 1)      If Image        If StartDrawing(ImageOutput(Image))          If Font            DrawingFont(Font)          EndIf          If *Width  : *Width\d  = DesktopUnscaledX(TextWidth(Text$))  : EndIf          If *Height : *Height\d = DesktopUnscaledY(TextHeight(Text$)) : EndIf          StopDrawing()        EndIf        FreeImage(Image)      EndIf    EndIf  EndProcedureCompilerEndIf;CompilerIf Not Defined(GetTextWidthPix, #PB_Procedure)  Procedure.l GetTextWidthPix(Gadget, Text$)    ;    ; Role: Returns the logical (DPI-unscaled) pixel width of 'Text$' rendered in 'Gadget's font.    ;    Protected TWidth.d, THeight.d    ;    GetTextSurfPix(Gadget, Text$, @TWidth, @THeight)    ProcedureReturn Round(TWidth, #PB_Round_Nearest)  EndProcedureCompilerEndIf;;;**************************************************************;-                 3. RichEdit_BasicLibrary;;             Basic functions for EditorGadgets;            mainly collected on PureBasic forums;             and adapted by Zapman - Dec. 2024;;**************************************************************;CompilerIf Not Defined(SF_USECODEPAGE, #PB_Constant)  #SF_USECODEPAGE = $20CompilerEndIfCompilerIf Not Defined(CP_UTF8, #PB_Constant)  #CP_UTF8 = 65001CompilerEndIfCompilerIf Not Defined(EM_FINDTEXTW, #PB_Constant)  #EM_FINDTEXTW = #WM_USER + 123CompilerEndIf;Procedure.l RE_StreamStringOutCallback(*dwCookie.Integer, *pbBuff, cb.l, *pcb.Long)  Protected NewPtr, CurrentSize  ;  ; Role: Win32 EDITSTREAMCALLBACK appending streamed RichEdit chunks into a dynamically grown buffer.  ;       Returns 0 to continue streaming, or 1 on allocation failure to abort #EM_STREAMOUT cleanly.  ;  If *pcb    *pcb\l = 0  EndIf  If cb > 0 And *dwCookie And *pbBuff    ; *dwCookie holds the fixed address of the caller's StrPtr variable, while *dwCookie\i    ; tracks the buffer address across reallocations as chunks arrive.    If *dwCookie\i = 0      NewPtr = AllocateMemory(cb, #PB_Memory_NoClear)      If NewPtr = 0        ProcedureReturn 1      EndIf      CopyMemory(*pbBuff, NewPtr, cb)      *dwCookie\i = NewPtr    Else      CurrentSize = MemorySize(*dwCookie\i)      NewPtr = ReAllocateMemory(*dwCookie\i, CurrentSize + cb, #PB_Memory_NoClear)      If NewPtr = 0        ProcedureReturn 1      EndIf      CopyMemory(*pbBuff, NewPtr + CurrentSize, cb)      *dwCookie\i = NewPtr    EndIf  EndIf  If *pcb    *pcb\l = cb  EndIf  ProcedureReturn 0EndProcedure;Procedure.s RE_GetContent_RTF(Gadget, format = #SF_RTF, UseDirectID = 0)  Protected edstr.EDITSTREAM, StrPtr, Ghdl  Protected Str$  ;  ; Role: Streams out the content of a RichEdit control as RTF (default) or UTF-8 plain text  ;       (when 'format' is 0 or includes #SF_TEXT). Combine with #SFF_SELECTION to restrict  ;       extraction to the current selection, or set 'UseDirectID' to pass an OS HWND directly.  ;  If UseDirectID = 0    Ghdl = GadgetID(Gadget)  Else    Ghdl = Gadget  EndIf  ;  If format = 0 Or (format & #SF_TEXT)    format | (#CP_UTF8 << 16) | #SF_USECODEPAGE | #SF_TEXT  EndIf  ;  StrPtr            = 0  edstr\dwCookie    = @StrPtr  edstr\pfnCallback = @RE_StreamStringOutCallback()  edstr\dwError     = 0  SendMessage_(Ghdl, #EM_STREAMOUT, format, @edstr)  If edstr\dwError    If StrPtr      FreeMemory(StrPtr)    EndIf  ElseIf StrPtr    Str$ = PeekS(StrPtr, MemorySize(StrPtr), #PB_UTF8 | #PB_ByteLength)    FreeMemory(StrPtr)  EndIf  ProcedureReturn Str$EndProcedure;Procedure.s RE_GetGadgetSelectedText(Gadget, format = #SFF_SELECTION | #SF_TEXT)  ;  ; Role: Returns the currently selected text of a RichEdit EditorGadget as a plain string.  ;  ProcedureReturn RE_GetContent_RTF(Gadget, format)EndProcedure;Procedure RE_GetSelection(Gadget, *txtrange.CHARRANGE)  ;  ; Role: Fills '*txtrange' with the start (cpMin) and end (cpMax) character offsets of the current selection.  ;  ProcedureReturn SendMessage_(GadgetID(Gadget), #EM_EXGETSEL, 0, *txtrange)EndProcedure;Procedure RE_SetSelection(Gadget, PosStart, PosEnd)  Protected txtrange.CHARRANGE  ;  ; Role: Selects the character range [PosStart..PosEnd] inside a RichEdit EditorGadget.  ;  txtrange\cpMin = PosStart  txtrange\cpMax = PosEnd  ProcedureReturn SendMessage_(GadgetID(Gadget), #EM_EXSETSEL, 0, @txtrange)EndProcedure;Procedure RE_ReplaceSelection(Gadget, ReplaceString$)  ;  ; Role: Replaces the current RichEdit selection with 'ReplaceString$' (preserving undo capability).  ;  ProcedureReturn SendMessage_(GadgetID(Gadget), #EM_REPLACESEL, 1, @ReplaceString$)EndProcedure;Procedure.s RE_GetGadgetWholeText(Gadget, format = #SF_TEXT)  ;  ; Role: Returns the entire text of a RichEdit EditorGadget as a plain string.  ;  ProcedureReturn RE_GetContent_RTF(Gadget, format)EndProcedure;Procedure RE_SaveContent(Gadget, FileName$, format = #SF_RTF, DelPict = 0)  Protected ct, p, pr, po, pf, hFile, Result  Protected Content$  ;  ; Role: Saves the content of a RichEdit EditorGadget to 'FileName$' in UTF-8 encoding.  ;       Saves RTF data by default ('format' = #SF_RTF), or plain text when 'format' is 0 / #SF_TEXT.  ;       Combine 'format' with #SFF_SELECTION to export only the selected range, and set 'DelPict'  ;       to strip embedded {\pict ...} blocks from RTF output.  ;  Content$ = RE_GetContent_RTF(Gadget, format)  If Content$ <> ""    If format & #SF_RTF      ; Default (-1 / $FFFFFF) foreground entries serialize as white in RTF color tables; remap them to black:      Content$ = ReplaceString(Content$, "\red255\green255\blue255", "\red0\green0\blue0")      ;      If DelPict        ; Strip nested {\pict ...} RTF groups by tracking brace depth:        Repeat          p = FindString(Content$, "{\pict")          If p            ct = 1            pr = p + 5            Repeat              po = FindString(Content$, "{", pr + 1)              pf = FindString(Content$, "}", pr + 1)              If po And (po < pf Or pf = 0)                pr = po                ct + 1              ElseIf pf And (pf < po Or po = 0)                pr = pf                ct - 1              EndIf            Until ct = 0 Or (po = 0 And pf = 0)            If pr              pr + 1              While Mid(Content$, pr, 1) = " " : pr + 1 : Wend              While p > 1 And Mid(Content$, p - 1, 1) = " " : p - 1 : Wend              Content$ = Left(Content$, p - 1) + Mid(Content$, pr)            Else              Break            EndIf          EndIf        Until p = 0      EndIf      Content$ = Trim(Content$)    EndIf    ;    hFile = CreateFile(#PB_Any, FileName$)    If hFile      Result = WriteString(hFile, Content$)      CloseFile(hFile)    EndIf  EndIf  ProcedureReturn ResultEndProcedure;Procedure RE_AdjustZoom(NoGadget, AdjFactor)  Protected num.l, denom.l, Factor.f  ;  ; Role: Adjusts the zoom level of a RichEdit EditorGadget by 'AdjFactor' percent  ;       (pass 0 to reset zoom to 100%, or e.g. +10 / -10 for relative scaling).  ;  SendMessage_(GadgetID(NoGadget), #EM_GETZOOM, @num, @denom)  If num > 0 And denom > 0    Factor = num / denom  Else    Factor = 1.0  EndIf  ;  If AdjFactor    Factor * (AdjFactor + 100.0) / 100.0  Else    Factor = 1.0  EndIf  ;  ; RichEdit #EM_SETZOOM requires 1/64 < (num / denom) < 64; using denom = 100 preserves 1% granularity:  denom = 100  num   = Round(denom * Factor, #PB_Round_Nearest)  If num < 2    num = 2  ElseIf num > 6399    num = 6399  EndIf  SendMessage_(GadgetID(NoGadget), #EM_SETZOOM, num, denom)EndProcedure;Procedure RE_SearchString(Gadget, SearchString$, MATCHCASE = 0, WHOLEWORD = 0, UP = 0, startPos = -2)  Protected OrigSel.CHARRANGE, EndRange.CHARRANGE, text.FINDTEXT  Protected SearchOrigin, flg, Res  ;  ; Role: Searches 'SearchString$' inside the RichEdit EditorGadget 'Gadget' after the current selection  ;       (or before it when 'UP' <> 0), or starting from 'startPos' when 'startPos' <> -2.  ; Output:  ;   >= 0 : Character offset of the match (which is automatically selected in 'Gadget').  ;   -2   : Not found in the scanned direction, but unsearched text remains on the other side of the origin.  ;   -1   : Not found anywhere in the document (or 'SearchString$' is empty).  ;  If SearchString$ = ""    ProcedureReturn -1  EndIf  ;  If startPos <> -2    RE_SetSelection(Gadget, startPos, startPos)  EndIf  RE_GetSelection(Gadget, @OrigSel)  text\chrg = OrigSel  ;  If text\chrg\cpMin <> text\chrg\cpMax    ; Advance past the active selection when searching downward; upward search already starts from cpMin:    If UP = 0      text\chrg\cpMin = text\chrg\cpMax    EndIf  EndIf  SearchOrigin    = text\chrg\cpMin  text\chrg\cpMax = -1  text\lpstrText  = @SearchString$  ;  flg = 0  If MATCHCASE : flg | #FR_MATCHCASE : EndIf  If WHOLEWORD : flg | #FR_WHOLEWORD : EndIf  If UP = 0    : flg | #FR_DOWN      : EndIf  ;  Res = SendMessage_(GadgetID(Gadget), #EM_FINDTEXTW, flg, @text)  If Res > -1    RE_SetSelection(Gadget, Res, Res + Len(SearchString$))  Else    ; Determine whether wrapping around from the start or end could still find a match:    If UP = 0      If SearchOrigin > 0        Res = -2      EndIf    Else      RE_SetSelection(Gadget, -1, -1)      RE_GetSelection(Gadget, @EndRange)      If SearchOrigin < EndRange\cpMax        Res = -2      EndIf      RE_SetSelection(Gadget, OrigSel\cpMin, OrigSel\cpMax)    EndIf  EndIf  ProcedureReturn ResEndProcedure; Enumeration REFR_ShortCuts  #REFRShortCut_Quit = 50100  #REFRShortCut_Search  #REFRShortCut_TabEndEnumeration;Procedure RE_FindReplace(Gadget, Replace = 0, ParentID = #PB_Default, XShiftOrPos = #PB_Default, YShiftOrPos = #PB_Default, ParentAnchor = #CWO_Center, WindowAnchor = #CWO_Center)  Protected txtrange.CHARRANGE  Protected SelectedText$, GadgetList$, find$, repl$, msg$  Protected ParentWindow = #PB_Default, ActiveWindow, ParentWindowID, FRWindow  Protected ParentHasBeenDisabled = #False  Protected WParam, WWidth, WHeight, OX, OY, VPos  Protected TG1, TG2, SearchStringGadget, ReplaceStringGadget  Protected BPrevious, BNext, BReplace, BReplaceAll, BQuit, chk1, chk2, chk3  Protected Event, EvGadget, EvType, DoSearch, RewindSearch, HasQuery  Protected Pos, StartPos, PassCount, KeepSearching, NbReplace  ;  ; Role: Opens a modal Find (or Find/Replace when 'Replace' <> 0) dialog operating on the  ;       RichEdit EditorGadget 'Gadget'.  ;  ; Positioning parameters (ParentID, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor):  ; • Follow the exact same rules as ComputeWinOrigins() (defaults to an offset of +400, +100  ;   relative to the active/parent window so the dialog does not cover the edited text).  ;  If Not IsGadget(Gadget)    ProcedureReturn  EndIf  ;  If IsWindow(ParentID)    ParentWindow = ParentID  ElseIf ParentID > 0 And IsWindow_(ParentID)    ParentWindow = GetProp_(ParentID, "PB_WindowID") - 1    If Not IsWindow(ParentWindow)      ParentWindow = #CWO_ActiveWindowPos    EndIf  ElseIf ParentID = #PB_Default    If IsWindow(GetActiveWindow())      ParentWindow = GetActiveWindow()    Else      ParentWindow = #CWO_ActiveWindowPos    EndIf  Else    ParentWindow = ParentID  EndIf  ;  WWidth = 510  If Replace    WHeight = 160  Else    WHeight = 120  EndIf  If XShiftOrPos = #PB_Default    XShiftOrPos = 400  EndIf  If YShiftOrPos = #PB_Default    YShiftOrPos = 100  EndIf  ;  ActiveWindow = ParentWindow  If Not IsWindow(ActiveWindow)    ActiveWindow = GetActiveWindow()  EndIf  ;  WParam         = #PB_Window_Invisible | #PB_Window_SystemMenu  ParentWindowID = ComputeWinOrigins(@OX, @OY, WWidth, WHeight, ParentWindow, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor)  FRWindow       = OpenWindow(#PB_Any, OX, OY, WWidth, WHeight, GetTextFromCatalog("SWTitle"), WParam, ParentWindowID)  If FRWindow    If IsWindow(ActiveWindow) And IsWindowEnabled_(WindowID(ActiveWindow))      DisableWindow(ActiveWindow, #True)      ParentHasBeenDisabled = #True    EndIf    ;    CompilerIf Defined(ApplyDarkModeToWindow, #PB_Procedure)      ApplyDarkModeToWindow(FRWindow)    CompilerEndIf    StickyWindow(FRWindow, #True)    ;    TG1 = TextGadget(#PB_Any, 10, 20, 100, 22, GetTextFromCatalog("SWSearch"))    GadgetList$ + Str(TG1) + ","    SearchStringGadget = StringGadget(#PB_Any, 100, 15, 300, 25, "")    GadgetList$ + Str(SearchStringGadget) + ","    BPrevious = ButtonGadget(#PB_Any, 410, 15, 35, 26, "<<")    GadgetList$ + Str(BPrevious) + ","    DisableGadget(BPrevious, #True)    BNext = ButtonGadget(#PB_Any, 465, 15, 35, 26, ">>", #PB_Button_Default)    GadgetList$ + Str(BNext) + ","    DisableGadget(BNext, #True)    ;    If Replace      VPos = 55      TG2  = TextGadget(#PB_Any, 10, VPos, 100, 22, GetTextFromCatalog("SWReplaceTitle"))      GadgetList$ + Str(TG2) + ","      ReplaceStringGadget = StringGadget(#PB_Any, 100, VPos - 5, 300, 25, "")      GadgetList$ + Str(ReplaceStringGadget) + ","      BReplace = ButtonGadget(#PB_Any, 410, VPos - 5, 90, 26, GetTextFromCatalog("SWReplace"))      GadgetList$ + Str(BReplace) + ","      DisableGadget(BReplace, #True)      BReplaceAll = ButtonGadget(#PB_Any, 410, VPos + 30, 90, 26, GetTextFromCatalog("SWReplaceAll"))      GadgetList$ + Str(BReplaceAll) + ","      DisableGadget(BReplaceAll, #True)    EndIf    ;    BQuit = ButtonGadget(#PB_Any, 410, WindowHeight(FRWindow) - 33, 90, 26, GetTextFromCatalog("Quit"))    GadgetList$ + Str(BQuit) + ","    ;    VPos = 85    If Replace = 0      VPos - 40    EndIf    chk1 = CheckBoxGadget(#PB_Any, 10, VPos, 135, 26, GetTextFromCatalog("SWCaseSensitive"))    GadgetList$ + Str(chk1) + ","    chk2 = CheckBoxGadget(#PB_Any, 155, VPos, 100, 26, GetTextFromCatalog("SWWholeWord"))    GadgetList$ + Str(chk2) + ","    If Replace      chk3 = CheckBoxGadget(#PB_Any, 255, VPos, 150, 26, GetTextFromCatalog("SWInAllDocument"))      GadgetList$ + Str(chk3) + ","    EndIf    ;    ; Keep highlighted matches visible in the target RichEdit while FRWindow holds the focus:    SendMessage_(GadgetID(Gadget), #EM_HIDESELECTION, #False, 0)    ;    ; Pre-populate the search box when a short selection already exists in the RichEdit:    SelectedText$ = RE_GetContent_RTF(Gadget, #SFF_SELECTION | #SF_TEXT)    If SelectedText$ <> "" And Len(SelectedText$) < 128      SetGadgetText(SearchStringGadget, SelectedText$)      DisableGadget(BPrevious, #False)      DisableGadget(BNext,     #False)      If Replace        DisableGadget(BReplace,    #False)        DisableGadget(BReplaceAll, #False)        SetActiveGadget(ReplaceStringGadget)      Else        SetActiveGadget(SearchStringGadget)        SendMessage_(GadgetID(SearchStringGadget), #EM_SETSEL, 0, -1)      EndIf    Else      SetActiveGadget(SearchStringGadget)    EndIf    ;    AddKeyboardShortcut(FRWindow, #PB_Shortcut_Return, #REFRShortCut_Search)    AddKeyboardShortcut(FRWindow, #PB_Shortcut_Escape, #REFRShortCut_Quit)    AddKeyboardShortcut(FRWindow, #PB_Shortcut_Tab,    #REFRShortCut_Tab)    ;    ApplyFontToGadgetList(GadgetList$)    ;    CompilerIf Defined(SetGadgetsColorsFromTheme, #PB_Procedure)      ; Apply active theme colors when 'ApplyColorThemes.pbi' is included before 'Alert.pbi':      If ListSize(InterfaceColorPresets()) > 0        SetGadgetsColorsFromTheme(FRWindow, InterfaceColorPresets(), GadgetList$)      EndIf    CompilerEndIf    ;    HideWindow(FRWindow, #False)    ;    Repeat      Event    = WaitWindowEvent()      DoSearch = 0      If EventWindow() <> FRWindow        If Event = #PB_Event_ActivateWindow Or Event = #PB_Event_LeftClick          SetActiveWindow(FRWindow)        EndIf        Continue      EndIf      ;      EvGadget = EventGadget()      EvType   = EventType()      If Event = #PB_Event_Menu        Select EventMenu()          Case #REFRShortCut_Tab            If GetActiveGadget() = SearchStringGadget And IsGadget(ReplaceStringGadget)              SetActiveGadget(ReplaceStringGadget)              SendMessage_(GadgetID(ReplaceStringGadget), #EM_SETSEL, 0, -1)            ElseIf IsGadget(ReplaceStringGadget) And GetActiveGadget() = ReplaceStringGadget              SetActiveGadget(SearchStringGadget)              SendMessage_(GadgetID(SearchStringGadget), #EM_SETSEL, 0, -1)            EndIf          Case #REFRShortCut_Search            If GetGadgetText(SearchStringGadget) <> ""              DoSearch = 1              Event    = #PB_Event_Gadget              EvGadget = BNext            EndIf          Case #REFRShortCut_Quit            Break        EndSelect      ElseIf Event = #PB_Event_CloseWindow        Break      EndIf      ;      If Event = #PB_Event_Gadget        If EvGadget = BQuit          Break        ElseIf EvGadget = SearchStringGadget          If EvType = #PB_EventType_Change            HasQuery = Bool(GetGadgetText(SearchStringGadget) <> "")            DisableGadget(BPrevious, Bool(HasQuery = 0))            DisableGadget(BNext,     Bool(HasQuery = 0))            If Replace              DisableGadget(BReplace,    Bool(HasQuery = 0))              DisableGadget(BReplaceAll, Bool(HasQuery = 0))            EndIf          ElseIf EvType = #PB_EventType_Focus            SendMessage_(GadgetID(SearchStringGadget), #EM_SETSEL, 0, -1)          EndIf        ElseIf Replace And EvGadget = ReplaceStringGadget          If EvType = #PB_EventType_Focus            SendMessage_(GadgetID(ReplaceStringGadget), #EM_SETSEL, 0, -1)          EndIf        ElseIf DoSearch Or EvGadget = BNext Or EvGadget = BPrevious Or (Replace And (EvGadget = BReplace Or EvGadget = BReplaceAll))          find$ = GetGadgetText(SearchStringGadget)          If find$ <> ""            If Replace And (EvGadget = BReplace Or EvGadget = BReplaceAll)              ; Collapse any active selection to its start so RE_SearchString() matches the currently highlighted occurrence first:              RE_GetSelection(Gadget, @txtrange)              If txtrange\cpMin <> txtrange\cpMax                RE_SetSelection(Gadget, txtrange\cpMin, txtrange\cpMin)              EndIf            EndIf            ;            RewindSearch = Bool(EvGadget = BPrevious)            StartPos     = -2            If IsGadget(chk3) And GetGadgetState(chk3)              SetGadgetState(chk3, 0)              If RewindSearch : StartPos = -1 : Else : StartPos = 0 : EndIf            EndIf            ;            PassCount = 0            NbReplace = 0            Repeat              KeepSearching = #False              PassCount + 1              Repeat                Pos = RE_SearchString(Gadget, find$, GetGadgetState(chk1), GetGadgetState(chk2), RewindSearch, StartPos)                StartPos = -2                If Replace And Pos > -1 And (EvGadget = BReplace Or EvGadget = BReplaceAll)                  repl$ = GetGadgetText(ReplaceStringGadget)                  RE_ReplaceSelection(Gadget, repl$)                  RE_GetSelection(Gadget, @txtrange)                  txtrange\cpMin = txtrange\cpMax - Len(repl$)                  ; Advance past the replacement during ReplaceAll or when repl$ contains find$ to prevent re-matching:                  If EvGadget = BReplaceAll Or FindString(repl$, find$, 1)                    txtrange\cpMin = txtrange\cpMax                  EndIf                  RE_SetSelection(Gadget, txtrange\cpMin, txtrange\cpMax)                  NbReplace + 1                EndIf              Until EvGadget <> BReplaceAll Or Pos < 0 Or Replace = 0              ;              ; Offer a single wrap-around pass when unsearched text remains before/after the starting cursor:              If Pos = -2 And PassCount = 1                If NbReplace > 0 And EvGadget = BReplaceAll                  msg$ = Str(NbReplace) + " " + GetTextFromCatalog("SWReplacementMade") + #CRLF$                ElseIf NbReplace = 0                  msg$ = GetTextFromCatalog("SWUnableToFind") + " " + find$ + #CRLF$                Else                  msg$ = ""                EndIf                If RewindSearch                  msg$ + GetTextFromCatalog("SWSearchFromEnd")                  StartPos = -1                Else                  msg$ + GetTextFromCatalog("SWSearchFromStart")                  StartPos = 0                EndIf                If MessageRequester(GetTextFromCatalog("SWTitle"), msg$, #PB_MessageRequester_YesNo) = #PB_MessageRequester_Yes                  KeepSearching = #True                EndIf              EndIf            Until KeepSearching = #False            ;            msg$ = ""            If Replace And EvGadget = BReplaceAll              msg$ = Str(NbReplace) + " " + GetTextFromCatalog("SWReplacementMade")            ElseIf Pos = -1              msg$ = GetTextFromCatalog("SWUnableToFind") + " " + find$            EndIf            If msg$ <> ""              MessageRequester(GetTextFromCatalog("SWTitle"), msg$, #PB_MessageRequester_Ok)            EndIf          EndIf        EndIf      EndIf    ForEver    ;    CloseWindow(FRWindow)    If ParentHasBeenDisabled And IsWindow(ActiveWindow)      DisableWindow(ActiveWindow, #False)    EndIf  EndIfEndProcedure;;*************************************************;;-                4. Alert library;;*************************************************;CompilerIf Not Defined(ENM_REQUESTRESIZE, #PB_Constant)  #ENM_REQUESTRESIZE = $00040000CompilerEndIfCompilerIf Not Defined(EN_REQUESTRESIZE, #PB_Constant)  #EN_REQUESTRESIZE = $0701CompilerEndIfCompilerIf Not Defined(EM_REQUESTRESIZE, #PB_Constant)  #EM_REQUESTRESIZE = #WM_USER + 65CompilerEndIf;Structure AW_REQRESIZE  hwndFrom.i  idFrom.i  code.l  CompilerIf #PB_Compiler_Processor = #PB_Processor_x64    AlignmentPad.l  CompilerEndIf  rc.RECTEndStructure;Structure AW_MemoryStreamState  *Buffer  TotalBytes.i  Offset.iEndStructure;Structure AlertWindowGList  WindowNum.i  Margins.i  BHeight.i  BWidth.i  CopyMenu.i  MeasuredREHeight.i  SizingOldProc.i  ;  RE_gadget.i  YesNoCancel.i  BOK.i  BCancel.i  BYes.i  BNo.i  BSearch.i  BCopy.i  BSave.iEndStructure;Enumeration AlertYesNoCancel  #AW_AlertOnly  #AW_YesOrNo_YesByDefault  #AW_YesOrNo_NoByDefault  #AW_OKOrCancel_OKByDefault  #AW_OKOrCancel_CancelByDefault  #AW_YesNoOrCancel_YesByDefault  #AW_YesNoOrCancel_NoByDefault  #AW_YesNoOrCancel_CancelByDefaultEndEnumeration;Enumeration AlertWShortcuts  #AW_Shortcut_Quit = 44250  #AW_Shortcut_DefButton  #AW_Shortcut_Search  #AW_Shortcut_Save  #AW_MenuCopy  #AW_MenuCopyAllEndEnumeration;#RTF_Marker = 23675;Global AlertGList.AlertWindowGList;Procedure.l AW_StreamInCallback(*State.AW_MemoryStreamState, *pbBuff, cb.l, *pcb.Long)  Protected Remaining  ;  ; Role: Win32 EDITSTREAMCALLBACK feeding an in-memory RTF byte buffer into RichEdit via #EM_STREAMIN.  ;  If *pcb    *pcb\l = 0  EndIf  If *State And *pbBuff And cb > 0    Remaining = *State\TotalBytes - *State\Offset    If Remaining > cb      Remaining = cb    EndIf    If Remaining > 0      CopyMemory(*State\Buffer + *State\Offset, *pbBuff, Remaining)      *State\Offset + Remaining      If *pcb        *pcb\l = Remaining      EndIf    EndIf  EndIf  ProcedureReturn 0EndProcedure;Procedure AW_SizingNotifyCallback(hWnd, uMsg, wParam, lParam)  Protected *req.AW_REQRESIZE  ;  ; Role: Temporary window subclass callback capturing RichEdit #EN_REQUESTRESIZE notifications  ;       to obtain exact pixel heights during initial automatic window sizing.  ;  If uMsg = #WM_NOTIFY And lParam    *req = lParam    If *req\code = #EN_REQUESTRESIZE And IsGadget(AlertGList\RE_gadget) And *req\hwndFrom = GadgetID(AlertGList\RE_gadget)      AlertGList\MeasuredREHeight = DesktopUnscaledY(*req\rc\bottom - *req\rc\top)    EndIf  EndIf  If AlertGList\SizingOldProc    ProcedureReturn CallWindowProc_(AlertGList\SizingOldProc, hWnd, uMsg, wParam, lParam)  EndIf  ProcedureReturn DefWindowProc_(hWnd, uMsg, wParam, lParam)EndProcedure;Procedure AW_MeasureRichEditHeight(LogicalWidth)  ;  ; Role: Queries RichEdit for the exact logical height required to render its entire content  ;       at 'LogicalWidth' (using a tall temporary height so no vertical scrollbar steals width).  ;  If LogicalWidth < 40    LogicalWidth = 40  EndIf  AlertGList\MeasuredREHeight = 0  ResizeGadget(AlertGList\RE_gadget, AlertGList\Margins, AlertGList\Margins, LogicalWidth, 4000)  SendMessage_(GadgetID(AlertGList\RE_gadget), #EM_REQUESTRESIZE, 0, 0)  If AlertGList\MeasuredREHeight <= 0    AlertGList\MeasuredREHeight = 24  EndIf  ProcedureReturn AlertGList\MeasuredREHeightEndProcedure;Procedure ResizeAlertWindow()  Protected WWidth, WHeight, Margins, LowBPos, YesNoCancel  ;  ; Role: Repositions the RichEdit area and action buttons whenever the Alert window is resized,  ;       placing the default button in the rightmost slot and hiding utility buttons on narrow widths.  ;  WWidth      = WindowWidth(AlertGList\WindowNum)  WHeight     = WindowHeight(AlertGList\WindowNum)  Margins     = AlertGList\Margins  LowBPos     = WHeight - AlertGList\BHeight - Margins  YesNoCancel = AlertGList\YesNoCancel  ;  ResizeGadget(AlertGList\RE_gadget, #PB_Ignore, #PB_Ignore, WWidth - Margins * 2, WHeight - AlertGList\BHeight - Margins * 3)  ;  ; Rightmost button slot (default action):  If IsGadget(AlertGList\BOK) And (YesNoCancel = #AW_AlertOnly Or YesNoCancel = #AW_OKOrCancel_OKByDefault)    ResizeGadget(AlertGList\BOK, WWidth - AlertGList\BWidth - Margins, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  If IsGadget(AlertGList\BYes) And (YesNoCancel = #AW_YesOrNo_YesByDefault Or YesNoCancel = #AW_YesNoOrCancel_YesByDefault)    ResizeGadget(AlertGList\BYes, WWidth - AlertGList\BWidth - Margins, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  If IsGadget(AlertGList\BNo) And (YesNoCancel = #AW_YesOrNo_NoByDefault Or YesNoCancel = #AW_YesNoOrCancel_NoByDefault)    ResizeGadget(AlertGList\BNo, WWidth - AlertGList\BWidth - Margins, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  If IsGadget(AlertGList\BCancel) And (YesNoCancel = #AW_OKOrCancel_CancelByDefault Or YesNoCancel = #AW_YesNoOrCancel_CancelByDefault)    ResizeGadget(AlertGList\BCancel, WWidth - AlertGList\BWidth - Margins, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  ;  ; Second button slot from the right:  If IsGadget(AlertGList\BOK) And YesNoCancel = #AW_OKOrCancel_CancelByDefault    ResizeGadget(AlertGList\BOK, WWidth - (AlertGList\BWidth + Margins) * 2, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  If IsGadget(AlertGList\BYes) And (YesNoCancel = #AW_YesOrNo_NoByDefault Or YesNoCancel = #AW_YesNoOrCancel_NoByDefault)    ResizeGadget(AlertGList\BYes, WWidth - (AlertGList\BWidth + Margins) * 2, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  If IsGadget(AlertGList\BNo) And (YesNoCancel = #AW_YesOrNo_YesByDefault Or YesNoCancel = #AW_YesNoOrCancel_YesByDefault Or YesNoCancel = #AW_YesNoOrCancel_CancelByDefault)    ResizeGadget(AlertGList\BNo, WWidth - (AlertGList\BWidth + Margins) * 2, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  If IsGadget(AlertGList\BCancel) And YesNoCancel = #AW_OKOrCancel_OKByDefault    ResizeGadget(AlertGList\BCancel, WWidth - (AlertGList\BWidth + Margins) * 2, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  ;  ; Third button slot from the right:  If IsGadget(AlertGList\BYes) And YesNoCancel = #AW_YesNoOrCancel_CancelByDefault    ResizeGadget(AlertGList\BYes, WWidth - (AlertGList\BWidth + Margins) * 3, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  If IsGadget(AlertGList\BCancel) And (YesNoCancel = #AW_YesNoOrCancel_YesByDefault Or YesNoCancel = #AW_YesNoOrCancel_NoByDefault)    ResizeGadget(AlertGList\BCancel, WWidth - (AlertGList\BWidth + Margins) * 3, LowBPos, #PB_Ignore, #PB_Ignore)  EndIf  ;  ; Utility buttons (Copy, Save, Search) available in #AW_AlertOnly mode:  If IsGadget(AlertGList\BCopy) And YesNoCancel = #AW_AlertOnly    ResizeGadget(AlertGList\BCopy,   WWidth - (AlertGList\BWidth + Margins) * 2, LowBPos, #PB_Ignore, #PB_Ignore)    ResizeGadget(AlertGList\BSave,   WWidth - (AlertGList\BWidth + Margins) * 3, LowBPos, #PB_Ignore, #PB_Ignore)    ResizeGadget(AlertGList\BSearch, WWidth - (AlertGList\BWidth + Margins) * 4, LowBPos, #PB_Ignore, #PB_Ignore)    ;    If WWidth < (AlertGList\BWidth + Margins) * 3 + Margins      HideGadget(AlertGList\BCopy,   #True)      HideGadget(AlertGList\BSave,   #True)      HideGadget(AlertGList\BSearch, #True)    ElseIf WWidth < (AlertGList\BWidth + Margins) * 4 + Margins      HideGadget(AlertGList\BCopy,   #False)      HideGadget(AlertGList\BSave,   #False)      HideGadget(AlertGList\BSearch, #True)    Else      HideGadget(AlertGList\BCopy, #False)      HideGadget(AlertGList\BSave, #False)      ; Only display the Search button when the text display surface reaches 160,000 square pixels:      If (GadgetWidth(AlertGList\RE_gadget) * GadgetHeight(AlertGList\RE_gadget)) < 160000        HideGadget(AlertGList\BSearch, #True)      Else        HideGadget(AlertGList\BSearch, #False)      EndIf    EndIf  EndIfEndProcedure;Procedure THG(EventGadget, Gadget)  ;  ; Role: Safely checks whether 'EventGadget' matches an optional gadget slot that was instantiated.  ;  If IsGadget(Gadget) And EventGadget = Gadget    ProcedureReturn #True  EndIf  ProcedureReturn #FalseEndProcedure;Procedure AW_CopyToClipboard(Gadget, SelectionOnly = #False)  Protected PlainText$, RTFText$  Protected FormatFlags, cfRTF, hOwner, UniBytes, hMemUni, *pMem, *utf8RTF, RTFBytes, hMemRTF  ;  ; Role: Places both Unicode plain text (#CF_UNICODETEXT) and formatted Rich Text ("Rich Text Format")  ;       into the Windows clipboard simultaneously so rich editors (Word, Outlook) preserve fonts and  ;       colors while code/text editors paste clean plain text.  ;  If Not IsGadget(Gadget)    ProcedureReturn #False  EndIf  ;  FormatFlags = 0  If SelectionOnly    FormatFlags = #SFF_SELECTION  EndIf  ;  PlainText$ = RE_GetContent_RTF(Gadget, #SF_TEXT | FormatFlags)  RTFText$   = RE_GetContent_RTF(Gadget, #SF_RTF | FormatFlags)  If PlainText$ = "" And RTFText$ = ""    ProcedureReturn #False  EndIf  ;  ; Normalize standalone CR line breaks from RichEdit into standard Windows CRLF sequences for plain-text targets:  PlainText$ = ReplaceString(ReplaceString(PlainText$, #CRLF$, #LF$), #CR$, #LF$)  PlainText$ = ReplaceString(PlainText$, #LF$, #CRLF$)  ;  ; Remap default (-1 / $FFFFFF) foreground entries serialized as white in RTF color tables back to black:  RTFText$ = ReplaceString(RTFText$, "\red255\green255\blue255", "\red0\green0\blue0")  ;  hOwner = GetParent_(GadgetID(Gadget))  If OpenClipboard_(hOwner)    EmptyClipboard_()    ;    ; 1. Deposit UTF-16 plain text (#CF_UNICODETEXT); Windows assumes ownership of hMemUni once SetClipboardData_ succeeds:    If PlainText$ <> ""      UniBytes = StringByteLength(PlainText$, #PB_Unicode) + SizeOf(Character)      hMemUni  = GlobalAlloc_(#GMEM_MOVEABLE, UniBytes)      If hMemUni        *pMem = GlobalLock_(hMemUni)        If *pMem          PokeS(*pMem, PlainText$, -1, #PB_Unicode)          GlobalUnlock_(hMemUni)          If SetClipboardData_(#CF_UNICODETEXT, hMemUni) = 0            GlobalFree_(hMemUni)          EndIf        Else          GlobalFree_(hMemUni)        EndIf      EndIf    EndIf    ;    ; 2. Deposit 8-bit null-terminated RTF stream ("Rich Text Format") for Word and RTF-aware applications:    cfRTF = RegisterClipboardFormat_("Rich Text Format")    If cfRTF And RTFText$ <> ""      *utf8RTF = UTF8(RTFText$)      If *utf8RTF        RTFBytes = MemorySize(*utf8RTF)        hMemRTF  = GlobalAlloc_(#GMEM_MOVEABLE, RTFBytes)        If hMemRTF          *pMem = GlobalLock_(hMemRTF)          If *pMem            CopyMemory(*utf8RTF, *pMem, RTFBytes)            GlobalUnlock_(hMemRTF)            If SetClipboardData_(cfRTF, hMemRTF) = 0              GlobalFree_(hMemRTF)            EndIf          Else            GlobalFree_(hMemRTF)          EndIf        EndIf        FreeMemory(*utf8RTF)      EndIf    EndIf    ;    CloseClipboard_()    ProcedureReturn #True  EndIf  ProcedureReturn #FalseEndProcedure;Procedure Alert(Message$, WindowTitle$ = "", WSticky = 1, WhiteBackGround = 0, Txtleft = 0, FixedWidth = 0, TabList$ = "", YesNoCancel = #AW_AlertOnly, ParentID = #PB_Default, XShiftOrPos = 0, YShiftOrPos = 0, ParentAnchor = #CWO_Center, WindowAnchor = #CWO_Center)  Protected mi.MONITORINFO, edIn.EDITSTREAM, StreamState.AW_MemoryStreamState  Protected format.PARAFORMAT, paraFormat.PARAFORMAT2  Protected GadgetList$, NFile$, SavePattern$  Protected ParentWindow = #PB_Default, ActiveWindow, ParentWindowID  Protected ParentHasBeenDisabled = #False  Protected WParam, WWidth, WHeight, OX, OY, RTF, hMonitor, hRE  Protected BoundWidthMin, BoundHeightMin, BoundWidthMax, BoundHeightMax, MinButtonsCount  Protected TabCount, *tabStops, PosInList, *utf8Buf, BDefault, *GadgetAdress  Protected MaxReadW, ChromeH, LowW, HighW, MidW, ReqTextH, ReqWinH, TargetRatio.d  Protected EventID, EventGadget, SaveAsRTF, QuitAll = 0  ;  ; Role: Displays 'Message$' (plain text or RTF) in a resizable modal dialog whose width and height  ;       automatically adapt to the content—from compact landscape prompts for short questions up to  ;       tall 800-px reading windows for long documentation—with Copy, Save, and Search utilities.  ;  ; Entry parameters:  ; • WhiteBackGround : Non-zero uses the standard white RichEdit background instead of pale yellow ($F0FDFD).  ; • Txtleft         : Non-zero forces left alignment even on short plain-text messages.  ; • FixedWidth      : Non-zero locks the initial window width to 'FixedWidth' logical pixels.  ; • TabList$        : Optional comma-separated tab-stop positions ("pos1,pos2,pos3").  ; • YesNoCancel     : Value from 'AlertYesNoCancel' selecting OK, Yes/No, OK/Cancel, or Yes/No/Cancel buttons.  ; • ParentID, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor : Follow ComputeWinOrigins() rules.  ;  ; Return value:  ; • #PB_MessageRequester_Yes (for OK / Yes), #PB_MessageRequester_No, or #PB_MessageRequester_Cancel.  ;  If Message$ = ""    ProcedureReturn 0  EndIf  If WindowTitle$ = ""    WindowTitle$ = GetTextFromCatalog("Attention")  EndIf  ;  If IsWindow(ParentID)    ParentWindow = ParentID  ElseIf ParentID > 0 And IsWindow_(ParentID)    ParentWindow = GetProp_(ParentID, "PB_WindowID") - 1    If Not IsWindow(ParentWindow)      ParentWindow = #CWO_ActiveWindowPos    EndIf  ElseIf ParentID = #PB_Default    If IsWindow(GetActiveWindow())      ParentWindow = GetActiveWindow()    Else      ParentWindow = #CWO_ActiveWindowPos    EndIf  Else    ParentWindow = ParentID  EndIf  ;  If PeekC(@Message$) = #RTF_Marker    ; Raw byte-packed UTF-8/ANSI RTF buffer loaded directly into memory:    RTF = 1  ElseIf LCase(Left(Message$, 5)) = "{\rtf" Or LCase(Left(Message$, 6)) = "{\urtf"    ; Standard PureBasic Unicode string containing RTF markup:    RTF = 2  Else    RTF = 0  EndIf  ;  AlertGList\BHeight     = 24  AlertGList\BWidth      = 90  AlertGList\Margins     = 8  AlertGList\CopyMenu    = #PB_Ignore  AlertGList\YesNoCancel = YesNoCancel  AlertGList\BOK         = #PB_Ignore  AlertGList\BCancel     = #PB_Ignore  AlertGList\BYes        = #PB_Ignore  AlertGList\BNo         = #PB_Ignore  AlertGList\BSearch     = #PB_Ignore  AlertGList\BCopy       = #PB_Ignore  AlertGList\BSave       = #PB_Ignore  ;  ; Ensure minimum width always accommodates all active decision buttons without clipping on the left:  If YesNoCancel >= #AW_YesNoOrCancel_YesByDefault    MinButtonsCount = 3  ElseIf YesNoCancel >= #AW_YesOrNo_YesByDefault    MinButtonsCount = 2  Else    MinButtonsCount = 1  EndIf  BoundWidthMin = (AlertGList\BWidth + AlertGList\Margins) * MinButtonsCount + AlertGList\Margins  If BoundWidthMin < 250    BoundWidthMin = 250  EndIf  BoundHeightMin = 100  ;  If FixedWidth > 0    WWidth = FixedWidth    If BoundWidthMin > WWidth      BoundWidthMin = WWidth    EndIf  Else    WWidth = BoundWidthMin  EndIf  WHeight = BoundHeightMin  ;  ActiveWindow = ParentWindow  If Not IsWindow(ActiveWindow)    ActiveWindow = GetActiveWindow()  EndIf  ;  WParam               = #PB_Window_Invisible | #PB_Window_MinimizeGadget | #PB_Window_MaximizeGadget | #PB_Window_SystemMenu | #PB_Window_SizeGadget | #PB_Window_TitleBar  ParentWindowID       = ComputeWinOrigins(@OX, @OY, WWidth, WHeight, ParentWindow, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor)  AlertGList\WindowNum = OpenWindow(#PB_Any, OX, OY, WWidth, WHeight, WindowTitle$, WParam, ParentWindowID)  If IsWindow(AlertGList\WindowNum)    If IsWindow(ActiveWindow) And IsWindowEnabled_(WindowID(ActiveWindow))      DisableWindow(ActiveWindow, #True)      ParentHasBeenDisabled = #True    EndIf    ;    hMonitor       = MonitorFromWindow_(WindowID(AlertGList\WindowNum), #MONITOR_DEFAULTTONEAREST)    mi\cbSize      = SizeOf(MONITORINFO)    GetMonitorInfo_(hMonitor, @mi)    BoundWidthMax  = DesktopUnscaledX(mi\rcWork\right - mi\rcWork\left) - 80    BoundHeightMax = DesktopUnscaledY(mi\rcWork\bottom - mi\rcWork\top) - 80    If BoundWidthMax < BoundWidthMin   : BoundWidthMax = BoundWidthMin   : EndIf    If BoundHeightMax < BoundHeightMin : BoundHeightMax = BoundHeightMin : EndIf    WindowBounds(AlertGList\WindowNum, BoundWidthMin, BoundHeightMin, #PB_Ignore, #PB_Ignore)    ;    If WSticky      StickyWindow(AlertGList\WindowNum, #True)    EndIf    ;    ; Create and configure the RichEdit control with the default UI font BEFORE inserting content:    AlertGList\RE_gadget = EditorGadget(#PB_Any, AlertGList\Margins, AlertGList\Margins, 200, 200)    hRE                  = GadgetID(AlertGList\RE_gadget)    SetGadgetFont(AlertGList\RE_gadget, PBBAllGadgetsFont)    SendMessage_(hRE, #EM_SETTARGETDEVICE, #Null, 0)    SendMessage_(hRE, #EM_LIMITTEXT, -1, 0)    SendMessage_(hRE, #EM_SETTEXTMODE, #TM_RICHTEXT, 0)    SendMessage_(hRE, #EM_SETEVENTMASK, 0, SendMessage_(hRE, #EM_GETEVENTMASK, 0, 0) | #ENM_REQUESTRESIZE)    ;    If TabList$ <> ""      TabCount  = CountString(TabList$, ",") + 1      *tabStops = AllocateMemory(TabCount * SizeOf(Long))      If *tabStops        For PosInList = 1 To TabCount          PokeL(*tabStops + (PosInList - 1) * SizeOf(Long), Val(StringField(TabList$, PosInList, ",")))        Next        SendMessage_(hRE, #EM_SETTABSTOPS, TabCount, *tabStops)        FreeMemory(*tabStops)      EndIf    EndIf    ;    ; Populate the RichEdit via #EM_STREAMIN for RTF streams, or #EM_REPLACESEL for plain Unicode text:    If RTF = 1      StreamState\Buffer     = @Message$      StreamState\TotalBytes = MemoryStringLength(@Message$, #PB_Ascii)      StreamState\Offset     = 0      edIn\dwCookie          = @StreamState      edIn\pfnCallback       = @AW_StreamInCallback()      SendMessage_(hRE, #EM_STREAMIN, #SF_RTF, @edIn)    ElseIf RTF = 2      *utf8Buf = UTF8(Message$)      If *utf8Buf        StreamState\Buffer     = *utf8Buf        StreamState\TotalBytes = MemorySize(*utf8Buf) - 1        StreamState\Offset     = 0        edIn\dwCookie          = @StreamState        edIn\pfnCallback       = @AW_StreamInCallback()        SendMessage_(hRE, #EM_STREAMIN, #SF_RTF, @edIn)        FreeMemory(*utf8Buf)      EndIf    Else      SendMessage_(hRE, #EM_REPLACESEL, 0, @Message$)      ; Apply subtle left/right paragraph indents so plain text does not touch the RichEdit frame:      RE_SetSelection(AlertGList\RE_gadget, 0, -1)      format\cbSize        = SizeOf(PARAFORMAT)      format\dwMask        = #PFM_RIGHTINDENT | #PFM_OFFSETINDENT      format\dxStartIndent = 100      format\dxRightIndent = 100      SendMessage_(hRE, #EM_SETPARAFORMAT, #SCF_SELECTION, @format)    EndIf    SendMessage_(hRE, #EM_SETREADONLY, #True, 0)    ;    ; Instantiate the requested button set:    If YesNoCancel = #AW_AlertOnly Or YesNoCancel = #AW_OKOrCancel_OKByDefault Or YesNoCancel = #AW_OKOrCancel_CancelByDefault      BDefault       = Bool(YesNoCancel = #AW_AlertOnly Or YesNoCancel = #AW_OKOrCancel_OKByDefault)      AlertGList\BOK = ButtonGadget(#PB_Any, 1, 1, AlertGList\BWidth, AlertGList\BHeight, GetTextFromCatalog("OK"), #PB_Button_Default * BDefault)    EndIf    If YesNoCancel = #AW_OKOrCancel_OKByDefault Or YesNoCancel = #AW_OKOrCancel_CancelByDefault Or YesNoCancel = #AW_YesNoOrCancel_YesByDefault Or YesNoCancel = #AW_YesNoOrCancel_NoByDefault Or YesNoCancel = #AW_YesNoOrCancel_CancelByDefault      BDefault           = Bool(YesNoCancel = #AW_OKOrCancel_CancelByDefault Or YesNoCancel = #AW_YesNoOrCancel_CancelByDefault)      AlertGList\BCancel = ButtonGadget(#PB_Any, 1, 1, AlertGList\BWidth, AlertGList\BHeight, GetTextFromCatalog("Cancel"), #PB_Button_Default * BDefault)    EndIf    If YesNoCancel = #AW_YesOrNo_YesByDefault Or YesNoCancel = #AW_YesOrNo_NoByDefault Or YesNoCancel = #AW_YesNoOrCancel_YesByDefault Or YesNoCancel = #AW_YesNoOrCancel_NoByDefault Or YesNoCancel = #AW_YesNoOrCancel_CancelByDefault      BDefault        = Bool(YesNoCancel = #AW_YesOrNo_YesByDefault Or YesNoCancel = #AW_YesNoOrCancel_YesByDefault)      AlertGList\BYes = ButtonGadget(#PB_Any, 1, 1, AlertGList\BWidth, AlertGList\BHeight, GetTextFromCatalog("Yes"), #PB_Button_Default * BDefault)      BDefault        = Bool(YesNoCancel = #AW_YesOrNo_NoByDefault Or YesNoCancel = #AW_YesNoOrCancel_NoByDefault)      AlertGList\BNo  = ButtonGadget(#PB_Any, 1, 1, AlertGList\BWidth, AlertGList\BHeight, GetTextFromCatalog("No"), #PB_Button_Default * BDefault)    EndIf    If YesNoCancel = #AW_AlertOnly      AlertGList\BCopy   = ButtonGadget(#PB_Any, 1, 1, AlertGList\BWidth, AlertGList\BHeight, GetTextFromCatalog("Copy"))      AlertGList\BSave   = ButtonGadget(#PB_Any, 1, 1, AlertGList\BWidth, AlertGList\BHeight, GetTextFromCatalog("Save"))      AlertGList\BSearch = ButtonGadget(#PB_Any, 1, 1, AlertGList\BWidth, AlertGList\BHeight, GetTextFromCatalog("SWTitle"))    EndIf    ;    ; Measure exact RichEdit layout dimensions via temporary #EN_REQUESTRESIZE subclassing    ; (uninstalled immediately afterwards, prior to theme/dark-mode subclassing):    ChromeH                  = AlertGList\BHeight + AlertGList\Margins * 3 + 6    AlertGList\SizingOldProc = SetWindowLongPtr_(WindowID(AlertGList\WindowNum), #GWL_WNDPROC, @AW_SizingNotifyCallback())    ;    If FixedWidth > 0      WWidth = FixedWidth      If WWidth > BoundWidthMax : WWidth = BoundWidthMax : EndIf      ReqTextH = AW_MeasureRichEditHeight(WWidth - AlertGList\Margins * 2)    Else      ; Progressive aspect-ratio search: smoothly transitions from wide landscape (ratio ~2.4 at W=250)      ; for short prompts down to square (ratio 1.0 at W=800), then caps width at 800 px for long docs:      MaxReadW = 800      If MaxReadW > BoundWidthMax        MaxReadW = BoundWidthMax      EndIf      If MaxReadW < BoundWidthMin        MaxReadW = BoundWidthMin      EndIf      LowW  = BoundWidthMin      HighW = MaxReadW      While LowW < HighW        MidW        = (LowW + HighW) / 2        ReqTextH    = AW_MeasureRichEditHeight(MidW - AlertGList\Margins * 2)        ReqWinH     = ReqTextH + ChromeH        TargetRatio = 2.4 - 1.4 * (MidW - 250.0) / 550.0        If TargetRatio < 1.0          TargetRatio = 1.0        EndIf        If ReqWinH > MidW / TargetRatio          LowW = MidW + 1        Else          HighW = MidW        EndIf      Wend      WWidth   = LowW      ReqTextH = AW_MeasureRichEditHeight(WWidth - AlertGList\Margins * 2)    EndIf    ;    SetWindowLongPtr_(WindowID(AlertGList\WindowNum), #GWL_WNDPROC, AlertGList\SizingOldProc)    AlertGList\SizingOldProc = 0    ;    ; Center short plain-text prompts automatically unless left alignment or tab stops were requested:    If RTF = 0 And Txtleft = 0 And TabList$ = "" And (WWidth * ReqTextH) < 50000      RE_SetSelection(AlertGList\RE_gadget, 0, -1)      paraFormat\cbSize     = SizeOf(PARAFORMAT2)      paraFormat\dwMask     = #PFM_ALIGNMENT      paraFormat\wAlignment = #PFA_CENTER      SendMessage_(hRE, #EM_SETPARAFORMAT, #SCF_SELECTION, @paraFormat)    EndIf    RE_SetSelection(AlertGList\RE_gadget, 0, 0)    ;    WHeight = ReqTextH + ChromeH    If WHeight < BoundHeightMin : WHeight = BoundHeightMin : EndIf    If WHeight > BoundHeightMax : WHeight = BoundHeightMax : EndIf    ;    ComputeWinOrigins(@OX, @OY, WWidth, WHeight, ParentWindow, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor)    ResizeWindow(AlertGList\WindowNum, OX, OY, WWidth, WHeight)    ResizeAlertWindow()    ;    ; Guard against fractional high-DPI border rounding triggering #WS_VSCROLL when room remains on screen:    While WHeight < BoundHeightMax And (GetWindowLongPtr_(hRE, #GWL_STYLE) & #WS_VSCROLL)      WHeight + 8      If WHeight > BoundHeightMax : WHeight = BoundHeightMax : EndIf      ComputeWinOrigins(@OX, @OY, WWidth, WHeight, ParentWindow, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor)      ResizeWindow(AlertGList\WindowNum, OX, OY, WWidth, WHeight)      ResizeAlertWindow()    Wend    ;    ; Apply the shared UI font to all instantiated buttons, then apply theme / dark-mode styling:    *GadgetAdress = @AlertGList\BOK    Repeat      If IsGadget(PeekI(*GadgetAdress))        GadgetList$ + Str(PeekI(*GadgetAdress)) + ","      EndIf      *GadgetAdress + SizeOf(Integer)    Until *GadgetAdress > @AlertGList\BSave    ApplyFontToGadgetList(GadgetList$)    GadgetList$ + Str(AlertGList\RE_gadget) + ","    ;    CompilerIf Defined(ApplyDarkModeToWindow, #PB_Procedure)      ApplyDarkModeToWindow(AlertGList\WindowNum)    CompilerEndIf    ;    CompilerIf Defined(SetGadgetsColorsFromTheme, #PB_Procedure)      ; Apply active theme colors when 'ApplyColorThemes.pbi' is included before 'Alert.pbi':      If ListSize(InterfaceColorPresets()) > 0        SetGadgetsColorsFromTheme(AlertGList\WindowNum, InterfaceColorPresets(), GadgetList$)        If InterfaceColorPresets()\BackgroundColor <> #PB_Default          WhiteBackGround = 1        EndIf      EndIf    CompilerEndIf    ;    If WhiteBackGround = 0      SetGadgetColor(AlertGList\RE_gadget, #PB_Gadget_BackColor, $F0FDFD)    EndIf    ;    HideWindow(AlertGList\WindowNum, #False)    RedrawWindow_(WindowID(AlertGList\WindowNum), #Null, #Null, #RDW_INVALIDATE | #RDW_ERASE | #RDW_ALLCHILDREN | #RDW_UPDATENOW)    BindEvent(#PB_Event_SizeWindow, @ResizeAlertWindow(), AlertGList\WindowNum)    ;    AddKeyboardShortcut(AlertGList\WindowNum, #PB_Shortcut_Return, #AW_Shortcut_DefButton)    AddKeyboardShortcut(AlertGList\WindowNum, #PB_Shortcut_Escape, #AW_Shortcut_Quit)    AddKeyboardShortcut(AlertGList\WindowNum, #PB_Shortcut_Control | #PB_Shortcut_F, #AW_Shortcut_Search)    AddKeyboardShortcut(AlertGList\WindowNum, #PB_Shortcut_Control | #PB_Shortcut_S, #AW_Shortcut_Save)    ;    AlertGList\CopyMenu = CreatePopupMenu(#PB_Any)    MenuItem(#AW_MenuCopy,    GetTextFromCatalog("Copy"))    MenuItem(#AW_MenuCopyAll, GetTextFromCatalog("CopyAll"))    CompilerIf Defined(ApplyThemesToMenu, #PB_Procedure)      ApplyThemesToMenu(AlertGList\CopyMenu)    CompilerEndIf    ;    ClearKeyboardBuffer(AlertGList\WindowNum)    ;    Repeat      EventID = WaitWindowEvent()      If EventWindow() <> AlertGList\WindowNum        If WSticky And (EventID = #PB_Event_ActivateWindow Or EventID = #PB_Event_LeftClick)          SetActiveWindow(AlertGList\WindowNum)        EndIf        Continue      EndIf      ;      If EventID = #PB_Event_Gadget        EventGadget = EventGadget()      ElseIf EventID = #PB_Event_CloseWindow        QuitAll = #PB_MessageRequester_Cancel      ElseIf EventID = #PB_Event_Menu        Select EventMenu()          Case #AW_Shortcut_Quit            QuitAll = #PB_MessageRequester_Cancel          Case #AW_Shortcut_DefButton            If YesNoCancel = #AW_AlertOnly Or YesNoCancel = #AW_YesOrNo_YesByDefault Or YesNoCancel = #AW_YesNoOrCancel_YesByDefault Or YesNoCancel = #AW_OKOrCancel_OKByDefault              QuitAll = #PB_MessageRequester_Yes            ElseIf YesNoCancel = #AW_YesOrNo_NoByDefault Or YesNoCancel = #AW_YesNoOrCancel_NoByDefault              QuitAll = #PB_MessageRequester_No            Else              QuitAll = #PB_MessageRequester_Cancel            EndIf          Case #AW_Shortcut_Search            EventID     = #PB_Event_Gadget            EventGadget = AlertGList\BSearch          Case #AW_Shortcut_Save            EventID     = #PB_Event_Gadget            EventGadget = AlertGList\BSave          Case #AW_MenuCopy            AW_CopyToClipboard(AlertGList\RE_gadget, #True)          Case #AW_MenuCopyAll            AW_CopyToClipboard(AlertGList\RE_gadget, #False)            RE_SetSelection(AlertGList\RE_gadget, 0, -1)        EndSelect      EndIf      ;      If EventID = #PB_Event_Gadget        If THG(EventGadget, AlertGList\BOK) Or THG(EventGadget, AlertGList\BYes)          QuitAll = #PB_MessageRequester_Yes        ElseIf THG(EventGadget, AlertGList\BCancel)          QuitAll = #PB_MessageRequester_Cancel        ElseIf THG(EventGadget, AlertGList\BNo)          QuitAll = #PB_MessageRequester_No        ElseIf THG(EventGadget, AlertGList\BSearch)          RE_FindReplace(AlertGList\RE_gadget, 0, AlertGList\WindowNum)        ElseIf THG(EventGadget, AlertGList\BCopy)          If RE_GetGadgetSelectedText(AlertGList\RE_gadget) <> ""            DisplayPopupMenu(AlertGList\CopyMenu, WindowID(AlertGList\WindowNum))          Else            AW_CopyToClipboard(AlertGList\RE_gadget, #False)            RE_SetSelection(AlertGList\RE_gadget, 0, -1)          EndIf        ElseIf THG(EventGadget, AlertGList\BSave)          ; Propose RTF first when the displayed message contains RTF formatting, keeping TXT available in both modes:          If RTF > 0            SavePattern$ = "RTF (*.rtf)|*.rtf|" + GetTextFromCatalog("TextFile")          Else            SavePattern$ = GetTextFromCatalog("TextFile")          EndIf          NFile$ = SaveFileRequester(GetTextFromCatalog("SaveAs"), "", SavePattern$, 0)          If NFile$ <> ""            SaveAsRTF = Bool(RTF > 0 And ((SelectedFilePattern() = 0 And LCase(GetExtensionPart(NFile$)) <> "txt") Or LCase(GetExtensionPart(NFile$)) = "rtf"))            If SaveAsRTF              If LCase(GetExtensionPart(NFile$)) <> "rtf"                NFile$ + ".rtf"              EndIf              RE_SaveContent(AlertGList\RE_gadget, NFile$, #SF_RTF)            Else              If LCase(GetExtensionPart(NFile$)) <> "txt"                NFile$ + ".txt"              EndIf              RE_SaveContent(AlertGList\RE_gadget, NFile$, 0)            EndIf          EndIf        EndIf      EndIf    Until QuitAll    ;    UnbindEvent(#PB_Event_SizeWindow, @ResizeAlertWindow(), AlertGList\WindowNum)    If IsMenu(AlertGList\CopyMenu)      FreeMenu(AlertGList\CopyMenu)      AlertGList\CopyMenu = #PB_Ignore    EndIf    If IsWindow(AlertGList\WindowNum)      ClearKeyboardBuffer(AlertGList\WindowNum)      CloseWindow(AlertGList\WindowNum)    EndIf  EndIf  ;  If ParentHasBeenDisabled And IsWindow(ActiveWindow)    DisableWindow(ActiveWindow, #False)  EndIf  ProcedureReturn QuitAllEndProcedure;Procedure AlertYesNoCancel(Message$, Title$ = "", Type = #AW_YesOrNo_YesByDefault, ParentID = #PB_Default, XShiftOrPos = 0, YShiftOrPos = 0, ParentAnchor = #CWO_Center, WindowAnchor = #CWO_Center)  ;  ; Role: Convenience wrapper around Alert() replacing PureBasic's MessageRequester() Yes/No/Cancel modes.  ;  ; • 'Type' accepts any value from 'AlertYesNoCancel' (#AW_AlertOnly, #AW_YesOrNo_YesByDefault,  ;   #AW_YesOrNo_NoByDefault, #AW_OKOrCancel_OKByDefault, #AW_OKOrCancel_CancelByDefault,  ;   #AW_YesNoOrCancel_YesByDefault, #AW_YesNoOrCancel_NoByDefault, #AW_YesNoOrCancel_CancelByDefault).  ; • Returns #PB_MessageRequester_Yes, #PB_MessageRequester_No, or #PB_MessageRequester_Cancel.  ;  ProcedureReturn Alert(Message$, Title$, 1, 0, 0, 0, "", Type, ParentID, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor)EndProcedure;; *************************************************************************************;;-                                      5. DEMO;; *************************************************************************************;CompilerIf #PB_Compiler_IsMainFile  ; The following demo code only runs when this file is compiled directly as the main file:  ;  Alert("This is a simple message.")  ;  Define tx$ = "{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1036{\fonttbl{\f0\fnil\fcharset0 Bauhaus 93;}{\f1\fnil\fcharset0 Calibri;}}" + #CR$ +               "{\colortbl ;\red192\green80\blue77;}" + #CR$ +               "{\*\generator Riched20 10.0.19041}\viewkind4\uc1 " + #CR$ +               "\pard\sa200\sl276\slmult1\f0\fs22\lang12 Demonstration \f1\fs28 text \fs22 in \cf1\b\fs28 RTF \cf0\b0\fs22 format.\par" + #CR$ +               "}"  Alert(tx$)  ;  tx$ = "This example shows how the 'Alert()' window automatically resizes itself so that it can display " +        "text of any length without rewriting layout code each time a message of a different size is shown." + #CR$ +        "There is no limit to the size of the message you can pass here." + #CR$ +        "The window expands as needed up to comfortable reading bounds, and a vertical scrollbar appears " +        "automatically whenever the message is too long to fit entirely on screen."  Alert(tx$, "My title")  ;  tx$ + #CR$ + tx$ + #CR$ + tx$ + #CR$ + tx$ + #CR$ + tx$ + #CR$ + tx$ + #CR$ + tx$ + #CR$ +        #CR$ + tx$ + #CR$ + tx$ + #CR$ + tx$ + #CR$ + tx$ + #CR$ + tx$ + #CR$ + tx$ + #CR$  tx$ = "When the displayed text is really large, a 'Search' button automatically appears to allow searching within the text." + #CR$ + #CR$ + #CR$ + #CR$ + tx$  Alert(tx$)  ;  tx$ = "A variant of the 'Alert()' function, named 'AlertYesNoCancel()', is intended to replace MessageRequester() with the flags #PB_MessageRequester_YesNo or #PB_MessageRequester_YesNoCancel." + #CR$ +        "It offers the exact same flexibility as the 'Alert()' function."  AlertYesNoCancel(tx$, "Demonstration")  ;  tx$ + #CR$ + #CR$ + "Possible parameters for this variant are:" + #CR$ +                      "  #AW_AlertOnly" + #CR$ +                      "  #AW_YesOrNo_YesByDefault" + #CR$ +                      "  #AW_YesOrNo_NoByDefault" + #CR$ +                      "  #AW_OKOrCancel_OKByDefault" + #CR$ +                      "  #AW_OKOrCancel_CancelByDefault" + #CR$ +                      "  #AW_YesNoOrCancel_YesByDefault" + #CR$ +                      "  #AW_YesNoOrCancel_NoByDefault" + #CR$ +                      "  #AW_YesNoOrCancel_CancelByDefault" + #CR$ + #CR$ +                      "Here is an example of the result with #AW_YesNoOrCancel_CancelByDefault:" + #CR$ + #CR$ +                      "The return values are the same as those of PureBasic's native MessageRequester() function." + #CR$  AlertYesNoCancel(tx$, "Last Demonstration", #AW_YesNoOrCancel_CancelByDefault)CompilerEndIf;; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 1028; FirstLine = 233; Folding = AAAAA9---; EnableXP; DPIAware