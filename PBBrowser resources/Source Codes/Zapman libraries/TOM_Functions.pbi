;****************************************************************;;                          TOM Library;         By Zapman - Nov 2026 - PB 6.11 -> 6.4 - Windows only;;   This file should be saved under the name "TOM_Functions.pbi".;;            For text formatting or image insertion;                       in EditorGadgets.;;   Needs IDataObject.pbi and FontDescription.pbi as included files.;;                    The work from XCoder;   (https://www.purebasic.fr/english/viewtopic.php?t=76203);        has been partially used for some functions.;    You may read this tutorial if you are discovering TOM.;;****************************************************************;;       Example of using the Text Object Model (TOM);; One of the main advantages of TOM is that it allows modifying; the formatting of text inside an EditorGadget without changing; (and thus without losing) the current selection or scrolling position.;; Everything in this library is designed to simplify the programmer's; work: formatting commands are expressed in plain human-readable text,; and memory / COM interface cleanup is handled automatically behind the scenes.;; The two primary procedures in this library are:; - TOM_SetFontStyles(), which applies character styles;   (bold, italic, underline, colors, font name, size, etc.) to a text range.; - TOM_SetParaStyles(), which applies paragraph styles;   (alignment, indentation, line spacing, bulleted/numbered lists, etc.) to a text range.;; Example: TOM_SetFontStyles(GadgetID, "Bold, Size(12), ForeColor($0000D0)", StartPos, EndPos);; A complete interactive usage example is provided at the end of this file.;;****************************************************************;; "FontDescription.pbi" is required for flexible text-based command parsing:XIncludeFile("FontDescription.pbi");; "IDataObject.pbi" is required for TOM_InsertImage(), TOM_InsertText(), and TOM_Copy():XIncludeFile("IDataObject.pbi");#EndOfText    = -1#AsSelection  = -2 ; Targets the current user selection;#TomTrue      = -1#TomFalse     = 0#TomDefault   = -9999996#TomAutoColor = -9999997;Enumeration Tom_UnderlineStyles  #TomNone  #TomSingle  #TomWords  #TomDouble  #TomDotted  #TomDash  #TomDashDot  #TomDashDotDot  #TomWave  #TomThick  #TomHair  #TomDoubleWave  #TomHeavyWave  #TomLongDash  #TomThickDash  #TomThickDashDot  #TomThickDashDotDot  #TomThickDotted  #TomThickLongDashEndEnumeration;Enumeration Tom_AlignmentStyles  #TomAlignLeft        = 0  #TomAlignCenter      = 1  #TomAlignRight       = 2  #TomAlignJustify     = 3  #TomAlignDecimal     = 3  #TomAlignBar         = 4  #TomAlignInterWord   = 3  #TomAlignNewspaper   = 4  #TomAlignInterLetter = 5  #TomAlignScaled      = 6EndEnumeration;Enumeration Tom_SpaceLineRules  #TomLineSpaceSingle  #TomLineSpace1pt5  #TomLineSpaceDouble  #TomLineSpaceAtLeast  #TomLineSpaceExactly  #TomLineSpaceMultiple  #TomLineSpacePercentEndEnumeration;Enumeration Tom_Case  #TomLowerCase  #TomUpperCase  #TomTitleCase  #TomReserved  #TomSentenceCase  #TomToggleCaseEndEnumeration;Enumeration Tom_ExtendRange  #TomCharacter = 1  #TomWord  #TomSentence  #TomParagraph  #TomLine  #TomStoryEndEnumeration;#TomSuspend = $FF676985#TomResume  = $FF676986;Enumeration bullets  #TomListNone  #TomListBullet  #TomListNumberAsArabic             ; Standard Arabic numbering (1, 2, 3...)  #TomListNumberAsLCLetter           ; Lowercase letter numbering (a, b, c...)  #TomListNumberAsUCLetter           ; Uppercase letter numbering (A, B, C...)  #TomListNumberAsLCRoman            ; Lowercase Roman numerals (i, ii, iii...)  #TomListNumberAsUCRoman            ; Uppercase Roman numerals (I, II, III...)  #TomListNumberAsSequence  #TomListNumberedCircle             ; Number enclosed in a plain circle  #TomListNumberedBlackCircleWingding ; Number enclosed in a solid black circle  #TomListNumberedWhiteCircleWingding ; Number enclosed in a white circle  #TomListNumberedArabicWide         ; Arabic numbering with wider spacingEndEnumeration;#TomListParentheses = $10000 ; Encloses the list number in parentheses: (1)#TomListPeriod      = $20000 ; Follows the list number with a period: 1.#TomListPlain       = $30000 ; Displays plain list numbers without punctuation: 1#TomListMinus       = $80000 ; Follows the list number with a hyphen: 1-;; PureBasic's built-in ITextFont and ITextPara resident interfaces had inaccurate parameter; types in older PB versions (6.12 and earlier). Fixed interfaces are declared below.; Thanks to Justin (PB Forum) for providing these corrected definitions:;;- TOM Interfaces;DataSection  IID_ITextDocument: ; Universal TOM 1.0 IID "{8CC497C0-A1DF-11CE-8098-00AA0047BE5D}"    Data.l $8CC497C0    Data.w $A1DF, $11CE    Data.b $80, $98, $00, $AA, $00, $47, $BE, $5D    ;  IID_ITextDocument2: ; TOM 2.0 IID "{01C25500-4268-11D1-883A-3C8B00C10000}"    Data.l $01C25500    Data.w $4268, $11D1    Data.b $88, $3A, $3C, $8B, $00, $C1, $00, $00    ;  IID_ITextRange2:    Data.l $3103CCC3    Data.w $004D, $4B37    Data.b $98, $73, $26, $AE, $7C, $0B, $56, $8F    ;  IID_ITextFont2:    Data.l $C241F5E3    Data.w $7206, $11D8    Data.b $A2, $C7, $00, $A0, $D1, $D6, $C6, $B3EndDataSection;Interface ITextFont2 Extends IDispatch  GetDuplicate(prop.i)  SetDuplicate(Duplicate.i)  CanChange(prop.i)  IsEqual(pFont.i, prop.i)  Reset(Value.l)  GetStyle(prop.i)  SetStyle(Style.l)  GetAllCaps(prop.i)  SetAllCaps(AllCaps.l)  GetAnimation(prop.i)  SetAnimation(Animation.l)  GetBackColor(prop.i)  SetBackColor(BackColor.l)  GetBold(prop.i)  SetBold(Bold.l)  GetEmboss(prop.i)  SetEmboss(Emboss.l)  GetForeColor(prop.i)  SetForeColor(ForeColor.l)  GetHidden(prop.i)  SetHidden(Hidden.l)  GetEngrave(prop.i)  SetEngrave(Engrave.l)  GetItalic(prop.i)  SetItalic(Italic.l)  GetKerning(prop.i)  SetKerning(Kerning.f)  GetLanguageID(prop.i)  SetLanguageID(LanguageID.l)  GetName(prop.i)  SetName(Name.p-bstr)  GetOutline(prop.i)  SetOutline(Outline.l)  GetPosition(prop.i)  SetPosition(Position.f)  GetProtected(prop.i)  SetProtected(Protected.l)  GetShadow(prop.i)  SetShadow(Shadow.l)  GetSize(prop.i)  SetSize(Size.f)  GetSmallCaps(prop.i)  SetSmallCaps(SmallCaps.l)  GetSpacing(prop.i)  SetSpacing(Spacing.f)  GetStrikeThrough(prop.i)  SetStrikeThrough(StrikeThrough.l)  GetSubscript(prop.i)  SetSubscript(Subscript.l)  GetSuperscript(prop.i)  SetSuperscript(Superscript.l)  GetUnderline(prop.i)  SetUnderline(Underline.l)  GetWeight(prop.i)  SetWeight(Weight.l)  GetCount(prop.i)  GetAutoLigatures(prop.i)  SetAutoLigatures(AutoLigatures.l)  GetAutospaceAlpha(prop.i)  SetAutospaceAlpha(AutospaceAlpha.l)  GetAutospaceNumeric(prop.i)  SetAutospaceNumeric(AutospaceNumeric.l)  GetAutospaceParens(prop.i)  SetAutospaceParens(AutospaceParens.l)  GetCharRep(prop.i)  SetCharRep(CharRep.l)  GetCompressionMode(prop.i)  SetCompressionMode(CompressionMode.l)  GetCookie(prop.i)  SetCookie(Cookie.l)  GetDoubleStrike(prop.i)  SetDoubleStrike(DoubleStrike.l)  GetDuplicate2(prop.i)  SetDuplicate2(Duplicate2.i)  GetLinkType(prop.i)  GetMathZone(prop.i)  SetMathZone(MathZone.l)  GetModWidthPairs(prop.i)  SetModWidthPairs(ModWidthPairs.l)  GetModWidthSpace(prop.i)  SetModWidthSpace(ModWidthSpace.l)  GetOldNumbers(prop.i)  SetOldNumbers(OldNumbers.l)  GetOverlapping(prop.i)  SetOverlapping(Overlapping.l)  GetPositionSubSuper(prop.i)  SetPositionSubSuper(PositionSubSuper.l)  GetScaling(prop.i)  SetScaling(Scaling.l)  GetSpaceExtension(prop.i)  SetSpaceExtension(SpaceExtension.f)  GetUnderlinePositionMode(prop.i)  SetUnderlinePositionMode(UnderlinePositionMode.l)  GetEffects(pValue.i, pMask.i)  GetEffects2(pValue.i, pMask.i)  GetProperty(Type.l, prop.i)  GetPropertyInfo(Index.l, pType.i, pValue.i)  IsEqual2(pFont.i, prop.i)  SetEffects(Value.l, Mask.l)  SetEffects2(Value.l, Mask.l)  SetProperty(Type.l, Value.l)EndInterface;Interface ITextPara_Fixed Extends IDispatch  GetDuplicate(prop.i)  SetDuplicate(Duplicate.i)  CanChange(prop.i)  IsEqual(pPara.i, prop.i)  Reset(Value.l)  GetStyle(prop.i)  SetStyle(Style.l)  GetAlignment(prop.i)  SetAlignment(Alignment.l)  GetHyphenation(prop.i)  SetHyphenation(Hyphenation.l)  GetFirstLineIndent(prop.i)  GetKeepTogether(prop.i)  SetKeepTogether(KeepTogether.l)  GetKeepWithNext(prop.i)  SetKeepWithNext(KeepWithNext.l)  GetLeftIndent(prop.i)  GetLineSpacing(prop.i)  GetLineSpacingRule(prop.i)  GetListAlignment(prop.i)  SetListAlignment(ListAlignment.l)  GetListLevelIndex(prop.i)  SetListLevelIndex(ListLevelIndex.l)  GetListStart(prop.i)  SetListStart(ListStart.l)  GetListTab(prop.i)  SetListTab(ListTab.f)  GetListType(prop.i)  SetListType(ListType.l)  GetNoLineNumber(prop.i)  SetNoLineNumber(NoLineNumber.l)  GetPageBreakBefore(prop.i)  SetPageBreakBefore(PageBreakBefore.l)  GetRightIndent(prop.i)  SetRightIndent(RightIndent.f)  SetIndents(First.f, Left.f, Right.f)  SetLineSpacing(Rule.l, Spacing.f)  GetSpaceAfter(prop.i)  SetSpaceAfter(SpaceAfter.f)  GetSpaceBefore(prop.i)  SetSpaceBefore(SpaceBefore.f)  GetWidowControl(prop.i)  SetWidowControl(WidowControl.l)  GetTabCount(prop.i)  AddTab(tbPos.f, tbAlign.l, tbLeader.l)  ClearAllTabs()  DeleteTab(tbPos.f)  GetTab(iTab.l, ptbPos.i, ptbAlign.i, ptbLeader.i)EndInterface;Interface ITextRange2 Extends IDispatch  GetText(prop.i)  SetText(Text.p-bstr)  GetChar(prop.i)  SetChar(Char.l)  GetDuplicate(prop.i)  GetFormattedText(prop.i)  SetFormattedText(FormattedText.i)  GetStart(prop.i)  SetStart(Start.l)  GetEnd(prop.i)  SetEnd(End.l)  GetFont(prop.i)  SetFont(Font.i)  GetPara(prop.i)  SetPara(Para.i)  GetStoryLength(prop.i)  GetStoryType(prop.i)  Collapse(bStart.l)  Expand(Unit.l, prop.i)  GetIndex(Unit.l, prop.i)  SetIndex(Unit.l, Index.l, Extend.l)  SetRange(cpAnchor.l, cpActive.l)  InRange(*pTextRange, prop.i)  InStory(*pTextRange, prop.i)  IsEqual(*pTextRange, prop.i)  Select()  StartOf(Unit.l, Extend.l, prop.i)  EndOf(Unit.l, Extend.l, prop.i)  Move(Unit.l, Count.l, prop.i)  MoveStart(Unit.l, Count.l, prop.i)  MoveEnd(Unit.l, Count.l, prop.i)  MoveWhile(Cset.i, Count.l, prop.i)  MoveStartWhile(Cset.i, Count.l, prop.i)  MoveEndWhile(Cset.i, Count.l, prop.i)  MoveUntil(Cset.i, Count.l, prop.i)  MoveStartUntil(Cset.i, Count.l, prop.i)  MoveEndUntil(Cset.i, Count.l, prop.i)  FindText(bstr.p-bstr, Count.l, Flags.l, prop.i)  FindTextStart(bstr.p-bstr, Count.l, Flags.l, prop.i)  FindTextEnd(bstr.p-bstr, Count.l, Flags.l, prop.i)  Delete(Unit.l, Count.l, prop.i)  Cut(pVar.i)  Copy(pVar.i)  Paste(pVar.i, Format.l)  CanPaste(pVar.i, Format.l, prop.i)  CanEdit(prop.i)  ChangeCase(Type.l)  GetPoint(Type.l, px.i, py.i)  SetPoint(x.l, y.l, Type.l, Extend.l)  ScrollIntoView(Value.l)  GetEmbeddedObject(prop.i)  GetFlags(prop.i)  SetFlags(Flags.l)  GetType(prop.i)  MoveLeft(Unit.l, Count.l, Extend.l, prop.i)  MoveRight(Unit.l, Count.l, Extend.l, prop.i)  MoveUp(Unit.l, Count.l, Extend.l, prop.i)  MoveDown(Unit.l, Count.l, Extend.l, prop.i)  HomeKey(Unit.l, Extend.l, prop.i)  EndKey(Unit.l, Extend.l, prop.i)  TypeText(bstr.p-bstr)  GetCch(prop.i)  GetCells(prop.i)  GetColumn(prop.i)  GetCount(prop.i)  GetDuplicate2(prop.i)  GetFont2(prop.i)  SetFont2(Font2.i)  GetFormattedText2(prop.i)  SetFormattedText2(FormattedText2.i)  GetGravity(prop.i)  SetGravity(Gravity.l)  GetPara2(prop.i)  SetPara2(Para2.i)  GetRow(prop.i)  GetStartPara(prop.i)  GetTable(prop.i)  GetURL(prop.i)  SetURL(URL.p-bstr)  AddSubrange(cp1.l, cp2.l, Activate.l)  BuildUpMath(Flags.l)  DeleteSubrange(cpFirst.l, cpLim.l)  Find(*pTextRange, Count.l, Flags.l, pDelta.i)  GetChar2(pChar.i, Offset.l)  GetDropCap(pcLine.i, pPosition.i)  GetInlineObject(pType.i, pAlign.i, pChar.i, pChar1.i, pChar2.i, pCount.i, pTeXStyle.i, pcCol.i, pLevel.i)  GetProperty(Type.l, pValue.i)  GetRect(Type.l, pLeft.i, pTop.i, pRight.i, pBottom.i, pHit.i)  GetSubrange(iSubrange.l, pcpFirst.i, pcpLim.i)  GetText2(Flags.l, pbstr.i)  HexToUnicode()  InsertTable(cCol.l, cRow.l, AutoFit.l)  Linearize(Flags.l)  SetActiveSubrange(cpAnchor.l, cpActive.l)  SetDropCap(cLine.l, Position.l)  SetProperty(Type.l, Value.l)  SetText2(Flags.l, *pStream)  UnicodeToHex()  SetInlineObject(Type.l, Align.l, Char.l, Char1.l, Char2.l, Count.l, TeXStyle.l, cCol.l)  GetMathFunctionType(bstr.p-bstr, pValue.i)  InsertImage(width.l, Height.l, ascent.l, Type.l, bstrAltText.p-bstr, *pStream)EndInterface;Interface ITextDocument2_Fixed Extends IDispatch  GetName(prop.i)  GetSelection(prop.i)  GetStoryCount(prop.i)  GetStoryRanges(prop.i)  GetSaved(prop.i)  SetSaved(Saved.l)  GetDefaultTabStop(prop.i)  SetDefaultTabStop(DefaultTabStop.f)  New()  Open(pVar.i, Flags.l, CodePage.l)  Save(pVar.i, Flags.l, CodePage.l)  Freeze(prop.i)  Unfreeze(prop.i)  BeginEditCollection()  EndEditCollection()  Undo(Count.l, prop.i)  Redo(Count.l, prop.i)  Range(cpActive.l, cpAnchor.l, prop.i)  RangeFromPoint(x.l, y.l, prop.i)  GetCaretType(prop.i)  SetCaretType(CaretType.l)  GetDisplays(prop.i)  GetDocumentFont(prop.i)  SetDocumentFont(DocumentFont.i)  GetDocumentPara(prop.i)  SetDocumentPara(DocumentPara.i)  GetEastAsianFlags(prop.i)  GetGenerator(prop.i)  SetIMEInProgress(IMEInProgress.l)  GetNotificationMode(prop.i)  SetNotificationMode(NotificationMode.l)  GetSelection2(prop.i)  GetStoryRanges2(prop.i)  GetTypographyOptions(prop.i)  GetVersion(prop.i)  GetWindow(prop.i)  AttachMsgFilter(pFilter.i)  CheckTextLimit(Cch.l, pcch.i)  GetCallManager(prop.i)  GetClientRect(Type.l, pLeft.i, pTop.i, pRight.i, pBottom.i)  GetEffectColor(Index.l, pValue.i)  GetImmContext(prop.i)  GetPreferredFont(cp.l, CharRep.l, Options.l, curCharRep.l, curFontSize.l, pbstr.i, pPitchAndFamily.i, pNewFontSize.i)  GetProperty(Type.l, pValue.i)  GetStrings(ppStrs.i)  Notify(Notify.l)  Range2(cpActive.l, cpAnchor.l, prop.i)  RangeFromPoint2(x.l, y.l, Type.l, prop.i)  ReleaseCallManager(pVoid.i)  ReleaseImmContext(Context.q)  SetEffectColor(Index.l, Value.l)  SetProperty(Type.l, Value.l)  SetTypographyOptions(Options.l, Mask.l)  SysBeep()  Update(Value.l)  UpdateWindow()  GetMathProperties(pOptions.i)  SetMathProperties(Options.l, Mask.l)  GetActiveStory(prop.i)  SetActiveStory(ActiveStory.i)  GetMainStory(prop.i)  GetNewStory(prop.i)  GetStory(Index.l, prop.i)EndInterface;;- Internal DataObject & TOM Helpers;CompilerIf Not Defined(GetDIBHandleFromImage, #PB_Procedure)  ; Also defined in IDataObject_Helper.pbi; guarded here so TOM_Functions.pbi works standalone.  Procedure GetDIBHandleFromImage(HBitmap)    ;    ; Role: Converts a PureBasic Image ID or a Windows HBITMAP handle into a 32-bit #CF_DIB HGLOBAL memory block.    ; Output: Returns the newly allocated HGLOBAL handle containing the BITMAPINFOHEADER + pixel bits, or #Null.    ;    Protected TemporaryDC, TemporaryBitmap.BITMAP, TemporaryBitmapInfo.BITMAPINFO    Protected hDib, *Buffer, BitmapSize    ;    If IsImage(HBitmap)      HBitmap = ImageID(HBitmap)    EndIf    If HBitmap = #Null Or GetObject_(HBitmap, SizeOf(BITMAP), @TemporaryBitmap) = 0      ProcedureReturn #Null    EndIf    ;    TemporaryDC = CreateDC_("DISPLAY", #Null, #Null, #Null)    If TemporaryDC = #Null      ProcedureReturn #Null    EndIf    ;    TemporaryBitmapInfo\bmiHeader\biSize        = SizeOf(BITMAPINFOHEADER)    TemporaryBitmapInfo\bmiHeader\biWidth       = TemporaryBitmap\bmWidth    TemporaryBitmapInfo\bmiHeader\biHeight      = TemporaryBitmap\bmHeight    TemporaryBitmapInfo\bmiHeader\biPlanes      = 1    TemporaryBitmapInfo\bmiHeader\biBitCount    = 32    TemporaryBitmapInfo\bmiHeader\biCompression = #BI_RGB    ;    BitmapSize = TemporaryBitmap\bmWidth * Abs(TemporaryBitmap\bmHeight) * 4    hDib = GlobalAlloc_(#GMEM_MOVEABLE, SizeOf(BITMAPINFOHEADER) + BitmapSize)    If hDib      *Buffer = GlobalLock_(hDib)      If *Buffer        CopyMemory(@TemporaryBitmapInfo\bmiHeader, *Buffer, SizeOf(BITMAPINFOHEADER))        GetDIBits_(TemporaryDC, HBitmap, 0, Abs(TemporaryBitmap\bmHeight), *Buffer + SizeOf(BITMAPINFOHEADER), @TemporaryBitmapInfo, #DIB_RGB_COLORS)        GlobalUnlock_(hDib)      Else        GlobalFree_(hDib)        hDib = #Null      EndIf    EndIf    ;    DeleteDC_(TemporaryDC)    ProcedureReturn hDib  EndProcedureCompilerEndIf;Procedure SetIDataObjectImage(*MyDataObject.IDataObject, Image)  ;  ; Role: Populates *MyDataObject with a 32-bit #CF_DIB representation of Image (PureBasic Image ID or HBITMAP).  ; Output: Returns #True on success, #False otherwise.  ;  Protected MyFormatEtc.FormatEtc, MyStgMed.StgMedium  Protected hBitmap, hDib, SC  ;  If *MyDataObject = #Null Or Image = 0    ProcedureReturn #False  EndIf  ;  MyFormatEtc\tymed    = #TYMED_HGLOBAL  MyFormatEtc\cfFormat = #CF_DIB  MyFormatEtc\ptd      = #Null  MyFormatEtc\dwAspect = #DVASPECT_CONTENT  MyFormatEtc\lindex   = -1  ;  MyStgMed\pUnkForRelease = #Null  MyStgMed\tymed          = #TYMED_HGLOBAL  ;  If IsImage(Image)    Image = ImageID(Image)  EndIf  hBitmap = CopyImage_(Image, #IMAGE_BITMAP, 0, 0, #LR_COPYRETURNORG)  If hBitmap = #Null    ProcedureReturn #False  EndIf  ;  hDib = GetDIBHandleFromImage(hBitmap)  DeleteObject_(hBitmap)  If hDib = #Null    ProcedureReturn #False  EndIf  MyStgMed\hGlobal = hDib  ;  SC = *MyDataObject\SetData(@MyFormatEtc, @MyStgMed, #True)  If SC <> #S_OK    ReleaseStgMedium_(@MyStgMed)    ProcedureReturn #False  EndIf  ;  ProcedureReturn #TrueEndProcedure;Procedure SetIDataObjectText(*MyDataObject.IDataObject, StringData$)  ;  ; Role: Populates *MyDataObject with plain Unicode text (#CF_UNICODETEXT) or RTF content ("RTF in UTF8"),  ;       supporting both standard PureBasic Unicode strings and raw ASCII-poked RTF buffers inside StringData$.  ; Output: Returns #True on success, #False otherwise.  ;  Protected MyFormatEtc.FormatEtc, MyStgMed.StgMedium  Protected ASCIIEncoded, formatValue, ByteSize, hGlobal, *DataBuffer, SC  ;  If *MyDataObject = #Null    ProcedureReturn #False  EndIf  ;  MyFormatEtc\tymed    = #TYMED_HGLOBAL  MyFormatEtc\ptd      = #Null  MyFormatEtc\dwAspect = #DVASPECT_CONTENT  MyFormatEtc\lindex   = -1  ;  ; Detect whether raw single-byte ASCII RTF ("{\...") was poked directly into StringData$'s memory buffer  If @StringData$ And PeekA(@StringData$) = '{' And PeekA(@StringData$ + 1) = '\'    ASCIIEncoded = #True  EndIf  ;  If ASCIIEncoded Or Left(StringData$, 5) = "{\rtf" Or Left(StringData$, 6) = "{\urtf"    formatValue = RegisterClipboardFormat_("RTF in UTF8")    If formatValue = 0      ProcedureReturn #False    EndIf    MyFormatEtc\cfFormat = formatValue    If ASCIIEncoded      ByteSize = MemoryStringLength(@StringData$, #PB_Ascii) + 1    Else      ByteSize = StringByteLength(StringData$, #PB_UTF8) + 1    EndIf  Else    MyFormatEtc\cfFormat = #CF_UNICODETEXT    ByteSize = (Len(StringData$) + 1) * SizeOf(Character)  EndIf  ;  MyStgMed\pUnkForRelease = #Null  MyStgMed\tymed          = #TYMED_HGLOBAL  ;  hGlobal = GlobalAlloc_(#GMEM_MOVEABLE, ByteSize)  If hGlobal = #Null    ProcedureReturn #False  EndIf  *DataBuffer = GlobalLock_(hGlobal)  If *DataBuffer = #Null    GlobalFree_(hGlobal)    ProcedureReturn #False  EndIf  ;  If MyFormatEtc\cfFormat = #CF_UNICODETEXT    PokeS(*DataBuffer, StringData$, -1, #PB_Unicode)  ElseIf ASCIIEncoded    CopyMemory(@StringData$, *DataBuffer, ByteSize)  Else    PokeS(*DataBuffer, StringData$, -1, #PB_UTF8)  EndIf  GlobalUnlock_(hGlobal)  MyStgMed\hGlobal = hGlobal  ;  SC = *MyDataObject\SetData(@MyFormatEtc, @MyStgMed, #True)  If SC <> #S_OK    ReleaseStgMedium_(@MyStgMed)    ProcedureReturn #False  EndIf  ;  ProcedureReturn #TrueEndProcedure;Procedure TOM_PrintErrorMessage(result)  ;  ; Role: Prints a readable diagnostic message for common TOM HRESULT codes in the Debug window.  ;  If result <> #S_OK    Select result      Case #E_INVALIDARG   : Debug "TOM Error: E_INVALIDARG - Invalid argument."      Case #E_ACCESSDENIED : Debug "TOM Error: E_ACCESSDENIED - Write access denied."      Case #E_OUTOFMEMORY  : Debug "TOM Error: E_OUTOFMEMORY - Out of memory."      Case #CO_E_RELEASED  : Debug "TOM Error: CO_E_RELEASED - Formatting object is attached to a deleted range."      Default              : Debug "TOM Error: $" + Hex(result, #PB_Long)    EndSelect  Else    Debug "No error"  EndIfEndProcedure;Procedure TOM_FreeObj(*TOMObject.IUnknown)  ;  ; Role: Releases any TOM COM object returned by advanced TOM_Get*Obj() procedures without requiring OOP syntax.  ;  If *TOMObject    *TOMObject\Release()  EndIfEndProcedure;Procedure TOM_GetTextDocumentObj(GadgetID)  ;  ; Role: Obtains the ITextDocument2_Fixed (or fallback ITextDocument) COM interface for a RichEdit / EditorGadget.  ;       Note: Advanced callers must release the returned object via TOM_FreeObj(*Obj) or *Obj\Release().  ;  Protected RichEditOleObject.IRichEditOle  Protected *pTextDocument.ITextDocument2_Fixed  Protected SC  ;  If GadgetID    If IsGadget(GadgetID) : GadgetID = GadgetID(GadgetID) : EndIf    SendMessage_(GadgetID, #EM_GETOLEINTERFACE, 0, @RichEditOleObject)    If RichEditOleObject      ; Query TOM 2.0 first (Windows 8+ MSFTEDIT), falling back to universal TOM 1.0 (RichEd20) if unavailable      SC = RichEditOleObject\QueryInterface(?IID_ITextDocument2, @*pTextDocument)      If SC <> #S_OK Or *pTextDocument = #Null        SC = RichEditOleObject\QueryInterface(?IID_ITextDocument, @*pTextDocument)      EndIf      RichEditOleObject\Release()      If SC <> #S_OK        Debug "TOM_GetTextDocumentObj: Unable to query ITextDocument interface (" + Str(SC) + ")."      EndIf    Else      Debug "TOM_GetTextDocumentObj: Unable to obtain IRichEditOle. Check EditorGadget ID/handle."    EndIf  EndIf  ;  ProcedureReturn *pTextDocumentEndProcedure;Procedure TOM_GetTextRangeObj(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Obtains an ITextRange2 COM object spanning StartPos -> EndPos (0-based character offsets).  ;       - StartPos = #AsSelection (or omitted): targets the current selection.  ;       - EndPos   = #AsSelection (or < StartPos): collapses to an insertion point at StartPos.  ;       - StartPos = #EndOfText: sets an insertion point at the very end of the gadget's text.  ;       - EndPos   = #EndOfText: spans from StartPos to the end of the gadget's text.  ;       Note: Advanced callers must release the returned object via TOM_FreeObj(*Range) or *Range\Release().  ;  Protected *pTextDocument.ITextDocument2_Fixed  Protected *pTextRange.ITextRange2  Protected SC = #S_OK  ;  If StartPos = #EndOfText : StartPos = #MAXLONG : EndIf  If EndPos   = #EndOfText : EndPos   = #MAXLONG : EndIf  If StartPos > EndPos     : EndPos   = StartPos : EndIf  ;  *pTextDocument = TOM_GetTextDocumentObj(GadgetID)  If *pTextDocument    If StartPos = #AsSelection      SC = *pTextDocument\GetSelection(@*pTextRange)    Else      SC = *pTextDocument\Range(StartPos, EndPos, @*pTextRange)    EndIf    *pTextDocument\Release()    If SC <> #S_OK      Debug "TOM_GetTextRangeObj: Unable to get ITextRange interface (" + Str(SC) + ")."      *pTextRange = #Null    EndIf  EndIf  ;  ProcedureReturn *pTextRangeEndProcedure;;- Selection & Clipboard Helpers;Procedure TOM_GetSelectionPos(GadgetID, *Selrange.CHARRANGE)  ;  ; Role: Fills *Selrange\cpMin and *Selrange\cpMax with the 0-based start and end offsets of the current selection.  ; Output: Returns #TomTrue on success, #TomFalse otherwise.  ;  Protected *pTextRange.ITextRange2  ;  If *Selrange    *pTextRange = TOM_GetTextRangeObj(GadgetID)    If *pTextRange      *pTextRange\GetStart(@*Selrange\cpMin)      *pTextRange\GetEnd(@*Selrange\cpMax)      *pTextRange\Release()      ProcedureReturn #TomTrue    EndIf  EndIf  ;  ProcedureReturn #TomFalseEndProcedure;Procedure TOM_SetSelectionPos(GadgetID, StartPos, EndPos = #AsSelection)  ;  ; Role: Selects the 0-based character range StartPos -> EndPos inside GadgetID.  ; Output: Returns #TomTrue on success, #TomFalse otherwise.  ;  Protected *pTextRange.ITextRange2 = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)  ;  If *pTextRange    *pTextRange\Select()    *pTextRange\Release()    ProcedureReturn #TomTrue  EndIf  ;  ProcedureReturn #TomFalseEndProcedure;Procedure TOM_GetRealPos(GadgetID, StartPos = #AsSelection)  ;  ; Role: Resolves symbolic positions (#AsSelection or #EndOfText) into an actual 0-based character offset.  ;  Protected *pTextRange.ITextRange2 = TOM_GetTextRangeObj(GadgetID, StartPos)  Protected RetValue.l = 0  ;  If *pTextRange    *pTextRange\GetStart(@RetValue)    *pTextRange\Release()  EndIf  ;  ProcedureReturn RetValueEndProcedure;Procedure TOM_Copy(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection, Cut = 0)  ;  ; Role: Copies (or cuts when Cut <> 0) the 0-based range StartPos -> EndPos to the Windows clipboard,  ;       preserving both rich RTF/embedded images and plain Unicode text (#CF_UNICODETEXT).  ;       (RichEdit's native Copy() omits plain text whenever an image is part of the selection;  ;       this procedure enriches the resulting clipboard object with plain text automatically.)  ; Output: Returns #TomTrue on success, #TomFalse otherwise.  ;  Protected *pTextRange.ITextRange2 = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)  Protected *Buffer, SimpleText$, SrcDataObj.IDataObject, *mDataObj.IDataObject  Protected var.VARIANT, SC  ;  If *pTextRange = #Null    ProcedureReturn #TomFalse  EndIf  ;  ; Extract plain Unicode text from the range first  If *pTextRange\GetText(@*Buffer) <> #S_OK    *pTextRange\Release()    ProcedureReturn #TomFalse  EndIf  If *Buffer    SimpleText$ = PeekS(*Buffer, -1, #PB_Unicode)    SysFreeString_(*Buffer)  EndIf  ;  ; Copy or cut the rich formatted range into a temporary COM IDataObject  var\vt       = #VT_UNKNOWN | #VT_BYREF  var\ppunkVal = @SrcDataObj  If Cut    SC = *pTextRange\Cut(@var)  Else    SC = *pTextRange\Copy(@var)  EndIf  *pTextRange\Release()  ;  If SC <> #S_OK Or SrcDataObj = #Null    ProcedureReturn #TomFalse  EndIf  ;  ; Clone all rich formats into our own IDataObject, append plain Unicode text, and flush to the clipboard  *mDataObj = CreateIDataObject()  If *mDataObj = #Null    SrcDataObj\Release()    ProcedureReturn #TomFalse  EndIf  CloneIDataObject(SrcDataObj, *mDataObj)  SrcDataObj\Release()  ;  SetIDataObjectText(*mDataObj, SimpleText$)  OleSetClipboard_(*mDataObj)  OleFlushClipboard_()  ; Release our creator reference now that OleFlushClipboard_() has permanently transferred the data  *mDataObj\Release()  ;  ProcedureReturn #TomTrueEndProcedure;Procedure TOM_Cut(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Cuts the 0-based range StartPos -> EndPos to the Windows clipboard (rich RTF + plain text).  ;  ProcedureReturn TOM_Copy(GadgetID, StartPos, EndPos, 1)EndProcedure;Procedure TOM_Paste(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Pastes the current Windows clipboard contents into the 0-based range StartPos -> EndPos.  ; Output: Returns #TomTrue on success, #TomFalse otherwise.  ;  Protected *pTextRange.ITextRange2 = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)  ;  If *pTextRange    *pTextRange\Paste(0, 0)    *pTextRange\Release()    ProcedureReturn #TomTrue  EndIf  ;  ProcedureReturn #TomFalseEndProcedure;;;- Font & Paragraph Cloning Helpers;Procedure TOM_GetTextFontObj(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection, Duplicate = #TomFalse)  ;  ; Role: Obtains an ITextFont2 COM interface for the 0-based character range StartPos -> EndPos.  ;       - When Duplicate = #TomFalse: returns a live object bound to the range (modifying it alters the text).  ;       - When Duplicate = #TomTrue : returns an independent snapshot that can later be applied via TOM_ApplyTextFont().  ;       Note: For simple style copying without managing COM pointers, prefer TOM_CopyFontStyles().  ;       Otherwise, release the returned object after use via TOM_FreeObj(*FontObj) or *FontObj\Release().  ;  Protected *pTextRange.ITextRange2  Protected *pTextFont.ITextFont2  Protected *DTextFont.ITextFont2  Protected Result  ;  *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)  If *pTextRange    If *pTextRange\GetFont(@*pTextFont) = #S_OK And *pTextFont      If Duplicate = #TomTrue        *pTextFont\GetDuplicate(@*DTextFont)        Result = *DTextFont        *pTextFont\Release()      Else        Result = *pTextFont      EndIf    EndIf    *pTextRange\Release()  EndIf  ;  ProcedureReturn ResultEndProcedure;Procedure TOM_GetTextParaObj(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection, Duplicate = #TomFalse)  ;  ; Role: Obtains an ITextPara_Fixed COM interface for the 0-based character range StartPos -> EndPos.  ;       - When Duplicate = #TomFalse: returns a live object bound to the range's paragraph(s).  ;       - When Duplicate = #TomTrue : returns an independent snapshot that can later be applied via TOM_ApplyTextPara().  ;       Note: For simple paragraph style copying without managing COM pointers, prefer TOM_CopyParaStyles().  ;       Otherwise, release the returned object after use via TOM_FreeObj(*ParaObj) or *ParaObj\Release().  ;  Protected *pTextRange.ITextRange2  Protected *pTextPara.ITextPara_Fixed  Protected *DTextPara.ITextPara_Fixed  Protected Result  ;  *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)  If *pTextRange    If *pTextRange\GetPara(@*pTextPara) = #S_OK And *pTextPara      If Duplicate = #TomTrue        *pTextPara\GetDuplicate(@*DTextPara)        Result = *DTextPara        *pTextPara\Release()      Else        Result = *pTextPara      EndIf    Else      Debug "TOM_GetTextParaObj: Unable to obtain ITextPara."    EndIf    *pTextRange\Release()  EndIf  ;  ProcedureReturn ResultEndProcedure;Procedure TOM_ApplyTextFont(GadgetID, *pTextFont.ITextFont2, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Applies all character attributes stored in *pTextFont to the 0-based range StartPos -> EndPos.  ; Output: Returns #S_OK on success, or a COM HRESULT error code.  ;  Protected *pTextRange.ITextRange2  Protected Result = #S_FALSE  ;  If *pTextFont    *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)    If *pTextRange      Result = *pTextRange\SetFont(*pTextFont)      *pTextRange\Release()    EndIf  EndIf  ;  ProcedureReturn ResultEndProcedure;Procedure TOM_ApplyTextPara(GadgetID, *pTextPara.ITextPara_Fixed, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Applies all paragraph attributes stored in *pTextPara to the 0-based range StartPos -> EndPos.  ; Output: Returns #S_OK on success, or a COM HRESULT error code.  ;  Protected *pTextRange.ITextRange2  Protected Result = #S_FALSE  ;  If *pTextPara    *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)    If *pTextRange      Result = *pTextRange\SetPara(*pTextPara)      *pTextRange\Release()    EndIf  EndIf  ;  ProcedureReturn ResultEndProcedure;Procedure TOM_CopyFontStyles(GadgetID, SrcPos, DestStartPos = #AsSelection, DestEndPos = #AsSelection)  ;  ; Role: One-line helper that copies all character styles from the character at 0-based SrcPos  ;       and applies them to DestStartPos -> DestEndPos, freeing all COM objects automatically.  ; Output: Returns #TomTrue on success, #TomFalse otherwise.  ;  Protected *FontSnapshot.ITextFont2  Protected SC = #E_FAIL  ;  *FontSnapshot = TOM_GetTextFontObj(GadgetID, SrcPos, SrcPos + 1, #TomTrue)  If *FontSnapshot    SC = TOM_ApplyTextFont(GadgetID, *FontSnapshot, DestStartPos, DestEndPos)    *FontSnapshot\Release()  EndIf  ;  ProcedureReturn Bool(SC = #S_OK) * #TomTrueEndProcedure;Procedure TOM_CopyParaStyles(GadgetID, SrcPos, DestStartPos = #AsSelection, DestEndPos = #AsSelection)  ;  ; Role: One-line helper that copies all paragraph styles from the paragraph at 0-based SrcPos  ;       and applies them to DestStartPos -> DestEndPos, freeing all COM objects automatically.  ; Output: Returns #TomTrue on success, #TomFalse otherwise.  ;  Protected *ParaSnapshot.ITextPara_Fixed  Protected SC = #E_FAIL  ;  *ParaSnapshot = TOM_GetTextParaObj(GadgetID, SrcPos, SrcPos + 1, #TomTrue)  If *ParaSnapshot    SC = TOM_ApplyTextPara(GadgetID, *ParaSnapshot, DestStartPos, DestEndPos)    *ParaSnapshot\Release()  EndIf  ;  ProcedureReturn Bool(SC = #S_OK) * #TomTrueEndProcedure;;- Search, Case, Range Expansion & Display Control;Procedure TOM_Find(GadgetID, ToFind$, StartPos = #AsSelection, Flags = 0, Limit = 0)  ;  ; Role: Searches forward (from 0-based StartPos to the end of the text, or up to Limit characters) for ToFind$.  ; Output: Returns the 0-based start offset of the match if found, or -1 if not found (or on error).  ;  Protected *pTextRange.ITextRange2  Protected Result.l = -1, MatchLength.l  ;  If ToFind$ <> ""    *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos, #EndOfText)    If *pTextRange      If *pTextRange\FindTextStart(ToFind$, Limit, Flags, @MatchLength) = #S_OK        *pTextRange\GetStart(@Result)      EndIf      *pTextRange\Release()    EndIf  EndIf  ;  ProcedureReturn ResultEndProcedure;Procedure TOM_ExpandRange(*pTextRange.ITextRange2, Style$)  ;  ; Role: Expands an existing *pTextRange to encompass whole units specified by Style$:  ;       "Char", "Word", "Sentence", "Paragraph" ("Para"), "Line", or "Story".  ;  Protected RExpand  ;  If *pTextRange = #Null    ProcedureReturn #E_INVALIDARG  EndIf  ;  Style$ = LCase(Style$)  If FindString(Style$, "char")    RExpand = #TomCharacter  ElseIf FindString(Style$, "word")    RExpand = #TomWord  ElseIf FindString(Style$, "sentence")    RExpand = #TomSentence  ElseIf FindString(Style$, "para")    RExpand = #TomParagraph  ElseIf FindString(Style$, "line")    RExpand = #TomLine  ElseIf FindString(Style$, "story")    RExpand = #TomStory  Else    ProcedureReturn #E_INVALIDARG  EndIf  ;  ProcedureReturn *pTextRange\Expand(RExpand, 0)EndProcedure;Procedure TOM_ExpandSelection(GadgetID, Style$ = "Word")  ;  ; Role: Expands the user's current selection in GadgetID to the unit specified by Style$  ;       ("Char", "Word", "Sentence", "Paragraph", "Line", or "Story").  ;  Protected *pTextRange.ITextRange2, Result  ;  *pTextRange = TOM_GetTextRangeObj(GadgetID, #AsSelection)  If *pTextRange = #Null    ProcedureReturn #E_FAIL  EndIf  Result = TOM_ExpandRange(*pTextRange, Style$)  If Result = #S_OK    *pTextRange\Select()    If IsGadget(GadgetID)      SetActiveGadget(GadgetID)    ElseIf GadgetID      SetFocus_(GadgetID)    EndIf  EndIf  *pTextRange\Release()  ;  ProcedureReturn ResultEndProcedure;Global NewMap TOM_UndoSuspended();Procedure TOM_StopUndoRedo(GadgetID)  ;  ; Role: Suspends undo/redo history recording in GadgetID (useful during bulk programmatic formatting)  ;       and records this state by HWND so internal helpers never resume Undo behind the caller's back.  ;  Protected hWnd = GadgetID  Protected *pTextDocument.ITextDocument2_Fixed  ;  If IsGadget(GadgetID) : hWnd = GadgetID(GadgetID) : EndIf  *pTextDocument = TOM_GetTextDocumentObj(hWnd)  If *pTextDocument    *pTextDocument\Undo(#TomSuspend, 0)    *pTextDocument\Release()    TOM_UndoSuspended(Str(hWnd)) = #True  EndIfEndProcedure;Procedure TOM_EnableUndoRedo(GadgetID)  ;  ; Role: Resumes undo/redo history recording in GadgetID after a previous call to TOM_StopUndoRedo().  ;  Protected hWnd = GadgetID  Protected *pTextDocument.ITextDocument2_Fixed  ;  If IsGadget(GadgetID) : hWnd = GadgetID(GadgetID) : EndIf  *pTextDocument = TOM_GetTextDocumentObj(hWnd)  If *pTextDocument    *pTextDocument\Undo(#TomResume, 0)    *pTextDocument\Release()    DeleteMapElement(TOM_UndoSuspended(), Str(hWnd))  EndIfEndProcedure;Procedure TOM_SetCase(GadgetID, Style$, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Changes letter case across the 0-based range StartPos -> EndPos while preserving  ;       all per-character formatting, embedded images, selection bounds, and Ctrl+Z Undo history.  ;       (Works around MSFTEDIT.dll's native ChangeCase() bug, which mutates characters in place  ;       without pushing an Undo record onto the RichEdit Undo stack.)  ;       Style$ may contain: "Lower", "Upper", "Title", "Sentence", or "Toggle".  ;  Protected *pTextDocument.ITextDocument2_Fixed  Protected *pTextRange.ITextRange2  Protected OrigDataObj.IDataObject, NewDataObj.IDataObject  Protected varOrig.VARIANT, varNew.VARIANT  Protected cpMin.l, cpMax.l, hWnd, Result, TCase, UndoWasActive  ;  Style$ = LCase(Style$)  If FindString(Style$, "lower")    TCase = #TomLowerCase  ElseIf FindString(Style$, "upper")    TCase = #TomUpperCase  ElseIf FindString(Style$, "title")    TCase = #TomTitleCase  ElseIf FindString(Style$, "sentence")    TCase = #TomSentenceCase  ElseIf FindString(Style$, "toggle")    TCase = #TomToggleCase  Else    ProcedureReturn #E_INVALIDARG  EndIf  ;  If IsGadget(GadgetID)    hWnd = GadgetID(GadgetID)  Else    hWnd = GadgetID  EndIf  ;  *pTextRange = TOM_GetTextRangeObj(hWnd, StartPos, EndPos)  If *pTextRange = #Null    ProcedureReturn #E_FAIL  EndIf  ;  *pTextRange\GetStart(@cpMin)  *pTextRange\GetEnd(@cpMax)  If cpMax <= cpMin    ; Empty range: nothing to transform    *pTextRange\Release()    ProcedureReturn #S_OK  EndIf  ;  UndoWasActive  = Bool(FindMapElement(TOM_UndoSuspended(), Str(hWnd)) = 0)  *pTextDocument = TOM_GetTextDocumentObj(hWnd)  ;  If UndoWasActive And *pTextDocument    ; Freeze redrawing and suspend Undo while we snapshot original and case-converted rich ranges    *pTextDocument\Freeze(0)    *pTextDocument\Undo(#TomSuspend, 0)    ;    varOrig\vt       = #VT_UNKNOWN | #VT_BYREF    varOrig\ppunkVal = @OrigDataObj    If *pTextRange\Copy(@varOrig) = #S_OK And OrigDataObj      Result = *pTextRange\ChangeCase(TCase)      *pTextRange\SetRange(cpMin, cpMax)      ;      varNew\vt       = #VT_UNKNOWN | #VT_BYREF      varNew\ppunkVal = @NewDataObj      If Result = #S_OK And *pTextRange\Copy(@varNew) = #S_OK And NewDataObj        ; Restore exact original rich content while Undo is still suspended        varOrig\vt       = #VT_UNKNOWN        varOrig\ppunkVal = OrigDataObj        *pTextRange\Paste(@varOrig, 0)        *pTextRange\SetRange(cpMin, cpMax)        ;        ; Resume Undo and perform a single Paste of the case-converted rich content so Ctrl+Z undoes it cleanly        *pTextDocument\Undo(#TomResume, 0)        varNew\vt       = #VT_UNKNOWN        varNew\ppunkVal = NewDataObj        Result = *pTextRange\Paste(@varNew, 0)        NewDataObj\Release()      Else        *pTextDocument\Undo(#TomResume, 0)        If NewDataObj : NewDataObj\Release() : EndIf      EndIf      OrigDataObj\Release()    Else      ; Fallback if rich snapshot failed      *pTextDocument\Undo(#TomResume, 0)      Result = *pTextRange\ChangeCase(TCase)    EndIf    ;    ; Restore the user's active selection and keyboard focus when operating on #AsSelection    If StartPos = #AsSelection      *pTextRange\SetRange(cpMin, cpMax)      *pTextRange\Select()      If GetFocus_() <> hWnd        SetFocus_(hWnd)      EndIf    EndIf    *pTextDocument\Unfreeze(0)  Else    ; Undo was explicitly suspended by the caller via TOM_StopUndoRedo(): apply ChangeCase directly    Result = *pTextRange\ChangeCase(TCase)    If StartPos = #AsSelection And GetFocus_() <> hWnd      SetFocus_(hWnd)    EndIf  EndIf  ;  If *pTextDocument : *pTextDocument\Release() : EndIf  *pTextRange\Release()  ;  ProcedureReturn ResultEndProcedure;Procedure TOM_Freeze(GadgetID)  ;  ; Role: Freezes screen redrawing and interactive selection in GadgetID to prevent flickering  ;       and maximize speed during batch text/style updates. Call TOM_Unfreeze() when done.  ;  Protected *pTextDocument.ITextDocument2_Fixed = TOM_GetTextDocumentObj(GadgetID)  ;  If *pTextDocument    *pTextDocument\Freeze(0)    *pTextDocument\Release()  EndIfEndProcedure;Procedure TOM_Unfreeze(GadgetID)  ;  ; Role: Decrements the freeze count and restores normal screen redrawing and editing after TOM_Freeze().  ;  Protected *pTextDocument.ITextDocument2_Fixed = TOM_GetTextDocumentObj(GadgetID)  ;  If *pTextDocument    *pTextDocument\Unfreeze(0)    *pTextDocument\Release()  EndIfEndProcedure;Procedure TOM_GetIndex(GadgetID, StartPos = #AsSelection, IndexType$ = "Line")  ;  ; Role: Returns the 1-based TOM index of the unit ("Char", "Word", "Sentence", "Para", or "Line")  ;       containing 0-based StartPos, or -1 on error.  ;  Protected *pTextRange.ITextRange2, IType, valIndex.l = -1  ;  IndexType$ = LCase(IndexType$)  If FindString(IndexType$, "char")    IType = #TomCharacter  ElseIf FindString(IndexType$, "word")    IType = #TomWord  ElseIf FindString(IndexType$, "sentence")    IType = #TomSentence  ElseIf FindString(IndexType$, "para")    IType = #TomParagraph  Else    IType = #TomLine  EndIf  ;  *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos)  If *pTextRange    If *pTextRange\GetIndex(IType, @valIndex) <> #S_OK      valIndex = -1    EndIf    *pTextRange\Release()  EndIf  ;  ProcedureReturn valIndexEndProcedure;;- Text-Driven Font & Paragraph Styling;Macro TOM_FontSetUnset(StyleName, GetName, SetName)  ;  ; Role: Applies, toggles off, or resets a boolean/state TOM font property extracted via FD_ExtractParameter.  ;  parameter$ = FD_ExtractParameter(Style$, StyleName, #True, @Found)  If Found    If parameter$ <> "" And parameter$ <> "default"      If parameter$ = "1" Or parameter$ = "-1" Or FindString(parameter$, "true")        *pTextFont\SetName(#TomTrue)      ElseIf parameter$ = "0" Or FindString(parameter$, "false") Or FindString(parameter$, "none")        *pTextFont\SetName(#TomFalse)      Else        *pTextFont\SetName(Val(parameter$))      EndIf    ElseIf SetUnset = #TomDefault Or parameter$ = "default"      *pFontDefault\GetName(@pl)      *pTextFont\SetName(pl)    Else      *pTextFont\SetName(SetUnset)    EndIf  EndIfEndMacro;Macro TOM_FontSetFloat(StyleName, GetName, SetName)  ;  ; Role: Applies or resets a floating-point (.f) TOM font property (Size, Spacing, Position, Kerning).  ;  parameter$ = FD_ExtractParameter(Style$, StyleName, #True, @Found)  If Found    If SetUnset = #TomTrue And parameter$ <> "default" And parameter$ <> ""      *pTextFont\SetName(ValF(parameter$))    Else      *pTextFont\GetName(@pf)      If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or Abs(pf - ValF(parameter$)) < 0.001        *pFontDefault\GetName(@pf)        *pTextFont\SetName(pf)      EndIf    EndIf  EndIfEndMacro;Macro TOM_FontSetLong(StyleName, GetName, SetName)  ;  ; Role: Applies or resets a 32-bit integer (.l) TOM font property (ForeColor, BackColor, Weight, Style, Scaling).  ;       Supports both decimal and "$hex" values cleanly via Val().  ;  parameter$ = FD_ExtractParameter(Style$, StyleName, #True, @Found)  If Found    If SetUnset = #TomTrue And parameter$ <> "default" And parameter$ <> ""      *pTextFont\SetName(Val(parameter$))    Else      *pTextFont\GetName(@gpl)      If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or gpl = Val(parameter$)        *pFontDefault\GetName(@pl)        *pTextFont\SetName(pl)      EndIf    EndIf  EndIfEndMacro;Procedure TOM_SetFontStyles(GadgetID, Style$, StartPos = #AsSelection, EndPos = #AsSelection, SetUnset = #TomTrue)  ;  ; Role: Applies, unsets, or resets character styles across the 0-based text range StartPos -> EndPos  ;       using plain human-readable descriptions (powered by FontDescription.pbi).  ;  ; Supported Style$ attributes (comma- or semicolon-separated, case-insensitive, flexible syntax):  ; • Boolean flags : Bold, Italic, Light, Emboss, AllCaps, SmallCaps, Engrave, Shadow, Outline,  ;                   StrikeThrough (or StrikeOut), Subscript, Superscript, Hidden, Protected.  ; • Underline     : Underline (or Underline(Single)), Underline(Words|Double|Dotted|Dash|DashDot|  ;                   DashDotDot|Wave|Thick|Hair|DoubleWave|HeavyWave|LongDash|ThickDash|  ;                   ThickDashDot|ThickDashDotDot|ThickDotted|ThickLongDash|None).  ; • Numeric/Color : Size(val.f), Spacing(val.f), Position(val.f), Kerning(val.f),  ;                   ForeColor($BGR or RGB(r,g,b)), BackColor($BGR or RGB(r,g,b)),  ;                   Weight(val), Style(val), Scaling(val), Name(FontName).  ; • Simplified syntax is also accepted directly, e.g.: "Arial, 14.5, RGB(220,0,0), Bold, Italic".  ;  ; SetUnset modes:  ; • #TomTrue    (default) : Applies the styles specified in Style$.  ; • #TomFalse             : Turns off boolean flags, and resets valued attributes if their current  ;                           value matches the specified value (or unconditionally if no value is given).  ; • #TomDefault           : Resets all attributes listed in Style$ to the control's default font values.  ;  Protected *pTextFont.ITextFont2, *pFontDefault.ITextFont2  Protected pl.l, gpl.l, pf.f, Found  Protected ps$, parameter$, *BSTRString  ;  Style$ = NormalizeFontDescription(Style$)  Style$ = ReplaceString(Style$, "strikeout", "strikethrough")  If Style$ = ""    ProcedureReturn  EndIf  ;  *pTextFont = TOM_GetTextFontObj(GadgetID, StartPos, EndPos)  If *pTextFont    *pTextFont\GetDuplicate(@*pFontDefault)    If *pFontDefault      *pFontDefault\Reset(#TomDefault)      ;      TOM_FontSetUnset("bold",          GetBold,          SetBold)      TOM_FontSetUnset("italic",        GetItalic,        SetItalic)      TOM_FontSetUnset("emboss",        GetEmboss,        SetEmboss)      TOM_FontSetUnset("allcaps",       GetAllCaps,       SetAllCaps)      TOM_FontSetUnset("smallcaps",     GetSmallCaps,     SetSmallCaps)      TOM_FontSetUnset("engrave",       GetEngrave,       SetEngrave)      TOM_FontSetUnset("shadow",        GetShadow,        SetShadow)      TOM_FontSetUnset("outline",       GetOutline,       SetOutline)      TOM_FontSetUnset("strikethrough", GetStrikeThrough, SetStrikeThrough)      TOM_FontSetUnset("subscript",     GetSubscript,     SetSubscript)      TOM_FontSetUnset("superscript",   GetSuperscript,   SetSuperscript)      TOM_FontSetUnset("hidden",        GetHidden,        SetHidden)      TOM_FontSetUnset("protected",     GetProtected,     SetProtected)      ;      ; Support the simple "Light" keyword from FontDescription.pbi (maps to TOM Weight 300)      parameter$ = FD_ExtractParameter(Style$, "light", #True, @Found)      If Found        If SetUnset = #TomTrue And parameter$ <> "0" And parameter$ <> "false" And parameter$ <> "none" And parameter$ <> "default"          *pTextFont\SetWeight(300)        Else          *pFontDefault\GetWeight(@pl)          *pTextFont\SetWeight(pl)        EndIf      EndIf      ;      ; Handle Underline (works both as standalone "Underline" and parameterized "Underline(Wave)")      parameter$ = FD_ExtractParameter(Style$, "underline", #True, @Found)      If Found        Select parameter$          Case "none", "0", "false" : pl = #TomNone          Case "words"              : pl = #TomWords          Case "double"             : pl = #TomDouble          Case "dotted"             : pl = #TomDotted          Case "dash"               : pl = #TomDash          Case "dashdot"            : pl = #TomDashDot          Case "dashdotdot"         : pl = #TomDashDotDot          Case "wave"               : pl = #TomWave          Case "thick"              : pl = #TomThick          Case "hair"               : pl = #TomHair          Case "doublewave"         : pl = #TomDoubleWave          Case "heavywave"          : pl = #TomHeavyWave          Case "longdash"           : pl = #TomLongDash          Case "thickdash"          : pl = #TomThickDash          Case "thickdashdot"       : pl = #TomThickDashDot          Case "thickdashdotdot"    : pl = #TomThickDashDotDot          Case "thickdotted"        : pl = #TomThickDotted          Case "thicklongdash"      : pl = #TomThickLongDash          Default                   : pl = #TomSingle        EndSelect        ;        If SetUnset = #TomDefault Or parameter$ = "default"          *pFontDefault\GetUnderline(@pl)          *pTextFont\SetUnderline(pl)        ElseIf SetUnset = #TomTrue          *pTextFont\SetUnderline(pl)        Else          *pTextFont\GetUnderline(@gpl)          If gpl = pl Or parameter$ = ""            *pTextFont\SetUnderline(#TomNone)          EndIf        EndIf      EndIf      ;      ; Floating-point attributes      TOM_FontSetFloat("size",     GetSize,     SetSize)      TOM_FontSetFloat("spacing",  GetSpacing,  SetSpacing)      TOM_FontSetFloat("position", GetPosition, SetPosition)      TOM_FontSetFloat("kerning",  GetKerning,  SetKerning)      ;      ; 32-bit integer and color attributes      TOM_FontSetLong("backcolor", GetBackColor, SetBackColor)      TOM_FontSetLong("forecolor", GetForeColor, SetForeColor)      TOM_FontSetLong("weight",    GetWeight,    SetWeight)      TOM_FontSetLong("style",     GetStyle,     SetStyle)      If OSVersion() > #PB_OS_Windows_Server_2008_R2        TOM_FontSetLong("scaling", GetScaling,   SetScaling)      EndIf      ;      ; Font family name      parameter$ = FD_ExtractParameter(Style$, "name", #True, @Found)      If Found        If SetUnset = #TomTrue And parameter$ <> "default" And parameter$ <> ""          *pTextFont\SetName(parameter$)        Else          *pTextFont\GetName(@*BSTRString)          If *BSTRString            ps$ = PeekS(*BSTRString, -1, #PB_Unicode)            SysFreeString_(*BSTRString)          Else            ps$ = ""          EndIf          If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or LCase(ps$) = LCase(parameter$)            *pFontDefault\GetName(@*BSTRString)            If *BSTRString              ps$ = PeekS(*BSTRString, -1, #PB_Unicode)              SysFreeString_(*BSTRString)              *pTextFont\SetName(ps$)            EndIf          EndIf        EndIf      EndIf      ;      *pFontDefault\Release()    EndIf    *pTextFont\Release()  EndIfEndProcedure;Procedure TOM_ResetFontStyles(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Resets all character formatting across the 0-based range StartPos -> EndPos to default font values.  ;  Protected *pTextFont.ITextFont2 = TOM_GetTextFontObj(GadgetID, StartPos, EndPos)  ;  If *pTextFont    *pTextFont\Reset(#TomDefault)    *pTextFont\Release()  EndIfEndProcedure;Macro TOM_ParaSetFloat(StyleName, GetName, SetName)  ;  ; Role: Applies or resets a floating-point (.f) TOM paragraph property (RightIndent, SpaceBefore, SpaceAfter).  ;  parameter$ = FD_ExtractParameter(Style$, StyleName, #True, @Found)  If Found    If SetUnset = #TomTrue And parameter$ <> "default" And parameter$ <> ""      *pTextPara\SetName(ValF(parameter$))    Else      *pTextPara\GetName(@pf)      If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or Abs(pf - ValF(parameter$)) < 0.001        *pParaDefault\GetName(@pf)        *pTextPara\SetName(pf)      EndIf    EndIf  EndIfEndMacro;Procedure TOM_SetParaStyles(GadgetID, Style$, StartPos = #AsSelection, EndPos = #AsSelection, SetUnset = #TomTrue)  ;  ; Role: Applies, unsets, or resets paragraph styles across the paragraph(s) intersecting StartPos -> EndPos.  ;  ; Supported Style$ commands (comma- or semicolon-separated, case-insensitive):  ; • Align(Left | Center | Right | Justify | Decimal | Bar | InterWord | Newspaper | InterLetter | Scaled)  ; • LeftIndent(val.f), RightIndent(val.f), FirstLineIndent(val.f)  ; • SpaceBefore(val.f), SpaceAfter(val.f), Style(val)  ; • LineSpacing(Single | 1pt5 | Double | AtLeast,val.f | Exactly,val.f | Multiple,val.f | Percent,val.f)  ; • List(None | Bullet | Number | LCLetter | UCLetter | LCRoman | UCRoman | Circle | BlackCircle |  ;        WhiteCircle | Wide [, Parentheses | Period | Plain | Minus])  ;  Protected *pTextPara.ITextPara_Fixed, *pParaDefault.ITextPara_Fixed  Protected pl.l, gpl.l, pl2.l, Found  Protected pf.f, pf1.f, pf2.f, pf3.f  Protected parameter$, param1$, param2$  ;  Style$ = FD_NormalizeStringSyntax(Style$)  If Style$ = ""    ProcedureReturn  EndIf  ;  *pTextPara = TOM_GetTextParaObj(GadgetID, StartPos, EndPos)  If *pTextPara    *pTextPara\GetDuplicate(@*pParaDefault)    If *pParaDefault      *pParaDefault\Reset(#TomDefault)      ;      ; Bulleted and numbered lists      parameter$ = FD_ExtractParameter(Style$, "list", #True, @Found)      If Found        param1$ = ""        param2$ = ""        If parameter$ <> "none" And parameter$ <> "default"          param1$ = StringField(parameter$, 1, ",")          param2$ = StringField(parameter$, 2, ",")        EndIf        If parameter$ = "none" Or parameter$ = "0" Or parameter$ = "false"          pl = #TomListNone        ElseIf param1$ = "" Or param1$ = "bullet"          pl = #TomListBullet        ElseIf FindString(param1$, "lcletter")          pl = #TomListNumberAsLCLetter        ElseIf FindString(param1$, "ucletter")          pl = #TomListNumberAsUCLetter        ElseIf FindString(param1$, "lcroman")          pl = #TomListNumberAsLCRoman        ElseIf FindString(param1$, "ucroman")          pl = #TomListNumberAsUCRoman        ElseIf FindString(param1$, "number") Or FindString(param1$, "arabic")          pl = #TomListNumberAsArabic        ElseIf FindString(param1$, "blackcircle")          pl = #TomListNumberedBlackCircleWingding        ElseIf FindString(param1$, "whitecircle")          pl = #TomListNumberedWhiteCircleWingding        ElseIf FindString(param1$, "wide")          pl = #TomListNumberedArabicWide        ElseIf FindString(param1$, "circle")          pl = #TomListNumberedCircle        Else          pl = #TomListNone        EndIf        ;        If FindString(param2$, "parenth")          pl2 = #TomListParentheses        ElseIf FindString(param2$, "period") Or FindString(param2$, "stop")          pl2 = #TomListPeriod        ElseIf FindString(param2$, "plain")          pl2 = #TomListPlain        ElseIf FindString(param2$, "minus") Or FindString(param2$, "hyphen")          pl2 = #TomListMinus        Else          pl2 = 0        EndIf        ;        If SetUnset = #TomTrue And parameter$ <> "default"          *pTextPara\SetListType(pl | pl2)        Else          *pTextPara\GetListType(@gpl)          If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or (gpl & $FFFF) = pl            *pParaDefault\GetListType(@pl)            *pTextPara\SetListType(pl)          EndIf        EndIf      EndIf      ;      ; Paragraph horizontal alignment      parameter$ = FD_ExtractParameter(Style$, "align", #True, @Found)      If Found        Select parameter$          Case "center"      : pl = #TomAlignCenter          Case "right"       : pl = #TomAlignRight          Case "justify"     : pl = #TomAlignJustify          Case "decimal"     : pl = #TomAlignDecimal          Case "bar"         : pl = #TomAlignBar          Case "interword"   : pl = #TomAlignInterWord          Case "newspaper"   : pl = #TomAlignNewspaper          Case "interletter" : pl = #TomAlignInterLetter          Case "scaled"      : pl = #TomAlignScaled          Default            : pl = #TomAlignLeft        EndSelect        If SetUnset = #TomTrue And parameter$ <> "default"          *pTextPara\SetAlignment(pl)        Else          *pTextPara\GetAlignment(@gpl)          If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or gpl = pl            *pParaDefault\GetAlignment(@pl)            *pTextPara\SetAlignment(pl)          EndIf        EndIf      EndIf      ;      ; Indentation (RightIndent has its own setter; LeftIndent and FirstLineIndent use SetIndents)      TOM_ParaSetFloat("rightindent", GetRightIndent, SetRightIndent)      ;      parameter$ = FD_ExtractParameter(Style$, "leftindent", #True, @Found)      If Found        If SetUnset = #TomTrue And parameter$ <> "default" And parameter$ <> ""          *pTextPara\GetFirstLineIndent(@pf1)          *pTextPara\GetRightIndent(@pf3)          *pTextPara\SetIndents(pf1, ValF(parameter$), pf3)        Else          *pTextPara\GetLeftIndent(@pf2)          If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or Abs(pf2 - ValF(parameter$)) < 0.001            *pParaDefault\GetLeftIndent(@pf2)            *pTextPara\GetFirstLineIndent(@pf1)            *pTextPara\GetRightIndent(@pf3)            *pTextPara\SetIndents(pf1, pf2, pf3)          EndIf        EndIf      EndIf      ;      parameter$ = FD_ExtractParameter(Style$, "firstlineindent", #True, @Found)      If Found        If SetUnset = #TomTrue And parameter$ <> "default" And parameter$ <> ""          *pTextPara\GetLeftIndent(@pf2)          *pTextPara\GetRightIndent(@pf3)          *pTextPara\SetIndents(ValF(parameter$), pf2, pf3)        Else          *pTextPara\GetFirstLineIndent(@pf1)          If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or Abs(pf1 - ValF(parameter$)) < 0.001            *pParaDefault\GetFirstLineIndent(@pf1)            *pTextPara\GetLeftIndent(@pf2)            *pTextPara\GetRightIndent(@pf3)            *pTextPara\SetIndents(pf1, pf2, pf3)          EndIf        EndIf      EndIf      ;      ; Vertical spacing and integer paragraph style ID      TOM_ParaSetFloat("spacebefore", GetSpaceBefore, SetSpaceBefore)      TOM_ParaSetFloat("spaceafter",  GetSpaceAfter,  SetSpaceAfter)      ;      parameter$ = FD_ExtractParameter(Style$, "style", #True, @Found)      If Found        If SetUnset = #TomTrue And parameter$ <> "default" And parameter$ <> ""          *pTextPara\SetStyle(Val(parameter$))        Else          *pTextPara\GetStyle(@gpl)          If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or gpl = Val(parameter$)            *pParaDefault\GetStyle(@pl)            *pTextPara\SetStyle(pl)          EndIf        EndIf      EndIf      ;      ; Line spacing rule and value      parameter$ = FD_ExtractParameter(Style$, "linespacing", #True, @Found)      If Found        pl     = #TomLineSpaceSingle        param2$ = ""        If parameter$ <> "default"          param1$ = StringField(parameter$, 1, ",")          param2$ = StringField(parameter$, 2, ",")          Select param1$            Case "1pt5"     : pl = #TomLineSpace1pt5            Case "double"   : pl = #TomLineSpaceDouble            Case "atleast"  : pl = #TomLineSpaceAtLeast            Case "exactly"  : pl = #TomLineSpaceExactly            Case "multiple" : pl = #TomLineSpaceMultiple            Case "percent"  : pl = #TomLineSpacePercent            Default         : pl = #TomLineSpaceSingle          EndSelect        EndIf        If SetUnset = #TomTrue And parameter$ <> "default" And parameter$ <> ""          *pTextPara\SetLineSpacing(pl, ValF(param2$))        Else          *pTextPara\GetLineSpacing(@pf)          *pTextPara\GetLineSpacingRule(@gpl)          If SetUnset = #TomDefault Or parameter$ = "default" Or parameter$ = "" Or (gpl = pl And Abs(pf - ValF(param2$)) < 0.001)            *pParaDefault\GetLineSpacing(@pf)            *pParaDefault\GetLineSpacingRule(@pl)            *pTextPara\SetLineSpacing(pl, pf)          EndIf        EndIf      EndIf      ;      *pParaDefault\Release()    EndIf    *pTextPara\Release()  EndIfEndProcedure;Procedure TOM_ResetParaStyles(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Resets all paragraph formatting across StartPos -> EndPos to default paragraph values.  ;  Protected *pTextPara.ITextPara_Fixed = TOM_GetTextParaObj(GadgetID, StartPos, EndPos)  ;  If *pTextPara    *pTextPara\Reset(#TomDefault)    *pTextPara\Release()  EndIfEndProcedure;;- Style Inspection & Content Insertion / Extraction;Procedure.s TOM_GetFontStyles(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Examines the character formatting of the 0-based range StartPos -> EndPos  ;       and returns a comma-separated human-readable style description string.  ;  Protected *pTextFont.ITextFont2  Protected pl.l, pf.f, *BSTRString  Protected ps$, Style$  ;  *pTextFont = TOM_GetTextFontObj(GadgetID, StartPos, EndPos)  If *pTextFont    *pTextFont\GetBold(@pl)          : If pl = #TomTrue : Style$ + "Bold, "          : EndIf    *pTextFont\GetItalic(@pl)        : If pl = #TomTrue : Style$ + "Italic, "        : EndIf    *pTextFont\GetEmboss(@pl)        : If pl = #TomTrue : Style$ + "Emboss, "        : EndIf    *pTextFont\GetAllCaps(@pl)       : If pl = #TomTrue : Style$ + "AllCaps, "       : EndIf    *pTextFont\GetSmallCaps(@pl)     : If pl = #TomTrue : Style$ + "SmallCaps, "     : EndIf    *pTextFont\GetEngrave(@pl)       : If pl = #TomTrue : Style$ + "Engrave, "       : EndIf    *pTextFont\GetShadow(@pl)        : If pl = #TomTrue : Style$ + "Shadow, "        : EndIf    *pTextFont\GetOutline(@pl)       : If pl = #TomTrue : Style$ + "OutLine, "       : EndIf    ;    *pTextFont\GetUnderline(@pl)    Select pl      Case #TomSingle          : Style$ + "Underline(Single), "      Case #TomWords           : Style$ + "Underline(Words), "      Case #TomDouble          : Style$ + "Underline(Double), "      Case #TomDotted          : Style$ + "Underline(Dotted), "      Case #TomDash            : Style$ + "Underline(Dash), "      Case #TomDashDot         : Style$ + "Underline(DashDot), "      Case #TomDashDotDot      : Style$ + "Underline(DashDotDot), "      Case #TomWave            : Style$ + "Underline(Wave), "      Case #TomThick           : Style$ + "Underline(Thick), "      Case #TomHair            : Style$ + "Underline(Hair), "      Case #TomDoubleWave      : Style$ + "Underline(DoubleWave), "      Case #TomHeavyWave       : Style$ + "Underline(HeavyWave), "      Case #TomLongDash        : Style$ + "Underline(LongDash), "      Case #TomThickDash       : Style$ + "Underline(ThickDash), "      Case #TomThickDashDot    : Style$ + "Underline(ThickDashDot), "      Case #TomThickDashDotDot : Style$ + "Underline(ThickDashDotDot), "      Case #TomThickDotted     : Style$ + "Underline(ThickDotted), "      Case #TomThickLongDash   : Style$ + "Underline(ThickLongDash), "    EndSelect    ;    *pTextFont\GetStrikeThrough(@pl) : If pl = #TomTrue : Style$ + "StrikeThrough, " : EndIf    *pTextFont\GetSubscript(@pl)     : If pl = #TomTrue : Style$ + "Subscript, "     : EndIf    *pTextFont\GetSuperscript(@pl)   : If pl = #TomTrue : Style$ + "Superscript, "   : EndIf    *pTextFont\GetHidden(@pl)        : If pl = #TomTrue : Style$ + "Hidden, "        : EndIf    *pTextFont\GetProtected(@pl)     : If pl = #TomTrue : Style$ + "Protected, "     : EndIf    ;    *pTextFont\GetSize(@pf)    If pf > 0      Style$ + "Size(" + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), "    EndIf    *pTextFont\GetSpacing(@pf)  : If pf : Style$ + "Spacing("  + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), " : EndIf    *pTextFont\GetPosition(@pf) : If pf : Style$ + "Position(" + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), " : EndIf    *pTextFont\GetKerning(@pf)  : If pf : Style$ + "Kerning("  + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), " : EndIf    ;    *pTextFont\GetBackColor(@pl)    If pl <> #TomAutoColor And pl <> #TomDefault      Style$ + "BackColor($" + Hex(pl & $FFFFFF, #PB_Long) + "), "    EndIf    *pTextFont\GetForeColor(@pl)    If pl <> #TomAutoColor And pl <> #TomDefault      Style$ + "ForeColor($" + Hex(pl & $FFFFFF, #PB_Long) + "), "    EndIf    *pTextFont\GetWeight(@pl)    If pl > 0 And pl <> 400 And pl <> 700      Style$ + "Weight(" + Str(pl) + "), "    EndIf    *pTextFont\GetStyle(@pl)    If pl And pl <> #TomDefault      Style$ + "Style(" + Str(pl) + "), "    EndIf    If OSVersion() > #PB_OS_Windows_Server_2008_R2      *pTextFont\GetScaling(@pl)      If pl > 0 And pl <> 100        Style$ + "Scaling(" + Str(pl) + "), "      EndIf    EndIf    *pTextFont\GetName(@*BSTRString)    If *BSTRString      ps$ = PeekS(*BSTRString, -1, #PB_Unicode)      SysFreeString_(*BSTRString)      If ps$ <> ""        Style$ + "Name(" + ps$ + ")"      EndIf    EndIf    ;    *pTextFont\Release()  EndIf  ;  If Right(Style$, 2) = ", "    Style$ = Left(Style$, Len(Style$) - 2)  EndIf  ProcedureReturn Style$EndProcedure;Procedure.s TOM_GetParaStyles(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Examines the paragraph formatting of the paragraph(s) intersecting StartPos -> EndPos  ;       and returns a comma-separated human-readable style description string.  ;  Protected *pTextPara.ITextPara_Fixed  Protected pl.l, ListKind.l, ListOpt.l, pf.f  Protected Style$, ListType$, ListOpt$  ;  *pTextPara = TOM_GetTextParaObj(GadgetID, StartPos, EndPos)  If *pTextPara    *pTextPara\GetAlignment(@pl)    Select pl      Case #TomAlignLeft        : Style$ + "Align(Left), "      Case #TomAlignCenter      : Style$ + "Align(Center), "      Case #TomAlignRight       : Style$ + "Align(Right), "      Case #TomAlignJustify     : Style$ + "Align(Justify), "      Case #TomAlignBar         : Style$ + "Align(Bar), "      Case #TomAlignInterLetter : Style$ + "Align(InterLetter), "      Case #TomAlignScaled      : Style$ + "Align(Scaled), "    EndSelect    ;    *pTextPara\GetListType(@pl)    ListKind = pl & $FFFF    ListOpt  = pl & $F0000    Select ListKind      Case #TomListBullet                      : ListType$ = "Bullet"      Case #TomListNumberAsArabic              : ListType$ = "Number"      Case #TomListNumberAsLCLetter            : ListType$ = "LCLetter"      Case #TomListNumberAsUCLetter            : ListType$ = "UCLetter"      Case #TomListNumberAsLCRoman             : ListType$ = "LCRoman"      Case #TomListNumberAsUCRoman             : ListType$ = "UCRoman"      Case #TomListNumberedCircle              : ListType$ = "Circle"      Case #TomListNumberedBlackCircleWingding : ListType$ = "BlackCircle"      Case #TomListNumberedWhiteCircleWingding : ListType$ = "WhiteCircle"      Case #TomListNumberedArabicWide          : ListType$ = "Wide"    EndSelect    If ListType$ <> ""      Select ListOpt        Case #TomListParentheses : ListOpt$ = ",Parentheses"        Case #TomListPeriod      : ListOpt$ = ",Period"        Case #TomListPlain       : ListOpt$ = ",Plain"        Case #TomListMinus       : ListOpt$ = ",Minus"      EndSelect      Style$ + "List(" + ListType$ + ListOpt$ + "), "    EndIf    ;    *pTextPara\GetLeftIndent(@pf)      : If pf : Style$ + "LeftIndent("      + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), " : EndIf    *pTextPara\GetRightIndent(@pf)     : If pf : Style$ + "RightIndent("     + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), " : EndIf    *pTextPara\GetFirstLineIndent(@pf) : If pf : Style$ + "FirstLineIndent(" + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), " : EndIf    *pTextPara\GetSpaceBefore(@pf)     : If pf : Style$ + "SpaceBefore("     + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), " : EndIf    *pTextPara\GetSpaceAfter(@pf)      : If pf : Style$ + "SpaceAfter("      + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), " : EndIf    ;    *pTextPara\GetStyle(@pl)    If pl <> -1 And pl <> #TomDefault      Style$ + "Style(" + Str(pl) + "), "    EndIf    ;    *pTextPara\GetLineSpacingRule(@pl)    *pTextPara\GetLineSpacing(@pf)    Select pl      Case #TomLineSpace1pt5     : Style$ + "LineSpacing(1pt5), "      Case #TomLineSpaceDouble   : Style$ + "LineSpacing(Double), "      Case #TomLineSpaceAtLeast  : Style$ + "LineSpacing(AtLeast,"  + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), "      Case #TomLineSpaceExactly  : Style$ + "LineSpacing(Exactly,"  + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), "      Case #TomLineSpaceMultiple : Style$ + "LineSpacing(Multiple," + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), "      Case #TomLineSpacePercent  : Style$ + "LineSpacing(Percent,"  + RTrim(RTrim(StrF(pf, 2), "0"), ".") + "), "    EndSelect    ;    *pTextPara\Release()  EndIf  ;  If Right(Style$, 2) = ", "    Style$ = Left(Style$, Len(Style$) - 2)  EndIf  ProcedureReturn Style$EndProcedure;Procedure TOM_InsertImage(GadgetID, Image, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Inserts a PureBasic Image ID or Windows HBITMAP directly into GadgetID at StartPos -> EndPos  ;       using an in-memory IDataObject (leaving the user's Windows clipboard completely untouched).  ; Output: Returns #S_OK (0) on success, or a non-zero error code.  ;  Protected *pTextRange.ITextRange2  Protected var.VARIANT  Protected *mDataObj.IDataObject  Protected SC = #E_FAIL  ;  If Image    *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)    If *pTextRange      *mDataObj = CreateIDataObject()      If *mDataObj        If SetIDataObjectImage(*mDataObj, Image)          var\vt       = #VT_UNKNOWN          var\ppunkVal = *mDataObj          SC = *pTextRange\Paste(@var, 0)        EndIf        ; Release our creator reference (CreateIDataObject starts with Refcount = 1)        *mDataObj\Release()      EndIf      *pTextRange\Release()    EndIf  EndIf  ;  ProcedureReturn SCEndProcedure;Procedure.i TOM_ExtractRTFIntTag(Block$, Tag$)  Protected Pos, TagLen = Len(Tag$), Sign = 1, Value  Protected *Char.Character  ;  ; Role: Extracts the signed integer value immediately following an exact RTF control word  ;       (such as '\picwgoal1632'), ignoring longer control words sharing the same prefix.  ;  Repeat    Pos = FindString(Block$, Tag$, Pos + 1, #PB_String_NoCase)    If Pos      *Char = @Block$ + (Pos + TagLen - 1) * SizeOf(Character)      If (*Char\c >= '0' And *Char\c <= '9') Or         (*Char\c = '-' And PeekC(*Char + SizeOf(Character)) >= '0' And PeekC(*Char + SizeOf(Character)) <= '9')        If *Char\c = '-'          Sign = -1          *Char + SizeOf(Character)        EndIf        While *Char\c >= '0' And *Char\c <= '9'          Value = Value * 10 + (*Char\c - '0')          *Char + SizeOf(Character)        Wend        ProcedureReturn Value * Sign      EndIf    EndIf  Until Pos = 0  ;  ProcedureReturn 0EndProcedure;Procedure.s TOM_ResolveIncludePath(RawPath$, BaseDir$)  Protected NormPath$, AnchorDir$, Candidate$  ;  ; Role: Normalizes an RTF INCLUDEPICTURE path (unescaping doubled backslashes and forward slashes)  ;       and resolves relative paths against BaseDir$ when provided, or GetCurrentDirectory() otherwise.  ;  NormPath$ = ReplaceString(ReplaceString(Trim(RawPath$), "\\", "\"), "/", "\")  If NormPath$ = ""    ProcedureReturn ""  EndIf  ;  If Mid(NormPath$, 2, 1) = ":" Or Left(NormPath$, 2) = "\\"    If FileSize(NormPath$) > 0      ProcedureReturn NormPath$    EndIf    ProcedureReturn ""  EndIf  ;  If BaseDir$ <> ""    AnchorDir$ = ReplaceString(BaseDir$, "/", "\")  Else    AnchorDir$ = GetCurrentDirectory()  EndIf  If AnchorDir$ <> "" And Right(AnchorDir$, 1) <> "\"    AnchorDir$ + "\"  EndIf  ;  Candidate$ = AnchorDir$ + NormPath$  If FileSize(Candidate$) > 0    ProcedureReturn Candidate$  EndIf  ProcedureReturn ""EndProcedure;Procedure.s TOM_BuildRTFPictFromFile(FilePath$, GoalW, GoalH, ScaleX, ScaleY)  Protected FileID, FileBytes, Offset, SegLen, Marker, idx, ByteVal  Protected PixelW, PixelH, HimetricW, HimetricH, HeaderLen, TotalChars  Protected *RawBuf, *Src.Ascii, *Out.Character  Protected BlipTag$, Header$, PictRTF$  Static Dim HexNibble.c(15)  ;  ; Role: Reads a PNG, JPEG, or EMF image file from disk, parses its native dimensions directly  ;       from its binary header without external decoders, and builds an inline RTF '{\pict ...}' group.  ;  If HexNibble(15) = 0    For idx = 0 To 9   : HexNibble(idx) = '0' + idx      : Next    For idx = 10 To 15 : HexNibble(idx) = 'a' + idx - 10 : Next  EndIf  ;  FileID = ReadFile(#PB_Any, FilePath$, #PB_File_SharedRead)  If FileID = 0    ProcedureReturn ""  EndIf  FileBytes = Lof(FileID)  If FileBytes <= 8    CloseFile(FileID)    ProcedureReturn ""  EndIf  *RawBuf = AllocateMemory(FileBytes, #PB_Memory_NoClear)  If *RawBuf = 0    CloseFile(FileID)    ProcedureReturn ""  EndIf  If ReadData(FileID, *RawBuf, FileBytes) <> FileBytes    FreeMemory(*RawBuf)    CloseFile(FileID)    ProcedureReturn ""  EndIf  CloseFile(FileID)  ;  ; Detect PNG, JPEG, or EMF signature and extract native dimensions directly from binary headers  If FileBytes >= 24 And PeekL(*RawBuf) = $474E5089 And PeekL(*RawBuf + 4) = $0A1A0A0D    BlipTag$ = "\pngblip"    PixelW   = ((PeekA(*RawBuf + 16) << 24) | (PeekA(*RawBuf + 17) << 16) | (PeekA(*RawBuf + 18) << 8) | PeekA(*RawBuf + 19)) & $7FFFFFFF    PixelH   = ((PeekA(*RawBuf + 20) << 24) | (PeekA(*RawBuf + 21) << 16) | (PeekA(*RawBuf + 22) << 8) | PeekA(*RawBuf + 23)) & $7FFFFFFF  ElseIf PeekA(*RawBuf) = $FF And PeekA(*RawBuf + 1) = $D8    BlipTag$ = "\jpegblip"    Offset   = 2    While Offset + 8 < FileBytes And PeekA(*RawBuf + Offset) = $FF      While Offset + 8 < FileBytes And PeekA(*RawBuf + Offset + 1) = $FF        Offset + 1      Wend      Marker = PeekA(*RawBuf + Offset + 1)      If Marker >= $C0 And Marker <= $CF And Marker <> $C4 And Marker <> $C8 And Marker <> $CC        PixelH = (PeekA(*RawBuf + Offset + 5) << 8) | PeekA(*RawBuf + Offset + 6)        PixelW = (PeekA(*RawBuf + Offset + 7) << 8) | PeekA(*RawBuf + Offset + 8)        Break      EndIf      SegLen = (PeekA(*RawBuf + Offset + 2) << 8) | PeekA(*RawBuf + Offset + 3)      If SegLen < 2 : Break : EndIf      Offset + 2 + SegLen    Wend  ElseIf FileBytes >= 88 And PeekL(*RawBuf) = 1 And PeekL(*RawBuf + 40) = $464D4520    BlipTag$  = "\emfblip"    HimetricW = PeekL(*RawBuf + 32) - PeekL(*RawBuf + 24)    HimetricH = PeekL(*RawBuf + 36) - PeekL(*RawBuf + 28)    PixelW    = (HimetricW * 96) / 2540    PixelH    = (HimetricH * 96) / 2540  EndIf  ;  If BlipTag$ = ""    FreeMemory(*RawBuf)    ProcedureReturn ""  EndIf  ;  If PixelW <= 0 : PixelW = 100 : EndIf  If PixelH <= 0 : PixelH = 100 : EndIf  If HimetricW <= 0 : HimetricW = (PixelW * 2540 + 48) / 96 : EndIf  If HimetricH <= 0 : HimetricH = (PixelH * 2540 + 48) / 96 : EndIf  ;  ; Default to 100% native size (15 twips per pixel at 96 DPI) or preserve aspect ratio when one bound is omitted  If GoalW <= 0 And GoalH <= 0    GoalW = PixelW * 15    GoalH = PixelH * 15  ElseIf GoalW <= 0    GoalW = (GoalH * PixelW) / PixelH  ElseIf GoalH <= 0    GoalH = (GoalW * PixelH) / PixelH  EndIf  ;  Header$ = "{\pict" + BlipTag$ + "\picw" + Str(HimetricW) + "\pich" + Str(HimetricH) + "\picwgoal" + Str(GoalW) + "\pichgoal" + Str(GoalH)  If ScaleX > 0 : Header$ + "\picscalex" + Str(ScaleX) : EndIf  If ScaleY > 0 : Header$ + "\picscaley" + Str(ScaleY) : EndIf  Header$ + #CRLF$  ;  HeaderLen  = Len(Header$)  TotalChars = HeaderLen + (FileBytes * 2) + (((FileBytes - 1) / 40) * 2) + 1  PictRTF$   = Space(TotalChars)  CopyMemory(@Header$, @PictRTF$, HeaderLen * SizeOf(Character))  ;  *Src = *RawBuf  *Out = @PictRTF$ + HeaderLen * SizeOf(Character)  For idx = 0 To FileBytes - 1    If idx > 0 And (idx % 40) = 0      *Out\c = #CR : *Out + SizeOf(Character)      *Out\c = #LF : *Out + SizeOf(Character)    EndIf    ByteVal = *Src\a    *Src + 1    *Out\c = HexNibble(ByteVal >> 4)  : *Out + SizeOf(Character)    *Out\c = HexNibble(ByteVal & $0F) : *Out + SizeOf(Character)  Next  *Out\c = '}'  ;  FreeMemory(*RawBuf)  ProcedureReturn PictRTF$EndProcedure;Procedure.s TOM_ResolveRTFIncludePictures(RTF$, BaseDir$ = "")  Protected SearchPos = 1, KwPos, ScanPos, RtfLen, BraceBalance, FieldStart, FieldEnd, RelKwPos  Protected GoalW, GoalH, ScaleX, ScaleY  Protected *Scan.Character, *PathStart.Character  Protected NextCh.c  Protected FieldBlock$, RawPath$, FullImgPath$, PictBlock$  ;  ; Role: Scans an RTF document string for standard Word/RTF '{\field ... INCLUDEPICTURE "..." ...}' groups  ;       and replaces each resolvable linked image with an inline '{\pict ...}' group while honoring  ;       Word's '\picwgoal', '\pichgoal', '\picscalex', and '\picscaley' sizing directives.  ;  Repeat    KwPos = FindString(RTF$, "INCLUDEPICTURE", SearchPos, #PB_String_NoCase)    If KwPos = 0      Break    EndIf    ;    ; Walk backward across balanced braces to find the opening '{\field' of this field group    FieldStart   = 0    BraceBalance = 0    ScanPos      = KwPos - 1    While ScanPos >= 1      *Scan = @RTF$ + (ScanPos - 1) * SizeOf(Character)      If ScanPos = 1 Or PeekC(*Scan - SizeOf(Character)) <> '\'        If *Scan\c = '}'          BraceBalance + 1        ElseIf *Scan\c = '{'          If BraceBalance > 0            BraceBalance - 1          ElseIf LCase(Mid(RTF$, ScanPos, 7)) = "{\field"            NextCh = PeekC(*Scan + 7 * SizeOf(Character))            If NextCh = '{' Or NextCh = '\' Or NextCh = ' ' Or NextCh = #CR Or NextCh = #LF Or NextCh = #TAB              FieldStart = ScanPos              Break            EndIf          EndIf        EndIf      EndIf      ScanPos - 1    Wend    ;    If FieldStart = 0      SearchPos = KwPos + 14      Continue    EndIf    ;    ; Walk forward from FieldStart to find the matching closing '}' of the '{\field ...}' group    FieldEnd     = 0    BraceBalance = 0    RtfLen       = Len(RTF$)    ScanPos      = FieldStart    While ScanPos <= RtfLen      *Scan = @RTF$ + (ScanPos - 1) * SizeOf(Character)      If *Scan\c = '\'        ScanPos + 2        Continue      ElseIf *Scan\c = '{'        BraceBalance + 1      ElseIf *Scan\c = '}'        BraceBalance - 1        If BraceBalance = 0          FieldEnd = ScanPos          Break        EndIf      EndIf      ScanPos + 1    Wend    ;    If FieldEnd = 0      Break    EndIf    ;    FieldBlock$ = Mid(RTF$, FieldStart, FieldEnd - FieldStart + 1)    RelKwPos    = KwPos - FieldStart + 1    *Scan       = @FieldBlock$ + (RelKwPos + 13) * SizeOf(Character)    While *Scan\c = ' ' Or *Scan\c = #TAB Or *Scan\c = #CR Or *Scan\c = #LF      *Scan + SizeOf(Character)    Wend    ;    RawPath$ = ""    If *Scan\c = '"'      *Scan + SizeOf(Character)      *PathStart = *Scan      While *Scan\c <> 0 And *Scan\c <> '"'        *Scan + SizeOf(Character)      Wend      RawPath$ = PeekS(*PathStart, (*Scan - *PathStart) / SizeOf(Character))    ElseIf *Scan\c <> 0 And *Scan\c <> '}'      *PathStart = *Scan      While *Scan\c <> 0 And *Scan\c <> ' ' And *Scan\c <> #TAB And *Scan\c <> '}' And *Scan\c <> '{' And *Scan\c <> #CR And *Scan\c <> #LF        *Scan + SizeOf(Character)      Wend      RawPath$ = PeekS(*PathStart, (*Scan - *PathStart) / SizeOf(Character))    EndIf    ;    PictBlock$   = ""    FullImgPath$ = TOM_ResolveIncludePath(RawPath$, BaseDir$)    If FullImgPath$ <> ""      GoalW      = TOM_ExtractRTFIntTag(FieldBlock$, "\picwgoal")      GoalH      = TOM_ExtractRTFIntTag(FieldBlock$, "\pichgoal")      ScaleX     = TOM_ExtractRTFIntTag(FieldBlock$, "\picscalex")      ScaleY     = TOM_ExtractRTFIntTag(FieldBlock$, "\picscaley")      PictBlock$ = TOM_BuildRTFPictFromFile(FullImgPath$, GoalW, GoalH, ScaleX, ScaleY)    EndIf    ;    If PictBlock$ <> ""      RTF$      = Left(RTF$, FieldStart - 1) + PictBlock$ + Mid(RTF$, FieldEnd + 1)      SearchPos = FieldStart + Len(PictBlock$)    Else      SearchPos = FieldEnd + 1    EndIf  ForEver  ;  ProcedureReturn RTF$EndProcedure;Procedure TOM_InsertText(GadgetID, Text$, StartPos = #AsSelection, EndPos = #AsSelection, BaseDir$ = "")  Protected *pTextRange.ITextRange2  Protected var.VARIANT  Protected *mDataObj.IDataObject  Protected SC = #E_FAIL, UseResolved  Protected ResolvedRTF$  ;  ; Role: Inserts plain Unicode text, RTF text, or UTF-8/ASCII-poked RTF directly into GadgetID at StartPos -> EndPos  ;       using an in-memory IDataObject (leaving the user's Windows clipboard completely untouched).  ;       Automatically resolves any standard RTF 'INCLUDEPICTURE' linked image fields relative to BaseDir$  ;       (or GetCurrentDirectory() when BaseDir$ is omitted).  ; Output: Returns #S_OK (0) on success, or a non-zero COM HRESULT error code.  ;  *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)  If *pTextRange    *mDataObj = CreateIDataObject()    If *mDataObj      If @Text$ And PeekA(@Text$) = '{' And PeekA(@Text$ + 1) = '\'        ResolvedRTF$ = PeekS(@Text$, -1, #PB_Ascii)        If FindString(ResolvedRTF$, "INCLUDEPICTURE", 1, #PB_String_NoCase)          ResolvedRTF$ = TOM_ResolveRTFIncludePictures(ResolvedRTF$, BaseDir$)          UseResolved  = #True        EndIf      ElseIf (Left(Text$, 5) = "{\rtf" Or Left(Text$, 6) = "{\urtf") And FindString(Text$, "INCLUDEPICTURE", 1, #PB_String_NoCase)        ResolvedRTF$ = TOM_ResolveRTFIncludePictures(Text$, BaseDir$)        UseResolved  = #True      EndIf      ;      If (UseResolved And SetIDataObjectText(*mDataObj, ResolvedRTF$)) Or (UseResolved = #False And SetIDataObjectText(*mDataObj, Text$))        var\vt       = #VT_UNKNOWN        var\ppunkVal = *mDataObj        SC = *pTextRange\Paste(@var, 0)        If SC <> #S_OK          TOM_PrintErrorMessage(SC)        EndIf      EndIf      ; Release our creator reference (CreateIDataObject starts with Refcount = 1)      *mDataObj\Release()    EndIf    *pTextRange\Release()  EndIf  ;  ProcedureReturn SCEndProcedure;Procedure.s TOM_GetAvailableFormats(GadgetID, StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Returns a #CR$-separated list of clipboard format names available for the range StartPos -> EndPos,  ;       without touching the Windows clipboard.  ;  Protected *pTextRange.ITextRange2  Protected var.VARIANT  Protected mDataObj.IDataObject  Protected FormatEtc.FORMATETC  Protected enumFormat.IEnumFORMATETC  Protected Formats$  ;  *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)  If *pTextRange    var\vt       = #VT_UNKNOWN | #VT_BYREF    var\ppunkVal = @mDataObj    If *pTextRange\Copy(@var) = #S_OK And mDataObj      If mDataObj\EnumFormatEtc(#DATADIR_GET, @enumFormat) = #S_OK And enumFormat        While enumFormat\Next(1, @FormatEtc, #Null) = #S_OK          Formats$ + GetFormatName(FormatEtc\cfFormat) + #CR$          If FormatEtc\ptd            CoTaskMemFree_(FormatEtc\ptd)            FormatEtc\ptd = #Null          EndIf        Wend        enumFormat\Release()      EndIf      mDataObj\Release()    EndIf    *pTextRange\Release()  EndIf  ;  ProcedureReturn Formats$EndProcedure;Procedure.s TOM_GetText(GadgetID, Format$ = "", StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Extracts the text or RTF representation of StartPos -> EndPos without touching the clipboard.  ; Parameters:  ;   Format$ - Desired format:  ;             • "" / "text" / "cf_text" / "sf_text" / "CF_UNICODETEXT" -> Plain Unicode text  ;             • "RTF" / "cf_rtf" / "sf_rtf" / "Rich Text Format"       -> Standard RTF  ;             • "RTF in UTF8"                                          -> UTF-8 encoded RTF  ;             (Call TOM_GetAvailableFormats() to inspect all supported format names.)  ;  Protected *pTextRange.ITextRange2  Protected var.VARIANT  Protected mDataObj.IDataObject  Protected FormatEtc.FORMATETC  Protected enumFormat.IEnumFORMATETC  Protected stgm.STGMEDIUM  Protected *pGlobalMemory, BufferSize, LowerFmt$, Text$, FoundFmt  ;  LowerFmt$ = LCase(Format$)  If LowerFmt$ = "" Or LowerFmt$ = "text" Or LowerFmt$ = "texte" Or FindString(LowerFmt$, "sf_text") Or FindString(LowerFmt$, "cf_text")    LowerFmt$ = "cf_unicodetext"  ElseIf LowerFmt$ = "rtf" Or FindString(LowerFmt$, "sf_rtf") Or FindString(LowerFmt$, "cf_rtf")    LowerFmt$ = "rich text format"  EndIf  ;  *pTextRange = TOM_GetTextRangeObj(GadgetID, StartPos, EndPos)  If *pTextRange    var\vt       = #VT_UNKNOWN | #VT_BYREF    var\ppunkVal = @mDataObj    If *pTextRange\Copy(@var) = #S_OK And mDataObj      If mDataObj\EnumFormatEtc(#DATADIR_GET, @enumFormat) = #S_OK And enumFormat        While enumFormat\Next(1, @FormatEtc, #Null) = #S_OK          If LCase(GetFormatName(FormatEtc\cfFormat)) = LowerFmt$            FoundFmt = #True            Break          EndIf          If FormatEtc\ptd            CoTaskMemFree_(FormatEtc\ptd)            FormatEtc\ptd = #Null          EndIf        Wend        enumFormat\Release()      EndIf      ;      If FoundFmt        If mDataObj\GetData(@FormatEtc, @stgm) = #S_OK          If stgm\tymed = #TYMED_HGLOBAL And stgm\hGlobal            BufferSize     = GlobalSize_(stgm\hGlobal)            *pGlobalMemory = GlobalLock_(stgm\hGlobal)            If *pGlobalMemory And BufferSize > 0              If LowerFmt$ = "cf_unicodetext"                Text$ = PeekS(*pGlobalMemory, BufferSize / 2, #PB_Unicode)              ElseIf FindString(LowerFmt$, "utf8")                Text$ = PeekS(*pGlobalMemory, BufferSize, #PB_UTF8)              Else                Text$ = PeekS(*pGlobalMemory, BufferSize, #PB_Ascii)              EndIf              GlobalUnlock_(stgm\hGlobal)            EndIf          EndIf          ReleaseStgMedium_(@stgm)        EndIf        If FormatEtc\ptd          CoTaskMemFree_(FormatEtc\ptd)        EndIf      EndIf      mDataObj\Release()    EndIf    *pTextRange\Release()  EndIf  ;  ProcedureReturn Text$EndProcedure;Procedure TOM_InsertTaggedJPGImageFromFile(GadgetID, FileAdr$, marker$ = "", StartPos = #AsSelection, EndPos = #AsSelection)  ;  ; Role: Loads a JPEG/PNG/BMP image from disk, inserts it into GadgetID at StartPos -> EndPos,  ;       and optionally prepends a hidden RTF tag (marker$) right before the image.  ;  Protected Img  ;  UseJPEGImageDecoder()  Img = LoadImage(#PB_Any, FileAdr$)  If Img    StartPos = TOM_GetRealPos(GadgetID, StartPos)    TOM_InsertImage(GadgetID, Img, StartPos, EndPos)    FreeImage(Img)    If marker$ <> ""      TOM_InsertText(GadgetID, "{\rtf1\v " + marker$ + "}", StartPos)    EndIf  Else    MessageRequester("Oops!", "Cannot load image: " + FileAdr$)  EndIfEndProcedure;Procedure TOM_SetGadgetAsRichEdit(GadgetID)  ;  ; Role: Configures an EditorGadget (or RichEdit HWND) for full rich-text mode, automatic word wrap,  ;       and unlimited character capacity.  ;  If IsGadget(GadgetID)    GadgetID = GadgetID(GadgetID)  EndIf  SendMessage_(GadgetID, #EM_SETTEXTMODE, #TM_RICHTEXT, 0)  SendMessage_(GadgetID, #EM_SETTARGETDEVICE, #Null, 0) ; Enable automatic word wrapping  SendMessage_(GadgetID, #EM_LIMITTEXT, -1, 0)          ; Allow unlimited text lengthEndProcedure;CompilerIf #PB_Compiler_IsMainFile  ; The following demo only runs when this file is compiled directly as the main file.  ;  Define EGadget, BFreeze, BUnFreeze, BWordExpand, BSentenceExpand, BFindPossibilities  Define BUCase, BLCase, BTitle, BStopUndoRedo, BEnableUndoRedo, BExamStyle, TGadget  Define MyImage, Info$, StartPos, EndPos, Pos, Event  ;  OleInitialize_(#Null)  ;  If OpenWindow(0, 200, 200, 620, 460, "TOM Library Interactive Example", #PB_Window_ScreenCentered | #PB_Window_SystemMenu)    ;    ; Note: TOM works exclusively with EditorGadgets / RichEdit controls (never StringGadgets or TextGadgets).    EGadget = EditorGadget(#PB_Any, 10, 10, 600, 300)    TOM_SetGadgetAsRichEdit(EGadget)    ;    BFreeze            = ButtonGadget(#PB_Any, 10,  318, 136, 24, "Freeze (uneditable)")    BUnFreeze          = ButtonGadget(#PB_Any, 150, 318, 136, 24, "Unfreeze (editable)")    BWordExpand        = ButtonGadget(#PB_Any, 290, 318, 96,  24, "Word expand")    BSentenceExpand    = ButtonGadget(#PB_Any, 390, 318, 106, 24, "Sentence expand")    BFindPossibilities = ButtonGadget(#PB_Any, 500, 318, 110, 24, "Find 'possibilities'")    ;    BUCase          = ButtonGadget(#PB_Any, 10,  346, 72,  24, "UCase")    BLCase          = ButtonGadget(#PB_Any, 86,  346, 72,  24, "LCase")    BTitle          = ButtonGadget(#PB_Any, 162, 346, 72,  24, "Title")    BStopUndoRedo   = ButtonGadget(#PB_Any, 246, 346, 114, 24, "Stop Undo/Redo")    BEnableUndoRedo = ButtonGadget(#PB_Any, 364, 346, 118, 24, "Enable Undo/Redo")    BExamStyle      = ButtonGadget(#PB_Any, 486, 346, 124, 24, "Selection style")    ;    TGadget = TextGadget(#PB_Any, 10, 378, 600, 74, "")    ;    TOM_InsertText(EGadget, "This is a sample text with image:", #EndOfText)    ;    MyImage = CreateImage(#PB_Any, 80, 80)    If StartDrawing(ImageOutput(MyImage))      Box(0, 0, 80, 80, RGB(255, 255, 255))      Circle(40, 40, 30, RGB(255, 0, 0))      Box(50, 10, 25, 35, RGB(0, 0, 255))      DrawingMode(#PB_2DDrawing_Transparent)      DrawText(18, 32, "Image", RGB(255, 255, 255))      StopDrawing()    EndIf    TOM_InsertImage(EGadget, MyImage, 33)    FreeImage(MyImage)    ;    ; Apply Arial 14.5pt Bold to characters 0 -> 4 (0-based offsets)    TOM_SetFontStyles(EGadget, "Name(Arial), Size(14.5), Bold", 0, 4)    ;    ; Apply multiple styles to "sample" (characters 10 -> 16) — notice standalone "Underline" works cleanly    TOM_SetFontStyles(EGadget, "Size(15), Bold, Italic, Underline, Name(Times New Roman), Position(4)", 10, 16)    ;    ; Apply Wave underline to characters 0 -> 5    TOM_SetFontStyles(EGadget, "Underline(Wave)", 0, 5)    ;    ; Center the first paragraph    TOM_SetParaStyles(EGadget, "Align(Center)", 10, 16)    ;    Info$ = "Character 11: " + TOM_GetFontStyles(EGadget, 11, 12) + #CRLF$    Info$ + "Character 3:  " + TOM_GetFontStyles(EGadget, 3, 4) + #CRLF$    ;    ; Copy all character styles from character 10 to characters 18 -> 20 in a single line (no COM pointer needed!)    TOM_CopyFontStyles(EGadget, 10, 18, 20)    ;    ; Unset specific styles on character 15 (letter "e" of "sample")    TOM_SetFontStyles(EGadget, "Size(15), Bold, Italic, Underline, Name(Times New Roman), Position(4)", 15, 16, #TomFalse)    ;    TOM_InsertText(EGadget, #CR$ + #CR$ + "This is another sample text with more words to explore other paragraph possibilities, including FirstLineIndent for this one.", #EndOfText)    StartPos = TOM_Find(EGadget, "FirstLineIndent", 0)    If StartPos >= 0      TOM_SetFontStyles(EGadget, "ForeColor($0000D0), Bold", StartPos, StartPos + Len("FirstLineIndent"))      TOM_SetParaStyles(EGadget, "Align(Left), FirstLineIndent(20)", StartPos, StartPos + 1)    EndIf    ;    TOM_InsertText(EGadget, #CR$ + #CR$ + "This is another sample text with more words to explore other paragraph possibilities, including LeftIndent for this one.", #EndOfText)    StartPos = TOM_Find(EGadget, "LeftIndent", 0)    If StartPos >= 0      TOM_SetFontStyles(EGadget, "ForeColor($0000D0), Bold", StartPos, StartPos + Len("LeftIndent"))      TOM_SetParaStyles(EGadget, "FirstLineIndent(0), LeftIndent(20)", StartPos, StartPos + 1)    EndIf    ;    TOM_InsertText(EGadget, #CR$ + #CR$ + "This is another sample text with more words to explore other paragraph possibilities, including RightIndent, Justify, LineSpacing, and SpaceBefore for this one. Qui sommes-nous ? Quelle est notre essence, notre véritable identité ? Ces questions nous préoccupent depuis toujours.", #EndOfText)    StartPos = TOM_Find(EGadget, "RightIndent", 0)    If StartPos >= 0      TOM_SetFontStyles(EGadget, "ForeColor($DE7723), Bold", StartPos, StartPos + Len("RightIndent"))      TOM_SetParaStyles(EGadget, "LeftIndent(0), RightIndent(40), Align(Justify), LineSpacing(Exactly,16), SpaceBefore(4)", StartPos, StartPos + 1)      Info$ + "Last Para:    " + TOM_GetParaStyles(EGadget, StartPos, StartPos + 1)    EndIf    ;    ; Highlight remaining keywords dynamically via TOM_Find()    StartPos = TOM_Find(EGadget, "Justify", 0)    If StartPos >= 0      TOM_SetFontStyles(EGadget, "BackColor($00D0D0), Bold", StartPos, StartPos + Len("Justify"))    EndIf    StartPos = TOM_Find(EGadget, "LineSpacing", 0)    If StartPos >= 0      TOM_SetFontStyles(EGadget, "ForeColor($0000D0), Bold", StartPos, StartPos + Len("LineSpacing"))    EndIf    StartPos = TOM_Find(EGadget, "SpaceBefore", 0)    If StartPos >= 0      TOM_SetFontStyles(EGadget, "ForeColor($0000D0), Bold", StartPos, StartPos + Len("SpaceBefore"))    EndIf    ;    SetGadgetText(TGadget, Info$)    ;    Repeat      Event = WaitWindowEvent()      If Event = #PB_Event_Gadget        Select EventGadget()          Case BFreeze            TOM_Freeze(EGadget)          Case BUnFreeze            TOM_Unfreeze(EGadget)          Case BWordExpand            TOM_ExpandSelection(EGadget, "Word")          Case BSentenceExpand            TOM_ExpandSelection(EGadget, "Sentence")          Case BFindPossibilities            Pos = TOM_GetRealPos(EGadget)            If LCase(TOM_GetText(EGadget)) = "possibilities"              Pos + 1            EndIf            Pos = TOM_Find(EGadget, "possibilities", Pos)            If Pos < 0              ; Wrap around to the start of the document when reaching the end              Pos = TOM_Find(EGadget, "possibilities", 0)            EndIf            If Pos >= 0              TOM_SetSelectionPos(EGadget, Pos, Pos + Len("possibilities"))              SetActiveGadget(EGadget)            EndIf          Case BUCase            TOM_SetCase(EGadget, "Upper")          Case BLCase            TOM_SetCase(EGadget, "Lower")          Case BTitle            TOM_SetCase(EGadget, "Title")          Case BStopUndoRedo            TOM_StopUndoRedo(EGadget)          Case BEnableUndoRedo            TOM_EnableUndoRedo(EGadget)          Case BExamStyle            MessageRequester("Selection Styles", "Font: " + TOM_GetFontStyles(EGadget) + #CRLF$ + #CRLF$ + "Paragraph: " + TOM_GetParaStyles(EGadget))        EndSelect      EndIf    Until Event = #PB_Event_CloseWindow  EndIf  ;  OleUninitialize_()CompilerEndIf; IDE Options = PureBasic 6.40 (Windows - x64); CursorPosition = 2257; FirstLine = 692; Folding = AQAEQAAA-; EnableXP; DPIAware