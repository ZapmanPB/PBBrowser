;;***********************************************************;;              --  Add Tool to PureBasic --;       This set of functions by Zapman (Nov. 2026);       is intended to be used by PBBrowser to add or;       remove a tool from PureBasic preference file.;;***********************************************************;Structure AT_ShortCutsNumAndString  ShortcutNum.i  ShortCutString$EndStructure;NewList ShortCutsKeys.AT_ShortCutsNumAndString();Define NData.iRestore AT_NumShortRepeat  Read.i NData  If NData    AddElement(ShortCutsKeys())    ShortCutsKeys()\ShortcutNum = NData  EndIfUntil NData = 0;Restore AT_StringShortForEach ShortCutsKeys()  Read.s ShortCutsKeys()\ShortCutString$Next;Define VKFor VK = #VK_F1 To #VK_F24  AddElement(ShortCutsKeys())  ShortCutsKeys()\ShortcutNum = VK  ShortCutsKeys()\ShortCutString$ = "F" + Str(VK - #VK_F1 + 1)Next;For VK = #VK_NUMPAD0 To #VK_NUMPAD9  AddElement(ShortCutsKeys())  ShortCutsKeys()\ShortcutNum = VK  ShortCutsKeys()\ShortCutString$ = "NUMPAD" + Str(VK - #VK_NUMPAD0)Next;; Add standard digit keys ('0'..'9') and uppercase letter keys ('A'..'Z'), skipping undefined VK codes 58..64For VK = 48 To 57  AddElement(ShortCutsKeys())  ShortCutsKeys()\ShortcutNum = VK  ShortCutsKeys()\ShortCutString$ = Chr(VK)Next;For VK = 65 To 90  AddElement(ShortCutsKeys())  ShortCutsKeys()\ShortcutNum = VK  ShortCutsKeys()\ShortCutString$ = Chr(VK)Next;Procedure IsToolAlreadyInstalled(toolName$)  ;  ; Role: Checks whether an exact "MenuItemName = <toolName$>" entry exists inside PureBasic's Tools.prefs.  ; Output: Returns #True (1) if installed, or #False (0) otherwise.  ;  Protected PBPrefAdr$, configFile$, configLine$  Protected FileID, Format, Result  ;  PBPrefAdr$ = GetPureBasicPrefAdress()  If PBPrefAdr$ = ""    ProcedureReturn 0  EndIf  configFile$ = GetPathPart(PBPrefAdr$) + "Tools.prefs"  ;  FileID = ReadFile(#PB_Any, configFile$)  If FileID    Format = ReadStringFormat(FileID)    If Format = #PB_Ascii : Format = #PB_UTF8 : EndIf    While Eof(FileID) = 0      configLine$ = Trim(ReadString(FileID, Format))      If configLine$ = "MenuItemName = " + toolName$        Result = 1        Break      EndIf    Wend    CloseFile(FileID)  EndIf  ;  ProcedureReturn ResultEndProcedure;Procedure.s ComputeShortcutString(value.i)  ;  ; Role: Converts a PureBasic numeric shortcut bitmask into a human-readable combination (e.g., "CTRL + Q").  ;  Shared ShortCutsKeys()  Protected keyComb$  Protected ct  ;  ct = 0  ForEach ShortCutsKeys()    ; Decode modifier bit flags first (CTRL, SHIFT, ALT, CMD occupy indices 0..3)    If ct <= 3      If value & ShortCutsKeys()\ShortcutNum        keyComb$ + ShortCutsKeys()\ShortCutString$ + " + "        value & ~ShortCutsKeys()\ShortcutNum      EndIf    ElseIf value = ShortCutsKeys()\ShortcutNum      ProcedureReturn keyComb$ + ShortCutsKeys()\ShortCutString$    EndIf    ct + 1  Next  ;  If value    Debug "ComputeShortcutString - not decoded: " + Str(value)  EndIf  ProcedureReturn ""EndProcedure;Procedure.i ComputeShortcutValue(keyComb$)  ;  ; Role: Converts a human-readable shortcut string (e.g., "CTRL + SHIFT + F") into its numeric bitmask.  ;       Returns 0 if keyComb$ is empty or only contains modifier keys without a base key.  ;  Shared ShortCutsKeys()  Protected part$  Protected value.i, i.i, HasBaseKey  ;  If Trim(keyComb$) = ""    ProcedureReturn 0  EndIf  ;  i = 1  Repeat    part$ = Trim(StringField(keyComb$, i, " + "))    If part$ <> ""      ForEach ShortCutsKeys()        If part$ = ShortCutsKeys()\ShortCutString$          value | ShortCutsKeys()\ShortcutNum          If ListIndex(ShortCutsKeys()) > 3            HasBaseKey = #True          EndIf          Break        EndIf      Next    EndIf    i + 1  Until part$ = ""  ;  If HasBaseKey = #False    ProcedureReturn 0  EndIf  ;  ProcedureReturn valueEndProcedure;Structure CSCTitleAndButtons  CaptureShortCutsTitle$  UsedShortCutsTitle$  Explanation$  EraseTitle$  CancelButtonTitle$  OKButtonTitle$  IsAllreadyUsed$  DefaultShortCut$EndStructure;Procedure CaptureShortCut(UsedShortCutsList$ = "", *GadgetTitles.CSCTitleAndButtons = 0, AllowMouseButtons = #False)  ;  ; Role: Opens a modal dialog prompting the user to press a keyboard shortcut combination.  ; Parameters:  ;   UsedShortCutsList$ - Optional #CR$-separated list of "Command = SHORTCUT" lines already assigned.  ;   *GadgetTitles      - Optional localized labels (falls back to English defaults for empty fields).  ;   AllowMouseButtons  - When #True, allows capturing RBUTTON and MBUTTON; when #False, ignores mouse clicks.  ; Output: Returns the numeric shortcut value (0 if erased/none), or -1 if canceled.  ;  Shared ShortCutsKeys()  Static GadgetTitles.CSCTitleAndButtons  Protected WWidth, WHeight, OX, OY, ParentWindowID  Protected WShortCut, TShortCut, LShortCut, BOK, LShift, BErase, BCancel, FG, TG, TG2, ListFont  Protected Event, PTime, somekey, HasBaseKey, VKNum, Result  Protected KeyComb$, mKeyComb$, GadgetList$  ;  If *GadgetTitles    GadgetTitles\CaptureShortCutsTitle$ = *GadgetTitles\CaptureShortCutsTitle$    GadgetTitles\UsedShortCutsTitle$    = *GadgetTitles\UsedShortCutsTitle$    GadgetTitles\Explanation$           = *GadgetTitles\Explanation$    GadgetTitles\EraseTitle$            = *GadgetTitles\EraseTitle$    GadgetTitles\CancelButtonTitle$     = *GadgetTitles\CancelButtonTitle$    GadgetTitles\OKButtonTitle$         = *GadgetTitles\OKButtonTitle$    GadgetTitles\IsAllreadyUsed$        = *GadgetTitles\IsAllreadyUsed$    GadgetTitles\DefaultShortCut$       = *GadgetTitles\DefaultShortCut$  EndIf  ;  If GadgetTitles\CaptureShortCutsTitle$ = "" : GadgetTitles\CaptureShortCutsTitle$ = "Choose your shortcut"                  : EndIf  If GadgetTitles\UsedShortCutsTitle$ = ""    : GadgetTitles\UsedShortCutsTitle$    = "List of keyboard shortcuts already used:" : EndIf  If GadgetTitles\Explanation$ = ""           : GadgetTitles\Explanation$           = "By pressing the keys on your keyboard, choose the keyboard shortcut you want to use." : EndIf  If GadgetTitles\EraseTitle$ = ""            : GadgetTitles\EraseTitle$            = "Erase"            : EndIf  If GadgetTitles\CancelButtonTitle$ = ""     : GadgetTitles\CancelButtonTitle$     = "Cancel"           : EndIf  If GadgetTitles\OKButtonTitle$ = ""         : GadgetTitles\OKButtonTitle$         = "OK"               : EndIf  If GadgetTitles\IsAllreadyUsed$ = ""        : GadgetTitles\IsAllreadyUsed$        = "is already used"  : EndIf  If GadgetTitles\DefaultShortCut$ = ""       : GadgetTitles\DefaultShortCut$       = "CTRL + Q"         : EndIf  ;  If UsedShortCutsList$ <> ""    WWidth  = 530    WHeight = 400  Else    WWidth  = 320    WHeight = 200  EndIf  ;  ParentWindowID = ComputeWinOrigins(@OX, @OY, WWidth, WHeight, GPBBGadgets\PBBWindow)  WShortCut = OpenWindow(#PB_Any, OX, OY, WWidth, WHeight, GadgetTitles\CaptureShortCutsTitle$, #PB_Window_SystemMenu, ParentWindowID)  If WShortCut    ApplyDarkModeToWindow(WShortCut)    StickyWindow(WShortCut, 1)    ;    If UsedShortCutsList$ <> ""      LShift = 270      FG = FrameGadget(#PB_Any, LShift, 0, 1, WindowHeight(WShortCut), "", #PB_Frame_Single)      GadgetList$ + Str(FG) + ","      TG = TextGadget(#PB_Any, 5, 7, LShift - 10, 20, GadgetTitles\UsedShortCutsTitle$, #PB_Text_Center)      GadgetList$ + Str(TG) + ","      LShortCut = EditorGadget(#PB_Any, 5, 30, LShift - 10, WindowHeight(WShortCut) - 37, #PB_Editor_ReadOnly)      GadgetList$ + Str(LShortCut) + ","      SendMessage_(GadgetID(LShortCut), #EM_SETTARGETDEVICE, #Null, 0)      SetGadgetText(LShortCut, UsedShortCutsList$)    EndIf    ;    TG2 = TextGadget(#PB_Any, LShift + 10, WHeight / 5 - 20, WindowWidth(WShortCut) - LShift - 20, 70, GadgetTitles\Explanation$, #PB_Text_Center)    GadgetList$ + Str(TG2) + ","    TShortCut = TextGadget(#PB_Any, LShift + 30, WindowHeight(WShortCut) / 2 - 10, WindowWidth(WShortCut) - LShift - 60, 25, "", #PB_Text_Center | #PB_Text_Border)    GadgetList$ + Str(TShortCut) + ","    SetGadgetColor(TShortCut, #PB_Gadget_BackColor, RGB(230, 230, 230))    If FindString("= " + UsedShortCutsList$ + #CR$, "= " + GadgetTitles\DefaultShortCut$ + #CR$) = 0      SetGadgetText(TShortCut, GadgetTitles\DefaultShortCut$)    EndIf    ;    BErase = ButtonGadget(#PB_Any, LShift + (WindowWidth(WShortCut) - LShift - 100) / 2, WindowHeight(WShortCut) / 2 + 25, 100, 25, GadgetTitles\EraseTitle$)    GadgetList$ + Str(BErase) + ","    BOK = ButtonGadget(#PB_Any, WindowWidth(WShortCut) - 110, WindowHeight(WShortCut) - 35, 100, 25, GadgetTitles\OKButtonTitle$)    GadgetList$ + Str(BOK) + ","    BCancel = ButtonGadget(#PB_Any, LShift + 10, WindowHeight(WShortCut) - 35, 130, 25, GadgetTitles\CancelButtonTitle$)    GadgetList$ + Str(BCancel) + ","    ;    SetFontAndGadgetsColors(WShortCut, InterfaceColorPresets(), GadgetList$)    If LShortCut And IsGadget(LShortCut)      ListFont = LoadFont(#PB_Any, "Consolas", 9)      If ListFont        SetGadgetFont(LShortCut, FontID(ListFont))      EndIf    EndIf    ;    ; Drain any residual key state (e.g., Enter or menu shortcut still held down while opening the dialog)    ClearKeyboardBuffer(WShortCut)    Repeat      somekey = 0      If GetAsyncKeyState_(#VK_CONTROL) & $8000 Or GetAsyncKeyState_(#VK_SHIFT) & $8000 Or GetAsyncKeyState_(#VK_MENU) & $8000 Or GetAsyncKeyState_(#VK_RETURN) & $8000        somekey = 1      EndIf      If somekey        WindowEvent()        Delay(10)      EndIf    Until somekey = 0    ;    Result = -2    Repeat      Event = WaitWindowEvent(20)      If Event And EventWindow() <> WShortCut        SetActiveWindow(WShortCut)      EndIf      If LShortCut And GetActiveGadget() = LShortCut        ; Hide the blinking caret inside the read-only shortcut list        SetActiveGadget(TShortCut)      EndIf      ;      Select Event        Case #PB_Event_Gadget          Select EventGadget()            Case BOK              Result = ComputeShortcutValue(GetGadgetText(TShortCut))              Break            Case BErase              KeyComb$  = ""              mKeyComb$ = ""              SetGadgetText(TShortCut, "")            Case BCancel              Result = -1              Break          EndSelect          ;        Case #PB_Event_CloseWindow          Result = -1          Break      EndSelect      ;      ; Only poll global hardware key states while our capture dialog actually owns foreground focus      If GetActiveWindow() = WShortCut        KeyComb$   = ""        HasBaseKey = #False        ;        If GetAsyncKeyState_(#VK_CONTROL) & $8000 Or GetAsyncKeyState_(#VK_LCONTROL) & $8000 Or GetAsyncKeyState_(#VK_RCONTROL) & $8000 : KeyComb$ + "CTRL + "  : EndIf        If GetAsyncKeyState_(#VK_SHIFT)   & $8000 Or GetAsyncKeyState_(#VK_LSHIFT)   & $8000 Or GetAsyncKeyState_(#VK_RSHIFT)   & $8000 : KeyComb$ + "SHIFT + " : EndIf        If GetAsyncKeyState_(#VK_MENU)    & $8000 Or GetAsyncKeyState_(#VK_LMENU)    & $8000 Or GetAsyncKeyState_(#VK_RMENU)    & $8000 : KeyComb$ + "ALT + "   : EndIf        If GetAsyncKeyState_(#VK_LWIN)    & $8000 Or GetAsyncKeyState_(#VK_RWIN)     & $8000                                            : KeyComb$ + "CMD + "   : EndIf        ;        ForEach ShortCutsKeys()          If ListIndex(ShortCutsKeys()) > 3            VKNum = ShortCutsKeys()\ShortcutNum            If AllowMouseButtons = #False And (VKNum = #VK_RBUTTON Or VKNum = #VK_MBUTTON)              Continue            EndIf            If GetAsyncKeyState_(VKNum) & $8000              KeyComb$ + ShortCutsKeys()\ShortCutString$ + " + "              HasBaseKey = #True              Break ; Accept a single non-modifier base key per combination            EndIf          EndIf        Next        ;        ; Only commit a combination once a real base key is pressed alongside optional modifiers        If HasBaseKey          If CountString(KeyComb$, " +") < CountString(mKeyComb$, " +")            KeyComb$ = mKeyComb$          Else            mKeyComb$ = KeyComb$          EndIf          KeyComb$ = Left(KeyComb$, Len(KeyComb$) - 3)          SetGadgetText(TShortCut, KeyComb$)          ;          If UsedShortCutsList$ <> "" And FindString("= " + UsedShortCutsList$ + #CR$, "= " + KeyComb$ + #CR$)            PlaySound_("SystemExclamation", 0, #SND_ALIAS | #SND_ASYNC)            SetGadgetText(TShortCut, KeyComb$ + " " + GadgetTitles\IsAllreadyUsed$ + ".")            PTime = ElapsedMilliseconds()            ; Wait for all keys to be released while keeping the UI responsive            Repeat              somekey = 0              If GetAsyncKeyState_(#VK_CONTROL) & $8000 Or GetAsyncKeyState_(#VK_SHIFT) & $8000 Or GetAsyncKeyState_(#VK_MENU) & $8000                somekey = 1              Else                ForEach ShortCutsKeys()                  If ListIndex(ShortCutsKeys()) > 3 And GetAsyncKeyState_(ShortCutsKeys()\ShortcutNum) & $8000                    somekey = 1                    Break                  EndIf                Next              EndIf              WindowEvent()              Delay(10)            Until somekey = 0            ; Paint the collision warning immediately and keep queued button/close clicks intact            UpdateWindow_(WindowID(WShortCut))            While ElapsedMilliseconds() - PTime < 1000              Delay(20)            Wend            SetGadgetText(TShortCut, "")            KeyComb$  = ""            mKeyComb$ = ""          EndIf        ElseIf KeyComb$ = ""          mKeyComb$ = ""        EndIf      EndIf    ForEver    ;    CloseWindow(WShortCut)    If ListFont      FreeFont(ListFont)    EndIf  EndIf  ;  ClearKeyboardBuffer()  ProcedureReturn ResultEndProcedure;Procedure InitButtonsNamesForCaptureSC(*NameList.CSCTitleAndButtons)  ;  ; Role: Populates *NameList with localized strings from PBBrowser's language catalog.  ;  *NameList\CaptureShortCutsTitle$ = GetTextFromCatalogPB("CaptureShortCutsTitle")  *NameList\UsedShortCutsTitle$    = GetTextFromCatalogPB("UsedShortCutsTitle")  *NameList\Explanation$           = GetTextFromCatalogPB("AT_Explanations")  *NameList\EraseTitle$            = GetTextFromCatalogPB("Erase")  *NameList\CancelButtonTitle$     = GetTextFromCatalogPB("Cancel")  *NameList\OKButtonTitle$         = GetTextFromCatalogPB("OK")  *NameList\IsAllreadyUsed$        = GetTextFromCatalogPB("IsAllreadyUsed")  *NameList\DefaultShortCut$       = "CTRL + Q"EndProcedure;Procedure.s ComputeBackupFileName(PBPrefAdr$)  ;  ; Role: Rotates up to 5 backup copies (ToolsBak1.prefs .. ToolsBak5.prefs) and returns the next available path.  ;  Protected BaseDir$, backupFile$  Protected NoVersion, nnum, ct  ;  BaseDir$ = GetPathPart(PBPrefAdr$)  Repeat    NoVersion + 1    backupFile$ = BaseDir$ + "ToolsBak" + Str(NoVersion) + ".prefs"  Until FileSize(backupFile$) < 0  ;  If NoVersion > 5    For ct = 1 To NoVersion - 5      DeleteFile(BaseDir$ + "ToolsBak" + Str(ct) + ".prefs")    Next    For ct = NoVersion - 4 To NoVersion - 1      nnum + 1      RenameFile(BaseDir$ + "ToolsBak" + Str(ct) + ".prefs", BaseDir$ + "ToolsBak" + Str(nnum) + ".prefs")    Next    backupFile$ = BaseDir$ + "ToolsBak" + Str(nnum + 1) + ".prefs"  EndIf  ;  ProcedureReturn backupFile$EndProcedure;;Enumeration ReturnValuesForAddToolToToolsPrefs  #AT_ToolInstallationAborted  #AT_ToolAllreadyInstalled  #AT_ToolInstalledSuccessfully  #AT_ToolExeNotFound  #AT_UnableToFindPBPref  #AT_UnableToCreateToolsConfigFile  #AT_UnableToReadToolsConfigFile  #AT_UnableToBackUpToolsConfigFile  #AT_UnableToOpenPBPref  #AT_UnableToModifyToolsConfigFileEndEnumeration;Enumeration ReturnValuesForRemoveToolToToolsPrefs  #ATR_ToolNotInstalled  #ATR_ToolRemovedSuccessfully  #ATR_UnableToFindPBPref  #ATR_UnableToReadToolsConfigFile  #ATR_UnableToBackUpToolsConfigFile  #ATR_UnableToModifyToolsConfigFileEndEnumeration;Structure AT_ShortCutsAssociation  FunctionName$  ShortCut$  SortOrder.iEndStructure;Procedure.i AT_ComputeShortcutSortOrder(ShortcutVal.i)  ;  ; Role: Computes a deterministic integer sort key grouping shortcuts cleanly by:  ;       1) Modifier count (0, 1, 2, 3, 4),  ;       2) Modifier priority (CTRL -> SHIFT -> ALT -> CMD),  ;       3) Base key category (A..Z, 0..9, F1..F24 in numeric order, NUMPAD, other special keys).  ;  Protected VK, ModCount, ModMask, KeyRank  ;  If ShortcutVal & #PB_Shortcut_Control : ModCount + 1 : ModMask | 1 : EndIf  If ShortcutVal & #PB_Shortcut_Shift   : ModCount + 1 : ModMask | 2 : EndIf  If ShortcutVal & #PB_Shortcut_Alt     : ModCount + 1 : ModMask | 4 : EndIf  If ShortcutVal & #PB_Shortcut_Command : ModCount + 1 : ModMask | 8 : EndIf  ;  VK = ShortcutVal & $FFFF  If VK >= 'A' And VK <= 'Z'    KeyRank = 1000 + VK  ElseIf VK >= '0' And VK <= '9'    KeyRank = 2000 + VK  ElseIf VK >= #VK_F1 And VK <= #VK_F24    KeyRank = 3000 + (VK - #VK_F1)  ElseIf VK >= #VK_NUMPAD0 And VK <= #VK_DIVIDE    KeyRank = 4000 + VK  Else    KeyRank = 5000 + VK  EndIf  ;  ProcedureReturn (ModCount * 1000000) + (ModMask * 10000) + KeyRankEndProcedure;Procedure.s AT_ReadPrefFileContent(FilePath$, *Success.Integer)  ;  ; Role: Reads an entire PureBasic preference file using #PB_Any while preserving its text encoding.  ;  Protected FileID, Format  Protected Content$  ;  If *Success : *Success\i = #False : EndIf  FileID = ReadFile(#PB_Any, FilePath$)  If FileID    Format = ReadStringFormat(FileID)    If Format = #PB_Ascii : Format = #PB_UTF8 : EndIf    While Eof(FileID) = 0      Content$ + ReadString(FileID, Format) + #CRLF$    Wend    CloseFile(FileID)    If *Success : *Success\i = #True : EndIf  EndIf  ;  ProcedureReturn Content$EndProcedure;Procedure AT_WritePrefFileContent(FilePath$, Content$)  ;  ; Role: Writes Content$ to disk in UTF-8 (with BOM, matching PureBasic IDE's native .prefs format) via #PB_Any.  ;  Protected FileID  ;  FileID = CreateFile(#PB_Any, FilePath$, #PB_UTF8)  If FileID    WriteStringFormat(FileID, #PB_UTF8)    WriteString(FileID, Content$, #PB_UTF8)    CloseFile(FileID)    ProcedureReturn #True  EndIf  ;  ProcedureReturn #FalseEndProcedure;Procedure.s AT_RemoveAndRenumberTools(configContent$, toolNameToRemove$, *NewToolCount.Integer = #Null, *RemovedCount.Integer = #Null)  ;  ; Role: Parses Tools.prefs content section by section, removes any [Tool_X] section whose trimmed  ;       MenuItemName matches toolNameToRemove$ (if non-empty), renumbers all remaining tool sections  ;       sequentially from [Tool_0] to [Tool_{N-1}], preserves any other sections, and updates ToolCount.  ;  Protected NewList Sections.s()  Protected Header$, Footer$, Body$, Line$, Trimmed$, Result$  Protected LineCount, i, SectionMode, IsTargetTool, KeptCount, Removed, ToolCountUpdated  ;  LineCount = CountString(configContent$, #CRLF$) + 1  For i = 1 To LineCount    Line$    = StringField(configContent$, i, #CRLF$)    Trimmed$ = Trim(Line$)    If i = LineCount And Line$ = ""      Break    EndIf    If Left(Trimmed$, 1) = "[" And Right(Trimmed$, 1) = "]"      If Left(LCase(Trimmed$), 6) = "[tool_"        SectionMode = 1        AddElement(Sections())        Sections() = Line$ + #CRLF$      ElseIf SectionMode = 0        Header$ + Line$ + #CRLF$      Else        SectionMode = 2        Footer$ + Line$ + #CRLF$      EndIf    ElseIf SectionMode = 1      Sections() + Line$ + #CRLF$    ElseIf SectionMode = 2      Footer$ + Line$ + #CRLF$    Else      Header$ + Line$ + #CRLF$    EndIf  Next  ;  ; Filter out matching tool(s) using trimmed line matching and renumber surviving sections from [Tool_0]  ForEach Sections()    IsTargetTool = #False    If toolNameToRemove$ <> ""      LineCount = CountString(Sections(), #CRLF$)      For i = 2 To LineCount        If Trim(StringField(Sections(), i, #CRLF$)) = "MenuItemName = " + toolNameToRemove$          IsTargetTool = #True          Break        EndIf      Next    EndIf    If IsTargetTool      Removed + 1    Else      Body$ = Mid(Sections(), FindString(Sections(), #CRLF$) + 2)      Result$ + "[Tool_" + Str(KeptCount) + "]" + #CRLF$ + Body$      KeptCount + 1    EndIf  Next  Result$ + Footer$  ;  ; Rebuild the header with the exact updated ToolCount  Body$     = ""  LineCount = CountString(Header$, #CRLF$)  For i = 1 To LineCount    Line$ = StringField(Header$, i, #CRLF$)    If Left(Trim(Line$), 10) = "ToolCount " Or Left(Trim(Line$), 10) = "ToolCount="      Body$ + "ToolCount = " + Str(KeptCount) + #CRLF$      ToolCountUpdated = #True    Else      Body$ + Line$ + #CRLF$    EndIf  Next  If ToolCountUpdated = #False    Body$ = #CRLF$ + ";  PureBasic IDE ToolsMenu Configuration" + #CRLF$ + ";" + #CRLF$ + "[ToolsInfo]" + #CRLF$ + "ToolCount = " + Str(KeptCount) + #CRLF$ + ";" + #CRLF$ + ";" + #CRLF$ + Body$  EndIf  ;  If *NewToolCount : *NewToolCount\i = KeptCount : EndIf  If *RemovedCount : *RemovedCount\i = Removed   : EndIf  ProcedureReturn Body$ + Result$EndProcedure;Procedure AddToolToToolsPrefs(toolName$, toolExe$, PortableMode)  ;  ; Role: Adds or updates toolName$ inside PureBasic's Tools.prefs after prompting for a shortcut.  ;       Existing entries are never removed if the user cancels the shortcut dialog, and all  ;       remaining tools stay sequentially numbered ([Tool_0] .. [Tool_{N-1}]).  ;  Protected NewList ExistingShortCuts.AT_ShortCutsAssociation()  Protected CSGadgetNames.CSCTitleAndButtons  Protected PBPrefAdr$, configFile$, backupFile$, configContent$, newTool$  Protected SrcPath$, NewToolAdress$, line$, currentSection$, FunctionName$, value$  Protected MenuItemName$, Shortcut$, CurrentToolShortcut$, UsedShortCutsList$  Protected toolArguments$, toolWorkDir$, toolShortcut$, toolTrigger$  Protected TryUp, ReadOK, FileID, Format, ShortcutVal, toolCount, eqPos  ;  If #PB_Compiler_Debugger    ; Running from the IDE debugger: locate the compiled standalone executable in current or parent folders    SrcPath$ = GetPathPart(#PB_Compiler_File)    If SrcPath$ <> ""      Repeat        TryUp + 1        NewToolAdress$ = SrcPath$ + toolExe$        If FileSize(NewToolAdress$) <= 0          SrcPath$ = GetParentFolder(SrcPath$)        EndIf      Until TryUp > 3 Or FileSize(NewToolAdress$) > 0      If FileSize(NewToolAdress$) <= 0        AlertInPBBWindow(GetTextFromCatalogPB("UnableToFindPBBrowser"))        NewToolAdress$ = OpenFileRequester(GetTextFromCatalogPB("ShowPBBrowserPath"), GetSystemFolder(#CSIDL_PROGRAM_FILES) + "\" + toolExe$, toolExe$, 0)      EndIf      If FileSize(NewToolAdress$) <= 0        ProcedureReturn #AT_ToolExeNotFound      EndIf    Else      ProcedureReturn #AT_ToolExeNotFound    EndIf  Else    NewToolAdress$ = ProgramFilename()  EndIf  ;  PBPrefAdr$ = GetPureBasicPrefAdress()  If PBPrefAdr$ = ""    ProcedureReturn #AT_UnableToFindPBPref  EndIf  configFile$ = GetPathPart(PBPrefAdr$) + "Tools.prefs"  backupFile$ = ComputeBackupFileName(PBPrefAdr$)  ;  ; Load existing Tools.prefs or prepare a fresh in-memory skeleton without touching disk before confirmation  If FileSize(configFile$) < 0    configContent$ = #CRLF$ + ";  PureBasic IDE ToolsMenu Configuration" + #CRLF$ + ";" + #CRLF$ + "[ToolsInfo]" + #CRLF$ + "ToolCount = 0" + #CRLF$ + ";" + #CRLF$ + ";" + #CRLF$  Else    configContent$ = AT_ReadPrefFileContent(configFile$, @ReadOK)    If ReadOK = #False      ProcedureReturn #AT_UnableToReadToolsConfigFile    EndIf    ;    ; Collect shortcuts already used by OTHER tools in Tools.prefs regardless of key order inside [Tool_X]    currentSection$ = ""    MenuItemName$   = ""    ShortcutVal     = 0    FileID = ReadFile(#PB_Any, configFile$)    If FileID      Format = ReadStringFormat(FileID)      If Format = #PB_Ascii : Format = #PB_UTF8 : EndIf      Repeat        If Eof(FileID)          line$ = "[End]"        Else          line$ = Trim(ReadString(FileID, Format))        EndIf        If Left(line$, 1) = "[" And Right(line$, 1) = "]"          If currentSection$ <> "" And MenuItemName$ <> "" And ShortcutVal <> 0            Shortcut$ = ComputeShortcutString(ShortcutVal)            If Shortcut$ <> ""              If MenuItemName$ = toolName$                CurrentToolShortcut$ = Shortcut$              Else                AddElement(ExistingShortCuts())                ExistingShortCuts()\FunctionName$ = MenuItemName$                ExistingShortCuts()\ShortCut$     = Shortcut$                ExistingShortCuts()\SortOrder     = AT_ComputeShortcutSortOrder(ShortcutVal)              EndIf            EndIf          EndIf          If Left(LCase(line$), 6) = "[tool_"            currentSection$ = line$          Else            currentSection$ = ""          EndIf          MenuItemName$ = ""          ShortcutVal   = 0        ElseIf currentSection$ <> ""          If Left(line$, 15) = "MenuItemName = "            MenuItemName$ = Trim(Mid(line$, 16))          ElseIf Left(line$, 11) = "Shortcut = "            ShortcutVal = Val(Trim(Mid(line$, 12)))          EndIf        EndIf      Until line$ = "[End]"      CloseFile(FileID)    EndIf  EndIf  ;  ; Collect non-null IDE shortcuts from PureBasic.prefs ([Shortcuts] section)  currentSection$ = ""  FileID = ReadFile(#PB_Any, PBPrefAdr$)  If FileID    Format = ReadStringFormat(FileID)    If Format = #PB_Ascii : Format = #PB_UTF8 : EndIf    While Eof(FileID) = 0      line$ = Trim(ReadString(FileID, Format))      If Left(line$, 1) = "[" And Right(line$, 1) = "]"        currentSection$ = Mid(line$, 2, Len(line$) - 2)      ElseIf currentSection$ = "Shortcuts" And line$ <> "" And Left(line$, 1) <> ";"        eqPos = FindString(line$, "=")        If eqPos > 1          FunctionName$ = Trim(Left(line$, eqPos - 1))          value$        = Trim(Mid(line$, eqPos + 1))          ShortcutVal   = Val(value$)          If ShortcutVal <> 0            Shortcut$ = ComputeShortcutString(ShortcutVal)            If Shortcut$ <> ""              AddElement(ExistingShortCuts())              ExistingShortCuts()\FunctionName$ = FunctionName$              ExistingShortCuts()\ShortCut$     = Shortcut$              ExistingShortCuts()\SortOrder     = AT_ComputeShortcutSortOrder(ShortcutVal)            EndIf          EndIf        EndIf      EndIf    Wend    CloseFile(FileID)  Else    ProcedureReturn #AT_UnableToOpenPBPref  EndIf  ;  ; Sort shortcuts by their precomputed integer rank (modifier group -> key category)  SortStructuredList(ExistingShortCuts(), #PB_Sort_Ascending, OffsetOf(AT_ShortCutsAssociation\SortOrder), TypeOf(AT_ShortCutsAssociation\SortOrder))  ;  ForEach ExistingShortCuts()    UsedShortCutsList$ + ExistingShortCuts()\FunctionName$ + " = " + ExistingShortCuts()\ShortCut$ + #CR$  Next  ;  ; Configure localized labels (pre-filling the tool's existing shortcut if it was already installed)  InitButtonsNamesForCaptureSC(@CSGadgetNames)  CSGadgetNames\CancelButtonTitle$     = GetTextFromCatalogPB("AT_DontInstall")  CSGadgetNames\CaptureShortCutsTitle$ = GetTextFromCatalogPB("PBCaptureTitle")  CSGadgetNames\Explanation$           = GetTextFromCatalogPB("PBSC_Explanations")  If CurrentToolShortcut$ <> ""    CSGadgetNames\DefaultShortCut$ = CurrentToolShortcut$  EndIf  ;  ShortcutVal = CaptureShortCut(UsedShortCutsList$, @CSGadgetNames, #False)  If ShortcutVal = -1    ; User canceled: return immediately without altering or removing any existing Tools.prefs entry    ProcedureReturn #AT_ToolInstallationAborted  EndIf  ;  ; Back up Tools.prefs right before modifying it  If AT_WritePrefFileContent(backupFile$, configContent$) = #False    ProcedureReturn #AT_UnableToBackUpToolsConfigFile  EndIf  ;  ; Remove any prior entry for toolName$ and renumber existing sections cleanly from [Tool_0] upward  configContent$ = AT_RemoveAndRenumberTools(configContent$, toolName$, @toolCount)  ;  toolArguments$ = #DOUBLEQUOTE$ + "%HOME" + #DOUBLEQUOTE$ + " " + #DOUBLEQUOTE$ + "%WORD" + #DOUBLEQUOTE$ + " " + #DOUBLEQUOTE$ + "%SELECTION" + #DOUBLEQUOTE$ + " " + #DOUBLEQUOTE$ + "%CURSOR" + #DOUBLEQUOTE$ + " " + #DOUBLEQUOTE$ + "%FILE" + #DOUBLEQUOTE$ + " " + #DOUBLEQUOTE$ + "%TEMPFILE" + #DOUBLEQUOTE$  If PortableMode    toolArguments$ = "\PORTABLE " + toolArguments$  EndIf  toolWorkDir$  = GetPathPart(NewToolAdress$)  toolShortcut$ = Str(ShortcutVal)  toolTrigger$  = "0"  ;  newTool$ = "[Tool_" + Str(toolCount) + "]" + #CRLF$  newTool$ + "Command = " + NewToolAdress$ + #CRLF$  newTool$ + "Arguments = " + toolArguments$ + #CRLF$  newTool$ + "WorkingDir = " + toolWorkDir$ + #CRLF$  newTool$ + "MenuItemName = " + toolName$ + #CRLF$  newTool$ + "Shortcut = " + toolShortcut$ + #CRLF$  newTool$ + "ConfigLine = " + #CRLF$  newTool$ + "Trigger = " + toolTrigger$ + #CRLF$  newTool$ + "Flags = 0" + #CRLF$  newTool$ + "ReloadSource = 0" + #CRLF$  newTool$ + "HideEditor = 0" + #CRLF$  newTool$ + "HideFromMenu = 0" + #CRLF$  newTool$ + "SourceSpecific = 0" + #CRLF$  newTool$ + "Deactivate = 0" + #CRLF$  ;  configContent$ = ReplaceString(configContent$, "ToolCount = " + Str(toolCount), "ToolCount = " + Str(toolCount + 1))  configContent$ + newTool$  ;  If AT_WritePrefFileContent(configFile$, configContent$)    ProcedureReturn #AT_ToolInstalledSuccessfully  EndIf  ;  ProcedureReturn #AT_UnableToModifyToolsConfigFileEndProcedure;Procedure RemoveToolToToolsPrefs(toolName$)  ;  ; Role: Backs up PureBasic's Tools.prefs, removes toolName$, and renumbers all remaining  ;       [Tool_0 .. Tool_{N-1}] sections sequentially so the PureBasic IDE never loses subsequent tools.  ;  Protected PBPrefAdr$, configFile$, backupFile$, configContent$  Protected ReadOK, RemovedCount  ;  PBPrefAdr$ = GetPureBasicPrefAdress()  If PBPrefAdr$ = ""    ProcedureReturn #ATR_UnableToFindPBPref  EndIf  configFile$ = GetPathPart(PBPrefAdr$) + "Tools.prefs"  ;  If IsToolAlreadyInstalled(toolName$) = 0    ProcedureReturn #ATR_ToolNotInstalled  EndIf  ;  configContent$ = AT_ReadPrefFileContent(configFile$, @ReadOK)  If ReadOK = #False    ProcedureReturn #ATR_UnableToReadToolsConfigFile  EndIf  ;  backupFile$ = ComputeBackupFileName(PBPrefAdr$)  If AT_WritePrefFileContent(backupFile$, configContent$) = #False    ProcedureReturn #ATR_UnableToBackUpToolsConfigFile  EndIf  ;  configContent$ = AT_RemoveAndRenumberTools(configContent$, toolName$, #Null, @RemovedCount)  If RemovedCount = 0    ProcedureReturn #ATR_UnableToModifyToolsConfigFile  EndIf  ;  If AT_WritePrefFileContent(configFile$, configContent$)    ProcedureReturn #ATR_ToolRemovedSuccessfully  EndIf  ;  ProcedureReturn #ATR_UnableToModifyToolsConfigFileEndProcedure;Procedure InstallPBBrowserAndPrintResult(PortableMode)  ;  ; Role: Installs (or updates) "PB Browser" in PureBasic's Tools.prefs and displays the localized outcome.  ;  Protected Result = AddToolToToolsPrefs("PB Browser", "PBBrowser.exe", PortableMode)  Protected Msg$  ;  Select Result    Case #AT_ToolInstalledSuccessfully      : Msg$ = GetTextFromCatalogPB("ToolInstalledSuccessfully")    Case #AT_ToolAllreadyInstalled          : Msg$ = GetTextFromCatalogPB("ToolAllreadyInstalled")    Case #AT_ToolExeNotFound                : Msg$ = GetTextFromCatalogPB("ToolExeNotFound")    Case #AT_UnableToFindPBPref             : Msg$ = GetTextFromCatalogPB("UnableToFindPBPref")    Case #AT_UnableToCreateToolsConfigFile  : Msg$ = GetTextFromCatalogPB("UnableToCreateToolsConfigFile")    Case #AT_UnableToReadToolsConfigFile    : Msg$ = GetTextFromCatalogPB("UnableToReadToolsConfigFile")    Case #AT_UnableToBackUpToolsConfigFile  : Msg$ = GetTextFromCatalogPB("UnableToBackUpToolsConfigFile")    Case #AT_UnableToOpenPBPref             : Msg$ = GetTextFromCatalogPB("UnableToOpenPBPref")    Case #AT_UnableToModifyToolsConfigFile  : Msg$ = GetTextFromCatalogPB("UnableToModifyToolsConfigFile")  EndSelect  ;  If Msg$ <> ""    AlertInPBBWindow(Msg$)  EndIf  ProcedureReturn ResultEndProcedure;Procedure UnInstallPBBrowserAndPrintResult()  ;  ; Role: Removes "PB Browser" from PureBasic's Tools.prefs and displays the localized outcome.  ;  Protected Result = RemoveToolToToolsPrefs("PB Browser")  Protected Msg$  ;  Select Result    Case #ATR_ToolRemovedSuccessfully       : Msg$ = GetTextFromCatalogPB("ToolRemovedSuccessfully")    Case #ATR_ToolNotInstalled              : Msg$ = GetTextFromCatalogPB("ToolNotInstalled")    Case #ATR_UnableToFindPBPref            : Msg$ = GetTextFromCatalogPB("UnableToFindPBPref")    Case #ATR_UnableToReadToolsConfigFile   : Msg$ = GetTextFromCatalogPB("UnableToReadToolsConfigFile")    Case #ATR_UnableToBackUpToolsConfigFile : Msg$ = GetTextFromCatalogPB("UnableToBackUpToolsConfigFile")    Case #ATR_UnableToModifyToolsConfigFile : Msg$ = GetTextFromCatalogPB("UnableToModifyToolsConfigFile")  EndSelect  ;  If Msg$ <> ""    AlertInPBBWindow(Msg$)  EndIf  ProcedureReturn ResultEndProcedure;DataSection  AT_NumShort:    Data.i #PB_Shortcut_Control, #PB_Shortcut_Shift, #PB_Shortcut_Alt, #PB_Shortcut_Command    ;    Data.i #VK_BACK, #VK_TAB, #VK_CLEAR, #VK_RETURN, #VK_PAUSE, #VK_ESCAPE, #VK_SPACE    ;Data.i #VK_LBUTTON    Data.i #VK_RBUTTON, #VK_MBUTTON    Data.i #VK_PRIOR, #VK_NEXT, #VK_END, #VK_HOME, #VK_UP, #VK_DOWN, #VK_LEFT, #VK_RIGHT    Data.i #VK_SELECT, #VK_PRINT, #VK_EXECUTE, #VK_SNAPSHOT, #VK_INSERT, #VK_DELETE, #VK_HELP    ;    Data.i #VK_APPS, #VK_SLEEP    Data.i #VK_MULTIPLY, #VK_ADD, #VK_SEPARATOR, #VK_SUBTRACT, #VK_DECIMAL, #VK_DIVIDE    ;    Data.i #VK_LAUNCH_APP1, #VK_LAUNCH_APP2    ;    Data.i #VK_OEM_MINUS, #VK_OEM_PLUS, #VK_OEM_COMMA, #VK_OEM_PERIOD    Data.i #VK_OEM_1, #VK_OEM_2, #VK_OEM_3, #VK_OEM_4, #VK_OEM_5, #VK_OEM_6, #VK_OEM_7, #VK_OEM_8    ;    Data.i #VK_ATTN, #VK_CRSEL, #VK_EXSEL, #VK_EREOF, #VK_PLAY, #VK_ZOOM, #VK_NONAME, #VK_PA1, #VK_OEM_CLEAR    ;    Data.i #VK_CAPITAL, #VK_NUMLOCK, #VK_SCROLL    ;    Data.i 0    ;  AT_StringShort:    Data.s "CTRL", "SHIFT", "ALT", "CMD"    ;    Data.s "BACK", "TAB", "CLEAR", "RET", "PAUSE", "ESC", "SPACE"    ;Data.s "LBUTTON"    Data.s "RBUTTON", "MBUTTON"    Data.s "PAGEUP", "PAGEDOWN", "END", "HOME", "UP", "DOWN", "LEFT", "RIGHT"    Data.s "SELECT", "PRINT", "EXECUTE", "SNAPSHOT", "INSERT", "DEL", "HELP"    ;    Data.s "APPS", "SLEEP"    Data.s "MULT", "ADD", "SEP", "SUB", "DEC", "DIV"    ;    Data.s "LAUNCH1", "LAUNCH2"    ;    Data.s "-", "'+'", ",", "."    ;    Data.s "OEM_1", "OEM_2", "OEM_3", "OEM_4", "OEM_5", "OEM_6", "OEM_7", "OEM_8"    ;    Data.s "ATTN", "CRSEL", "EXSEL", "EREOF", "PLAY", "ZOOM", "NONAME", "PA1", "OEMCLEAR"    ;    Data.s "CAPSLOCK", "NUMLOCK", "SCROLLLOCK"    ;    Data.s "End"EndDataSection  ; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 652; FirstLine = 578; Folding = N--; EnableXP; DPIAware; UseMainFile = ..\..\PBBrowser.pb; Executable = AddToolToPureBasic.exe