;;***************************************************************************;                           GetOpenProject.pb;                        by Zapman - Nov. 2026;;        List of functions to check if a project is open by the IDE.;;    The PureBasic IDE has very few command lines to interact with it.;       There is none to ask it if any particular project is open.;          The following set of functions has one main target:;   -> Get the path of the project currently open in the IDE (if any).;;***************************************************************************;CompilerIf Not Defined(PROCESS_QUERY_LIMITED_INFORMATION, #PB_Constant)  #PROCESS_QUERY_LIMITED_INFORMATION = $1000CompilerEndIf;Prototype.l protoQueryFullProcessImageName(hProcess, dwFlags.l, lpExeName, *lpdwSize.Long);Enumeration GOP_SearchMode  #GOP_Mode_FindAnyPBExe = 1  #GOP_Mode_FindMainWindow  #GOP_Mode_FindOpenProjectEndEnumeration;Structure GOP_SearchContext  Mode.i  TargetExeLower$  FoundWindow.i  FallbackWindow.i  FoundExePath$  FoundProjectPath$EndStructure;Procedure.s GOP_GetProcessImagePath(processID.l)  ;  ; Role: Resolves the full executable path of a running process from its 32-bit PID.  ;       Caches QueryFullProcessImageNameW once from the resident kernel32 module and uses  ;       #PROCESS_QUERY_LIMITED_INFORMATION so queries succeed even across privilege levels.  ;  Static Initialized, QueryFunc.protoQueryFullProcessImageName  Protected hKernel, *AsciiName, hProcess  Protected PathLen.l  Protected Buffer$, Result$  ;  If processID = 0    ProcedureReturn ""  EndIf  ;  If Initialized = #False    Initialized = #True    hKernel = GetModuleHandle_("kernel32.dll")    If hKernel      *AsciiName = Ascii("QueryFullProcessImageNameW")      If *AsciiName        QueryFunc = GetProcAddress_(hKernel, *AsciiName)        FreeMemory(*AsciiName)      EndIf    EndIf  EndIf  ;  If QueryFunc    hProcess = OpenProcess_(#PROCESS_QUERY_LIMITED_INFORMATION, #False, processID)    If hProcess      PathLen = 2048      Buffer$ = Space(PathLen)      If QueryFunc(hProcess, 0, @Buffer$, @PathLen) And PathLen > 0        Result$ = Left(Buffer$, PathLen)      EndIf      CloseHandle_(hProcess)    EndIf  EndIf  ;  ProcedureReturn Result$EndProcedure;Procedure.s GOP_GetWindowText(hWnd)  ;  ; Role: Reads the complete text of a top-level or static child window dynamically.  ;  Protected TextLen, CopiedLen  Protected Buffer$  ;  If hWnd    TextLen = GetWindowTextLength_(hWnd)    If TextLen > 0      Buffer$ = Space(TextLen + 2)      CopiedLen = GetWindowText_(hWnd, @Buffer$, TextLen + 2)      If CopiedLen > 0        ProcedureReturn Left(Buffer$, CopiedLen)      EndIf    EndIf  EndIf  ;  ProcedureReturn ""EndProcedure;Procedure.s GOP_ExtractPBPPathFromText(RawText$)  ;  ; Role: Parses multi-line text from an IDE child control to extract the open ".pbp" file path,  ;       independently of the PureBasic IDE language ("Fichier du projet: ...", "Project file: ...", etc.).  ;  Protected Line$, Candidate$  Protected LineCount, i, ColonPos, SlashPos, LenLine  ;  If FindString(RawText$, ".pbp", 1, #PB_String_NoCase) = 0    ProcedureReturn ""  EndIf  ;  ; Normalize CRLF into single LF breaks so LineCount reflects real text lines (not inflated by CR+LF pairs)  RawText$ = ReplaceString(RawText$, #CRLF$, #LF$)  RawText$ = ReplaceString(RawText$, #CR$, #LF$)  LineCount = CountString(RawText$, #LF$) + 1  If LineCount < 3    ; The IDE Project panel info block always spans at least 3 lines (Name, File, Last opened / Editor)    ProcedureReturn ""  EndIf  ;  For i = 1 To LineCount    Line$ = Trim(StringField(RawText$, i, #LF$))    LenLine = Len(Line$)    If LenLine > 4 And LCase(Right(Line$, 4)) = ".pbp"      ; In Windows paths, ':' is illegal everywhere except right after a drive letter ("X:\"),      ; so ": " unambiguously separates the localized IDE label from the project file path.      ColonPos = FindString(Line$, ": ")      If ColonPos > 0        Candidate$ = LTrim(Mid(Line$, ColonPos + 2))      ElseIf FindString(Line$, ":") > 0 Or FindString(Line$, "：") > 0        ; Fallback when a translation omits the space after ':' or uses a full-width colon, while still requiring a label prefix        SlashPos = FindString(Line$, ":\")        If SlashPos > 2          Candidate$ = Mid(Line$, SlashPos - 1)        Else          SlashPos = FindString(Line$, "\\")          If SlashPos > 1            Candidate$ = Mid(Line$, SlashPos)          EndIf        EndIf      EndIf      ; Ensure Candidate$ holds an actual file path (and not a bare project name on line 1 ending in ".pbp")      If Candidate$ <> "" And (FindString(Candidate$, "\") Or FindString(Candidate$, "/"))        ProcedureReturn Candidate$      EndIf    EndIf  Next  ;  ProcedureReturn ""EndProcedure;Procedure GOP_EnumChildProc(hWnd, *Ctx.GOP_SearchContext)  ;  ; Role: Standard stdcall EnumChildWindows callback inspecting IDE child controls for a ".pbp" path.  ;  Protected ChildText$, ProjectPath$  ;  If *Ctx = 0    ProcedureReturn #False  EndIf  ;  ChildText$ = GOP_GetWindowText(hWnd)  If ChildText$ <> ""    ProjectPath$ = GOP_ExtractPBPPathFromText(ChildText$)    If ProjectPath$ <> ""      *Ctx\FoundProjectPath$ = ProjectPath$      ProcedureReturn #False    EndIf  EndIf  ;  ProcedureReturn #TrueEndProcedure;Procedure GOP_EnumWindowsProc(hWnd, *Ctx.GOP_SearchContext)  ;  ; Role: Standard stdcall EnumWindows callback filtering visible "PureBasic" windows according to *Ctx\Mode.  ;  Protected processID.l  Protected WindowTitle$, ExePath$  ;  If *Ctx = 0    ProcedureReturn #False  EndIf  ;  If IsWindowVisible_(hWnd)    WindowTitle$ = GOP_GetWindowText(hWnd)    If FindString(WindowTitle$, "PureBasic")      GetWindowThreadProcessId_(hWnd, @processID)      If processID        ExePath$ = GOP_GetProcessImagePath(processID)        If ExePath$ <> ""          Select *Ctx\Mode            Case #GOP_Mode_FindAnyPBExe              If LCase(GetFilePart(ExePath$)) = "purebasic.exe"                *Ctx\FoundExePath$ = ExePath$                ProcedureReturn #False              EndIf              ;            Case #GOP_Mode_FindMainWindow              If LCase(ExePath$) = *Ctx\TargetExeLower$                ; Prefer the primary IDE window (which owns a menu bar) over secondary dialogs like Preferences                If GetMenu_(hWnd)                  *Ctx\FoundWindow = hWnd                  ProcedureReturn #False                ElseIf *Ctx\FallbackWindow = 0                  *Ctx\FallbackWindow = hWnd                EndIf              EndIf              ;            Case #GOP_Mode_FindOpenProject              If LCase(ExePath$) = *Ctx\TargetExeLower$                ; Inspect child controls; if this window has no open project (e.g. dialog or 2nd instance), keep scanning                EnumChildWindows_(hWnd, @GOP_EnumChildProc(), *Ctx)                If *Ctx\FoundProjectPath$ <> ""                  *Ctx\FoundWindow = hWnd                  ProcedureReturn #False                EndIf              EndIf          EndSelect        EndIf      EndIf    EndIf  EndIf  ;  ProcedureReturn #TrueEndProcedure;Procedure.s GetCurrentRunningPBExePath()  ;  ; Role: Returns the full executable path of the first running PureBasic IDE instance with a visible window,  ;       or "" if no PureBasic IDE is currently open.  ;  Protected Ctx.GOP_SearchContext  ;  Ctx\Mode = #GOP_Mode_FindAnyPBExe  EnumWindows_(@GOP_EnumWindowsProc(), @Ctx)  ProcedureReturn Ctx\FoundExePath$EndProcedure;Procedure GetProcessIdFromFilePath(filePath.s)  ;  ; Role: Returns the PID of a running process whose full image path matches 'filePath', or 0 if not running.  ;  Protected proc.PROCESSENTRY32  Protected hSnapshot, MatchedPID  Protected TargetNameLower$, TargetPathLower$, ExePath$  ;  filePath = Trim(filePath)  If filePath = ""    ProcedureReturn 0  EndIf  ;  TargetNameLower$ = LCase(GetFilePart(filePath))  TargetPathLower$ = LCase(filePath)  hSnapshot = CreateToolhelp32Snapshot_(#TH32CS_SNAPPROCESS, 0)  If hSnapshot <> #INVALID_HANDLE_VALUE    proc\dwSize = SizeOf(PROCESSENTRY32)    If Process32First_(hSnapshot, @proc)      Repeat        If LCase(PeekS(@proc\szExeFile)) = TargetNameLower$          ExePath$ = GOP_GetProcessImagePath(proc\th32ProcessID)          If ExePath$ <> "" And LCase(ExePath$) = TargetPathLower$            MatchedPID = proc\th32ProcessID            Break          EndIf        EndIf      Until Process32Next_(hSnapshot, @proc) = 0    EndIf    CloseHandle_(hSnapshot)  EndIf  ;  ProcedureReturn MatchedPIDEndProcedure;Procedure GetPureBasicMainWindowNumber(filePath.s)  ;  ; Role: Returns the main window handle (HWND) of the running PureBasic IDE matching 'filePath', or 0 if none.  ;  Protected Ctx.GOP_SearchContext  ;  filePath = Trim(filePath)  If filePath = ""    ProcedureReturn 0  EndIf  ;  Ctx\Mode = #GOP_Mode_FindMainWindow  Ctx\TargetExeLower$ = LCase(filePath)  EnumWindows_(@GOP_EnumWindowsProc(), @Ctx)  If Ctx\FoundWindow    ProcedureReturn Ctx\FoundWindow  EndIf  ;  ProcedureReturn Ctx\FallbackWindowEndProcedure;Procedure.s GetPBOpenProject(PBAddress$)  ;  ; Role: Returns the full ".pbp" file path of the project currently open in the PureBasic IDE  ;       located at 'PBAddress$', or "" if no project is open (or if the IDE is not running).  ;  Protected Ctx.GOP_SearchContext  ;  PBAddress$ = Trim(PBAddress$)  If PBAddress$ = ""    ProcedureReturn ""  EndIf  ;  Ctx\Mode = #GOP_Mode_FindOpenProject  Ctx\TargetExeLower$ = LCase(PBAddress$)  EnumWindows_(@GOP_EnumWindowsProc(), @Ctx)  ProcedureReturn Ctx\FoundProjectPath$EndProcedure; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 240; FirstLine = 222; Folding = +z; EnableXP; DPIAware; UseMainFile = ..\..\PBBrowser.pb