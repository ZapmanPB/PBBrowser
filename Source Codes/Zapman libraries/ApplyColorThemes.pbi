; **************************************************************************;;                             ApplyColorThemes;                               Windows only;                         Zapman - November 2026 - 4.2;;      This file should be saved under the name "ApplyColorThemes.pbi".;;    This library offers a set of functions to implement color-themes;           support (including dark mode) into your applications.;;  • The EditThemesColors() function allows you to set a pair of colors for;    background and foreground and give a name to this set.;  • The SetGadgetsColorsFromTheme() function applies this theme to a list of gadgets.;  • GetColorThemesFromPreferences() and SetColorThemesToPreferences() allow;    you to record and restore a set of themes to and from a .prefs file.;  • ThemesDemoWindow() shows an example of use for this set of functions.;; **************************************************************************; NOTICE: This library is NOT standalone.; "SetGadgetColorEx.pbi" and "ZapmanColorRequester.pbi" are needed as included files.;; ******************************************************************;;-        1--- FIRST PART: FUNCTIONS FOR SETTING THEMES ---;CompilerIf #PB_Compiler_IsMainFile  EnableExplicitCompilerEndIf;XIncludeFile "SetGadgetColorEx.pbi"XIncludeFile "ZapmanColorRequester.pbi";Procedure TC_GetColorFromType(ColorType$, *currentColor.InterfaceColorsStruct)  ; Retrieve the raw theme color (#PB_Default or RGB value) matching the requested channel.  If ColorType$ = "BackgroundColor"    ProcedureReturn *currentColor\BackgroundColor  ElseIf ColorType$ = "TextColor"    ProcedureReturn *currentColor\TextColor  EndIfEndProcedure;Procedure TC_GetRealColorFromType(ColorType$, *currentColor.InterfaceColorsStruct)  ;  ; Translate #PB_Default into the actual system RGB color for color picker calculations.  ;  Protected Color = TC_GetColorFromType(ColorType$, *currentColor)  ProcedureReturn GetRealColorFromType(ColorType$, Color)EndProcedure;Procedure TC_SetColorFromType(ColorType$, Color, *currentColor.InterfaceColorsStruct)  ;  ; Store the updated RGB color into the active channel of the preset structure.  ;  If ColorType$ = "BackgroundColor"    *currentColor\BackgroundColor = Color  ElseIf ColorType$ = "TextColor"    *currentColor\TextColor = Color  EndIfEndProcedure;Procedure TC_DisableResetGadget(*currentColor.InterfaceColorsStruct, BDefault, ColorType$)  ;  ; Enable the reset button only for editable presets that own recorded defaults (not -2)  ; and whose currently edited channel actually differs from its default value.  ;  Protected DisableReset = #True  ;  If *currentColor\Editable And *currentColor\DefaultBackgroundColor <> -2    If (ColorType$ = "BackgroundColor" And *currentColor\DefaultBackgroundColor <> *currentColor\BackgroundColor) Or       (ColorType$ = "TextColor" And *currentColor\DefaultTextColor <> *currentColor\TextColor)      DisableReset = #False    EndIf  EndIf  DisableGadget(BDefault, DisableReset)EndProcedure;Procedure TC_DisableColorGadgets(*currentColor.InterfaceColorsStruct, *ECGadgets.EditColorGadgetsStruct, BDefault, ColorType$)  ;  ; Sync both the channel reset button and all numeric/hexadecimal input fields with preset editability.  ;  Protected DisableInputs = Bool(*currentColor\Editable = 0)  ;  TC_DisableResetGadget(*currentColor, BDefault, ColorType$)  DisableGadget(*ECGadgets\Red_Input, DisableInputs)  DisableGadget(*ECGadgets\Green_Input, DisableInputs)  DisableGadget(*ECGadgets\Blue_Input, DisableInputs)  DisableGadget(*ECGadgets\Hue_Input, DisableInputs)  DisableGadget(*ECGadgets\Sat_Input, DisableInputs)  DisableGadget(*ECGadgets\Lum_Input, DisableInputs)  DisableGadget(*ECGadgets\HexColor_Input, DisableInputs)EndProcedure;Procedure TC_EnableDisableComboReadOnly(TempPresetsEditable, gadgetPreset, BDel, CanDelete = #True)  ;  ; Toggle read-only mode on the internal Edit control of an editable ComboBoxGadget,  ; and prevent deleting locked presets or the very last remaining preset in the list.  ;  CompilerIf Not Defined(COMBOBOXINFO, #PB_Structure)    Structure COMBOBOXINFO      cbSize.l      rcItem.RECT      rcButton.RECT      stateButton.l      hwndCombo.i      hwndItem.i      hwndList.i    EndStructure  CompilerEndIf  Protected cbi.COMBOBOXINFO  cbi\cbSize = SizeOf(COMBOBOXINFO)  If GetComboBoxInfo_(GadgetID(gadgetPreset), @cbi) And cbi\hwndItem    SendMessage_(cbi\hwndItem, #EM_SETREADONLY, Bool(TempPresetsEditable = 0), 0)  EndIf  DisableGadget(BDel, Bool(TempPresetsEditable = 0 Or CanDelete = #False))EndProcedure;Procedure TC_AddThemePreset(Name$, Editable, BackColor, TextColor)  ;  ; Append a single built-in theme preset and initialize its default fallback colors.  ;  If AddElement(InterfaceColorPresets())    InterfaceColorPresets()\PresetName = Name$    InterfaceColorPresets()\Editable = Editable    InterfaceColorPresets()\BackgroundColor = BackColor    InterfaceColorPresets()\TextColor = TextColor    InterfaceColorPresets()\DefaultBackgroundColor = BackColor    InterfaceColorPresets()\DefaultTextColor = TextColor  EndIfEndProcedure;Procedure SetThemesColors()  ;  ; Populate the global preset list with built-in color themes and select "Standard" by default.  ;  ClearList(InterfaceColorPresets())  TC_AddThemePreset("Standard", #False, #PB_Default, #PB_Default)  TC_AddThemePreset("Lemon", #True, RGB(239, 255, 234), RGB(0, 50, 0))  TC_AddThemePreset("Light gray", #True, RGB(230, 231, 232), RGB(47, 47, 49))  TC_AddThemePreset("Dark gray", #True, RGB(30, 45, 45), RGB(240, 240, 240))  TC_AddThemePreset("Brown sugar", #True, RGB(61, 45, 45), RGB(240, 240, 200))  TC_AddThemePreset("Matrix", #True, RGB(0, 40, 40), RGB(90, 255, 160))  TC_AddThemePreset("Rapsody", #True, RGB(0, 10, 50), RGB(160, 255, 210))  TC_AddThemePreset("Raspberry", #True, $7E00A8, $CDFFCC)  SelectElement(InterfaceColorPresets(), 0)EndProcedure;Procedure SetGadgetsColorsFromTheme(MainWindow, *currentColor.InterfaceColorsStruct, GadgetList$, Colortype$ = "")  ;  ; Apply background and/or text colors from '*currentColor' to 'MainWindow' and each comma-separated gadget ID.  ; Canvas gadgets included in 'GadgetList$' are treated as 1px separator lines and repainted with a blended border color.  ;  Protected PosInGadgetList = 1, Field$, Gadget  ;  If IsWindow(MainWindow) And (Colortype$ = "" Or Colortype$ = "BackgroundColor")    SetWindowColor(MainWindow, *currentColor\BackgroundColor)  EndIf  Field$ = Trim(StringField(GadgetList$, PosInGadgetList, ","))  While Field$ <> ""    Gadget = Val(Field$)    If IsGadget(Gadget)      If GadgetType(Gadget) = #PB_GadgetType_Canvas        RepaintCanvasSeparator(Gadget, CalculateBorderColor(*currentColor\TextColor, *currentColor\BackgroundColor))      Else        If Colortype$ = "" Or Colortype$ = "BackgroundColor"          SetGadgetColorEx(Gadget, #PB_Gadget_BackColor, *currentColor\BackgroundColor)        EndIf        If Colortype$ = "" Or Colortype$ = "TextColor"          SetGadgetColorEx(Gadget, #PB_Gadget_FrontColor, *currentColor\TextColor)        EndIf      EndIf    EndIf    PosInGadgetList + 1    Field$ = Trim(StringField(GadgetList$, PosInGadgetList, ","))  WendEndProcedure;Procedure ApplyCurrentThemeToAllGadgets(WindowNum)  ;  ; Enumerate every child control of 'WindowNum' via Win32 API and apply the active preset colors.  ;  Protected ColorForEnum.SGCE_ColorForEnum, hWnd  ;  If IsWindow(WindowNum) And ListSize(InterfaceColorPresets()) > 0    SetWindowColor(WindowNum, InterfaceColorPresets()\BackgroundColor)    hWnd = WindowID(WindowNum)    ColorForEnum\Color = InterfaceColorPresets()\BackgroundColor    ColorForEnum\ColorType = #PB_Gadget_BackColor    EnumChildWindows_(hWnd, @SGCE_EnumGadgetsAndSetColor(), @ColorForEnum)    ColorForEnum\Color = InterfaceColorPresets()\TextColor    ColorForEnum\ColorType = #PB_Gadget_FrontColor    EnumChildWindows_(hWnd, @SGCE_EnumGadgetsAndSetColor(), @ColorForEnum)  EndIfEndProcedure;Procedure SetFontAndGadgetsColors(MainWindow, *currentColor.InterfaceColorsStruct, GadgetList$, Colortype$ = "")  ;  ; Apply theme colors first, then assign the shared Segoe UI 9pt HFONT across all listed gadgets.  ;  Protected PosInGadgetList = 1, Field$, Gadget  Global PBBAllGadgetsFont  ;  SetGadgetsColorsFromTheme(MainWindow, *currentColor, GadgetList$, Colortype$)  If PBBAllGadgetsFont = 0    PBBAllGadgetsFont = FontID(LoadFont(#PB_Any, "Segoe UI", 9))  EndIf  Field$ = Trim(StringField(GadgetList$, PosInGadgetList, ","))  While Field$ <> ""    Gadget = Val(Field$)    If IsGadget(Gadget)      SetGadgetFont(Gadget, PBBAllGadgetsFont)    EndIf    PosInGadgetList + 1    Field$ = Trim(StringField(GadgetList$, PosInGadgetList, ","))  WendEndProcedure;Procedure TC_SyncEditorFromPreset(*Preset.InterfaceColorsStruct, *ECGadgets.EditColorGadgetsStruct, GadgetList$, gadgetPreset, BDel, BDefault, CanDelete, ColorTypeFilter$ = "")  ;  ; Synchronize combo read-only state, input enablement, theme colors, and picker cursors after any preset change.  ;  TC_EnableDisableComboReadOnly(*Preset\Editable, gadgetPreset, BDel, CanDelete)  TC_DisableColorGadgets(*Preset, *ECGadgets, BDefault, *ECGadgets\SGC_ColorType$)  SetGadgetsColorsFromTheme(*ECGadgets\EditColorWindow, *Preset, GadgetList$, ColorTypeFilter$)  *ECGadgets\Color = TC_GetRealColorFromType(*ECGadgets\SGC_ColorType$, *Preset)  *ECGadgets\BackColor = GetRealColorFromType("BackgroundColor", *Preset\BackgroundColor)  *ECGadgets\TextColor = GetRealColorFromType("TextColor", *Preset\TextColor)  ZCR_SetGadgetsFromColor(*ECGadgets)EndProcedure;Procedure EditThemesColors(ParentID = #CWO_ActiveWindowPos, XShiftOrPos = 0, YShiftOrPos = 0, ParentAnchor = #CWO_Center, WindowAnchor = #CWO_Center)  ;  ; Role: Opens a modal dialog allowing the user to select, duplicate, rename, delete, and customize  ;       color presets (background and text channels) using embedded ZapmanColorRequester controls.  ; Parameters:  ;   • If ParentID is a valid window number (or OS HWND), the dialog is positioned relative to it  ;     and shifted by XShiftOrPos and YShiftOrPos.  ;   • If ParentID = #CWO_ActiveWindowPos, GetActiveWindow() is used as parent if valid, otherwise  ;     positioning falls back to the main screen.  ;   • If ParentID = #CWO_AbsolutePos, XShiftOrPos and YShiftOrPos define absolute screen coordinates.  ;   • If ParentID = #CWO_MonitorPos, positioning is computed relative to the monitor hosting  ;     GetActiveWindow() (or the main screen if none is active).  ;   • ParentAnchor and WindowAnchor specify which corner/center (#CWO_Center, #CWO_TopLeft, etc.)  ;     of the parent and dialog are aligned before applying XShiftOrPos and YShiftOrPos.  ;  Shared ECGadgets.EditColorGadgetsStruct  Protected ParentWindow = #PB_Default, ActiveWindow, ParentWindowID, ParentHasBeenDisabled  Protected gadgetPreset, BWidth, BAdd, BDel, OptionText, OptionBackground, TxPreset, BDefault  Protected WWidth, WHeight, WMargins, WParam, OX, OY, VPos, Frame1, MarginCircular  Protected GadgetList$, PresetText$, Index, mIndex, NewIndex, GetOut, mColor  Protected Event, EventType, EventGadget, EventMenu  Protected *TempPresetsAdr.InterfaceColorsStruct, *GadgetAdress  Protected NewList TempPresets.InterfaceColorsStruct()  ;  ; Resolve 'ParentID' whether the caller passed a PureBasic window number, an OS HWND, or a #CWO_* positioning mode.  If IsWindow(ParentID)    ParentWindow = ParentID  ElseIf ParentID >= 0 And IsWindow_(ParentID)    ParentWindow = WindowNumFromHandle(ParentID)  ElseIf ParentID = #PB_Default And IsWindow(GetActiveWindow())    ParentWindow = GetActiveWindow()  Else    ParentWindow = ParentID  EndIf  ;  ; Ensure at least the built-in presets exist and work on a temporary copy until the user confirms with OK.  If ListSize(InterfaceColorPresets()) < 1    SetThemesColors()  EndIf  If ListIndex(InterfaceColorPresets()) < 0    SelectElement(InterfaceColorPresets(), 0)  EndIf  CopyList(InterfaceColorPresets(), TempPresets())  SelectElement(TempPresets(), ListIndex(InterfaceColorPresets()))  ;  WWidth = 480  WHeight = 350  WMargins = 15  WParam = #PB_Window_SystemMenu | #PB_Window_Invisible  ActiveWindow = ParentWindow  If Not IsWindow(ActiveWindow)    ActiveWindow = GetActiveWindow()  EndIf  ParentWindowID = ComputeWinOrigins(@OX, @OY, WWidth, WHeight, ParentWindow, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor)  ECGadgets\EditColorWindow = OpenWindow(#PB_Any, OX, OY, WWidth, WHeight, GetTextFromCatalog("ThemeColors"), WParam, ParentWindowID)  ;  If ECGadgets\EditColorWindow    If IsWindow(ActiveWindow) And IsWindowEnabled_(WindowID(ActiveWindow))      DisableWindow(ActiveWindow, #True)      ParentHasBeenDisabled = #True    EndIf    ApplyDarkModeToWindow(ECGadgets\EditColorWindow)    StickyWindow(ECGadgets\EditColorWindow, 1)    ;    VPos = WMargins    TxPreset = TextGadget(#PB_Any, WMargins, VPos + 2, 100, 20, GetTextFromCatalog("Presets"))    GadgetList$ + Str(TxPreset) + ","    ;    ; #PB_ComboBox_Editable exposes an internal Edit child so custom presets can be renamed in place.    gadgetPreset = ComboBoxGadget(#PB_Any, WMargins + 105, VPos, 180, 22, #PB_ComboBox_Editable)    ForEach TempPresets()      AddGadgetItem(gadgetPreset, -1, TempPresets()\PresetName)    Next    SelectElement(TempPresets(), ListIndex(InterfaceColorPresets()))    SetGadgetState(gadgetPreset, ListIndex(TempPresets()))    GadgetList$ + Str(gadgetPreset) + ","    ;    BWidth = 22    BAdd = ButtonGadget(#PB_Any, WWidth - WMargins - 2 * BWidth - 5, VPos, BWidth, 22, "+")    GadgetList$ + Str(BAdd) + ","    BDel = ButtonGadget(#PB_Any, WWidth - WMargins - BWidth, VPos, BWidth, 22, "-")    GadgetList$ + Str(BDel) + ","    ;    VPos + 35    Frame1 = CanvasGadget(#PB_Any, WMargins, VPos, WWidth - 2 * WMargins, 1)    GadgetList$ + Str(Frame1) + ","    ;    BWidth = 140    VPos + 5    OptionBackground = OptionGadget(#PB_Any, 100, VPos, BWidth, 25, GetTextFromCatalog("BackgroundColor"))    GadgetList$ + Str(OptionBackground) + ","    SetGadgetState(OptionBackground, 1)    ;    OptionText = OptionGadget(#PB_Any, WWidth - BWidth - 20, VPos, BWidth, 25, GetTextFromCatalog("TextColor"))    GadgetList$ + Str(OptionText) + ","    ;    ; Configure layout metrics for the embedded ZapmanColorRequester controls; reset MarginBottom to prevent carry-over.    ECGadgets\SGC_ColorType$ = "BackgroundColor"    ECGadgets\Color = TC_GetRealColorFromType("BackgroundColor", TempPresets())    ECGadgets\MarginTop = VPos + 35    ECGadgets\MarginBottom = 0    MarginCircular = 15    ECGadgets\MarginButtonsBottom = MarginCircular    ECGadgets\MarginButtonsTop = 0    ECGadgets\MarginInterBlocks = 31    ECGadgets\MarginLeft = MarginCircular    ECGadgets\MarginRight = MarginCircular    ECGadgets\HexFieldVPos = -2    ECGadgets\HorizGadgetsMargin = 5    ECGadgets\BackColor = GetRealColorFromType("BackgroundColor", TempPresets()\BackgroundColor)    ECGadgets\TextColor = GetRealColorFromType("TextColor", TempPresets()\TextColor)    ;    ZCR_CreateGadgets()    ZCR_SetText()    ZCR_SetFieldsSizeAndMargins()    ZCR_CreateTargetAndCursors()    ZCR_ResizeGadgets()    ;    ; Append all ZapmanColorRequester gadget handles stored contiguously between Red_Legend and BCancel.    *GadgetAdress = @ECGadgets\Red_Legend    Repeat      GadgetList$ + Str(PeekI(*GadgetAdress)) + ","      *GadgetAdress + SizeOf(Integer)    Until *GadgetAdress > @ECGadgets\BCancel    ;    VPos = ECGadgets\InterBlocksVerticalPos + 5    BDefault = ButtonGadget(#PB_Any, WMargins, VPos, 170, 21, GetTextFromCatalog("ResetToDefaultColor"))    GadgetList$ + Str(BDefault) + ","    ;    TC_EnableDisableComboReadOnly(TempPresets()\Editable, gadgetPreset, BDel, Bool(ListSize(TempPresets()) > 1))    TC_DisableColorGadgets(TempPresets(), ECGadgets, BDefault, ECGadgets\SGC_ColorType$)    ;    CompilerIf Not Defined(ZCR_Escape_Cmd, #PB_Constant)      #ZCR_Escape_Cmd = 1      #ZCR_Enter = 2    CompilerEndIf    AddKeyboardShortcut(ECGadgets\EditColorWindow, #PB_Shortcut_Escape, #ZCR_Escape_Cmd)    AddKeyboardShortcut(ECGadgets\EditColorWindow, #PB_Shortcut_Return, #ZCR_Enter)    ;    ZCR_SetGadgetsFromColor(ECGadgets)    SetFontAndGadgetsColors(ECGadgets\EditColorWindow, TempPresets(), GadgetList$)    HideWindow(ECGadgets\EditColorWindow, #False)    SetActiveGadget(gadgetPreset)    ;    Repeat      Event = WaitWindowEvent(10)      If Event        EventType = EventType()        EventGadget = EventGadget()        EventMenu = EventMenu()        ;        ; Forward interactive color changes from sliders/inputs to the active channel when the preset is editable.        If TempPresets()\Editable          mColor = ECGadgets\Color          GetOut = ZCR_Events(Event, EventGadget, EventType)          If mColor <> ECGadgets\Color            TC_SetColorFromType(ECGadgets\SGC_ColorType$, ECGadgets\Color, TempPresets())            ECGadgets\BackColor = GetRealColorFromType("BackgroundColor", TempPresets()\BackgroundColor)            ECGadgets\TextColor = GetRealColorFromType("TextColor", TempPresets()\TextColor)            SetGadgetsColorsFromTheme(ECGadgets\EditColorWindow, TempPresets(), GadgetList$, ECGadgets\SGC_ColorType$)            TC_DisableResetGadget(TempPresets(), BDefault, ECGadgets\SGC_ColorType$)          EndIf        EndIf        ;        Select Event          Case #PB_Event_Menu            If EventMenu = #ZCR_Escape_Cmd              GetOut = -1            ElseIf EventMenu = #ZCR_Enter              GetOut = 1            EndIf          Case #PB_Event_Gadget            Select EventGadget              Case gadgetPreset                If GetGadgetState(gadgetPreset) = -1                  ; In-place text edit inside the combo's Edit control: rename the current preset item without losing caret position.                  If TempPresets()\Editable                    PresetText$ = GetGadgetText(gadgetPreset)                    If PresetText$ <> TempPresets()\PresetName                      TempPresets()\PresetName = PresetText$                      SetGadgetItemText(gadgetPreset, ListIndex(TempPresets()), PresetText$)                    EndIf                  EndIf                ElseIf GetGadgetState(gadgetPreset) <> ListIndex(TempPresets())                  SelectElement(TempPresets(), GetGadgetState(gadgetPreset))                  TC_SyncEditorFromPreset(TempPresets(), ECGadgets, GadgetList$, gadgetPreset, BDel, BDefault, Bool(ListSize(TempPresets()) > 1))                EndIf              Case BAdd                Index = ListIndex(TempPresets())                *TempPresetsAdr = @TempPresets()                mIndex = Index                ; Skip past any contiguous locked presets so newly duplicated presets always land in an editable slot.                While mIndex + 1 < ListSize(TempPresets()) And TempPresets()\Editable = 0                  mIndex + 1                  SelectElement(TempPresets(), mIndex)                Wend                If mIndex = Index Or TempPresets()\Editable = 0                  mIndex + 1                EndIf                If mIndex < ListSize(TempPresets())                  SelectElement(TempPresets(), mIndex)                  InsertElement(TempPresets())                Else                  AddElement(TempPresets())                EndIf                CopyStructure(*TempPresetsAdr, @TempPresets(), InterfaceColorsStruct)                TempPresets()\PresetName + " (copy)"                TempPresets()\Editable = #True                TempPresets()\DefaultTextColor = -2                TempPresets()\DefaultBackgroundColor = -2                AddGadgetItem(gadgetPreset, mIndex, TempPresets()\PresetName)                SetGadgetState(gadgetPreset, mIndex)                TC_SyncEditorFromPreset(TempPresets(), ECGadgets, GadgetList$, gadgetPreset, BDel, BDefault, Bool(ListSize(TempPresets()) > 1))              Case BDel                If TempPresets()\Editable And ListSize(TempPresets()) > 1                  Index = ListIndex(TempPresets())                  DeleteElement(TempPresets())                  RemoveGadgetItem(gadgetPreset, Index)                  NewIndex = Index - 1                  If NewIndex < 0                    NewIndex = 0                  EndIf                  SelectElement(TempPresets(), NewIndex)                  SetGadgetState(gadgetPreset, NewIndex)                  TC_SyncEditorFromPreset(TempPresets(), ECGadgets, GadgetList$, gadgetPreset, BDel, BDefault, Bool(ListSize(TempPresets()) > 1))                EndIf              Case OptionBackground, OptionText                If EventGadget = OptionBackground                  ECGadgets\SGC_ColorType$ = "BackgroundColor"                Else                  ECGadgets\SGC_ColorType$ = "TextColor"                EndIf                TC_DisableResetGadget(TempPresets(), BDefault, ECGadgets\SGC_ColorType$)                ECGadgets\Color = TC_GetRealColorFromType(ECGadgets\SGC_ColorType$, TempPresets())                ZCR_SetGadgetsFromColor(ECGadgets)              Case BDefault                If ECGadgets\SGC_ColorType$ = "BackgroundColor"                  TC_SetColorFromType("BackgroundColor", TempPresets()\DefaultBackgroundColor, TempPresets())                Else                  TC_SetColorFromType("TextColor", TempPresets()\DefaultTextColor, TempPresets())                EndIf                TC_SyncEditorFromPreset(TempPresets(), ECGadgets, GadgetList$, gadgetPreset, BDel, BDefault, Bool(ListSize(TempPresets()) > 1), ECGadgets\SGC_ColorType$)              Case ECGadgets\BOk                GetOut = 1              Case ECGadgets\BCancel                GetOut = -1            EndSelect        EndSelect      EndIf    Until Event = #PB_Event_CloseWindow Or GetOut    ;    If GetOut = 1      ; Commit edited presets and promote newly created presets (-2) so their current colors become their new defaults.      ClearList(InterfaceColorPresets())      CopyList(TempPresets(), InterfaceColorPresets())      ForEach InterfaceColorPresets()        If InterfaceColorPresets()\DefaultTextColor = -2          InterfaceColorPresets()\DefaultTextColor = InterfaceColorPresets()\TextColor        EndIf        If InterfaceColorPresets()\DefaultBackgroundColor = -2          InterfaceColorPresets()\DefaultBackgroundColor = InterfaceColorPresets()\BackgroundColor        EndIf      Next      SelectElement(InterfaceColorPresets(), ListIndex(TempPresets()))    EndIf    ;    If ParentHasBeenDisabled And IsWindow(ActiveWindow)      DisableWindow(ActiveWindow, #False)    EndIf    CloseWindow(ECGadgets\EditColorWindow)    ECGadgets\EditColorWindow = 0  EndIf  ECGadgets\SGC_ColorType$ = ""EndProcedure;Procedure GetColorThemesFromPreferences(MyPreferenceFile$)  ;  ; Role: Loads the saved color presets and active theme index from 'MyPreferenceFile$' if the global  ;       preset list is still empty, or initializes the built-in presets when no saved data is found.  ; Output: Returns the zero-based index of the active theme in InterfaceColorPresets().  ;  Protected Found, PrefString$, ColorTheme, MaxIndex  ;  If ListSize(InterfaceColorPresets()) < 1    If MyPreferenceFile$ And OpenPreferences(MyPreferenceFile$)      ClearList(InterfaceColorPresets())      ExaminePreferenceKeys()      While NextPreferenceKey()        If Left(PreferenceKeyName(), 12) = "ColorPresets"          Found = 1          PrefString$ = PreferenceKeyValue()          AddElement(InterfaceColorPresets())          InterfaceColorPresets()\PresetName             = StringField(PrefString$, 1, ",")          InterfaceColorPresets()\Editable               = Val(StringField(PrefString$, 2, ","))          InterfaceColorPresets()\BackgroundColor        = Val(StringField(PrefString$, 3, ","))          InterfaceColorPresets()\TextColor              = Val(StringField(PrefString$, 4, ","))          InterfaceColorPresets()\DefaultBackgroundColor = Val(StringField(PrefString$, 5, ","))          InterfaceColorPresets()\DefaultTextColor       = Val(StringField(PrefString$, 6, ","))        EndIf      Wend      ColorTheme = ReadPreferenceInteger("ColorTheme", 0)      ClosePreferences()    EndIf    ;    If Found = 0      ; Fall back to built-in presets ("Standard" at index 0) when no saved theme entries exist      SetThemesColors()    EndIf    ;    MaxIndex = ListSize(InterfaceColorPresets()) - 1    If MaxIndex >= 0      If ColorTheme < 0 Or ColorTheme > MaxIndex        ColorTheme = 0      EndIf      SelectElement(InterfaceColorPresets(), ColorTheme)    EndIf  Else    ColorTheme = ListIndex(InterfaceColorPresets())    If ColorTheme < 0      ColorTheme = 0      SelectElement(InterfaceColorPresets(), 0)    EndIf  EndIf  ;  ProcedureReturn ColorThemeEndProcedure;Procedure SetColorThemesToPreferences(MyPreferenceFile$, DefaultTheme)  ;  ; Role: Replaces all "ColorPresets*" entries in 'MyPreferenceFile$' with the current contents  ;       of InterfaceColorPresets() and records 'DefaultTheme' as the active theme index.  ;  Protected PrefString$, Index, MaxIndex  Protected NewList OldKeys.s()  ;  MaxIndex = ListSize(InterfaceColorPresets()) - 1  If MyPreferenceFile$ And MaxIndex >= 0    If OpenPreferences(MyPreferenceFile$) = 0      If CreatePreferences(MyPreferenceFile$)        ClosePreferences()      EndIf    EndIf    ;    If OpenPreferences(MyPreferenceFile$)      ; Collect obsolete preset keys first so RemovePreferenceKey() never mutates an active enumeration      ExaminePreferenceKeys()      While NextPreferenceKey()        If Left(PreferenceKeyName(), 12) = "ColorPresets"          AddElement(OldKeys())          OldKeys() = PreferenceKeyName()        EndIf      Wend      ForEach OldKeys()        RemovePreferenceKey(OldKeys())      Next      ;      ; Serialize current presets using commas as field delimiters (commas in names become hyphens)      ForEach InterfaceColorPresets()        PrefString$ = ReplaceString(InterfaceColorPresets()\PresetName, ",", "-") + ","        PrefString$ + Str(InterfaceColorPresets()\Editable) + ","        PrefString$ + Str(InterfaceColorPresets()\BackgroundColor) + ","        PrefString$ + Str(InterfaceColorPresets()\TextColor) + ","        PrefString$ + Str(InterfaceColorPresets()\DefaultBackgroundColor) + ","        PrefString$ + Str(InterfaceColorPresets()\DefaultTextColor) + ","        Index + 1        WritePreferenceString("ColorPresets" + Str(Index), PrefString$)      Next      ;      If DefaultTheme < 0 Or DefaultTheme > MaxIndex        DefaultTheme = 0      EndIf      WritePreferenceInteger("ColorTheme", DefaultTheme)      ClosePreferences()      SelectElement(InterfaceColorPresets(), DefaultTheme)    EndIf  EndIfEndProcedure;;; *************************************************************************************;;-                      2--- SECOND PART: DEMO PROCEDURE ---;; *************************************************************************************;CompilerIf #PB_Compiler_IsMainFile  ; The following won't run when this file is used as 'Included'.  ;  Procedure ThemesDemoWindow()    ;    ; Role: Opens a standalone demonstration window showcasing live theme switching,    ;       custom theme editing via EditThemesColors(), per-gadget color overrides,    ;       and persistence of presets in a preference file.    ;    Protected PresentationText$, VPos, ct, GadgetList$, MyPreferenceFile$, ColorTheme, Event    ;    If OpenWindow(0, 100, 100, 450, 315, "Themes DemoWindow", #PB_Window_ScreenCentered | #PB_Window_SystemMenu | #PB_Window_Invisible)      ApplyDarkModeToWindow(0)      ;      Enumeration GadgetNum        #TFrame        #TOption1        #TOption2        #TCheckBox        #TButton1        #TText        #TString        #TEditor        #SepLine        #TTChooseTheme        #TCBChooseTheme        #TBEditThemes        #TBQuit      EndEnumeration      ;      PresentationText$ = "This window shows the result that SetGadgetColorEx can achieve when used to set display themes." + #CR$ + #CR$ +                           "The ''Exit'' button is colored red, regardless of the display theme chosen, showing that you can combine " +                          "the use of themes and independent colors for certain gadgets." + #CR$ + #CR$ +                           "Use the ''Choose the theme'' combobox to change the theme, and the ''Edit themes'' button to modify them."      ;      ; Create demo controls on the left column and a multiline presentation box on the right      FrameGadget(#TFrame, 10, 10, 120, 70, "Options")      OptionGadget(#TOption1, 15, 25, 100, 25, "Button #1")      OptionGadget(#TOption2, 15, 45, 100, 25, "Button #2")      ;      CheckBoxGadget(#TCheckBox, 10, 90, 100, 25, "Disable")      SetGadgetState(#TCheckBox, 1)      ButtonGadget(#TButton1, 10, 120, 100, 25, "Disabled Button")      DisableGadget(#TButton1, #True)      ;      TextGadget(#TText, 10, 150, 100, 25, "Simple text")      StringGadget(#TString, 10, 170, 100, 25, "StringGadget")      ;      EditorGadget(#TEditor, 140, 10, 300, 240, #PB_Editor_WordWrap)      SetGadgetText(#TEditor, PresentationText$)      ;      ; Single 1px CanvasGadget acting as a theme-aware horizontal separator above the bottom toolbar      CanvasGadget(#SepLine, 10, 265, WindowWidth(0) - 20, 1)      ;      VPos = WindowHeight(0) - 33      TextGadget(#TTChooseTheme, 10, VPos, 100, 25, "Choose the theme:")      ComboBoxGadget(#TCBChooseTheme, 120, VPos - 3, 100, 22)      ;      ; Load saved presets from the temporary preference file (or generate built-in presets on first run)      MyPreferenceFile$ = GetTemporaryDirectory() + "MyPrefs.txt"      ColorTheme = GetColorThemesFromPreferences(MyPreferenceFile$)      ForEach InterfaceColorPresets()        AddGadgetItem(#TCBChooseTheme, -1, InterfaceColorPresets()\PresetName)      Next      SelectElement(InterfaceColorPresets(), ColorTheme)      SetGadgetState(#TCBChooseTheme, ColorTheme)      ;      ButtonGadget(#TBEditThemes, 230, VPos - 4, 100, 25, "Edit themes")      ButtonGadget(#TBQuit, WindowWidth(0) - 100, VPos - 4, 90, 25, "Exit")      ;      ; Build the comma-separated list of all demo gadgets to be themed together      For ct = #TFrame To #TBQuit        GadgetList$ + Str(ct) + ","      Next      SetGadgetsColorsFromTheme(0, @InterfaceColorPresets(), GadgetList$)      ;      ; Override the Exit button foreground independently from the active theme      SetGadgetColorEx(#TBQuit, #PB_Gadget_FrontColor, RGB(255, 20, 20))      HideWindow(0, #False)      ;      Repeat        Event = WaitWindowEvent()        If Event = #PB_Event_Gadget          Select EventGadget()            Case #TCBChooseTheme              If GetGadgetState(#TCBChooseTheme) > -1                SelectElement(InterfaceColorPresets(), GetGadgetState(#TCBChooseTheme))                SetGadgetsColorsFromTheme(0, @InterfaceColorPresets(), GadgetList$)                SetGadgetColorEx(#TBQuit, #PB_Gadget_FrontColor, RGB(255, 20, 20))              EndIf            Case #TBEditThemes              ; Pass window 0 directly so EditThemesColors() handles modal parent disabling and relative offset              EditThemesColors(0, 80, 80)              ClearGadgetItems(#TCBChooseTheme)              ColorTheme = ListIndex(InterfaceColorPresets())              ForEach InterfaceColorPresets()                AddGadgetItem(#TCBChooseTheme, -1, InterfaceColorPresets()\PresetName)              Next              SelectElement(InterfaceColorPresets(), ColorTheme)              SetGadgetState(#TCBChooseTheme, ColorTheme)              SetGadgetsColorsFromTheme(0, @InterfaceColorPresets(), GadgetList$)              SetGadgetColorEx(#TBQuit, #PB_Gadget_FrontColor, RGB(255, 20, 20))              SetForegroundWindow_(WindowID(0))            Case #TCheckBox              If GetGadgetState(#TCheckBox)                DisableGadget(#TButton1, #True)                SetGadgetText(#TButton1, "Disabled Button")              Else                DisableGadget(#TButton1, #False)                SetGadgetText(#TButton1, "Enabled Button")              EndIf            Case #TBQuit              Break          EndSelect        ElseIf Event = #PB_Event_CloseWindow          Break        EndIf      ForEver      ;      ; Persist any customized presets and the active selection before releasing the global list      SetColorThemesToPreferences(MyPreferenceFile$, GetGadgetState(#TCBChooseTheme))      ClearList(InterfaceColorPresets())      CloseWindow(0)    EndIf  EndProcedure  ;  ThemesDemoWindow()  ;CompilerEndIf  ;; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 536; FirstLine = 533; Folding = --f-; EnableXP; DPIAware