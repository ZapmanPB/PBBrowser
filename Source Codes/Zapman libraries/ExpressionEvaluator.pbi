; *********************************************************************;;                         ExpressionEvaluator;                        By Zapman - Nov 2026;;  This file should be saved under the name "ExpressionEvaluator.pbi".;; *********************************************************************;; Direct pointer-based precedence-climbing evaluator for PureBasic 6.4; compile-time integer and string expressions via EvaluateExpression(Expression$):; - Integer literals (decimal, hexadecimal '$FF', binary '%1010', character literals 'A');   and string literals (standard "..." and escaped ~"...").; - PureBasic 6.4 operator precedence:;   * Unary '-', '+', '~' (precedence 7, right-associative);   * Shifts, modulo, bitwise XOR: '<<', '>>', '%', '!' (precedence 6);   * Bitwise OR / AND: '|', '&' (precedence 5);   * Multiplicative: '*', '/' (precedence 4);   * Additive & string concatenation: '+', '-' (precedence 3);   * Relational comparisons: '=', '<>', '<', '>', '<=', '>=' (precedence 2);   * Logical unary: 'Not' (operand precedence 2, right-associative);   * Logical binary: 'And', 'Or', 'Xor' (precedence 1); - Optional constant and compiler-function resolution via EE_UnknownResolver().; - Sets Global EvError to 0 on success, or 1 on syntax, math, or unresolved-symbol errors.;Global EvError, EvIsString, EvResultStr$;Declare EvaluateExpression(Expression$) ; Allows mutual recursion with EE_UnknownResolver() on Chr()/Asc();CompilerIf Not Defined(DOUBLEQUOTE, #PB_Constant)  #DOUBLEQUOTE = 34CompilerEndIfCompilerIf Not Defined(SIMPLEQUOTE, #PB_Constant)  #SIMPLEQUOTE = 39CompilerEndIf;CompilerIf #PB_Compiler_IsMainFile  Procedure.s EE_UnknownResolver(IdentifierName$, Arguments$ = "")    ;    ; Role: Minimalist mock resolver active only when running ExpressionEvaluator.pbi standalone.    ; Output: Returns the resolved numeric or quoted string literal, or "" when the symbol is unknown.    ;    Protected Result$ = ""    ;    Select UCase(IdentifierName$)      Case "#TRUE"        Result$ = "1"      Case "#FALSE"        Result$ = "0"      Case "#PB_COMPILER_OS"        ; String constants must be returned enclosed in double quotes        Result$ = #DOUBLEQUOTE$ + "Windows" + #DOUBLEQUOTE$      Case "#MY_CUSTOM_VAR"        Result$ = "42"      Case "DEFINED"        If ReplaceString(UCase(Arguments$), " ", "") = "TESTMACRO,#PB_MACRO"          Result$ = "1"        Else          Result$ = "0"        EndIf    EndSelect    ;    ProcedureReturn Result$  EndProcedureCompilerEndIf;CompilerIf Defined(EE_UnknownResolver, #PB_Procedure)  #ResolveUnknown = #TrueCompilerElse  #ResolveUnknown = #FalseCompilerEndIf;; *********************************************************************;Enumeration EE_BinaryOps  #EE_Op_None = 0  #EE_Op_And  #EE_Op_Or  #EE_Op_Xor  #EE_Op_Eq  #EE_Op_Ne  #EE_Op_Lt  #EE_Op_Gt  #EE_Op_Le  #EE_Op_Ge  #EE_Op_Add  #EE_Op_Sub  #EE_Op_Mul  #EE_Op_Div  #EE_Op_BitOr  #EE_Op_BitAnd  #EE_Op_Shl  #EE_Op_Shr  #EE_Op_Mod  #EE_Op_BitXorEndEnumeration;Structure EE_State  *Char.Character  IsStr.i  StrVal.s  Err.iEndStructure;Macro EE_GoNextChar(Chr)  ;  ; Role: Advances a character pointer by one character in memory.  ;  Chr + SizeOf(Character)EndMacro;Macro EE_SkipSpaces(Chr)  ;  ; Role: Advances a character pointer past horizontal whitespace (spaces, non-breaking spaces, tabs).  ;  While Chr\c = ' ' Or Chr\c = 160 Or Chr\c = #TAB : EE_GoNextChar(Chr) : WendEndMacro;Procedure EE_IsSeparator(Char.c)  ;  ; Role: Identifies whether 'Char' acts as a token boundary (including null terminator) in PureBasic expressions.  ;  Select Char    Case 0, ' ', 160, #TAB, 13, 10, ';', '#', '+', '-', '*', '/', '%', '=', '<', '>',         '(', ')', '|', '&', '~', '!', ':', ',', '\', #DOUBLEQUOTE, #SIMPLEQUOTE      ProcedureReturn 1  EndSelect  ProcedureReturn 0EndProcedure;Procedure.s EE_ExtractString(*PtrToChar, *ErrorFlag.Integer)  ;  ; Role: Extracts a standard ("...") or escaped (~"...") string literal and advances '*PtrToChar'.  ; Output: Returns the unquoted string value, or sets '*ErrorFlag\i = 1' if unclosed before EOL/EOF.  ;  Protected *Char.Character = PeekI(*PtrToChar), *Start.Character  Protected IsEscaped = Bool(*Char\c = '~')  Protected Result$  ;  If IsEscaped : EE_GoNextChar(*Char) : EndIf  If *Char\c <> #DOUBLEQUOTE    *ErrorFlag\i = 1    ProcedureReturn ""  EndIf  EE_GoNextChar(*Char)  *Start = *Char  ;  If IsEscaped = #False    ; Fast-path: extract the entire non-escaped literal in a single memory copy    While *Char\c <> 0 And *Char\c <> 13 And *Char\c <> 10 And *Char\c <> #DOUBLEQUOTE      EE_GoNextChar(*Char)    Wend    If *Char\c = #DOUBLEQUOTE      Result$ = PeekS(*Start, (*Char - *Start) / SizeOf(Character))      EE_GoNextChar(*Char)    Else      *ErrorFlag\i = 1    EndIf  Else    ; Escaped literal (~"..."): decode standard PureBasic escape sequences    While *Char\c <> 0 And *Char\c <> 13 And *Char\c <> 10 And *Char\c <> #DOUBLEQUOTE      If *Char\c = '\'        EE_GoNextChar(*Char)        If *Char\c = 0 Or *Char\c = 13 Or *Char\c = 10          Break        EndIf        Select *Char\c          Case 'n' : Result$ + #LF$          Case 'r' : Result$ + #CR$          Case 't' : Result$ + #TAB$          Default  : Result$ + Chr(*Char\c)        EndSelect      Else        Result$ + Chr(*Char\c)      EndIf      EE_GoNextChar(*Char)    Wend    If *Char\c = #DOUBLEQUOTE      EE_GoNextChar(*Char)    Else      *ErrorFlag\i = 1    EndIf  EndIf  ;  PokeI(*PtrToChar, *Char)  ProcedureReturn Result$EndProcedure;Procedure.s EE_ExtractIdentifier(*PtrToChar)  ;  ; Role: Extracts an identifier or constant name (collapsing optional 'Mod::' or 'Mod :: #Const' prefixes)  ;       and advances '*PtrToChar'.  ;  Protected *Char.Character = PeekI(*PtrToChar), *TempChar.Character, *Start.Character  Protected Result$  ;  EE_SkipSpaces(*Char)  *Start = *Char  If *Char\c = '#'    *TempChar = *Char + SizeOf(Character)    If (*TempChar\c >= 'A' And *TempChar\c <= 'Z') Or (*TempChar\c >= 'a' And *TempChar\c <= 'z') Or       *TempChar\c = '_' Or *TempChar\c >= 128      EE_GoNextChar(*Char)    Else      ProcedureReturn ""    EndIf  EndIf  ;  While EE_IsSeparator(*Char\c) = 0 Or *Char = *Start    If EE_IsSeparator(*Char\c) : Break : EndIf    EE_GoNextChar(*Char)    *TempChar = *Char    EE_SkipSpaces(*TempChar)    If *TempChar\c = ':' And PeekC(*TempChar + SizeOf(Character)) = ':'      ; Absorb 'Mod::Identifier' or 'Mod :: #Const' into a single qualified token      Result$ + PeekS(*Start, (*Char - *Start) / SizeOf(Character)) + "::"      *Char = *TempChar + 2 * SizeOf(Character)      EE_SkipSpaces(*Char)      *Start = *Char      If *Char\c = '#' : EE_GoNextChar(*Char) : EndIf    EndIf  Wend  ;  If *Char > *Start    Result$ + PeekS(*Start, (*Char - *Start) / SizeOf(Character))  EndIf  PokeI(*PtrToChar, *Char)  ProcedureReturn Result$EndProcedure;Procedure EE_PeekBinaryOp(*Char.Character, *OutPrec.Integer, *OutNextChar)  ;  ; Role: Inspects '*Char' for a binary operator without allocating strings.  ; Output: Returns the #EE_Op_... constant, writes its precedence (1..6) to '*OutPrec',  ;         and stores the post-operator character pointer in '*OutNextChar'.  ;  Protected Op = #EE_Op_None, Prec = 0, StepChars = 1  Protected NextC = PeekC(*Char + SizeOf(Character))  ;  Select *Char\c    Case '+' : Op = #EE_Op_Add    : Prec = 3    Case '-' : Op = #EE_Op_Sub    : Prec = 3    Case '*' : Op = #EE_Op_Mul    : Prec = 4    Case '/' : Op = #EE_Op_Div    : Prec = 4    Case '%' : Op = #EE_Op_Mod    : Prec = 6    Case '!' : Op = #EE_Op_BitXor : Prec = 6    Case '|' : Op = #EE_Op_BitOr  : Prec = 5    Case '&' : Op = #EE_Op_BitAnd : Prec = 5    Case '='      If NextC = '<'      : Op = #EE_Op_Le : Prec = 2 : StepChars = 2      ElseIf NextC = '>'  : Op = #EE_Op_Ge : Prec = 2 : StepChars = 2      Else                : Op = #EE_Op_Eq : Prec = 2      EndIf    Case '<'      If NextC = '='      : Op = #EE_Op_Le  : Prec = 2 : StepChars = 2      ElseIf NextC = '>'  : Op = #EE_Op_Ne  : Prec = 2 : StepChars = 2      ElseIf NextC = '<'  : Op = #EE_Op_Shl : Prec = 6 : StepChars = 2      Else                : Op = #EE_Op_Lt  : Prec = 2      EndIf    Case '>'      If NextC = '='      : Op = #EE_Op_Ge  : Prec = 2 : StepChars = 2      ElseIf NextC = '>'  : Op = #EE_Op_Shr : Prec = 6 : StepChars = 2      Else                : Op = #EE_Op_Gt  : Prec = 2      EndIf    Default      ; Check case-insensitive logical keywords ('Or', 'And', 'Xor') bounded by a separator      If (*Char\c | 32) = 'o' And (NextC | 32) = 'r' And EE_IsSeparator(PeekC(*Char + 2 * SizeOf(Character)))        Op = #EE_Op_Or : Prec = 1 : StepChars = 2      ElseIf (*Char\c | 32) = 'a' And (NextC | 32) = 'n' And (PeekC(*Char + 2 * SizeOf(Character)) | 32) = 'd' And             EE_IsSeparator(PeekC(*Char + 3 * SizeOf(Character)))        Op = #EE_Op_And : Prec = 1 : StepChars = 3      ElseIf (*Char\c | 32) = 'x' And (NextC | 32) = 'o' And (PeekC(*Char + 2 * SizeOf(Character)) | 32) = 'r' And             EE_IsSeparator(PeekC(*Char + 3 * SizeOf(Character)))        Op = #EE_Op_Xor : Prec = 1 : StepChars = 3      EndIf  EndSelect  ;  *OutPrec\i = Prec  If Op <> #EE_Op_None    PokeI(*OutNextChar, *Char + StepChars * SizeOf(Character))  EndIf  ProcedureReturn OpEndProcedure;Procedure EE_ApplyBinaryOp(Op, LeftVal, LeftIsStr, LeftStr$, RightVal, *S.EE_State)  ;  ; Role: Applies binary operator 'Op' to Left and Right operands (updating '*S\IsStr', '*S\StrVal', and '*S\Err').  ;  Protected RightIsStr = *S\IsStr  Protected RightStr$  ;  If RightIsStr    RightStr$ = *S\StrVal    *S\IsStr  = #False    *S\StrVal = ""  EndIf  ;  ; Boolean logical operators accept both numeric and string truth values (non-empty string = #True)  If Op = #EE_Op_And Or Op = #EE_Op_Or Or Op = #EE_Op_Xor    If LeftIsStr  : LeftVal  = Bool(LeftStr$ <> "")  : Else : LeftVal  = Bool(LeftVal <> 0)  : EndIf    If RightIsStr : RightVal = Bool(RightStr$ <> "") : Else : RightVal = Bool(RightVal <> 0) : EndIf    Select Op      Case #EE_Op_And : ProcedureReturn Bool(LeftVal And RightVal)      Case #EE_Op_Or  : ProcedureReturn Bool(LeftVal Or RightVal)      Case #EE_Op_Xor : ProcedureReturn Bool(LeftVal XOr RightVal)    EndSelect  EndIf  ;  ; String concatenation and relational comparisons require both operands to be strings  If LeftIsStr Or RightIsStr    If LeftIsStr <> RightIsStr      *S\Err = 1      ProcedureReturn 0    EndIf    Select Op      Case #EE_Op_Add        *S\IsStr  = #True        *S\StrVal = LeftStr$ + RightStr$        ProcedureReturn Bool(*S\StrVal <> "")      Case #EE_Op_Eq : ProcedureReturn Bool(LeftStr$ = RightStr$)      Case #EE_Op_Ne : ProcedureReturn Bool(LeftStr$ <> RightStr$)      Case #EE_Op_Lt : ProcedureReturn Bool(LeftStr$ < RightStr$)      Case #EE_Op_Gt : ProcedureReturn Bool(LeftStr$ > RightStr$)      Case #EE_Op_Le : ProcedureReturn Bool(LeftStr$ <= RightStr$)      Case #EE_Op_Ge : ProcedureReturn Bool(LeftStr$ >= RightStr$)      Default        : *S\Err = 1 : ProcedureReturn 0    EndSelect  EndIf  ;  ; Pure integer arithmetic, bitwise, shift, and comparison operations  Select Op    Case #EE_Op_Add    : ProcedureReturn LeftVal + RightVal    Case #EE_Op_Sub    : ProcedureReturn LeftVal - RightVal    Case #EE_Op_Mul    : ProcedureReturn LeftVal * RightVal    Case #EE_Op_Div    : If RightVal : ProcedureReturn LeftVal / RightVal : Else : *S\Err = 1 : EndIf    Case #EE_Op_Mod    : If RightVal : ProcedureReturn LeftVal % RightVal : Else : *S\Err = 1 : EndIf    Case #EE_Op_Eq     : ProcedureReturn Bool(LeftVal = RightVal)    Case #EE_Op_Ne     : ProcedureReturn Bool(LeftVal <> RightVal)    Case #EE_Op_Lt     : ProcedureReturn Bool(LeftVal < RightVal)    Case #EE_Op_Gt     : ProcedureReturn Bool(LeftVal > RightVal)    Case #EE_Op_Le     : ProcedureReturn Bool(LeftVal <= RightVal)    Case #EE_Op_Ge     : ProcedureReturn Bool(LeftVal >= RightVal)    Case #EE_Op_BitAnd : ProcedureReturn LeftVal & RightVal    Case #EE_Op_BitOr  : ProcedureReturn LeftVal | RightVal    Case #EE_Op_BitXor : ProcedureReturn LeftVal ! RightVal    Case #EE_Op_Shl    : ProcedureReturn LeftVal << RightVal    Case #EE_Op_Shr    : ProcedureReturn LeftVal >> RightVal  EndSelect  ProcedureReturn 0EndProcedure;Procedure EE_ParseExpr(*S.EE_State, MinPrec = 1)  ;  ; Role: Recursive precedence-climbing expression parser operating directly on '*S\Char'.  ;       Parses prefix atoms/unary operators first, then reduces all binary operators with precedence >= 'MinPrec'.  ;  Protected *Char.Character, *Start.Character, *NextOpChar.Character  Protected LeftVal, RightVal, LeftIsStr, Op, OpPrec, UnaryC, ParenDepth  Protected LeftStr$, Ident$, IdentLCase$, Args$, Resolved$  ;  If *S\Err : ProcedureReturn 0 : EndIf  *Char = *S\Char  EE_SkipSpaces(*Char)  *S\IsStr  = #False  *S\StrVal = ""  ;  ; -------------------------------------------------------------------  ; 1. PREFIX ATOM OR UNARY OPERATOR  ; -------------------------------------------------------------------  If *Char\c = #DOUBLEQUOTE Or (*Char\c = '~' And PeekC(*Char + SizeOf(Character)) = #DOUBLEQUOTE)    *S\StrVal = EE_ExtractString(@*Char, @*S\Err)    *S\IsStr  = #True    *S\Char   = *Char    LeftVal   = Bool(*S\StrVal <> "")    ;  ElseIf *Char\c = #SIMPLEQUOTE    ; Single-character literal ('A')    EE_GoNextChar(*Char)    If *Char\c = 0 Or *Char\c = 13 Or *Char\c = 10 Or *Char\c = #SIMPLEQUOTE      *S\Err = 1    Else      LeftVal = *Char\c      EE_GoNextChar(*Char)      If *Char\c = #SIMPLEQUOTE : EE_GoNextChar(*Char) : Else : *S\Err = 1 : EndIf    EndIf    *S\Char = *Char    ;  ElseIf *Char\c = '('    EE_GoNextChar(*Char)    *S\Char = *Char    LeftVal = EE_ParseExpr(*S, 1)    *Char   = *S\Char    EE_SkipSpaces(*Char)    If *Char\c = ')' : EE_GoNextChar(*Char) : *S\Char = *Char : Else : *S\Err = 1 : EndIf    ;  ElseIf *Char\c = '+' Or *Char\c = '-' Or *Char\c = '~'    ; High-precedence unary operators (precedence 7, right-associative)    UnaryC = *Char\c    EE_GoNextChar(*Char)    *S\Char = *Char    LeftVal = EE_ParseExpr(*S, 7)    If *S\IsStr      *S\Err = 1    ElseIf UnaryC = '-'      LeftVal = -LeftVal    ElseIf UnaryC = '~'      LeftVal = ~LeftVal    EndIf    ;  ElseIf *Char\c >= '0' And *Char\c <= '9'    *Start = *Char    While *Char\c >= '0' And *Char\c <= '9' : EE_GoNextChar(*Char) : Wend    If EE_IsSeparator(*Char\c) = 0      *S\Err = 1    Else      LeftVal = Val(PeekS(*Start, (*Char - *Start) / SizeOf(Character)))    EndIf    *S\Char = *Char    ;  ElseIf *Char\c = '$'    *Start = *Char    EE_GoNextChar(*Char)    While (*Char\c >= '0' And *Char\c <= '9') Or (*Char\c >= 'a' And *Char\c <= 'f') Or (*Char\c >= 'A' And *Char\c <= 'F')      EE_GoNextChar(*Char)    Wend    If *Char = *Start + SizeOf(Character) Or EE_IsSeparator(*Char\c) = 0      *S\Err = 1    Else      LeftVal = Val(PeekS(*Start, (*Char - *Start) / SizeOf(Character)))    EndIf    *S\Char = *Char    ;  ElseIf *Char\c = '%'    *Start = *Char    EE_GoNextChar(*Char)    While *Char\c = '0' Or *Char\c = '1' : EE_GoNextChar(*Char) : Wend    If *Char = *Start + SizeOf(Character) Or EE_IsSeparator(*Char\c) = 0      *S\Err = 1    Else      LeftVal = Val(PeekS(*Start, (*Char - *Start) / SizeOf(Character)))    EndIf    *S\Char = *Char    ;  ElseIf (*Char\c | 32) = 'n' And (PeekC(*Char + SizeOf(Character)) | 32) = 'o' And         (PeekC(*Char + 2 * SizeOf(Character)) | 32) = 't' And EE_IsSeparator(PeekC(*Char + 3 * SizeOf(Character)))    ; Logical unary 'Not' (evaluates relational/arithmetic operand at MinPrec = 2 before 'And'/'Or'/'Xor')    *S\Char = *Char + 3 * SizeOf(Character)    LeftVal = EE_ParseExpr(*S, 2)    If *S\IsStr      LeftVal   = Bool(*S\StrVal = "")      *S\IsStr  = #False      *S\StrVal = ""    Else      LeftVal = Bool(LeftVal = 0)    EndIf    ;  ElseIf *Char\c = '#' Or (*Char\c >= 'A' And *Char\c <= 'Z') Or         (*Char\c >= 'a' And *Char\c <= 'z') Or *Char\c = '_' Or *Char\c >= 128    Ident$      = EE_ExtractIdentifier(@*Char)    IdentLCase$ = LCase(Ident$)    If Ident$ = "" Or IdentLCase$ = "and" Or IdentLCase$ = "or" Or IdentLCase$ = "xor"      *S\Err  = 1      *S\Char = *Char    Else      CompilerIf #ResolveUnknown        EE_SkipSpaces(*Char)        If *Char\c = '('          ; Extract raw balanced argument slice for compile-time functions (Defined, SizeOf, Chr, Asc)          EE_GoNextChar(*Char)          *Start     = *Char          ParenDepth = 1          While ParenDepth > 0 And *Char\c <> 0 And *Char\c <> 13 And *Char\c <> 10 And *Char\c <> ';'            If *Char\c = #DOUBLEQUOTE Or (*Char\c = '~' And PeekC(*Char + SizeOf(Character)) = #DOUBLEQUOTE)              EE_ExtractString(@*Char, @*S\Err)              If *S\Err : Break : EndIf            ElseIf *Char\c = #SIMPLEQUOTE              EE_GoNextChar(*Char)              If *Char\c <> 0 And *Char\c <> 13 And *Char\c <> 10 : EE_GoNextChar(*Char) : EndIf              If *Char\c = #SIMPLEQUOTE : EE_GoNextChar(*Char) : Else : *S\Err = 1 : Break : EndIf            Else              If *Char\c = '('                ParenDepth + 1              ElseIf *Char\c = ')'                ParenDepth - 1              EndIf              EE_GoNextChar(*Char)            EndIf          Wend          If *S\Err = 0 And ParenDepth = 0            Args$ = Trim(PeekS(*Start, (*Char - *Start) / SizeOf(Character) - 1))          Else            *S\Err = 1          EndIf        EndIf        *S\Char = *Char        If *S\Err = 0          Resolved$ = EE_UnknownResolver(Ident$, Args$)          If Resolved$ = ""            *S\Err = 1          ElseIf Len(Resolved$) >= 2 And Left(Resolved$, 1) = #DOUBLEQUOTE$ And Right(Resolved$, 1) = #DOUBLEQUOTE$            *S\IsStr  = #True            *S\StrVal = Mid(Resolved$, 2, Len(Resolved$) - 2)            LeftVal   = Bool(*S\StrVal <> "")          Else            LeftVal = Val(Resolved$)          EndIf        EndIf      CompilerElse        *S\Char = *Char        *S\Err  = 1      CompilerEndIf    EndIf    ;  Else    *S\Err = 1  EndIf  ;  ; -------------------------------------------------------------------  ; 2. PRECEDENCE-CLIMBING BINARY REDUCTION LOOP  ; -------------------------------------------------------------------  While *S\Err = 0    *Char = *S\Char    EE_SkipSpaces(*Char)    Op = EE_PeekBinaryOp(*Char, @OpPrec, @*NextOpChar)    If Op = #EE_Op_None Or OpPrec < MinPrec      *S\Char = *Char      Break    EndIf    ;    LeftIsStr = *S\IsStr    If LeftIsStr : LeftStr$ = *S\StrVal : EndIf    *S\Char  = *NextOpChar    RightVal = EE_ParseExpr(*S, OpPrec + 1)    If *S\Err : Break : EndIf    ;    LeftVal = EE_ApplyBinaryOp(Op, LeftVal, LeftIsStr, LeftStr$, RightVal, *S)  Wend  ;  ProcedureReturn LeftValEndProcedure;Procedure EvaluateExpression(Expression$)  ;  ; Role: Evaluates an integer or boolean/string expression and sets Global EvError (0 if valid, 1 on failure),  ;       EvIsString (#True when the final result is a string), and EvResultStr$.  ;  Protected State.EE_State  Protected Result  ;  State\Char = @Expression$  Result     = EE_ParseExpr(@State, 1)  ;  ; Reject trailing unparsed tokens or unmatched closing parentheses  If State\Err = 0    EE_SkipSpaces(State\Char)    If State\Char\c <> 0 And State\Char\c <> 13 And State\Char\c <> 10 And State\Char\c <> ';'      State\Err = 1    EndIf  EndIf  ;  EvError = State\Err  If EvError = 0 And State\IsStr    EvIsString   = #True    EvResultStr$ = State\StrVal    ProcedureReturn Bool(EvResultStr$ <> "")  EndIf  EvIsString   = #False  EvResultStr$ = ""  If EvError    ProcedureReturn 0  EndIf  ProcedureReturn ResultEndProcedure;; Example of usage:CompilerIf #PB_Compiler_IsMainFile  ; The following won't run when this file is used as 'Included'.  ;  Expression$ = "$FFF8&%1001"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str($FFF8 & %1001)  Debug "_____________________________________________"  ;  Expression$ = "(44/2)+3*4"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str((44 / 2) + 3 * 4)  Debug "_____________________________________________"  ;  Expression$ = "3 + 2 * (5 + 7)"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(3 + 2 * (5 + 7))  Debug "_____________________________________________"  ;  Expression$ = "5 + -2"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(5 + -2)  Debug "_____________________________________________"  ;  Expression$ = "3 + ~5"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(3 + ~5)  Debug "_____________________________________________"  ;  Expression$ = "10 - 3 + 2"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(10 - 3 + 2)  Debug "_____________________________________________"  ;  Expression$ = "1 | 2 & ~4"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(1 | 2 & ~4)  Debug "_____________________________________________"  ;  ; --- Tests for comparison operators ---  ;  Expression$ = "10 = 10"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool(10 = 10))  Debug "_____________________________________________"  ;  Expression$ = "5 <> 8"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool(5 <> 8))  Debug "_____________________________________________"  ;  Expression$ = "4 * 2 > 7"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool(4 * 2 > 7))  Debug "_____________________________________________"  ;  Expression$ = "10 - 2 <= 8"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool(10 - 2 <= 8))  Debug "_____________________________________________"  ;  Expression$ = "10 = 8"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool(10 = 8))  Debug "_____________________________________________"  ;  ; --- Tests for logical operators (And, Or, Xor, Not) and parser edge cases ---  ;  Expression$ = "Not 0"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool(Not 0))  Debug "_____________________________________________"  ;  Expression$ = "1 = 1 And 2 = 2"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool(1 = 1 And 2 = 2))  Debug "_____________________________________________"  ;  Expression$ = "1 = 2 Or 5 > 3"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool(1 = 2 Or 5 > 3))  Debug "_____________________________________________"  ;  Expression$ = "(Not 0) And (0 Or 1)"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool((Not 0) And (0 Or 1)))  Debug "_____________________________________________"  ;  Expression$ = "1" + #TAB$ + "Xor" + #TAB$ + "1"  result  = EvaluateExpression(Expression$)  Debug "The expression 1[TAB]Xor[TAB]1 is equal to " + Str(result)  Debug "Verification: " + Str(Bool(1 XOr 1))  Debug "_____________________________________________"  ;  ; --- Tests for string evaluations ---  ;  ; 1. Standard equality  Expression$ = #DOUBLEQUOTE$ + "PureBasic" + #DOUBLEQUOTE$ + " = " + #DOUBLEQUOTE$ + "PureBasic" + #DOUBLEQUOTE$  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool("PureBasic" = "PureBasic"))  Debug "_____________________________________________"  ;  ; 2. Inequality check  Expression$ = #DOUBLEQUOTE$ + "Mac" + #DOUBLEQUOTE$ + " <> " + #DOUBLEQUOTE$ + "Windows" + #DOUBLEQUOTE$  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool("Mac" <> "Windows"))  Debug "_____________________________________________"  ;  ; 3. Case sensitivity (Should fail and return 0)  Expression$ = #DOUBLEQUOTE$ + "Test" + #DOUBLEQUOTE$ + " = " + #DOUBLEQUOTE$ + "test" + #DOUBLEQUOTE$  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool("Test" = "test"))  Debug "_____________________________________________"  ;  ; 4. Edge case: Empty strings  Expression$ = #DOUBLEQUOTE$ + #DOUBLEQUOTE$ + " = " + #DOUBLEQUOTE$ + #DOUBLEQUOTE$  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool("" = ""))  Debug "_____________________________________________"  ;  ; 5. Mixed types: Strings and logic combined in one AST  Expression$ = "(" + #DOUBLEQUOTE$ + "A" + #DOUBLEQUOTE$ + " = " + #DOUBLEQUOTE$ + "A" + #DOUBLEQUOTE$ + ") And (10 > 5)"  result  = EvaluateExpression(Expression$)  Debug "The expression " + Expression$ + " is equal to " + Str(result)  Debug "Verification: " + Str(Bool("A" = "A" And 10 > 5))  Debug "_____________________________________________"  ;CompilerEndIf;; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 722; FirstLine = 674; Folding = ---; EnableXP; DPIAware