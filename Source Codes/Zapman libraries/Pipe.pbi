;;***********************************************************;;                      -- Pipe.pbi --;       For Windows only - PB 6.11 -> 6.4 - Nov 2026;                         Zapman;;   This file should be saved under the name "Pipe.pbi".;;     This set of functions facilitates single-instance;    detection and inter-process argument forwarding via;                 Windows Named Pipes.;;***********************************************************;#Pipe_BufferChars = 8192#Pipe_BufferBytes = #Pipe_BufferChars * SizeOf(Character)#Pipe_IOTimeoutMS = 2000;Enumeration PipeServerState  #PipeState_Failed        = -1  #PipeState_Uninitialized = 0  #PipeState_NeedConnect   = 1  #PipeState_Listening     = 2  #PipeState_Connected     = 3EndEnumeration;Global Pipe_FullName$;Procedure.s GetConnectNamedPipeErrorDescription(errorCode)  ;  ; Role: Translates common Windows Named Pipe and asynchronous I/O error codes into readable English messages.  ;  Select errorCode    Case #INVALID_HANDLE_VALUE      ProcedureReturn "INVALID HANDLE VALUE"    Case #ERROR_BROKEN_PIPE      ProcedureReturn "The pipe has been ended."    Case #ERROR_PIPE_CONNECTED      ProcedureReturn "There is a process on the other end of the pipe."    Case #ERROR_PIPE_LISTENING      ProcedureReturn "Waiting for a process to open the other end of the pipe."    Case #ERROR_NO_DATA      ProcedureReturn "The pipe is being closed."    Case #ERROR_PIPE_NOT_CONNECTED      ProcedureReturn "No process is on the other end of the pipe."    Case #ERROR_PIPE_BUSY      ProcedureReturn "All pipe instances are busy."    Case 233 ; #ERROR_PIPE_DISCONNECTED      ProcedureReturn "The other end of the pipe is closed."    Case #ERROR_MORE_DATA      ProcedureReturn "More data is available."    Case #ERROR_IO_PENDING      ProcedureReturn "I/O operation is pending."    Case #ERROR_OPERATION_ABORTED      ProcedureReturn "The operation was aborted."    Case #ERROR_FILE_NOT_FOUND      ProcedureReturn "The system cannot find the file specified."    Case #ERROR_ACCESS_DENIED      ProcedureReturn "Access is denied."    Case #ERROR_INVALID_HANDLE      ProcedureReturn "The handle is invalid."    Case #WAIT_TIMEOUT      ProcedureReturn "The pipe I/O operation timed out."    Default      ProcedureReturn "Unknown error code: " + Str(errorCode)  EndSelectEndProcedure;Procedure.s Pipe_ResolveName(PipeName$ = "")  ;  ; Role: Builds a canonical "\\.\pipe\<name>runningpipe" path from PipeName$, or derives it from  ;       ProgramFilename() when omitted (stripping PureBasic debugger "_Compilation..." suffixes  ;       and falling back to "zapmanrunningpipe" when running from a generic temp executable).  ;  Protected BaseName$, CompPos  ;  BaseName$ = LCase(Trim(PipeName$))  If Left(BaseName$, 9) = "\\.\pipe\"    BaseName$ = Mid(BaseName$, 10)  EndIf  ;  If BaseName$ = ""    BaseName$ = LCase(GetFilePart(ProgramFilename(), #PB_FileSystem_NoExtension))    If Left(BaseName$, 21) = "purebasic_compilation"      BaseName$ = ""    Else      CompPos = FindString(BaseName$, "_compilation")      If CompPos > 1        BaseName$ = Left(BaseName$, CompPos - 1)      EndIf    EndIf    If BaseName$ = ""      BaseName$ = "zapman"    EndIf  EndIf  ;  If Right(BaseName$, 11) <> "runningpipe"    BaseName$ + "runningpipe"  EndIf  ;  ProcedureReturn "\\.\pipe\" + BaseName$EndProcedure;Procedure Pipe_CompleteOverlapped(hPipe, *Overlapped.OVERLAPPED, *BytesTransferred.Long, TimeoutMS = #Pipe_IOTimeoutMS)  ;  ; Role: Waits up to TimeoutMS for an asynchronous ReadFile/WriteFile operation in #ERROR_IO_PENDING state,  ;       canceling the IRP safely before returning if the remote process stalls or terminates unexpectedly.  ; Output: Returns #True on completion, or #False on failure/timeout (preserving LastError).  ;  Protected LastErr, WaitRes  ;  LastErr = GetLastError_()  If LastErr <> #ERROR_IO_PENDING    SetLastError_(LastErr)    ProcedureReturn #False  EndIf  ;  WaitRes = WaitForSingleObject_(*Overlapped\hEvent, TimeoutMS)  If WaitRes <> #WAIT_OBJECT_0    ; Cancel pending kernel I/O and wait for cancellation to settle before *Overlapped leaves scope    CancelIo_(hPipe)    GetOverlappedResult_(hPipe, *Overlapped, *BytesTransferred, #True)    SetLastError_(#WAIT_TIMEOUT)    ProcedureReturn #False  EndIf  ;  ProcedureReturn Bool(GetOverlappedResult_(hPipe, *Overlapped, *BytesTransferred, #False) <> 0)EndProcedure;Procedure Pipe_ArmConnection(hPipe, *Overlapped.OVERLAPPED)  ;  ; Role: Resets *Overlapped and initiates a non-blocking ConnectNamedPipe_() listen operation.  ; Output: Returns #PipeState_Listening if pending, #PipeState_Connected if a client is already waiting,  ;         or #PipeState_NeedConnect on transient failure.  ;  Protected LastErr  ;  ZeroMemory_(*Overlapped, OffsetOf(OVERLAPPED\hEvent))  ResetEvent_(*Overlapped\hEvent)  If ConnectNamedPipe_(hPipe, *Overlapped)    ProcedureReturn #PipeState_Connected  EndIf  ;  LastErr = GetLastError_()  If LastErr = #ERROR_PIPE_CONNECTED    ProcedureReturn #PipeState_Connected  ElseIf LastErr = #ERROR_IO_PENDING    ProcedureReturn #PipeState_Listening  EndIf  ;  ProcedureReturn #PipeState_NeedConnectEndProcedure;Procedure CheckForOtherInstance(message$, PipeName$ = "")  ;  ; Role: Checks whether another instance of the application already owns the named pipe.  ;       - If no instance is running, records the resolved pipe name and returns #False.  ;       - If an instance is already running, transmits message$ (even if empty), waits for "ACK",  ;         and returns #True so the caller can terminate immediately.  ;  Protected Overlapped.OVERLAPPED  Protected hRunningPipe, *SendBuffer  Protected BytesTransmitted.l, DummyZero.w, AckBuffer.q  Protected ByteLen, TotalRetries, WriteRetries, LastErr, SentOK  ;  Pipe_FullName$ = Pipe_ResolveName(PipeName$)  ByteLen        = StringByteLength(message$, #PB_Unicode)  If ByteLen > 0    *SendBuffer = @message$  Else    ; Provide a valid non-null address when sending a 0-byte message to wake up the existing instance    *SendBuffer = @DummyZero  EndIf  ;  While TotalRetries < 100    hRunningPipe = CreateFile_(@Pipe_FullName$, #GENERIC_READ | #GENERIC_WRITE, 0, #Null, #OPEN_EXISTING, #FILE_FLAG_OVERLAPPED, #Null)    If hRunningPipe <> #INVALID_HANDLE_VALUE      Overlapped\hEvent = CreateEvent_(#Null, #True, #False, #Null)      If Overlapped\hEvent = #Null        CloseHandle_(hRunningPipe)        ProcedureReturn #True      EndIf      ;      WriteRetries = 0      Repeat        ZeroMemory_(@Overlapped, OffsetOf(OVERLAPPED\hEvent))        ResetEvent_(Overlapped\hEvent)        If WriteFile_(hRunningPipe, *SendBuffer, ByteLen, @BytesTransmitted, @Overlapped)          SentOK = #True          Break        ElseIf Pipe_CompleteOverlapped(hRunningPipe, @Overlapped, @BytesTransmitted)          SentOK = #True          Break        EndIf        ;        LastErr = GetLastError_()        If LastErr = #ERROR_PIPE_NOT_CONNECTED          ; Server recycled the pipe right between CreateFile and WriteFile: reconnect cleanly          Break        EndIf        WriteRetries + 1        Delay(20)      Until WriteRetries >= 10      ;      If SentOK        ; Wait for the server's "ACK" reply before closing our handle so no unread data is dropped        ZeroMemory_(@Overlapped, OffsetOf(OVERLAPPED\hEvent))        ResetEvent_(Overlapped\hEvent)        If ReadFile_(hRunningPipe, @AckBuffer, SizeOf(AckBuffer), @BytesTransmitted, @Overlapped) = 0          Pipe_CompleteOverlapped(hRunningPipe, @Overlapped, @BytesTransmitted)        EndIf        CloseHandle_(Overlapped\hEvent)        CloseHandle_(hRunningPipe)        ProcedureReturn #True      EndIf      ;      CloseHandle_(Overlapped\hEvent)      CloseHandle_(hRunningPipe)      If LastErr <> #ERROR_PIPE_NOT_CONNECTED        ProcedureReturn #True      EndIf    Else      LastErr = GetLastError_()      If LastErr = #ERROR_FILE_NOT_FOUND        ; No previous instance owns the pipe: we are the primary instance        ProcedureReturn #False      ElseIf LastErr = #ERROR_PIPE_BUSY        WaitNamedPipe_(@Pipe_FullName$, 20)      Else        ; Another instance owns the pipe, though an unexpected access error prevented connection        ProcedureReturn #True      EndIf    EndIf    ;    TotalRetries + 1    Delay(20)  Wend  ;  ProcedureReturn #TrueEndProcedure;Procedure.s ListenForPipeMessages(*ClientConnected.Integer = #Null)  ;  ; Role: Initializes the server named pipe on the first call, then polls it non-blockingly (0 ms,  ;       zero memory allocation while idle) on subsequent calls from the main event loop.  ; Parameters:  ;   *ClientConnected - Optional integer pointer set to #True whenever another instance connected  ;                      (even if it transmitted an empty message$), or #False when idle.  ; Output: Returns the message string sent by the secondary instance, or "" when idle / empty.  ;  Static PipeState = #PipeState_Uninitialized  Static hRunningPipe = #INVALID_HANDLE_VALUE  Static Overlapped.OVERLAPPED  Protected StringBuffer$, Result$, Ack$  Protected BytesTransmitted.l, AckBytes.l, LastErr, ReadOK  ;  If *ClientConnected    *ClientConnected\i = #False  EndIf  If PipeState = #PipeState_Failed    ProcedureReturn ""  EndIf  ;  If PipeState = #PipeState_Uninitialized    If Pipe_FullName$ = ""      Pipe_FullName$ = Pipe_ResolveName()    EndIf    hRunningPipe = CreateNamedPipe_(@Pipe_FullName$, #PIPE_ACCESS_DUPLEX | #FILE_FLAG_OVERLAPPED, #PIPE_TYPE_MESSAGE | #PIPE_READMODE_MESSAGE | #PIPE_WAIT, #PIPE_UNLIMITED_INSTANCES, #Pipe_BufferBytes, #Pipe_BufferBytes, 0, #Null)    If hRunningPipe = #INVALID_HANDLE_VALUE      LastErr   = GetLastError_()      PipeState = #PipeState_Failed      MessageRequester("Error", "Unable to initialize the pipe: " + GetConnectNamedPipeErrorDescription(LastErr))      ProcedureReturn ""    EndIf    ; OVERLAPPED I/O strictly requires a manual-reset event (#True), initially non-signaled (#False)    Overlapped\hEvent = CreateEvent_(#Null, #True, #False, #Null)    If Overlapped\hEvent = #Null      LastErr = GetLastError_()      CloseHandle_(hRunningPipe)      hRunningPipe = #INVALID_HANDLE_VALUE      PipeState    = #PipeState_Failed      MessageRequester("Error", "Unable to create pipe event: " + GetConnectNamedPipeErrorDescription(LastErr))      ProcedureReturn ""    EndIf    PipeState = #PipeState_NeedConnect  EndIf  ;  If PipeState = #PipeState_NeedConnect    PipeState = Pipe_ArmConnection(hRunningPipe, @Overlapped)  EndIf  ;  If PipeState = #PipeState_Listening    ; Ultra-fast non-blocking check: return immediately with zero allocations when no client has connected    If WaitForSingleObject_(Overlapped\hEvent, 0) <> #WAIT_OBJECT_0      ProcedureReturn ""    EndIf    If GetOverlappedResult_(hRunningPipe, @Overlapped, @BytesTransmitted, #False) = 0      DisconnectNamedPipe_(hRunningPipe)      PipeState = Pipe_ArmConnection(hRunningPipe, @Overlapped)      ProcedureReturn ""    EndIf    PipeState = #PipeState_Connected  EndIf  ;  If PipeState = #PipeState_Connected    ; Allocate the receive buffer only when an incoming connection actually arrives    StringBuffer$ = Space(#Pipe_BufferChars)    ZeroMemory_(@Overlapped, OffsetOf(OVERLAPPED\hEvent))    ResetEvent_(Overlapped\hEvent)    ReadOK = ReadFile_(hRunningPipe, @StringBuffer$, #Pipe_BufferBytes, @BytesTransmitted, @Overlapped)    If ReadOK = 0      ReadOK = Pipe_CompleteOverlapped(hRunningPipe, @Overlapped, @BytesTransmitted)    EndIf    ;    If ReadOK      If *ClientConnected        *ClientConnected\i = #True      EndIf      Result$ = Left(StringBuffer$, BytesTransmitted / SizeOf(Character))      ; Acknowledge receipt so the secondary instance knows it can safely close its handle and exit      Ack$ = "ACK"      ZeroMemory_(@Overlapped, OffsetOf(OVERLAPPED\hEvent))      ResetEvent_(Overlapped\hEvent)      If WriteFile_(hRunningPipe, @Ack$, StringByteLength(Ack$, #PB_Unicode), @AckBytes, @Overlapped) = 0        Pipe_CompleteOverlapped(hRunningPipe, @Overlapped, @AckBytes)      EndIf    Else      LastErr = GetLastError_()      If LastErr = #ERROR_BROKEN_PIPE Or LastErr = #ERROR_NO_DATA Or LastErr = 233        ; Client connected and closed immediately without sending payload: still treat as a wake-up signal        If *ClientConnected          *ClientConnected\i = #True        EndIf      Else        MessageRequester("Pipe Read Error", "Unable to complete read operation: (" + Str(LastErr) + ") " + GetConnectNamedPipeErrorDescription(LastErr))      EndIf    EndIf    ;    ; Disconnect the finished client and immediately re-arm asynchronous listening for future instances    DisconnectNamedPipe_(hRunningPipe)    PipeState = Pipe_ArmConnection(hRunningPipe, @Overlapped)  EndIf  ;  ProcedureReturn Result$EndProcedure; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 308; FirstLine = 295; Folding = --; EnableXP; DPIAware; UseMainFile = ..\PBBrowser.pb