;; ****************************************************************************************;;                                   SetGadgetColorEx();                                      Windows only;                                 Zapman - Nov. 2026 - 7;;            This file should be saved under the name "SetGadgetColorEx.pbi".;;            The first part of this library offers miscellaneous functions like:; • IsDarkModeEnabled() checks whether the running computer is set to dark mode or not.; • ApplyDarkModeToWindow() matches the title bar of a window with the computer theme.; • GetProperty() retrieves a PureBasic ID from a handle (the opposite of GadgetID()).;; The second part of this library is a set of specialized functions used by the third part.;;              The third part of this library extends the SetGadgetColor();              PureBasic native function to all of the PureBasic gadgets.;    You can now call SetGadgetColor() for buttons, panels, combos, StringGadgets, etc.;        You can also call ApplyColorsToAllGadgets() to assign a pair of colors;                   to all of the gadgets created in a given window.;;                        A fourth part contains a demo procedure.;; IMPORTANT NOTE: the 'ApplyColorThemes.pbi' library is also available on the Zapman website:;        https://www.editions-humanis.com/downloads/PureBasic/ZapmanDowloads_EN.htm;         It offers you a cool and sophisticated interface to manage color themes;                             and apply them to your windows.;; ****************************************************************************************;CompilerIf #PB_Compiler_IsMainFile  EnableExplicitCompilerEndIf;;-   1--- FIRST PART: MISCELLANEOUS FUNCTIONS (possibly reusable for other needs) ---;CompilerIf Not(Defined(DwmSetWindowAttribute, #PB_Prototype))  Prototype.i DwmSetWindowAttribute(hWnd.i, dwAttribute.i, pvAttribute.i, cbAttribute.i)CompilerEndIf;CompilerIf Not(Defined(IsDarkModeEnabled, #PB_Procedure))  Procedure IsDarkModeEnabled()    ;    ; Role: Detects whether app dark mode is enabled in the Windows registry.    ; Output: Returns 1 if dark mode is active, 0 otherwise.    ;    Protected key = 0    Protected darkModeEnabled = 0    ;    If RegOpenKeyEx_(#HKEY_CURRENT_USER, "Software\Microsoft\Windows\CurrentVersion\Themes\Personalize", 0, #KEY_READ, @key) = #ERROR_SUCCESS      Protected value = 1      Protected valueSize = SizeOf(value)      If RegQueryValueEx_(key, "AppsUseLightTheme", 0, #Null, @value, @valueSize) = #ERROR_SUCCESS        darkModeEnabled = Bool(value = 0) ; 0 = dark, 1 = light      EndIf      RegCloseKey_(key)    EndIf    ;    ProcedureReturn darkModeEnabled  EndProcedureCompilerEndIf;CompilerIf Not(Defined(ApplyDarkModeToWindow, #PB_Procedure))  Procedure ApplyDarkModeToWindow(Window = 0)    ;    ; Role: Applies the dark theme to a window title bar if dark mode is enabled in Windows.    ;    Protected hWnd = WindowID(Window)    ;    If hWnd And OSVersion() >= #PB_OS_Windows_10      Protected hDwmapi = OpenLibrary(#PB_Any, "dwmapi.dll")      ;      If hDwmapi        Protected DwmSetWindowAttribute_.DwmSetWindowAttribute = GetFunction(hDwmapi, "DwmSetWindowAttribute")        If DwmSetWindowAttribute_          Protected darkModeEnabled.l = IsDarkModeEnabled()          If darkModeEnabled            ; Try attribute 20 (Win10 20H1+ / Win11), fallback to 19 for older Win10 builds            If DwmSetWindowAttribute_(hWnd, 20, @darkModeEnabled, SizeOf(darkModeEnabled)) <> 0              DwmSetWindowAttribute_(hWnd, 19, @darkModeEnabled, SizeOf(darkModeEnabled))            EndIf            If GetWindowColor(Window) = #PB_Default              ; Only alter the client background when a gadget-coloring library is active and no explicit color was set              CompilerIf Defined(SetGadgetsColorsFromTheme, #PB_Procedure)                If ListSize(InterfaceColorPresets()) > 0                  Protected ThemeBackColor = GetRealColorFromType("BackgroundColor", InterfaceColorPresets()\BackgroundColor)                  If ThemeBackColor <> #PB_Default                    SetWindowColor(Window, ThemeBackColor)                  EndIf                EndIf              CompilerElseIf Defined(SetGadgetColorEx, #PB_Procedure)                SetWindowColor(Window, $202020)              CompilerEndIf            EndIf            ;            ; Force the non-client frame to repaint without hiding or flickering the window            If IsWindowVisible_(hWnd)              SetWindowPos_(hWnd, 0, 0, 0, 0, 0, #SWP_NOMOVE | #SWP_NOSIZE | #SWP_NOZORDER | #SWP_FRAMECHANGED)            EndIf          EndIf        EndIf        ;        CloseLibrary(hDwmapi)      EndIf    EndIf  EndProcedureCompilerEndIf;CompilerIf Not(Defined(GetProperty, #PB_Procedure))  ;  Structure GP_PropSearchStruct    *PropName    Found.i  EndStructure  ;  Procedure GP_EnumPropsProc(hWnd, lpszString, hData, *Search.GP_PropSearchStruct)    ;    ; Role: Win32 EnumPropsEx callback checking whether a named property exists on 'hWnd'.    ;    If lpszString > 65535 ; Values <= 65535 are integer ATOMs, not string pointers      If PeekS(lpszString) = PeekS(*Search\PropName)        *Search\Found = #True        ProcedureReturn #False ; Property found, stop enumeration      EndIf    EndIf    ProcedureReturn #True ; Continue enumeration  EndProcedure  ;  Procedure GetProperty(hWnd, propName$)    ;    ; Role: Retrieves the value of a window property named 'propName$' on 'hWnd'.    ; Output: Returns the property value if it exists, or -1 if it does not exist.    ;         This makes it possible to tell the difference between a non-existent property    ;         and an existing property that has a value of zero.    ;    ;         You can call GetProperty() with "PB_ID" as the second parameter    ;         to retrieve a gadget's PureBasic number from its OS handle:    ;         #MyGadgetNum = 1    ;         StringGadget(#MyGadgetNum, 10, 10, 100, 25, "My string")    ;         handle = GadgetID(#MyGadgetNum)    ;         PBNum = GetProperty(handle, "PB_ID")    ;         ----> Now, PBNum = #MyGadgetNum    ;    Protected Search.GP_PropSearchStruct    ;    If hWnd And propName$      Search\PropName = @propName$      EnumPropsEx_(hWnd, @GP_EnumPropsProc(), @Search)      If Search\Found        ProcedureReturn GetProp_(hWnd, propName$)      EndIf    EndIf    ProcedureReturn -1  EndProcedureCompilerEndIf;CompilerIf Not(Defined(GetGadgetParentWindow, #PB_Procedure))  Procedure GetGadgetParentWindow(Gadget)    ;    ; Role: Retrieves the PureBasic window number of the top-level window owning 'Gadget'.    ;       Original cross-platform function by 'mk-soft' (English PureBasic forum).    ; Output: Returns the PureBasic Window ID, or -1 if invalid.    ;    Protected ID, r1 = -1    ;    If IsGadget(Gadget)      CompilerSelect #PB_Compiler_OS        CompilerCase #PB_OS_MacOS          Protected *Gadget.sdkGadget = IsGadget(Gadget)          If *Gadget            ID = WindowID(*Gadget\Window)            r1 = PB_Window_GetID(ID)          EndIf        CompilerCase #PB_OS_Linux          ID = gtk_widget_get_toplevel_(GadgetID(Gadget))          If ID            r1 = g_object_get_data_(ID, "pb_id")          EndIf        CompilerCase #PB_OS_Windows          ID = GetAncestor_(GadgetID(Gadget), #GA_ROOT)          r1 = GetProp_(ID, "PB_WINDOWID")          If r1 > 0            r1 - 1          Else            r1 = -1          EndIf      CompilerEndSelect    EndIf    ProcedureReturn r1  EndProcedureCompilerEndIf;CompilerIf Not(Defined(MixColors, #PB_Procedure))  Procedure MixColors(Color1, Color2, Ratio.f)    ;    ; Role: Blends two RGB colors according to 'Ratio' (0.0 = Color2, 1.0 = Color1).    ;    If Ratio > 1 : Ratio = 1 : ElseIf Ratio < 0 : Ratio = 0 : EndIf    Protected Red = Red(Color1) * Ratio + Red(Color2) * (1 - Ratio)    Protected Green = Green(Color1) * Ratio + Green(Color2) * (1 - Ratio)    Protected Blue = Blue(Color1) * Ratio + Blue(Color2) * (1 - Ratio)    ProcedureReturn RGB(Red, Green, Blue)  EndProcedureCompilerEndIf;CompilerIf Not(Defined(ShiftColorComponent, #PB_Procedure))  Procedure ShiftColorComponent(CComponent, Shift)    ;    ; Role: Shifts an 8-bit color channel by 'Shift' and clamps the result to [0..255].    ;    CComponent + Shift    If CComponent < 0 : CComponent = 0 : ElseIf CComponent > 255 : CComponent = 255 : EndIf    ProcedureReturn CComponent  EndProcedureCompilerEndIf;;; ****************************************************************************************;-              2--- SECOND PART: SPECIALIZED FUNCTIONS FOR THIS LIBRARY ---;;EnumerationBinary EdgesStyle  #SGCE_NoEdges = 0  #SGCE_HoverSensitive = 1  #SGCE_Flat  #SGCE_Single  #SGCE_Double  #SGCE_WithTitleEndEnumeration;Structure SGCE_GadgetsInfosStruct  ID.i  Handle.i  FrontColor.i  BackColor.i  BackBrush.i  EdgesColor.l  HighlightedEdgesColor.l  EdgesStyle.i  Enabled.i  MainWindow.iEndStructure;#SGCE_StandardColors = -1;NewList SGCE_GadgetsInfos.SGCE_GadgetsInfosStruct();Procedure SGCE_IsCustomColorGadget(GadgetID)  ;  ; Role: Classifies how 'GadgetID' must be colorized.  ; Output:  1 = Fully drawn/colorized by this library (Button, CheckBox, Option, Panel,  ;              ComboBox, ExplorerCombo, Frame, Container, Calendar, Date, ListIcon, ExplorerList).  ;         -1 = Interior colorized natively by PureBasic, but borders must be redrawn here.  ;          0 = Fully managed natively by PureBasic (no custom drawing needed).  ;  Protected CustomColor = 1  ;  Select GadgetType(GadgetID)    Case #PB_GadgetType_Editor, #PB_GadgetType_String, #PB_GadgetType_ListView, #PB_GadgetType_ButtonImage      ; Interior colors are managed by PureBasic, but edges need to be redrawn      CustomColor = -1    Case #PB_GadgetType_Spin, #PB_GadgetType_Image, #PB_GadgetType_ExplorerTree, #PB_GadgetType_Tree      ; Interior colors are managed by PureBasic, but edges need to be redrawn      CustomColor = -1    Case #PB_GadgetType_MDI, #PB_GadgetType_ScrollArea, #PB_GadgetType_Canvas      ; Interior colors are managed by PureBasic, but edges need to be redrawn      CustomColor = -1      ;    Case #PB_GadgetType_HyperLink, #PB_GadgetType_Text, #PB_GadgetType_ProgressBar      ; Colors are natively managed by PureBasic and require no custom border redrawing      CustomColor = 0  EndSelect  ProcedureReturn CustomColorEndProcedureCompilerIf Not(Defined(RGBAColor, #PB_Structure))  Structure RGBAColor    ; Fields use unsigned byte type 'a' (0..255) rather than signed 'b'    red.a    green.a    blue.a    alpha.a  EndStructureCompilerEndIf;CompilerIf Not(Defined(tagRGBQUAD, #PB_Structure))  Structure tagRGBQUAD    ; Fields use unsigned byte type 'a' (0..255) rather than signed 'b'    blue.a    green.a    red.a    alpha.a  EndStructureCompilerEndIf;Procedure SGCE_PartialReplaceColors(StartX, StartY, EndX, EndY, Width, *BitmapAddress, maxlum, LowContrast.f, *backColor.RGBAColor, *FrontColor.RGBAColor, DoBlowOut = 1)  ;  ; Role: Remaps pixel colors within the [StartX..EndX-1, StartY..EndY-1] region of a 32-bit BGRA DIB  ;       from system theme tones to the target *backColor and *FrontColor.  ;  Protected y, x, *pixelColor.tagRGBQUAD, PixelDarkness.f, PixelLuminosity.f  Protected BlowOut.f, CrushBlacks.f, mColor.l, mConvColor.l  ;  If StartX < EndX And StartY < EndY    ; Force calculation on the very first pixel even if its raw BGRA value is 0    mColor = ~PeekL(*BitmapAddress + (StartY * Width + StartX) * 4)  EndIf  ;  For y = StartY To EndY - 1    Protected yXWidth = y * Width    For x = StartX To EndX - 1      ; Compute the 32-bit BGRA address of the current pixel      *pixelColor = *BitmapAddress + (yXWidth + x) * 4      If mColor = PeekL(*pixelColor)        ; Reuse the cached conversion when adjacent pixels share the exact same source color        PokeL(*pixelColor, mConvColor)      Else        mColor = PeekL(*pixelColor)        ;        PixelLuminosity = (*pixelColor\red + *pixelColor\green + *pixelColor\blue) / maxlum        ;        ; Enhance text readability when contrast between *backColor and *FrontColor is medium or low:        ; BlowOut pushes bright tones closer to pure white ("blowing out" highlights in photography)        If DoBlowOut And PixelLuminosity > 0.7          Protected Emphasis.f = 3.7          BlowOut = (PixelLuminosity + 1) * (PixelLuminosity + 1) / Emphasis          If BlowOut > 1 : BlowOut = 1 : EndIf          ; Apply stronger BlowOut correction as contrast between background and stroke decreases          PixelLuminosity = PixelLuminosity * (1 - LowContrast) + BlowOut * LowContrast        EndIf        If DoBlowOut = 2 And PixelLuminosity < 0.99          ; Slightly darken light gray for PanelGadget, whose native tab gray differs from other gadgets          PixelLuminosity * 0.95        EndIf        If PixelLuminosity < 0.3          ; CrushBlacks deepens dark tones ("crushing" blacks in photography)          CrushBlacks = PixelLuminosity * PixelLuminosity * PixelLuminosity          ; Apply stronger CrushBlacks correction as contrast between background and stroke decreases          PixelLuminosity = PixelLuminosity * (1 - LowContrast) + CrushBlacks * LowContrast        EndIf        ;        If PixelLuminosity > 1 : PixelLuminosity = 1 : EndIf        PixelDarkness = 1 - PixelLuminosity        ;        ; Two-stage color remapping preserving mid-tone hue accents:        ; 1. Lighter source pixels shift progressively toward *backColor        *pixelColor\red   * PixelDarkness + *backColor\red   * PixelLuminosity        *pixelColor\green * PixelDarkness + *backColor\green * PixelLuminosity        *pixelColor\blue  * PixelDarkness + *backColor\blue  * PixelLuminosity        ;        ; 2. Darker source pixels shift progressively toward *FrontColor        *pixelColor\red   * PixelLuminosity + *FrontColor\red   * PixelDarkness        *pixelColor\green * PixelLuminosity + *FrontColor\green * PixelDarkness        *pixelColor\blue  * PixelLuminosity + *FrontColor\blue  * PixelDarkness        mConvColor = PeekL(*pixelColor)      EndIf      ;    Next  NextEndProcedure;Procedure SGCE_CreateBitmapWithAddress(hDCSrce, Width, Height, *backColor.RGBAColor, *FrontColor.RGBAColor, *memDC.Integer, *BitmapAddress.Integer, *oldBitmap.Integer, *maxlum.Integer, *LowContrast.Float)  ;  ; Role: Creates a 32-bit DIB section compatible with 'hDCSrce', copies its current pixels,  ;       and computes the reference luminosity and contrast metrics for color replacement.  ; Output: Returns the DIB handle and populates the output pointers.  ;  Protected bmi.BITMAPINFO  bmi\bmiHeader\biSize = SizeOf(BITMAPINFOHEADER)  bmi\bmiHeader\biWidth = Width  bmi\bmiHeader\biHeight = Height  bmi\bmiHeader\biPlanes = 1  bmi\bmiHeader\biBitCount = 32 ; 32 bits per pixel (BGRA)  bmi\bmiHeader\biCompression = #BI_RGB  ;  ; Compute reference maximum brightness from the system button-face color (guarded against zero)  *maxlum\i = Red(GetSysColor_(#COLOR_BTNFACE)) + Green(GetSysColor_(#COLOR_BTNFACE)) + Blue(GetSysColor_(#COLOR_BTNFACE))  If *maxlum\i = 0 : *maxlum\i = 1 : EndIf  ;  ; LowContrast equals 1 when BackColor and FrontColor have identical brightness, and 0 at maximum contrast  *LowContrast\f = (*backColor\red + *backColor\green + *backColor\blue - *FrontColor\red - *FrontColor\green - *FrontColor\blue) / *maxlum\i  *LowContrast\f = Abs(1 - Abs(*LowContrast\f))  ;  ; Create the DIB section and retrieve direct access to its pixel buffer  Protected hBitmap = CreateDIBSection_(hDCSrce, bmi, #DIB_RGB_COLORS, *BitmapAddress, 0, 0)  ;  ; Create a compatible memory DC and copy the source surface into it  *memDC\i = CreateCompatibleDC_(hDCSrce)  *oldBitmap\i = SelectObject_(*memDC\i, hBitmap)  BitBlt_(*memDC\i, 0, 0, Width, Height, hDCSrce, 0, 0, #SRCCOPY)  ProcedureReturn hBitmapEndProcedure;Procedure SGCE_RepaintEdges(*GadgetsInfos.SGCE_GadgetsInfosStruct, Highlight = #False, hDCType = 1, TopOffset = 0)  ;  ; Role: Repaints the custom border (and optional background fill) of a gadget.  ; Parameters: hDCType   - >2 : Pre-acquired HDC (e.g. FrameGadget inside #WM_PAINT)  ;                         -1 : Acquire via BeginPaint_/EndPaint_ on the gadget itself  ;                        1..2: Paint using the parent window's DC  ;                          0 : Paint using the gadget's own DC (e.g. #WM_NCPAINT / DropDown)  ;             TopOffset - Vertical top inset in pixels (half font height for titled FrameGadgets).  ;  Protected gRect.Rect, pt.POINT, ps.PAINTSTRUCT  Protected hdc, hWndDC, hOldPen, hOldBrush, hBrush, hPen  Protected gHandle = *GadgetsInfos\Handle  Protected EdgeWidth, EdgesColor, PaintBackground  ;  If *GadgetsInfos\EdgesStyle & #SGCE_Double    EdgeWidth = 2  ElseIf *GadgetsInfos\EdgesStyle & (#SGCE_Single | #SGCE_Flat | #SGCE_WithTitle)    EdgeWidth = 1  Else    EdgeWidth = 0  EndIf  ;  If Highlight    EdgesColor = *GadgetsInfos\HighlightedEdgesColor    PaintBackground = Bool(GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Date)  Else    If *GadgetsInfos\EdgesStyle & #SGCE_Flat      EdgesColor = *GadgetsInfos\FrontColor    Else      EdgesColor = *GadgetsInfos\EdgesColor    EndIf    ;    If GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Container      PaintBackground = #True    ElseIf GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Frame And GetWindow_(GadgetID(*GadgetsInfos\ID), #GW_CHILD)      PaintBackground = #True    EndIf  EndIf  ;  If EdgeWidth Or PaintBackground    If Abs(hDCType) > 2      ; BeginPaint_ was already called by the caller; hDCType holds the active HDC      hdc = hDCType      GetClientRect_(gHandle, @gRect)      gRect\top + TopOffset    ElseIf hDCType = -1      ; #WM_PAINT handling where the client rectangle is wide enough to host the border      hdc = BeginPaint_(gHandle, ps)      GetClientRect_(gHandle, @gRect)      gRect\right + 2 * EdgeWidth : gRect\bottom + 2 * EdgeWidth    ElseIf hDCType > 0      ; #WM_PAINT handling where the client rectangle cannot host the border: draw on parent DC      hWndDC = GetParent_(gHandle)      hdc = GetDC_(hWndDC)      GetWindowRect_(gHandle, @gRect)      ; Convert screen coordinates from GetWindowRect_ to parent client coordinates      pt\x = gRect\left : pt\y = gRect\top      ScreenToClient_(hWndDC, @pt)      gRect\right - gRect\left + pt\x : gRect\bottom - gRect\top + pt\y      gRect\left = pt\x : gRect\top = pt\y    Else ; hDCType = 0      ; Post-paint or #WM_NCPAINT border drawing relative to (0, 0) on the gadget's own DC      hWndDC = gHandle      hdc = GetDC_(hWndDC)      GetWindowRect_(gHandle, @gRect)      gRect\right - gRect\left : gRect\bottom - gRect\top      gRect\left = 0 : gRect\top = 0    EndIf    ;    If EdgeWidth      hPen = CreatePen_(#PS_SOLID, EdgeWidth, EdgesColor)    Else      hPen = CreatePen_(#PS_SOLID, 0, *GadgetsInfos\BackColor)    EndIf    If PaintBackground      hBrush = CreateSolidBrush_(*GadgetsInfos\BackColor)    Else      hBrush = GetStockObject_(#NULL_BRUSH)    EndIf    hOldPen = SelectObject_(hdc, hPen)    hOldBrush = SelectObject_(hdc, hBrush)    ;    Rectangle_(hdc, gRect\left + EdgeWidth / 2, gRect\top + EdgeWidth / 2, gRect\right, gRect\bottom)    If PaintBackground = 0 And EdgeWidth = 1      ; Erase the inner 3D highlight frame with the gadget's background color      DeleteObject_(hPen)      hPen = CreatePen_(#PS_SOLID, 1, *GadgetsInfos\BackColor)      SelectObject_(hdc, hPen)      Rectangle_(hdc, gRect\left + 1, gRect\top + 1, gRect\right - 1, gRect\bottom - 1)    EndIf    SelectObject_(hdc, hOldPen)    SelectObject_(hdc, hOldBrush)    If PaintBackground      DeleteObject_(hBrush)    EndIf    DeleteObject_(hPen)    If hWndDC      ReleaseDC_(hWndDC, hdc)    EndIf  ElseIf hDCType = -1    BeginPaint_(gHandle, ps)  EndIf  If hDCType = -1    EndPaint_(gHandle, ps)  EndIfEndProcedure;Define SGCE_KillCalendarAnimationProcedure SGCE_DrawAndReplaceColors(gHandle, lParam, OldCBProc, BackColor, FrontColor, GType)  ;  ; Role: Renders a gadget into an off-screen 32-bit DIB via its original #WM_PAINT handler,  ;       remaps its colors to 'BackColor' and 'FrontColor', and blits the result to the screen.  ;  Protected ps.PAINTSTRUCT, gRect.Rect, ActualTheme  Protected hBitmap, oldBitmap, memDC, maxlum, LowContrast.f  Protected *BitmapAddress, CenterRect.Rect, hBrush, hDC  Shared SGCE_KillCalendarAnimation  ;  If GType = #PB_GadgetType_Date Or GType = #PB_GadgetType_Calendar    If SGCE_KillCalendarAnimation      ActualTheme = GetWindowTheme_(gHandle)      If ActualTheme <> 0        ; Save the current theme of the Calendar        SetProp_(gHandle, "SGCE_OldTheme", ActualTheme)        ; Temporarily strip the theme to suppress native Calendar transition animations        SetWindowTheme_(gHandle, "", "")        ; Colorize the unthemed Calendar background immediately to prevent visible flickering        SendMessage_(gHandle, #MCM_SETCOLOR, #MCSC_BACKGROUND, BackColor)      EndIf      SGCE_KillCalendarAnimation = #False    EndIf    ;    ActualTheme = GetWindowTheme_(gHandle)    If ActualTheme = 0 And GetProp_(gHandle, "SGCE_OldTheme")      ; Restore the Explorer theme that was temporarily disabled to suppress animations      SetWindowTheme_(gHandle, @"Explorer", #Null)    EndIf  EndIf  ;  GetClientRect_(gHandle, @gRect)  hDC = BeginPaint_(gHandle, ps)  ;  Protected Width = gRect\right - gRect\left  Protected Height = gRect\bottom - gRect\top  ;  If Width > 0 And Height > 0    hBitmap = SGCE_CreateBitmapWithAddress(hDC, Width, Height, @BackColor, @FrontColor, @memDC, @*BitmapAddress, @oldBitmap, @maxlum, @LowContrast)    ;    ; Invoke the original #WM_PAINT procedure so the system renders into memDC instead of hDC    CallWindowProc_(OldCBProc, gHandle, #WM_PAINT, memDC, lParam)    ;    If GType = #PB_GadgetType_Panel      SelectClipRgn_(memDC, 0)      ; Large PanelGadgets are expensive to remap pixel-by-pixel across their entire surface:      ; restrict pixel remapping to the borders/tabs (note: DIB rows are stored bottom-up)      ; and fill the central body directly with BackColor.      Protected hSlice = DesktopScaledX(3), vSlice = DesktopScaledY(3), upSlice = DesktopScaledY(26)      ;      If hSlice > Width : hSlice = Width : EndIf      If vSlice > Height : vSlice = Height : EndIf      If vSlice + upSlice > Height : upSlice = Height - vSlice : EndIf      ; Horizontal bottom edge (rows 0..vSlice-1 in bottom-up DIB coordinates)      SGCE_PartialReplaceColors(0, 0, Width, vSlice, Width, *BitmapAddress, maxlum, LowContrast, @BackColor, @FrontColor, 2)      ; Horizontal top tab strip (rows Height-upSlice..Height-1 in bottom-up DIB coordinates)      SGCE_PartialReplaceColors(0, Height - upSlice, Width, Height, Width, *BitmapAddress, maxlum, LowContrast, @BackColor, @FrontColor, 2)      ; Vertical left edge      SGCE_PartialReplaceColors(0, vSlice, hSlice, Height - upSlice, Width, *BitmapAddress, maxlum, LowContrast, @BackColor, @FrontColor, 2)      ; Vertical right edge      SGCE_PartialReplaceColors(Width - hSlice, vSlice, Width, Height - upSlice, Width, *BitmapAddress, maxlum, LowContrast, @BackColor, @FrontColor, 2)      ;      If Width > hSlice * 2 And Height > (vSlice + upSlice)        hBrush = CreateSolidBrush_(PeekL(@BackColor))        CenterRect\left = hSlice : CenterRect\right = Width - hSlice        CenterRect\top = upSlice : CenterRect\bottom = Height - vSlice        FillRect_(memDC, CenterRect, hBrush)        DeleteObject_(hBrush)      EndIf    Else      SGCE_PartialReplaceColors(0, 0, Width, Height, Width, *BitmapAddress, maxlum, LowContrast, @BackColor, @FrontColor)    EndIf    ;    ; Copy the colorized off-screen buffer back to the screen DC    BitBlt_(hDC, gRect\left, gRect\top, Width, Height, memDC, 0, 0, #SRCCOPY)    ;    ; Release GDI off-screen resources    SelectObject_(memDC, oldBitmap)    DeleteObject_(hBitmap)    DeleteDC_(memDC)  EndIf  ;  EndPaint_(gHandle, ps)EndProcedure;Procedure SGCE_ChildrenCallback(CTRLhandle, uMsg, wParam, lParam)  ;  ; Role: Subclass callback for child helper controls (UpDown spinners, Calendar inside DateGadget).  ;  Protected SGCE_OldCallBack = GetProp_(CTRLhandle, "SGCE_OldCallBack")  Protected *GadgetsInfos.SGCE_GadgetsInfosStruct = GetProp_(CTRLhandle, "SGCE_Infos")  ;  If uMsg = #WM_PAINT    SGCE_DrawAndReplaceColors(CTRLhandle, lParam, SGCE_OldCallBack, *GadgetsInfos\BackColor, *GadgetsInfos\FrontColor, GadgetType(*GadgetsInfos\ID))    ProcedureReturn 1  EndIf  ;  ProcedureReturn CallWindowProc_(SGCE_OldCallBack, CTRLhandle, uMsg, wParam, lParam)EndProcedure;Procedure SGCE_DropDownCallback(gHandle, uMsg, wParam, lParam)  ;  ; Role: Subclass callback for the temporary popup DropDown window opened by a DateGadget.  ;  Protected SGCE_OldCallBack = GetProp_(gHandle, "SGCE_OldCallBack")  Protected ps.PAINTSTRUCT, SavedHandle  Protected *GadgetsInfos.SGCE_GadgetsInfosStruct = GetProp_(gHandle, "SGCE_Infos")  ;  If uMsg = #WM_PAINT    BeginPaint_(gHandle, ps)    EndPaint_(gHandle, ps)    ;    ; Temporarily point Handle to the popup DropDown HWND to draw its border without corrupting the DateGadget handle    SavedHandle = *GadgetsInfos\Handle    *GadgetsInfos\Handle = gHandle    SGCE_RepaintEdges(*GadgetsInfos, #True, 0)    *GadgetsInfos\Handle = SavedHandle    ProcedureReturn 0  EndIf  ;  ProcedureReturn CallWindowProc_(SGCE_OldCallBack, gHandle, uMsg, wParam, lParam)EndProcedure;Procedure SGCE_DrawContainerGadget(*GadgetsInfos.SGCE_GadgetsInfosStruct)  ;  ; Role: Validates the #WM_PAINT cycle of a ContainerGadget and draws its custom border on the parent DC.  ;  Protected ps.PAINTSTRUCT  Protected gHandle = *GadgetsInfos\Handle  ;  BeginPaint_(gHandle, ps)  EndPaint_(gHandle, ps)  ;  SGCE_RepaintEdges(*GadgetsInfos)EndProcedure;Declare GetGadgetColorEx(GadgetID, ColorType);Procedure SGCE_GetParentBackColor(gHandle, MainWindow, ResolveDefault = #True)  ;  ; Role: Retrieves the background color of the immediate parent window or container gadget owning 'gHandle'.  ; Parameters: ResolveDefault - When #True, translates #PB_Default into the actual Win32 #COLOR_BTNFACE RGB color.  ;  Protected BackColor = #PB_Default  Protected hParent = GetAncestor_(gHandle, #GA_PARENT)  Protected ParentPBID  ;  If hParent    If IsWindow(MainWindow) And hParent = WindowID(MainWindow)      BackColor = GetWindowColor(MainWindow)    Else      ParentPBID = GetProperty(hParent, "PB_ID")      If ParentPBID >= 0 And IsGadget(ParentPBID)        BackColor = GetGadgetColorEx(ParentPBID, #PB_Gadget_BackColor)      EndIf    EndIf  EndIf  ;  If ResolveDefault And BackColor = #PB_Default    BackColor = GetSysColor_(#COLOR_BTNFACE)  EndIf  ;  ProcedureReturn BackColorEndProcedure;Procedure SGCE_DrawFrameGadget(*GadgetsInfos.SGCE_GadgetsInfosStruct)  ;  ; Role: Custom-renders a FrameGadget, accounting for its border style, container background,  ;       parent background strip above the top border, and optional caption.  ;  Protected gRect.Rect, Size.SIZE, ps.PAINTSTRUCT  Protected gHandle = *GadgetsInfos\Handle  Protected hBrush, hFont, hOldFont, TopOffset, ParentBackColor  ;  If *GadgetsInfos\EdgesStyle & #SGCE_WithTitle = 0    SGCE_RepaintEdges(*GadgetsInfos, #False, -1)  Else    Protected hDC = BeginPaint_(gHandle, ps)    Protected Text$ = GetGadgetText(*GadgetsInfos\ID)    ;    If Text$      hFont = SendMessage_(gHandle, #WM_GETFONT, 0, 0)      If hFont = 0        hFont = GetGadgetFont(*GadgetsInfos\ID)        If hFont = 0          hFont = GetGadgetFont(#PB_Default)        EndIf      EndIf      If hFont        hOldFont = SelectObject_(hDC, hFont)      EndIf      GetTextExtentPoint32_(hDC, Text$, Len(Text$), @Size)      TopOffset = Size\cy / 2    EndIf    ;    If TopOffset > 0      ; Fill the outer top strip (0 .. TopOffset) above the frame border with the parent's background color      ParentBackColor = SGCE_GetParentBackColor(gHandle, *GadgetsInfos\MainWindow)      GetClientRect_(gHandle, @gRect)      gRect\bottom = TopOffset      hBrush = CreateSolidBrush_(ParentBackColor)      FillRect_(hDC, gRect, hBrush)      DeleteObject_(hBrush)    EndIf    ;    ; Draw the frame border (and interior background from TopOffset downward if container)    SGCE_RepaintEdges(*GadgetsInfos, #False, hDC, TopOffset)    ;    If Text$      ; Erase the 1-pixel top border segment behind the caption text:      ; use BackColor if this FrameGadget is a container, or ParentBackColor if transparent      GetClientRect_(gHandle, @gRect)      gRect\left + DesktopScaledX(6)      gRect\right = gRect\left + Size\cx + DesktopScaledX(6)      gRect\top = TopOffset      gRect\bottom = TopOffset + 1      If GetWindow_(gHandle, #GW_CHILD)        hBrush = CreateSolidBrush_(*GadgetsInfos\BackColor)      Else        hBrush = CreateSolidBrush_(ParentBackColor)      EndIf      FillRect_(hDC, gRect, hBrush)      DeleteObject_(hBrush)      ;      ; Draw the caption centered vertically over the top border line      gRect\top = 0      gRect\bottom = Size\cy      SetTextColor_(hDC, *GadgetsInfos\FrontColor)      SetBkMode_(hDC, #TRANSPARENT)      DrawText_(hDC, Text$, Len(Text$), @gRect, #DT_CENTER | #DT_VCENTER | #DT_SINGLELINE)      ;      If hOldFont        SelectObject_(hDC, hOldFont)      EndIf    EndIf    ;    EndPaint_(gHandle, ps)  EndIf  ProcedureReturn 1EndProcedure;Procedure SGCE_DrawExplorerComboItem(SGCE_OldCallBack, gHandle, uMsg, wParam, lParam, *GadgetsInfos.SGCE_GadgetsInfosStruct)  ;  ; Role: Intercepts #WM_DRAWITEM on an ExplorerComboGadget to render and recolor each item off-screen.  ;  Protected bitmapInfo.BITMAP  Protected *drawItem.DRAWITEMSTRUCT = lParam  Protected hDC = *drawItem\hDC  Protected disWidth = *drawItem\rcItem\right - *drawItem\rcItem\left  Protected disHeight = *drawItem\rcItem\bottom - *drawItem\rcItem\top  ;  ; Retrieve the dimensions of the destination bitmap selected into hDC  Protected hBitmapSrc = GetCurrentObject_(hDC, #OBJ_BITMAP)  GetObject_(hBitmapSrc, SizeOf(BITMAP), @bitmapInfo)  Protected Width = bitmapInfo\bmWidth  Protected Height = bitmapInfo\bmHeight  ;  Protected hBitmap, oldBitmap, memDC, maxlum, LowContrast.f  Protected *BitmapAddress  ;  If Width > 0 And Height > 0    hBitmap = SGCE_CreateBitmapWithAddress(hDC, Width, Height, @*GadgetsInfos\BackColor, @*GadgetsInfos\FrontColor, @memDC, @*BitmapAddress, @oldBitmap, @maxlum, @LowContrast)    SelectObject_(memDC, GetCurrentObject_(hDC, #OBJ_FONT))    ;    ; Redirect the native owner-draw handler to memDC    *drawItem\hDC = memDC    CallWindowProc_(SGCE_OldCallBack, gHandle, uMsg, wParam, lParam)    *drawItem\hDC = hDC    ;    ; Skip color remapping on pure focus-rectangle updates    If *drawItem\itemAction <> #ODA_FOCUS      SGCE_PartialReplaceColors(0, 0, Width, Height, Width, *BitmapAddress, maxlum, LowContrast, @*GadgetsInfos\BackColor, @*GadgetsInfos\FrontColor, 0)    EndIf    ;    ; Copy the rendered result from memDC back to hDC    If *drawItem\itemAction = #ODA_DRAWENTIRE And *drawItem\rcItem\top < SendMessage_(gHandle, #CB_GETITEMHEIGHT, 0, 0)      SelectClipRgn_(hDC, 0)      BitBlt_(hDC, 0, 0, Width, Height, memDC, 0, 0, #SRCCOPY)    Else      BitBlt_(hDC, *drawItem\rcItem\left, *drawItem\rcItem\top, disWidth, disHeight, memDC, *drawItem\rcItem\left, *drawItem\rcItem\top, #SRCCOPY)    EndIf    ;    SelectObject_(memDC, oldBitmap)    DeleteObject_(hBitmap)    DeleteDC_(memDC)  EndIfEndProcedure;Procedure SGCE_InstallCallbackAndData(hWnd, *procAddr, *GadgetsInfos, ClassName$ = "")  ;  ; Role: Subclasses 'hWnd' with '*procAddr' (optionally filtering by Win32 class name)  ;       and attaches '*GadgetsInfos' to #GWL_USERDATA if not already subclassed.  ; Output: Returns #True if newly installed, #False otherwise.  ;  If hWnd    If ClassName$      Protected WclassName$ = Space(256)      GetClassName_(hWnd, @WclassName$, 255)      If LCase(WclassName$) <> LCase(ClassName$)        ProcedureReturn #False      EndIf    EndIf    Protected SGCE_OldCallBack = GetProp_(hWnd, "SGCE_OldCallBack")    If SGCE_OldCallBack = 0      SGCE_OldCallBack = SetWindowLongPtr_(hWnd, #GWL_WNDPROC, *procAddr)      SetProp_(hWnd, "SGCE_OldCallBack", SGCE_OldCallBack)      SetProp_(hWnd, "SGCE_ActualCallBack", *procAddr)      If *GadgetsInfos        SetProp_(hWnd, "SGCE_Infos", *GadgetsInfos)      EndIf      ProcedureReturn #True    EndIf  EndIf  ProcedureReturn #FalseEndProcedure;Procedure SGCE_UninstallCallback(hWnd, ClassName$ = "")  ;  ; Role: Restores the original window procedure on 'hWnd' and removes subclassing properties.  ; Output: Returns #True if uninstalled, #False otherwise.  ;  If hWnd    If ClassName$      Protected WclassName$ = Space(256)      GetClassName_(hWnd, @WclassName$, 255)      If LCase(WclassName$) <> LCase(ClassName$)        ProcedureReturn #False      EndIf    EndIf    Protected SGCE_OldCallBack = GetProp_(hWnd, "SGCE_OldCallBack")    Protected SGCE_ActualCallBack = GetProp_(hWnd, "SGCE_ActualCallBack")    If SGCE_OldCallBack And GetWindowLongPtr_(hWnd, #GWL_WNDPROC) = SGCE_ActualCallBack      SetWindowLongPtr_(hWnd, #GWL_WNDPROC, SGCE_OldCallBack)      RemoveProp_(hWnd, "SGCE_OldCallBack")      RemoveProp_(hWnd, "SGCE_ActualCallBack")      RemoveProp_(hWnd, "SGCE_Infos")      ProcedureReturn #True    EndIf  EndIf  ProcedureReturn #FalseEndProcedure;Procedure SGCE_EnumThreadAndInstallCallback(hWnd, *GadgetsInfos.SGCE_GadgetsInfosStruct)  ;  ; Role: EnumThreadWindows callback locating the popup "DropDown" window spawned by a DateGadget  ;       in order to subclass both the popup container and its embedded MonthCal child control.  ;  Protected hCal, gRect.Rect  Protected className$ = Space(256)  ;  GetClassName_(hWnd, @className$, 255)  If LCase(className$) = "dropdown"    If SGCE_InstallCallbackAndData(hWnd, @SGCE_DropDownCallback(), *GadgetsInfos)      ; Retrieve the Calendar control hosted inside the DropDown popup      hCal = GetWindow_(hWnd, #GW_CHILD)      ; Note: instead of pixel remapping via SGCE_ChildrenCallback(), one could alternatively disable      ; visual styles (SetWindowTheme_(hCal, "", "")) and send #MCM_SETCOLOR messages directly.      SGCE_InstallCallbackAndData(hCal, @SGCE_ChildrenCallback(), *GadgetsInfos)      ;      ; Resize the DropDown host window to tightly match the Calendar's minimum required rectangle      SendMessage_(hCal, #MCM_GETMINREQRECT, 0, @gRect)      SetWindowPos_(hWnd, 0, 0, 0, gRect\right - gRect\left, gRect\bottom - gRect\top + 6, #SWP_NOMOVE | #SWP_NOZORDER)    EndIf  EndIf  ProcedureReturn #TrueEndProcedure;Procedure SGCE_RedrawChildWindows(hWnd, lParam)  ;  ; Role: EnumChildWindows callback invalidating every PureBasic child gadget hosted inside a ContainerGadget.  ;  If GetProperty(hWnd, "PB_ID") <> -1    InvalidateRect_(hWnd, 0, #True)  EndIf  ProcedureReturn #TrueEndProcedure;Procedure SGCE_ChangeColorsCallback(gHandle, uMsg, wParam, lParam)  ;  ; Role: Main subclass window procedure handling custom painting, border highlighting,  ;       combo list coloring, and child control subclassing for colorized gadgets.  ;  Protected hCTRLWnd, BackColor, BackLuminosity, Shift  Protected *GadgetsInfos.SGCE_GadgetsInfosStruct = GetProp_(gHandle, "SGCE_Infos")  Protected SGCE_OldCallBack = GetProp_(gHandle, "SGCE_OldCallBack")  Static LastHoveredGadget  Shared SGCE_KillCalendarAnimation  ;  Select uMsg    Case #WM_CAPTURECHANGED      If IsGadget(*GadgetsInfos\ID) And GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Date        ; Subclass the popup DropDown window opened when clicking a DateGadget arrow        EnumThreadWindows_(GetCurrentThreadId_(), @SGCE_EnumThreadAndInstallCallback(), *GadgetsInfos)      EndIf      ;    Case #WM_NOTIFY      If GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Date        Protected *nmhdr.NMHDR = lParam        If *nmhdr\code = #NM_RELEASEDCAPTURE          ; Triggered when a date is clicked inside a DateGadget's popup calendar          SGCE_KillCalendarAnimation = #True        EndIf      EndIf      ;    Case #WM_LBUTTONUP      If GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Calendar        SGCE_KillCalendarAnimation = #True      EndIf      ;    Case 4097      If GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Date Or GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Calendar        ; Internal calendar notification sent upon selection click        SGCE_KillCalendarAnimation = #True      EndIf      ;    Case #WM_DRAWITEM      If GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_ExplorerCombo        SGCE_DrawExplorerComboItem(SGCE_OldCallBack, gHandle, uMsg, wParam, lParam, *GadgetsInfos)        ProcedureReturn 0      EndIf      ;    Case #WM_SETTEXT, #WM_ENABLE      ; Repaint whenever the caption changes or the gadget is enabled/disabled      InvalidateRect_(gHandle, 0, #True)      ;    Case #WM_MOUSEMOVE, #WM_NCMOUSEMOVE      CallWindowProc_(SGCE_OldCallBack, gHandle, uMsg, wParam, lParam)      If LastHoveredGadget <> gHandle        If *GadgetsInfos\EdgesStyle & #SGCE_HoverSensitive          SGCE_RepaintEdges(*GadgetsInfos, #True)          LastHoveredGadget = gHandle          ;          ; Subscribe to #WM_MOUSELEAVE / #WM_NCMOUSELEAVE notifications          Protected tme.TRACKMOUSEEVENT          tme\cbSize = SizeOf(TRACKMOUSEEVENT)          tme\hwndTrack = gHandle          tme\dwFlags = #TME_LEAVE          If uMsg = #WM_NCMOUSEMOVE            tme\dwFlags | #TME_NONCLIENT          EndIf          TrackMouseEvent_(@tme)        EndIf      EndIf      ;    Case #WM_MOUSELEAVE, #WM_NCMOUSELEAVE      If LastHoveredGadget        LastHoveredGadget = 0        If *GadgetsInfos\EdgesStyle & #SGCE_HoverSensitive          SGCE_RepaintEdges(*GadgetsInfos, #False)        EndIf      EndIf      ;    Case #WM_CTLCOLORLISTBOX, #WM_CTLCOLOREDIT      ; Colorize ComboBox drop-down lists and editable fields using the cached GDI brush      SetBkColor_(wParam, *GadgetsInfos\BackColor)      SetTextColor_(wParam, *GadgetsInfos\FrontColor)      If *GadgetsInfos\BackBrush        ProcedureReturn *GadgetsInfos\BackBrush      EndIf      ;    Case #WM_NCPAINT      ; Let native control paint non-client scrollbars first, then draw custom borders      CallWindowProc_(SGCE_OldCallBack, gHandle, uMsg, wParam, lParam)      If SGCE_IsCustomColorGadget(*GadgetsInfos\ID) = -1        SGCE_RepaintEdges(*GadgetsInfos, Bool(LastHoveredGadget = gHandle))      EndIf      ProcedureReturn 0      ;    Case #WM_PAINT      If GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Spin        ; SpinGadget interior is managed by PureBasic; subclass its companion UpDown sibling        hCTRLWnd = GetWindow_(gHandle, #GW_HWNDNEXT)        If SGCE_InstallCallbackAndData(hCTRLWnd, @SGCE_ChildrenCallback(), *GadgetsInfos, #UPDOWN_CLASS)          InvalidateRect_(hCTRLWnd, 0, #True)        EndIf        ProcedureReturn CallWindowProc_(SGCE_OldCallBack, gHandle, uMsg, wParam, lParam)        ;      ElseIf SGCE_IsCustomColorGadget(*GadgetsInfos\ID) = -1        ; Interior is handled natively and borders are drawn during #WM_NCPAINT        ProcedureReturn CallWindowProc_(SGCE_OldCallBack, gHandle, uMsg, wParam, lParam)        ;      ElseIf GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Frame        SGCE_DrawFrameGadget(*GadgetsInfos)        If GetWindow_(gHandle, #GW_CHILD) And (GetWindowLongPtr_(gHandle, #GWL_STYLE) & #WS_CLIPCHILDREN) = 0          EnumChildWindows_(gHandle, @SGCE_RedrawChildWindows(), 0)        EndIf        ProcedureReturn 0        ;      ElseIf GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_Container        SGCE_DrawContainerGadget(*GadgetsInfos)        EnumChildWindows_(gHandle, @SGCE_RedrawChildWindows(), 0)        ProcedureReturn 0        ;      Else        BackColor = *GadgetsInfos\BackColor        ; When gHandle is the subclassed #WC_HEADER child of a ListIcon or ExplorerList,        ; FindWindowEx_ for a nested #WC_HEADER returns 0: slightly shift the header background        If (GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_ListIcon Or GadgetType(*GadgetsInfos\ID) = #PB_GadgetType_ExplorerList) And FindWindowEx_(gHandle, 0, #WC_HEADER, #Null) = 0          BackLuminosity = Red(BackColor) * 0.299 + Green(BackColor) * 0.587 + Blue(BackColor) * 0.114          Shift = 15          If BackLuminosity > 128 : Shift * -1 : EndIf          BackColor = RGB(ShiftColorComponent(Red(BackColor), Shift), ShiftColorComponent(Green(BackColor), Shift), ShiftColorComponent(Blue(BackColor), Shift))        EndIf        ;        SGCE_DrawAndReplaceColors(gHandle, lParam, SGCE_OldCallBack, BackColor, *GadgetsInfos\FrontColor, GadgetType(*GadgetsInfos\ID))        ;        If *GadgetsInfos\Enabled <> IsWindowEnabled_(gHandle)          ; Enabled state changed externally: schedule a follow-up repaint to sync visual state          *GadgetsInfos\Enabled = IsWindowEnabled_(gHandle)          InvalidateRect_(gHandle, 0, #True)        EndIf        ;        If *GadgetsInfos\EdgesStyle & #SGCE_HoverSensitive          SGCE_RepaintEdges(*GadgetsInfos, Bool(LastHoveredGadget = *GadgetsInfos\Handle Or LastHoveredGadget = gHandle))        EndIf      EndIf      ;      hCTRLWnd = FindWindowEx_(gHandle, 0, #UPDOWN_CLASS, #Null) ; UpDown spinner on PanelGadget      If hCTRLWnd And SGCE_InstallCallbackAndData(hCTRLWnd, @SGCE_ChildrenCallback(), *GadgetsInfos)        InvalidateRect_(hCTRLWnd, 0, #True)      EndIf      ;      hCTRLWnd = FindWindowEx_(gHandle, 0, #WC_HEADER, #Null) ; Header bar on ListIcon / ExplorerList      If hCTRLWnd And SGCE_InstallCallbackAndData(hCTRLWnd, @SGCE_ChangeColorsCallback(), *GadgetsInfos)        InvalidateRect_(hCTRLWnd, 0, #True)      EndIf      ;      ProcedureReturn 0  EndSelect  ;  ProcedureReturn CallWindowProc_(SGCE_OldCallBack, gHandle, uMsg, wParam, lParam)EndProcedure;Procedure SGCE_MainWindowCallbackCleaner(hWnd, uMsg, wParam, lParam)  ;  ; Role: Subclass callback on top-level windows releasing gadget tracking entries and GDI brushes on #WM_DESTROY.  ;  Shared SGCE_GadgetsInfos()  ;  If uMsg = #WM_DESTROY    ForEach SGCE_GadgetsInfos()      If Not(IsGadget(SGCE_GadgetsInfos()\ID)) Or Not(IsWindow(SGCE_GadgetsInfos()\MainWindow)) Or WindowID(SGCE_GadgetsInfos()\MainWindow) = hWnd        If SGCE_GadgetsInfos()\BackBrush          DeleteObject_(SGCE_GadgetsInfos()\BackBrush)        EndIf        DeleteElement(SGCE_GadgetsInfos())      EndIf    Next  EndIf  ;  Protected SGCE_OldCallBack = GetProp_(hWnd, "SGCE_OldCallBack")  ProcedureReturn CallWindowProc_(SGCE_OldCallBack, hWnd, uMsg, wParam, lParam)EndProcedure;; ****************************************************************************************;;-                 3--- THIRD PART: MAIN FUNCTIONS OF THIS LIBRARY ---;; ****************************************************************************************;Procedure GetGadgetColorEx(GadgetID, ColorType)  ;  ; Role: Extended replacement for GetGadgetColor() supporting custom-colorized gadgets  ;       (buttons, frames, combos, panels, etc.) alongside native PureBasic gadgets.  ;  Shared SGCE_GadgetsInfos()  Protected Result = GetGadgetColor(GadgetID, ColorType)  ;  If IsGadget(GadgetID) And SGCE_IsCustomColorGadget(GadgetID) And ListSize(SGCE_GadgetsInfos())    Protected *ActualElement = @SGCE_GadgetsInfos()    ;    ForEach SGCE_GadgetsInfos()      If SGCE_GadgetsInfos()\Handle = GadgetID(GadgetID)        If ColorType = #PB_Gadget_BackColor          Result = SGCE_GadgetsInfos()\BackColor        ElseIf ColorType = #PB_Gadget_FrontColor          Result = SGCE_GadgetsInfos()\FrontColor        EndIf        Break      EndIf    Next    ;    If *ActualElement      ChangeCurrentElement(SGCE_GadgetsInfos(), *ActualElement)    Else      ResetList(SGCE_GadgetsInfos())    EndIf  EndIf  ProcedureReturn ResultEndProcedure;Procedure SetGadgetColorEx(GadgetID, ColorType, Color = 0, ThisColorOnly = 0)  ;  ; Role: Extended SetGadgetColor() supporting all PureBasic gadgets on Windows.  ; Parameters: ColorType     - #PB_Gadget_BackColor, #PB_Gadget_FrontColor, #SGCE_StandardColors  ;                             (to restore default system rendering), or any native PB color constant.  ;             Color         - RGB() color value or #PB_Default.  ;             ThisColorOnly - If 0, automatically computes a contrasting FrontColor (when setting BackColor)  ;                             or inherits the parent background color (when setting FrontColor) if the  ;                             counterpart color is still #PB_Default. If 1, modifies only 'ColorType'.  ;  Shared SGCE_GadgetsInfos()  Protected gHandle, BackLuminosity, ParentWindow, Found, hCTRLWnd, gRect.Rect  Protected TargetFrontColor, TargetBackColor, RealFrontColor, RealBackColor  Protected ApplyDarkMode, CustomColor  ;  If IsGadget(GadgetID)    If ColorType <> #PB_Gadget_FrontColor And ColorType <> #PB_Gadget_BackColor And ColorType <> #SGCE_StandardColors      ; Forward auxiliary PureBasic color types (e.g. #PB_Gadget_LineColor) directly to the native function      SetGadgetColor(GadgetID, ColorType, Color)      ProcedureReturn    EndIf    ;    gHandle = GadgetID(GadgetID)    ParentWindow = GetGadgetParentWindow(GadgetID)    If IsWindow(ParentWindow)      ; Install cleanup callback on the top-level window to free tracking data on #WM_DESTROY      SGCE_InstallCallbackAndData(WindowID(ParentWindow), @SGCE_MainWindowCallbackCleaner(), 0)    EndIf    ;    ForEach SGCE_GadgetsInfos()      If SGCE_GadgetsInfos()\ID = GadgetID        Found = #True        Break      EndIf    Next    ;    Select GadgetType(GadgetID)      Case #PB_GadgetType_ScrollArea, #PB_GadgetType_ScrollBar, #PB_GadgetType_Editor, #PB_GadgetType_ListIcon, #PB_GadgetType_ListView        ApplyDarkMode = #True      Case #PB_GadgetType_ComboBox, #PB_GadgetType_ExplorerCombo, #PB_GadgetType_ExplorerList, #PB_GadgetType_ExplorerTree        ApplyDarkMode = #True      Case #PB_GadgetType_Container, #PB_GadgetType_Web, #PB_GadgetType_WebView, #PB_GadgetType_Scintilla, #PB_GadgetType_Tree, #PB_GadgetType_MDI        ApplyDarkMode = #True    EndSelect    ;    If ColorType <> #SGCE_StandardColors      If Found        TargetFrontColor = SGCE_GadgetsInfos()\FrontColor        TargetBackColor  = SGCE_GadgetsInfos()\BackColor      Else        TargetFrontColor = #PB_Default        TargetBackColor  = #PB_Default      EndIf      ;      If ColorType = #PB_Gadget_BackColor        TargetBackColor = Color        If ThisColorOnly = 0 And TargetFrontColor = #PB_Default And Color <> #PB_Default          ; Compute an automatic contrasting FrontColor from BackColor luminance          BackLuminosity = Red(Color) * 0.299 + Green(Color) * 0.587 + Blue(Color) * 0.114          If BackLuminosity < 128 And BackLuminosity > 80            TargetFrontColor = #White          ElseIf BackLuminosity > 128            TargetFrontColor = 0          Else            TargetFrontColor = RGB(220, 220, 220)          EndIf        EndIf      ElseIf ColorType = #PB_Gadget_FrontColor        TargetFrontColor = Color        If ThisColorOnly = 0 And TargetBackColor = #PB_Default And Color <> #PB_Default          ; Inherit BackColor from the immediate parent window or container gadget          TargetBackColor = SGCE_GetParentBackColor(gHandle, ParentWindow, #False)        EndIf      EndIf      ;      ; Revert to native standard rendering when both colors match default system colors      If (TargetFrontColor = #PB_Default Or TargetFrontColor = GetSysColor_(#COLOR_WINDOWTEXT)) And (TargetBackColor = #PB_Default Or TargetBackColor = GetSysColor_(#COLOR_BTNFACE))        ColorType = #SGCE_StandardColors      EndIf    EndIf    ;    If ColorType = #SGCE_StandardColors      If ApplyDarkMode        SetWindowTheme_(gHandle, @"Explorer", #Null)      EndIf      If Found        If GadgetType(GadgetID) = #PB_GadgetType_Frame          ; Restore visibility of PureBasic's internal GroupBox child inside #PB_Frame_Container          hCTRLWnd = 0          Repeat            hCTRLWnd = FindWindowEx_(gHandle, hCTRLWnd, "Button", #Null)            If hCTRLWnd And GetProperty(hCTRLWnd, "PB_ID") = -1 And (GetWindowLong_(hCTRLWnd, #GWL_STYLE) & $F) = #BS_GROUPBOX              ShowWindow_(hCTRLWnd, #SW_SHOWNA)            EndIf          Until hCTRLWnd = 0        EndIf        ;        hCTRLWnd = FindWindowEx_(gHandle, 0, #UPDOWN_CLASS, #Null) ; PanelGadget UpDown control        SGCE_UninstallCallback(hCTRLWnd)        ;        hCTRLWnd = FindWindowEx_(gHandle, 0, #WC_HEADER, #Null)    ; ListIcon / ExplorerList header        SGCE_UninstallCallback(hCTRLWnd)        ;        hCTRLWnd = GetWindow_(gHandle, #GW_HWNDNEXT)               ; SpinGadget UpDown sibling        SGCE_UninstallCallback(hCTRLWnd, #UPDOWN_CLASS)        ;        SGCE_UninstallCallback(gHandle)        ;        If SGCE_GadgetsInfos()\BackBrush          DeleteObject_(SGCE_GadgetsInfos()\BackBrush)        EndIf        DeleteElement(SGCE_GadgetsInfos())        ;        If IsWindowVisible_(gHandle)          HideGadget(GadgetID, #True)          HideGadget(GadgetID, #False)        EndIf      EndIf      SetGadgetColor(GadgetID, #PB_Gadget_FrontColor, #PB_Default)      SetGadgetColor(GadgetID, #PB_Gadget_BackColor, #PB_Default)      ProcedureReturn    EndIf    ;    If TargetFrontColor = #PB_Default      RealFrontColor = GetSysColor_(#COLOR_WINDOWTEXT)    Else      RealFrontColor = TargetFrontColor    EndIf    If TargetBackColor = #PB_Default      RealBackColor = GetSysColor_(#COLOR_BTNFACE)    Else      RealBackColor = TargetBackColor    EndIf    ;    If ApplyDarkMode      ; Match scrollbar visual theme (light vs dark) to background luminance      If Red(RealBackColor) * 0.299 + Green(RealBackColor) * 0.587 + Blue(RealBackColor) * 0.114 > 128        SetWindowTheme_(gHandle, @"Explorer", #Null)      Else        SetWindowTheme_(gHandle, @"DarkMode_Explorer", #Null)      EndIf    EndIf    ;    If Found = #False      AddElement(SGCE_GadgetsInfos())      SGCE_GadgetsInfos()\ID = GadgetID      SGCE_GadgetsInfos()\Handle = gHandle      SGCE_GadgetsInfos()\Enabled = IsWindowEnabled_(gHandle)      SGCE_GadgetsInfos()\MainWindow = ParentWindow    EndIf    SGCE_GadgetsInfos()\FrontColor = TargetFrontColor    SGCE_GadgetsInfos()\BackColor  = TargetBackColor    ;    CustomColor = SGCE_IsCustomColorGadget(GadgetID)    If CustomColor      SGCE_GadgetsInfos()\FrontColor = RealFrontColor      SGCE_GadgetsInfos()\BackColor  = RealBackColor      If SGCE_GadgetsInfos()\BackBrush        DeleteObject_(SGCE_GadgetsInfos()\BackBrush)      EndIf      SGCE_GadgetsInfos()\BackBrush = CreateSolidBrush_(RealBackColor)      SGCE_GadgetsInfos()\EdgesStyle = #SGCE_NoEdges      ;      ; Determine border style flags according to gadget type and Win32 window styles      If CustomColor = -1 Or GadgetType(GadgetID) = #PB_GadgetType_ListIcon Or GadgetType(GadgetID) = #PB_GadgetType_Calendar Or GadgetType(GadgetID) = #PB_GadgetType_ExplorerList        If GetWindowLongPtr_(gHandle, #GWL_EXSTYLE) & (#WS_EX_CLIENTEDGE | #WS_EX_WINDOWEDGE) Or GetWindowLongPtr_(gHandle, #GWL_STYLE) & #WS_BORDER Or GadgetType(GadgetID) = #PB_GadgetType_Editor          SGCE_GadgetsInfos()\EdgesStyle = #SGCE_HoverSensitive | #SGCE_Single        EndIf        If GadgetType(GadgetID) = #PB_GadgetType_ScrollArea Or GadgetType(GadgetID) = #PB_GadgetType_Canvas          If GetWindowLong_(gHandle, #GWL_EXSTYLE) & #WS_EX_STATICEDGE            SGCE_GadgetsInfos()\EdgesStyle = #SGCE_HoverSensitive | #SGCE_Single          ElseIf GetWindowLong_(gHandle, #GWL_EXSTYLE) & #WS_EX_WINDOWEDGE            SGCE_GadgetsInfos()\EdgesStyle = #SGCE_HoverSensitive | #SGCE_Double          ElseIf GetWindowLong_(gHandle, #GWL_STYLE) & #WS_BORDER            SGCE_GadgetsInfos()\EdgesStyle = #SGCE_HoverSensitive | #SGCE_Flat          EndIf        EndIf        If GadgetType(GadgetID) = #PB_GadgetType_Calendar          ; Clamp CalendarGadget dimensions to its exact minimum required rectangle          SendMessage_(gHandle, #MCM_GETMINREQRECT, 0, @gRect)          SetWindowPos_(gHandle, 0, 0, 0, gRect\right - gRect\left - 2, gRect\bottom - gRect\top - 2, #SWP_NOMOVE | #SWP_NOZORDER)        EndIf        ;      ElseIf GadgetType(GadgetID) = #PB_GadgetType_Date        SGCE_GadgetsInfos()\EdgesStyle = #SGCE_Single        ;      ElseIf GadgetType(GadgetID) = #PB_GadgetType_Frame        If GetWindowLong_(gHandle, #GWL_EXSTYLE) & #WS_EX_CLIENTEDGE          SGCE_GadgetsInfos()\EdgesStyle = #SGCE_Double        ElseIf GetWindowLong_(gHandle, #GWL_EXSTYLE) & #WS_EX_STATICEDGE          SGCE_GadgetsInfos()\EdgesStyle = #SGCE_Single        ElseIf GetWindowLong_(gHandle, #GWL_STYLE) & #WS_BORDER          SGCE_GadgetsInfos()\EdgesStyle = #SGCE_Flat        Else          SGCE_GadgetsInfos()\EdgesStyle = #SGCE_WithTitle          ; Hide PureBasic's internal #BS_GROUPBOX child when #PB_Frame_Container is used,          ; preventing it from overpainting our custom-colored border and caption          hCTRLWnd = 0          Repeat            hCTRLWnd = FindWindowEx_(gHandle, hCTRLWnd, "Button", #Null)            If hCTRLWnd And GetProperty(hCTRLWnd, "PB_ID") = -1 And (GetWindowLong_(hCTRLWnd, #GWL_STYLE) & $F) = #BS_GROUPBOX              ShowWindow_(hCTRLWnd, #SW_HIDE)            EndIf          Until hCTRLWnd = 0        EndIf        ;      ElseIf GadgetType(GadgetID) = #PB_GadgetType_Container        If GetWindowLong_(gHandle, #GWL_EXSTYLE) & #WS_EX_CLIENTEDGE          SGCE_GadgetsInfos()\EdgesStyle = #SGCE_Double        ElseIf GetWindowLong_(gHandle, #GWL_EXSTYLE) & #WS_EX_STATICEDGE          SGCE_GadgetsInfos()\EdgesStyle = #SGCE_Single        ElseIf GetWindowLong_(gHandle, #GWL_STYLE) & #WS_BORDER          SGCE_GadgetsInfos()\EdgesStyle = #SGCE_Flat        EndIf      EndIf      ;      SGCE_GadgetsInfos()\EdgesColor = MixColors(RealFrontColor, RealBackColor, 0.25)      SGCE_GadgetsInfos()\HighlightedEdgesColor = MixColors(RealFrontColor, RealBackColor, 0.6)      ;      SGCE_InstallCallbackAndData(gHandle, @SGCE_ChangeColorsCallback(), @SGCE_GadgetsInfos())    EndIf    ;    If CustomColor <> 1      If ColorType = #PB_Gadget_FrontColor        SetGadgetColor(GadgetID, #PB_Gadget_FrontColor, SGCE_GadgetsInfos()\FrontColor)        If ThisColorOnly = 0          SetGadgetColor(GadgetID, #PB_Gadget_BackColor, SGCE_GadgetsInfos()\BackColor)        EndIf      ElseIf ColorType = #PB_Gadget_BackColor        SetGadgetColor(GadgetID, #PB_Gadget_BackColor, SGCE_GadgetsInfos()\BackColor)        If ThisColorOnly = 0          SetGadgetColor(GadgetID, #PB_Gadget_FrontColor, SGCE_GadgetsInfos()\FrontColor)        EndIf      EndIf    EndIf    ;    If IsWindowVisible_(gHandle)      RedrawWindow_(gHandle, #Null, #Null, #RDW_INVALIDATE | #RDW_ERASE | #RDW_FRAME | #RDW_ALLCHILDREN)      If GadgetType(GadgetID) = #PB_GadgetType_Spin        hCTRLWnd = GetWindow_(gHandle, #GW_HWNDNEXT)        If hCTRLWnd          InvalidateRect_(hCTRLWnd, 0, #True)        EndIf      EndIf    EndIf  EndIfEndProcedure;Structure SGCE_ColorForEnum  ColorType.i  Color.iEndStructure;Procedure SGCE_EnumGadgetsAndSetColor(hGadget, *ColorForEnum.SGCE_ColorForEnum)  ;  ; Role: EnumChildWindows callback applying a single color attribute to every PureBasic gadget found.  ;  Protected GadgetPBID = GetProperty(hGadget, "PB_ID")  If GadgetPBID >= 0    SetGadgetColorEx(GadgetPBID, *ColorForEnum\ColorType, *ColorForEnum\Color)  EndIf  ProcedureReturn #TrueEndProcedure;Procedure ApplyColorsToAllGadgets(WindowNum, FrontColor, BackColor)  ;  ; Role: Applies 'BackColor' and 'FrontColor' to 'WindowNum' and to all PureBasic gadgets it hosts.  ;  Protected ColorForEnum.SGCE_ColorForEnum  ;  SetWindowColor(WindowNum, BackColor)  Protected hWnd = WindowID(WindowNum)  ;  ColorForEnum\Color = BackColor  ColorForEnum\ColorType = #PB_Gadget_BackColor  EnumChildWindows_(hWnd, @SGCE_EnumGadgetsAndSetColor(), @ColorForEnum)  ;  ColorForEnum\Color = FrontColor  ColorForEnum\ColorType = #PB_Gadget_FrontColor  EnumChildWindows_(hWnd, @SGCE_EnumGadgetsAndSetColor(), @ColorForEnum)EndProcedure;; Transparently redirect PureBasic's native GetGadgetColor() and SetGadgetColor() to this libraryMacro GetGadgetColor(a, b)  GetGadgetColorEx(a, b)EndMacro;Macro SetGadgetColor(a, b, c)  SetGadgetColorEx(a, b, c)EndMacro;;; ****************************************************************************************;;-                         4--- FOURTH PART: DEMO PROCEDURE ---;; ****************************************************************************************;CompilerIf #PB_Compiler_IsMainFile  ; The following code will not run when this file is included in another project  ;  Macro ColorizeGadgets    ApplyColorsToAllGadgets(#SGCE_DemoWindow, FrontColor, BackColor)    ;    ; Customize specific gadgets when a non-standard theme is active    If BackColor <> #PB_Default      ; Lighten or darken the background of the frame container, its options, and the right container      If Red(BackColor) * 0.299 + Green(BackColor) * 0.587 + Blue(BackColor) * 0.114 > 128        LightenBackground = RGB(ShiftColorComponent(Red(BackColor), -20), ShiftColorComponent(Green(BackColor), -20), ShiftColorComponent(Blue(BackColor), -20))      Else        LightenBackground = RGB(ShiftColorComponent(Red(BackColor), 20), ShiftColorComponent(Green(BackColor), 20), ShiftColorComponent(Blue(BackColor), 20))      EndIf      SetGadgetColor(#SGCE_Frame, #PB_Gadget_BackColor, LightenBackground)      SetGadgetColor(#SGCE_Option1, #PB_Gadget_BackColor, LightenBackground)      SetGadgetColor(#SGCE_Option2, #PB_Gadget_BackColor, LightenBackground)      ;      ; Apply accent colors to OptionGadgets      SetGadgetColor(#SGCE_Option1, #PB_Gadget_FrontColor, RGB($FF, $50, $FF))      If Red(BackColor) * 0.299 + Green(BackColor) * 0.587 + Blue(BackColor) * 0.114 > 128        SetGadgetColor(#SGCE_Option2, #PB_Gadget_FrontColor, $008080)      Else        SetGadgetColor(#SGCE_Option2, #PB_Gadget_FrontColor, $00FFE0)      EndIf      ;      SetGadgetColor(#SGCE_Container, #PB_Gadget_BackColor, LightenBackground)    EndIf    ;    ; Keep each theme selector button previewing its own target palette    SetGadgetColor(#SGCE_StandardButton, #PB_Gadget_BackColor, StandardBack)    SetGadgetColor(#SGCE_StandardButton, #PB_Gadget_FrontColor, StandardFront)    SetGadgetColor(#SGCE_LightBlueButton, #PB_Gadget_BackColor, LightBlueBack)    SetGadgetColor(#SGCE_LightBlueButton, #PB_Gadget_FrontColor, LightBlueFront)    SetGadgetColor(#SGCE_MatrixButton, #PB_Gadget_BackColor, MatrixBack)    SetGadgetColor(#SGCE_MatrixButton, #PB_Gadget_FrontColor, MatrixFront)    SetGadgetColor(#SGCE_DarkGreyButton, #PB_Gadget_BackColor, DarkGreyBack)    SetGadgetColor(#SGCE_DarkGreyButton, #PB_Gadget_FrontColor, DarkGreyFront)  EndMacro  ;  Procedure MulticolorDemoWindow()    ;    ; Role: Opens a demonstration window showcasing custom gadget coloring across themes.    ;    Protected LightenBackground, PanelWidth, ct, a, ContainerWidth, StandardBack, StandardFront, LightBlueBack    Protected LightBlueFront, MatrixBack, MatrixFront, DarkGreyBack, DarkGreyFront, BackColor, FrontColor, Event    ;    Enumeration WindowAndGadgetNum      #SGCE_DemoWindow      #SGCE_Frame      #SGCE_Option1      #SGCE_Option2      #SGCE_CheckBox      #SGCE_Button1      #SGCE_String      #SGCE_Editor      #SGCE_ListView      #SGCE_Panel      #SGCE_Container      #SGCE_StandardButton      #SGCE_LightBlueButton      #SGCE_MatrixButton      #SGCE_DarkGreyButton      #SGCE_ListIcon      #SGCE_Combo      #SGCE_ComboEdit      #SGCE_ExplorerCombo      #SGCE_Date      #SGCE_Calendar      #SGCE_ExplorerList      #SGCE_ExplorerTree      #SGCE_Tree      #SGCE_Spin      #SGCE_BQuit    EndEnumeration    ;    ; Creating the window with #PB_Window_Invisible and unhiding it right before the event loop    ; provides a cleaner initial rendering (optional)    If OpenWindow(#SGCE_DemoWindow, 100, 100, 540, 310, "SetGadgetColorEx Demo", #PB_Window_ScreenCentered | #PB_Window_SystemMenu | #PB_Window_Invisible)      ApplyDarkModeToWindow(#SGCE_DemoWindow)      ;      ; Create two option buttons inside a container FrameGadget      FrameGadget(#SGCE_Frame, 10, 10, 120, 65, "FrameGadget", #PB_Frame_Container)        OptionGadget(#SGCE_Option1, 15, 15, 70, 25, "Option #1")        SetGadgetState(#SGCE_Option1, 1)        OptionGadget(#SGCE_Option2, 15, 35, 70, 25, "Option #2")      CloseGadgetList()      ;      CheckBoxGadget(#SGCE_CheckBox, 10, 90, 120, 25, "CheckBoxGadget")      SetGadgetState(#SGCE_CheckBox, 1)      ButtonGadget(#SGCE_Button1, 20, 120, 100, 25, "Disabled Button")      DisableGadget(#SGCE_Button1, #True)      ;      TextGadget(#PB_Any, 10, 160, 120, 25, "StringGadget")      StringGadget(#SGCE_String, 10, 180, 120, 25, "StringGadget")      ;      TextGadget(#PB_Any, 10, 230, 120, 20, "EditorGadget")      EditorGadget(#SGCE_Editor, 10, 250, 120, 50)      SetGadgetText(#SGCE_Editor, "EditorGadget with a long text.")      ;      PanelWidth = 247      PanelGadget(#SGCE_Panel, 140, 10, PanelWidth, WindowHeight(#SGCE_DemoWindow) - 19)      ;      AddGadgetItem(#SGCE_Panel, -1, "Combos")        TextGadget(#PB_Any, 6, 20, PanelWidth - 20, 20, "ComboBoxGadget")        ComboBoxGadget(#SGCE_Combo, 6, 40, PanelWidth - 20, 22)        For ct = 1 To 5 : AddGadgetItem(#SGCE_Combo, -1, "ComboBox standard " + Str(ct)) : Next        SetGadgetState(#SGCE_Combo, 0)        ;        TextGadget(#PB_Any, 6, 80, PanelWidth - 20, 20, "ComboBoxGadget - Editable")        ComboBoxGadget(#SGCE_ComboEdit, 6, 100, PanelWidth - 20, 22, #PB_ComboBox_Editable)        For ct = 1 To 5 : AddGadgetItem(#SGCE_ComboEdit, -1, "ComboBox Editable " + Str(ct)) : Next        SetGadgetState(#SGCE_ComboEdit, 0)        ;        TextGadget(#PB_Any, 6, 160, PanelWidth - 20, 20, "ExplorerComboGadget")        ExplorerComboGadget(#SGCE_ExplorerCombo, 6, 180, PanelWidth - 20, 22, "C:")        ;      AddGadgetItem(#SGCE_Panel, -1, "Lists")        TextGadget(#PB_Any, 6, 10, PanelWidth - 20, 20, "ListIconGadget")        ListIconGadget(#SGCE_ListIcon, 6, 30, PanelWidth - 20, 80, "ListIcon", 70)        AddGadgetColumn(#SGCE_ListIcon, 1, "Column 2", 100)        For ct = 1 To 10          AddGadgetItem(#SGCE_ListIcon, -1, "Element " + Str(ct) + #LF$ + "Column 2 Element " + Str(ct))        Next        TextGadget(#PB_Any, 6, 130, PanelWidth - 20, 20, "ExplorerListGadget")        ExplorerListGadget(#SGCE_ExplorerList, 6, 150, PanelWidth - 20, 100, "C:")        ;      AddGadgetItem(#SGCE_Panel, -1, "ListView")        TextGadget(#PB_Any, 6, 30, PanelWidth - 20, 20, "ListViewGadget")        ListViewGadget(#SGCE_ListView, 6, 50, PanelWidth - 20, 140)        For ct = 1 To 20          AddGadgetItem(#SGCE_ListView, ct - 1, "ListView Gadget " + Str(ct))        Next        ;      AddGadgetItem(#SGCE_Panel, -1, "Date")        TextGadget(#PB_Any, 6, 10, PanelWidth - 20, 20, "DateGadget")        DateGadget(#SGCE_Date, 6, 30, PanelWidth - 20, 22)        TextGadget(#PB_Any, 6, 70, PanelWidth - 20, 20, "CalendarGadget")        CalendarGadget(#SGCE_Calendar, 6, 90, PanelWidth, 164)        ;      AddGadgetItem(#SGCE_Panel, -1, "Trees")        TextGadget(#PB_Any, 6, 10, PanelWidth - 20, 20, "ExplorerTreeGadget")        ExplorerTreeGadget(#SGCE_ExplorerTree, 6, 30, PanelWidth - 20, 95, "C:")        TextGadget(#PB_Any, 6, 135, PanelWidth - 20, 20, "TreeGadget")        TreeGadget(#SGCE_Tree, 6, 155, PanelWidth - 20, 100)        For a = 0 To 10          AddGadgetItem(#SGCE_Tree, -1, "Normal " + Str(a), 0, 0)          AddGadgetItem(#SGCE_Tree, -1, "Node " + Str(a), 0, 0)          AddGadgetItem(#SGCE_Tree, -1, "SubElement 1", 0, 1)          AddGadgetItem(#SGCE_Tree, -1, "SubElement 2", 0, 1)          AddGadgetItem(#SGCE_Tree, -1, "SubElement 3", 0, 1)          AddGadgetItem(#SGCE_Tree, -1, "SubElement 4", 0, 1)          AddGadgetItem(#SGCE_Tree, -1, "File " + Str(a), 0, 0)        Next        ;      AddGadgetItem(#SGCE_Panel, -1, "Others")        TextGadget(#PB_Any, 6, 10, PanelWidth - 20, 20, "SpinGadget")        SpinGadget(#SGCE_Spin, 6, 30, PanelWidth - 20, 22, 0, 5, #PB_Spin_Numeric)        SetGadgetText(#SGCE_Spin, "1")        HyperLinkGadget(#PB_Any, 6, 70, PanelWidth - 20, 20, "HyperLinkGadget", $FFA020)        TextGadget(#PB_Any, 6, 110, PanelWidth - 20, 20, "ScrollAreaGadget")        ScrollAreaGadget(#PB_Any, 6, 130, PanelWidth - 20, 50, 220, 60)        CloseGadgetList()        ;      CloseGadgetList()      ;      ContainerWidth = 130      TextGadget(#PB_Any, WindowWidth(#SGCE_DemoWindow) - ContainerWidth - 10, 12, ContainerWidth, 70, "<-- Browse the panels to see what each gadget looks like when colorized.", #PB_Text_Center)      ;      TextGadget(#PB_Any, WindowWidth(#SGCE_DemoWindow) - ContainerWidth - 10, 100, ContainerWidth, 20, "Choose your color:", #PB_Text_Center)      ContainerGadget(#SGCE_Container, WindowWidth(#SGCE_DemoWindow) - ContainerWidth - 10, 120, ContainerWidth, 130)        ButtonGadget(#SGCE_StandardButton,  10, 10,  ContainerWidth - 20, 22, "Standard")        ButtonGadget(#SGCE_LightBlueButton, 10, 40,  ContainerWidth - 20, 22, "Light blue")        ButtonGadget(#SGCE_MatrixButton,    10, 70,  ContainerWidth - 20, 22, "Matrix")        ButtonGadget(#SGCE_DarkGreyButton,  10, 100, ContainerWidth - 20, 22, "Dark grey")      CloseGadgetList()      ;      DisableGadget(#SGCE_MatrixButton, #True)      ButtonGadget(#SGCE_BQuit, WindowWidth(#SGCE_DemoWindow) - ContainerWidth - 10, WindowHeight(#SGCE_DemoWindow) - 35, 130, 25, "Exit")      ;      ; You can assign colors to gadgets individually, or apply a global theme in two ways:      ; • Include 'ApplyColorThemes.pbi' from:      ;   https://www.editions-humanis.com/downloads/PureBasic/ZapmanDowloads_EN.htm      ;   to let users create, edit, or select complete color themes.      ; • Or call ApplyColorsToAllGadgets() directly as shown in ColorizeGadgets above.      StandardBack   = #PB_Default      StandardFront  = #PB_Default      LightBlueBack  = $FFFFE0      LightBlueFront = $A04000      MatrixBack     = $282800      MatrixFront    = $A0FF5A      DarkGreyBack   = $202020      DarkGreyFront  = $E0E0E0      ;      BackColor  = MatrixBack  ; Matrix default setting      FrontColor = MatrixFront ; Matrix default setting      ;      ColorizeGadgets      ;      HideWindow(#SGCE_DemoWindow, #False)      ;      Repeat        Event = WaitWindowEvent()        If Event = #PB_Event_Gadget          Select EventGadget()            Case #SGCE_CheckBox              If GetGadgetState(#SGCE_CheckBox)                DisableGadget(#SGCE_Button1, #True)                SetGadgetText(#SGCE_Button1, "Disabled Button")              Else                DisableGadget(#SGCE_Button1, #False)                SetGadgetText(#SGCE_Button1, "Enabled Button")              EndIf            Case #SGCE_StandardButton, #SGCE_LightBlueButton, #SGCE_MatrixButton, #SGCE_DarkGreyButton              BackColor  = GetGadgetColor(EventGadget(), #PB_Gadget_BackColor)              FrontColor = GetGadgetColor(EventGadget(), #PB_Gadget_FrontColor)              ;              DisableGadget(#SGCE_StandardButton, #False)              DisableGadget(#SGCE_LightBlueButton, #False)              DisableGadget(#SGCE_MatrixButton, #False)              DisableGadget(#SGCE_DarkGreyButton, #False)              DisableGadget(EventGadget(), #True)              ;              ColorizeGadgets            Case #SGCE_BQuit              Break          EndSelect        ElseIf Event = #PB_Event_CloseWindow          Break        EndIf      ForEver      CloseWindow(#SGCE_DemoWindow)    EndIf  EndProcedure  ;  MulticolorDemoWindow()  ;CompilerEndIf; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 64; FirstLine = 37; Folding = wDAwpJA9; DPIAware