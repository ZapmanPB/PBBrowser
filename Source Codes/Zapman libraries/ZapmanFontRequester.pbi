;; ****************************************************************************;;                            Zapman Font Requester;                                 Windows only;                                Nov 2026 - 15;;     This file should be saved under the name "ZapmanFontRequester.pbi".;;            This library is intended to implement an alternative;              to the PureBasic native FontRequester() function.;;                Needs FontDescription.pbi as an included file.;;  The main procedures of this library are 'FontRequesterEx()' and 'ZapmanFontRequester()',;  which are quite similar but accept different types of parameters (see comments at the;  beginning of these procedures).;; This library is organized into five distinct sections:;; 1. 'Language settings' contains functions that manage the multilingual;    aspect of the library. Read the comment at the beginning of this section;    for more details.; 2. 'Shared UI font' defines the default interface font used across the;    requester's gadgets (font inspection helpers such as 'GetFontName()' are;    provided by the companion 'FontDescription.pbi' library).; 3. 'Zapman FontRequester specific functions' is a set of routines required;    by the public functions to operate.; 4. 'Zapman FontRequester public functions' are the main functions of this library.;    They offer two different ways to invoke a customizable font requester.;    Please read the comments at the beginning of each procedure to know how to use it.; 5. The 'DEMO' section illustrates the purpose of this library.;;; This library is compatible with the Zapman 'ApplyColorThemes.pbi' library,; which allows you to display your windows in 'Dark Mode' or with other color themes.; It is also compatible with (and will automatically use) 'ZapmanColorRequester.pbi'; if that library is included in your project.;; ****************************************************************************;; "FontDescription.pbi" is required for textual font description parsing and formatting:XIncludeFile("FontDescription.pbi");;- 1. Language settings;; All Zapman libraries are designed to be integrated into multilingual applications.; It is entirely possible to redefine the 'GetTextFromCatalog()' function in a file; that precedes this one in your 'XIncludeFile' list. That way, you can store the; translations of the texts used in your application's gadgets in your own format.; However, the functions in this section provide a simple and self-contained solution,; and if your language is not included in the list of translated languages, only a few; lines need to be added at the end of this section.;; Translations were generated from the English catalog, using an excerpt from a classic; poem in each corresponding language for the 'Sample' preview text.;CompilerIf #PB_Compiler_IsMainFile  EnableExplicitCompilerEndIf;Global MyLanguage$If MyLanguage$ = ""  MyLanguage$ = "EN" ; Supported language codes: "EN", "ES", "FR", "DE", "IT", "RU", or "ZH".EndIf;CompilerIf Not Defined(LanguageListStructure, #PB_Structure)  Structure LanguageListStructure    Language$    LanguageEntry$    LanguageTranslation$  EndStructure  ;  Global NewList LanguageList.LanguageListStructure()CompilerEndIf;CompilerIf Not Defined(GetTextFromCatalog, #PB_Procedure)  Procedure.s GetTextFromCatalog(SName$)    ;    ; Role: Retrieves the localized string matching 'SName$' for the active 'MyLanguage$' code.    ; Output: Localized string if found, or 'SName$' itself as fallback.    ;    ForEach LanguageList()      If LanguageList()\Language$ = MyLanguage$ And LCase(LanguageList()\LanguageEntry$) = LCase(SName$)        ProcedureReturn LanguageList()\LanguageTranslation$      EndIf    Next    ProcedureReturn SName$  EndProcedureCompilerEndIf;CompilerIf Not Defined(FillLanguageList, #PB_Procedure)  Procedure FillLanguageList(Language$, LanguageEntry$, LanguageTranslation$)    ;    ; Role: Populates 'LanguageList()' with comma-separated key/translation pairs for 'Language$'    ;       without overwriting entries that were already registered.    ;    Protected PosInList = 0, KeyWord$, Found    ;    Repeat      PosInList + 1      KeyWord$ = StringField(LanguageEntry$, PosInList, ",")      If KeyWord$ <> ""        Found = 0        ForEach LanguageList()          If LanguageList()\Language$ = Language$ And LCase(LanguageList()\LanguageEntry$) = LCase(KeyWord$)            Found = 1            Break          EndIf        Next        If Found = 0          AddElement(LanguageList())          LanguageList()\Language$            = Language$          LanguageList()\LanguageEntry$       = KeyWord$          LanguageList()\LanguageTranslation$ = StringField(LanguageTranslation$, PosInList, ",")        EndIf      EndIf    Until KeyWord$ = ""  EndProcedureCompilerEndIf;Define LanguageEntry$, LanguageTranslation$;LanguageEntry$ = "ChooseAFont,Variants:,Size:,DetailsDwn,DetailsUp,Cancel,OK,Normal,Bold,Italic,Underline,StrikeOut,Color:,"LanguageEntry$ + "fancyFont,unspecified,monospace,withSerif,handwriting,withoutSerif,Unknown,Name:,Type:,Family:,Style:,Script(s):,Metrics:,"LanguageEntry$ + "Sample,"LanguageEntry$ + "CAFDemoText";; ------------- English list of expressions ---------------LanguageTranslation$ = "Choose a font,Variants:,Size:,Details ⏷,Details ⏶,Cancel,OK,Normal,Bold,Italic,Underline,StrikeOut,Color:,"LanguageTranslation$ + "fancy font,unspecified,monospace,with serif,handwriting,without serif,Unknown,Name:,Type:,Family:,Style:,Script(s):,Metrics:,"LanguageTranslation$ + "Sample,"LanguageTranslation$ + "The invisible worm" + #CR$LanguageTranslation$ + "That flies in the night" + #CR$LanguageTranslation$ + "In the howling storm" + #CR$LanguageTranslation$ + "Has found out thy bed" + #CR$LanguageTranslation$ + "Of crimson joy:" + #CR$LanguageTranslation$ + "his dark secret love" + #CR$LanguageTranslation$ + "thy life destroy."FillLanguageList("EN", LanguageEntry$, LanguageTranslation$);; ------------- Spanish list of expressions ---------------LanguageTranslation$ = "Elige una fuente,Variantes:,Tamaño:,Detalles ⏷,Detalles ⏶,Cancelar,OK,Normal,Negrita,Cursiva,Subrayado,Tachado,Color:,"LanguageTranslation$ + "fuente elegante,no especificada,monoespaciada,con serif,escritura manual,sin serif,Desconocido,Nombre:,Tipo:,Familia:,Estilo:,Guion(es):,Métricas:,"LanguageTranslation$ + "Muestra,"LanguageTranslation$ + "Recuerde el alma dormida" + #CR$LanguageTranslation$ + "avive el seso y despierte" + #CR$LanguageTranslation$ + "contemplando cómo se pasa la vida" + #CR$LanguageTranslation$ + "cómo se viene la muerte tan callando."FillLanguageList("ES", LanguageEntry$, LanguageTranslation$);; ------------- French list of expressions ----------------LanguageTranslation$ = "Choisir une police,Variantes :,Taille :,Détails ⏷,Détails ⏶,Annuler,OK,Normal,Gras,Italique,Souligné,Barré,Couleur :,"LanguageTranslation$ + "police fantaisie,non spécifié,monospace,avec empattement,écriture manuelle,sans empattement,Inconnu,Nom :,Type :,Famille :,Style :,Script(s) :,Métriques :,"LanguageTranslation$ + "Exemple,"LanguageTranslation$ + "Toujours avec l'espoir de rencontrer la mer" + #CR$LanguageTranslation$ + "Ils voyageaient sans pain sans bâtons et sans urnes" + #CR$LanguageTranslation$ + "Mordant au citron d'or de l'idéal amer."FillLanguageList("FR", LanguageEntry$, LanguageTranslation$);; ------------- German list of expressions ----------------LanguageTranslation$ = "Wählen Sie eine Schriftart,Varianten:,Größe:,Einzelheiten ⏷,Einzelheiten ⏶,Abbrechen,OK,Normal,Fett,Kursiv,Unterstrichen,Durchgestrichen,Farbe:,"LanguageTranslation$ + "elegante Schrift,nicht angegeben,monospaced,mit Serifen,Handschrift,ohne Serifen,Unbekannt,Name:,Typ:,Familie:,Stil:,Schrift(en):,Metriken:,"LanguageTranslation$ + "Probe,"LanguageTranslation$ + "Wer reitet so spät durch Nacht und Wind?" + #CR$LanguageTranslation$ + "Es ist der Vater mit seinem Kind;" + #CR$LanguageTranslation$ + "Er hat den Knaben wohl in dem Arm" + #CR$LanguageTranslation$ + "Er fasst ihn sicher er hält ihn warm."FillLanguageList("DE", LanguageEntry$, LanguageTranslation$);; ------------- Italian list of expressions ---------------LanguageTranslation$ = "Scegli un carattere,Varianti:,Dimensione:,Dettagli ⏷,Dettagli ⏶,Annulla,OK,Normale,Grassetto,Corsivo,Sottolineato,Barrato,Colore:,"LanguageTranslation$ + "carattere elegante,non specificato,monospaziato,con grazie,scrittura a mano,sans-serif,Sconosciuto,Nome:,Tipo:,Famiglia:,Stile:,Script:,Metriche:,"LanguageTranslation$ + "Campione,"LanguageTranslation$ + "Sempre caro mi fu quest'ermo colle" + #CR$LanguageTranslation$ + "E questa siepe che da tanta parte" + #CR$LanguageTranslation$ + "Dell'ultimo orizzonte il guardo esclude."FillLanguageList("IT", LanguageEntry$, LanguageTranslation$);; ------------- Russian list of expressions ---------------LanguageTranslation$ = "Выберите шрифт,Варианты:,Размер:,Подробности ⏷,Подробности ⏶,Отмена,OK,Обычный,Жирный,Курсив,Подчеркнутый,Зачеркнутый,Цвет:,"LanguageTranslation$ + "декоративный шрифт,не указано,моноширинный,с засечками,рукописный,без засечек,Неизвестно,Имя:,Тип:,Семейство:,Стиль:,Набор(ы) символов:,Метрики:,"LanguageTranslation$ + "Образец,"LanguageTranslation$ + "Белеет парус одинокий" + #CR$LanguageTranslation$ + "В тумане моря голубом!.." + #CR$LanguageTranslation$ + "Что ищет он в стране далекой?" + #CR$LanguageTranslation$ + "Что кинул он в краю родном?.."FillLanguageList("RU", LanguageEntry$, LanguageTranslation$);; ------------- Mandarin list of expressions --------------LanguageTranslation$ = "选择字体,变体:,大小:,详情 ⏷,详情 ⏶,取消,确定,常规,加粗,倾斜,下划线,删除线,颜色:,"LanguageTranslation$ + "艺术字体,未指定,等宽字体,有衬线,手写体,无衬线,未知,名称:,类型:,字族:,样式:,字符集:,度量:,"LanguageTranslation$ + "示例,"LanguageTranslation$ + "床前明月光" + #CR$LanguageTranslation$ + "疑是地上霜" + #CR$LanguageTranslation$ + "举头望明月" + #CR$LanguageTranslation$ + "低头思故乡。"FillLanguageList("ZH", LanguageEntry$, LanguageTranslation$);; ----------- Add your own language here -------------; LanguageTranslation$ = "Expression1,Expression2,etc."; FillLanguageList("XX", LanguageEntry$, LanguageTranslation$) ; Replace "XX" with your language code.;; ****************************************************************************;;-                           2. Shared UI font;; ****************************************************************************;Global PBBAllGadgetsFontIf PBBAllGadgetsFont = 0  ; Define the default OS font handle used to render gadgets inside FontRequesterEx():  PBBAllGadgetsFont = FontID(LoadFont(#PB_Any, "Segoe UI", 9))EndIf;; ****************************************************************************;;-                3. Zapman FontRequester specific functions;; ****************************************************************************;#ZFR_ChooseColor           = $4000000#ZFR_NORASTERFONTS         = $8000000#ZFR_ShowSize              = $10000000#ZFR_FontRequester_Effects = #PB_Font_Bold | #PB_Font_Italic | #PB_Font_StrikeOut | #PB_Font_Underline | #ZFR_ChooseColor | #ZFR_ShowSize | #CF_NOVERTFONTS#ZFR_FontRequester_Default = #PB_Font_Bold | #PB_Font_Italic | #ZFR_ShowSize | #CF_NOVERTFONTS;Global ZFR_FontDescription$ ; Stores the resulting font description after a call to ZapmanFontRequester() or FontRequesterEx().;CompilerIf Not Defined(CWO_Positioning, #PB_Enumeration)  Enumeration CWO_Positioning    #CWO_ActiveWindowPos = -1    #CWO_AbsolutePos     = -2    #CWO_MonitorPos      = -3  EndEnumerationCompilerEndIf;CompilerIf Not Defined(CWO_PositionAnchor, #PB_Enumeration)  Enumeration CWO_PositionAnchor    #CWO_Center = 0    #CWO_TopLeft    #CWO_TopRight    #CWO_BottomLeft    #CWO_BottomRight  EndEnumerationCompilerEndIf;CompilerIf Not Defined(ComputeWinOrigins, #PB_Procedure)  Procedure ComputeWinOrigins(*OX.Integer, *OY.Integer, WWidth, WHeight, ParentWindow = #CWO_ActiveWindowPos, XShiftOrPos = 0, YShiftOrPos = 0, ParentAnchor = #CWO_Center, WindowAnchor = #CWO_Center)    ;    ; Role: Computes the X and Y logical screen origins for a new window from its client dimensions    ;       (WWidth, WHeight) relative to a parent window or to the target monitor's work area,    ;       clamped so the window stays within visible work-area bounds.    ; Output: Writes computed coordinates to '*OX' and '*OY', and returns the OS HWND of 'ParentWindow'    ;         (or 0 when positioned relative to a monitor or at absolute coordinates).    ;    ; Positioning rules:    ; • If ParentWindow is a valid PureBasic window number, the new window is positioned relative    ;   to it and then shifted by XShiftOrPos and YShiftOrPos.    ; • If ParentWindow = #CWO_ActiveWindowPos and GetActiveWindow() returns a valid window number,    ;   GetActiveWindow() is used as the parent window; otherwise the main monitor is used.    ; • If ParentWindow = #CWO_AbsolutePos, XShiftOrPos and YShiftOrPos are used directly as the    ;   absolute coordinates of the new window.    ; • If ParentWindow = #CWO_MonitorPos, the position is calculated relative to the monitor    ;   containing GetActiveWindow() (or the main monitor if no PureBasic window is active).    ; • 'ParentAnchor' selects the reference point on the parent window or monitor (#CWO_Center,    ;   #CWO_TopLeft, #CWO_TopRight, #CWO_BottomLeft, or #CWO_BottomRight).    ; • 'WindowAnchor' selects the matching anchor point on the new window itself.    ; • In all cases except #CWO_AbsolutePos, 'XShiftOrPos' and 'YShiftOrPos' offset the result.    ;    Protected DesktopLeft, DesktopRight, DesktopTop, DesktopBottom    Protected ParentWindowID, MFWindow, hMonitor, TotalHeight, mi.MONITORINFO    ;    If ParentWindow = #CWO_AbsolutePos      *OX\i = XShiftOrPos      *OY\i = YShiftOrPos      ProcedureReturn 0    EndIf    ;    If ParentWindow = #CWO_ActiveWindowPos And IsWindow(GetActiveWindow())      ParentWindow = GetActiveWindow()    EndIf    ;    ; Retrieve the work-area bounds of the monitor hosting the parent (or active) window:    MFWindow = ParentWindow    If Not IsWindow(MFWindow)      MFWindow = GetActiveWindow()    EndIf    If IsWindow(MFWindow)      MFWindow = WindowID(MFWindow)    Else      MFWindow = 0    EndIf    ;    hMonitor  = MonitorFromWindow_(MFWindow, #MONITOR_DEFAULTTONEAREST)    mi\cbSize = SizeOf(MONITORINFO)    GetMonitorInfo_(hMonitor, @mi)    ;    DesktopLeft   = DesktopUnscaledX(mi\rcWork\left)    DesktopRight  = DesktopUnscaledX(mi\rcWork\right)    DesktopTop    = DesktopUnscaledY(mi\rcWork\top)    DesktopBottom = DesktopUnscaledY(mi\rcWork\bottom)    ;    ; Compute the reference point on the parent window or monitor:    If IsWindow(ParentWindow)      ParentWindowID = WindowID(ParentWindow)      *OX\i = WindowX(ParentWindow)      *OY\i = WindowY(ParentWindow)      ;      If ParentAnchor = #CWO_Center        *OX\i + WindowWidth(ParentWindow) / 2        *OY\i + WindowHeight(ParentWindow) / 2      ElseIf ParentAnchor = #CWO_TopRight        *OX\i + WindowWidth(ParentWindow)      ElseIf ParentAnchor = #CWO_BottomLeft        *OY\i + WindowHeight(ParentWindow)      ElseIf ParentAnchor = #CWO_BottomRight        *OX\i + WindowWidth(ParentWindow)        *OY\i + WindowHeight(ParentWindow)      EndIf    Else      *OX\i = DesktopLeft      *OY\i = DesktopTop      ;      If ParentAnchor = #CWO_Center        *OX\i = (DesktopLeft + DesktopRight) / 2        *OY\i = (DesktopTop + DesktopBottom) / 2      ElseIf ParentAnchor = #CWO_TopRight        *OX\i = DesktopRight      ElseIf ParentAnchor = #CWO_BottomLeft        *OY\i = DesktopBottom      ElseIf ParentAnchor = #CWO_BottomRight        *OX\i = DesktopRight        *OY\i = DesktopBottom      EndIf    EndIf    ;    ; Account for the title bar and horizontal frame borders added by OpenWindow() around WHeight:    TotalHeight = WHeight + DesktopUnscaledY(GetSystemMetrics_(#SM_CYCAPTION) + GetSystemMetrics_(#SM_CYSIZEFRAME) * 2)    If WindowAnchor = #CWO_Center      *OX\i - WWidth / 2      *OY\i - TotalHeight / 2    ElseIf WindowAnchor = #CWO_TopRight      *OX\i - WWidth    ElseIf WindowAnchor = #CWO_BottomLeft      *OY\i - TotalHeight    ElseIf WindowAnchor = #CWO_BottomRight      *OX\i - WWidth      *OY\i - TotalHeight    EndIf    ;    ; Apply caller offset and clamp to the monitor work area (checking right/bottom before left/top    ; so the title bar remains reachable even if the window exceeds small screen dimensions):    *OX\i + XShiftOrPos    *OY\i + YShiftOrPos    If *OX\i + WWidth > DesktopRight      *OX\i = DesktopRight - WWidth - 10    EndIf    If *OX\i < DesktopLeft      *OX\i = DesktopLeft + 10    EndIf    If *OY\i + TotalHeight > DesktopBottom      *OY\i = DesktopBottom - TotalHeight - 10    EndIf    If *OY\i < DesktopTop      *OY\i = DesktopTop + 10    EndIf    ;    ProcedureReturn ParentWindowID  EndProcedureCompilerEndIf;Structure FontInfoStruct  FontName$  FontStyle$  ScriptList$  FontType.i  PitchAndFamily.l  ntmFlags.i  IsSymbolFont.b  DisplaySize.l  DisplayYOffset.l  ;  MainFontName$  Variants$EndStructure;Global NewList ZFR_FontList.FontInfoStruct();Procedure.s ZFR_GetFontTypeNameFromNum(FontType)  ;  ; Role: Converts a Win32 EnumFontFamEx FontType bitmask into a human-readable type label.  ;  If FontType & #TRUETYPE_FONTTYPE    ProcedureReturn "TrueType"  ElseIf FontType & #DEVICE_FONTTYPE    ProcedureReturn "Device"  ElseIf FontType & #RASTER_FONTTYPE    ProcedureReturn "Raster"  EndIf  ProcedureReturn GetTextFromCatalog("Unknown")EndProcedure;Procedure.s ZFR_GetFontFamilyNameFromNum(PitchAndFamily)  ;  ; Role: Converts a LOGFONT lfPitchAndFamily byte into a localized family and pitch description.  ;  Protected FontFamilyStr$  Protected FamilyNum = PitchAndFamily & $F0  ;  Select FamilyNum    Case #FF_DECORATIVE      FontFamilyStr$ = "DECORATIVE (" + GetTextFromCatalog("fancyFont") + ")"    Case #FF_DONTCARE      FontFamilyStr$ = "DONTCARE (" + GetTextFromCatalog("unspecified") + ")"    Case #FF_MODERN      FontFamilyStr$ = "MODERN (" + GetTextFromCatalog("monospace") + ")"    Case #FF_ROMAN      FontFamilyStr$ = "ROMAN (" + GetTextFromCatalog("withSerif") + ")"    Case #FF_SCRIPT      FontFamilyStr$ = "SCRIPT (" + GetTextFromCatalog("handwriting") + ")"    Case #FF_SWISS      FontFamilyStr$ = "SWISS (" + GetTextFromCatalog("withoutSerif") + ")"    Default      FontFamilyStr$ = GetTextFromCatalog("Unknown")  EndSelect  If (PitchAndFamily & $03) = #FIXED_PITCH And FindString(FontFamilyStr$, GetTextFromCatalog("monospace")) = 0    FontFamilyStr$ + " (" + GetTextFromCatalog("monospace") + ")"  EndIf  ProcedureReturn FontFamilyStr$EndProcedure;Procedure ZFR_EnumFontProc(*lpelfex.ENUMLOGFONTEX, *lpntm.NEWTEXTMETRIC, FontType, lParam)  ;  ; Role: Win32 EnumFontFamiliesEx_ callback collecting installed fonts that match filter flags in 'lParam'.  ;  Protected FontName$   = PeekS(@*lpelfex\elfLogFont\lfFaceName[0])  Protected ScriptName$ = PeekS(@*lpelfex\elfScript[0])  Protected CharSet     = *lpelfex\elfLogFont\lfCharSet & $FF  ;  ; Apply optional exclusion filters (#CF_NOVERTFONTS, #CF_FIXEDPITCHONLY, #ZFR_NORASTERFONTS, #CF_TTONLY, OEM/Symbol):  If Left(FontName$, 1) <> "@" Or (lParam & #CF_NOVERTFONTS) = 0    If (*lpelfex\elfLogFont\lfPitchAndFamily & $03) = #FIXED_PITCH Or (lParam & #CF_FIXEDPITCHONLY) = 0      If (FontType & #RASTER_FONTTYPE) = 0 Or (lParam & #ZFR_NORASTERFONTS) = 0        If (FontType & #TRUETYPE_FONTTYPE) Or (lParam & #CF_TTONLY) = 0          If CharSet <> #OEM_CHARSET Or ((lParam & #CF_NOOEMFONTS) = 0 And (lParam & #CF_NOVECTORFONTS) = 0)            If (CharSet <> #OEM_CHARSET And CharSet <> #SYMBOL_CHARSET) Or (lParam & #CF_SCRIPTSONLY) = 0              If ListSize(ZFR_FontList()) < 1 Or FontName$ <> ZFR_FontList()\FontName$                AddElement(ZFR_FontList())                ZFR_FontList()\FontName$      = FontName$                ZFR_FontList()\FontStyle$     = PeekS(@*lpelfex\elfStyle[0])                ZFR_FontList()\FontType       = FontType                ZFR_FontList()\PitchAndFamily = *lpelfex\elfLogFont\lfPitchAndFamily                ZFR_FontList()\ScriptList$    = ScriptName$                ZFR_FontList()\ntmFlags       = *lpntm\ntmFlags                ZFR_FontList()\IsSymbolFont   = Bool(CharSet = #SYMBOL_CHARSET)              ElseIf ScriptName$ <> "" And FindString(", " + ZFR_FontList()\ScriptList$ + ", ", ", " + ScriptName$ + ", ") = 0                ZFR_FontList()\ScriptList$ + ", " + ScriptName$                If CharSet = #SYMBOL_CHARSET                  ZFR_FontList()\IsSymbolFont = #True                EndIf              EndIf              If *lpntm\tmWeight >= 600                ; Mark naturally heavy fonts (weight >= SemiBold) as bold so they are not artificially emboldened:                ZFR_FontList()\ntmFlags | #NTM_BOLD              EndIf            EndIf          EndIf        EndIf      EndIf    EndIf  EndIf  ProcedureReturn 1EndProcedure;Procedure ZFR_ListFonts(Window, FontListGadget, Options)  ;  ; Role: Enumerates system fonts matching 'Options', groups style variants under their base  ;       family name, and populates 'FontListGadget' with the sorted list of main font names.  ;  Protected *PrevEntry.FontInfoStruct, *Main, *LastFLE  Protected VariantIndicators$ = "Extra,Semi,Demi,Light,Med,Bold,Black,Heavy,Ultra,Cond,Italic,SmBd,Bd,Cn,Bk,Blk,Hv,Lt,Md,XBlk,Thin"  Protected Indic$, MMainFontName$, VariantList$, Variant$, PrevChar$  Protected hdc, PosInList, Pos, PPos, SearchStart  ;  If Window    If IsWindow(Window)      Window = WindowID(Window)    EndIf    hdc = GetDC_(Window)    If hdc      ClearList(ZFR_FontList())      EnumFontFamiliesEx_(hdc, 0, @ZFR_EnumFontProc(), Options, 0)      ReleaseDC_(Window, hdc)      ;      SortStructuredList(ZFR_FontList(), #PB_Sort_Ascending | #PB_Sort_NoCase, OffsetOf(FontInfoStruct\FontName$), TypeOf(FontInfoStruct\FontName$))      ;      ; Merge non-contiguous multi-script duplicates and split variant suffixes from main family names:      *PrevEntry = 0      ForEach ZFR_FontList()        If *PrevEntry And *PrevEntry\FontName$ = ZFR_FontList()\FontName$          If ZFR_FontList()\ScriptList$ <> "" And FindString(", " + *PrevEntry\ScriptList$ + ", ", ", " + ZFR_FontList()\ScriptList$ + ", ") = 0            *PrevEntry\ScriptList$ + ", " + ZFR_FontList()\ScriptList$          EndIf          *PrevEntry\ntmFlags | ZFR_FontList()\ntmFlags          If ZFR_FontList()\IsSymbolFont            *PrevEntry\IsSymbolFont = #True          EndIf          DeleteElement(ZFR_FontList())          Continue        EndIf        *PrevEntry = @ZFR_FontList()        ;        ; Locate the earliest standalone variant keyword (preceded by a space or a hyphen):        PosInList = 0        Pos = 0        Repeat          PosInList + 1          Indic$ = StringField(VariantIndicators$, PosInList, ",")          If Indic$            SearchStart = 2            Repeat              PPos = FindString(ZFR_FontList()\FontName$, Indic$, SearchStart)              If PPos                PrevChar$ = Mid(ZFR_FontList()\FontName$, PPos - 1, 1)                If (PrevChar$ = " " Or PrevChar$ = "-") And (Pos = 0 Or PPos < Pos)                  Pos = PPos                  Break                EndIf                SearchStart = PPos + 1              EndIf            Until PPos = 0          EndIf        Until Indic$ = ""        ;        If Pos > 1          ZFR_FontList()\MainFontName$ = RTrim(Trim(Left(ZFR_FontList()\FontName$, Pos - 1)), "-")        Else          ZFR_FontList()\MainFontName$ = ZFR_FontList()\FontName$        EndIf      Next      ;      ; Re-sort by main family name and group variants into FontListGadget:      SortStructuredList(ZFR_FontList(), #PB_Sort_Ascending | #PB_Sort_NoCase, OffsetOf(FontInfoStruct\MainFontName$), TypeOf(FontInfoStruct\MainFontName$))      ;      MMainFontName$ = ""      ForEach ZFR_FontList()        If ZFR_FontList()\MainFontName$ <> MMainFontName$          MMainFontName$ = ZFR_FontList()\MainFontName$          AddGadgetItem(FontListGadget, -1, MMainFontName$)          VariantList$ = ""          *Main = @ZFR_FontList()          While ZFR_FontList()\MainFontName$ = MMainFontName$            Variant$ = LTrim(Trim(Mid(ZFR_FontList()\FontName$, Len(ZFR_FontList()\MainFontName$) + 1)), "-")            If Variant$ = ""              Variant$ = GetTextFromCatalog("Normal")            EndIf            VariantList$ + Variant$ + ","            ZFR_FontList()\Variants$ = Variant$            If NextElement(ZFR_FontList()) = 0              MMainFontName$ = ""            EndIf          Wend          *LastFLE = @ZFR_FontList()          ChangeCurrentElement(ZFR_FontList(), *Main)          ZFR_FontList()\Variants$ = VariantList$          ChangeCurrentElement(ZFR_FontList(), *LastFLE)          If MMainFontName$            PreviousElement(ZFR_FontList())          EndIf        EndIf      Next    EndIf  EndIfEndProcedure;Procedure.s ZFR_GetFontInfosText()  ;  ; Role: Builds the multi-line technical summary (name, type, family, style, scripts, and  ;       DPI-independent typographic metrics) for the currently selected element in ZFR_FontList().  ;  Protected FontInfos$, tm.TEXTMETRIC  Protected lf.LOGFONT, hFont, hDC, oldFont  ;  FontInfos$ = GetTextFromCatalog("Name:") + " " + ZFR_FontList()\FontName$ + #CR$  FontInfos$ + GetTextFromCatalog("Type:") + " " + ZFR_GetFontTypeNameFromNum(ZFR_FontList()\FontType) + "  -  "  FontInfos$ + GetTextFromCatalog("Family:") + " " + ZFR_GetFontFamilyNameFromNum(ZFR_FontList()\PitchAndFamily) + "  -  "  FontInfos$ + GetTextFromCatalog("Style:") + " " + ZFR_FontList()\FontStyle$ + #CR$  FontInfos$ + GetTextFromCatalog("Script(s):") + " " + ZFR_FontList()\ScriptList$ + #CR$  ;  ; Measure metrics at a fixed 320-unit logical em-height (10x a 32-pt reference, independent of screen DPI):  lf\lfHeight  = -320  lf\lfCharSet = #DEFAULT_CHARSET  PokeS(@lf\lfFaceName[0], ZFR_FontList()\FontName$, #LF_FACESIZE - 1)  hFont = CreateFontIndirect_(@lf)  If hFont    hDC = GetDC_(0)    If hDC      oldFont = SelectObject_(hDC, hFont)      If oldFont        GetTextMetrics_(hDC, @tm)        SelectObject_(hDC, oldFont)      EndIf      ReleaseDC_(0, hDC)    EndIf    DeleteObject_(hFont)  EndIf  FontInfos$ + GetTextFromCatalog("Metrics:") + " Height=" + Str(Round(tm\tmHeight / 10.0, #PB_Round_Nearest))  FontInfos$ + ", Ascent=" + Str(Round(tm\tmAscent / 10.0, #PB_Round_Nearest))  FontInfos$ + ", Descent=" + Str(Round(tm\tmDescent / 10.0, #PB_Round_Nearest))  FontInfos$ + ", IntLeading=" + Str(Round(tm\tmInternalLeading / 10.0, #PB_Round_Nearest))  FontInfos$ + ", ExtLeading=" + Str(Round(tm\tmExternalLeading / 10.0, #PB_Round_Nearest))  FontInfos$ + ", Weight=" + Str(tm\tmWeight) + #CR$  ProcedureReturn FontInfos$EndProcedure;Procedure.s ZFR_RetrieveFontListElementFromGadgets(CFont, CBVariants, CFontOnly = #False, itemNumCFont = -1, itemNumCBVariants = -1)  ;  ; Role: Positions ZFR_FontList() on the entry matching the selected main family in 'CFont'  ;       (and the selected style variant in 'CBVariants' unless 'CFontOnly' is #True).  ; Output: Returns the full system face name of the matched ZFR_FontList() element.  ;  Protected *Main  Protected FontName$, Variant$, VariantTarget$, Found = 0  ;  If ListSize(ZFR_FontList()) = 0    ProcedureReturn ""  EndIf  If itemNumCFont = -1    itemNumCFont = GetGadgetState(CFont)  EndIf  If itemNumCBVariants = -1    itemNumCBVariants = GetGadgetState(CBVariants)  EndIf  ;  FontName$ = GetGadgetItemText(CFont, itemNumCFont)  If FontName$ <> ""    ForEach ZFR_FontList()      If ZFR_FontList()\MainFontName$ = FontName$        If CFontOnly          Found = 1        Else          VariantTarget$ = GetGadgetItemText(CBVariants, itemNumCBVariants)          *Main = @ZFR_FontList()          While ZFR_FontList()\MainFontName$ = FontName$            Variant$ = LTrim(Trim(Mid(ZFR_FontList()\FontName$, Len(FontName$) + 1)), "-")            If Variant$ = ""              Variant$ = GetTextFromCatalog("Normal")            EndIf            If Variant$ = VariantTarget$              Found = 1              Break            EndIf            If NextElement(ZFR_FontList()) = 0              Break            EndIf          Wend        EndIf        Break      EndIf    Next    If Found = 0 And *Main      ChangeCurrentElement(ZFR_FontList(), *Main)    EndIf  EndIf  ProcedureReturn ZFR_FontList()\FontName$EndProcedure;Procedure ZFR_ApplyFontToExample(CFont, CBVariants, SSize, CBBold, CBItalic, CBUnderline, CBStrikeOut, FontColor, TExample, TDetails, DetailsToggle, Reset = 0)  ;  ; Role: Synchronizes the Bold/Italic checkboxes with the intrinsic weight/slope of the selected  ;       font variant, updates the sample preview font and color, and refreshes technical details.  ;  Static mItalicState = -1, mBoldState = -1, TextFont  Protected FontStyle = 0, Size, NewFont  ;  If Reset    mItalicState = -1    mBoldState   = -1  EndIf  If ListSize(ZFR_FontList()) = 0    ProcedureReturn  EndIf  ;  ZFR_RetrieveFontListElementFromGadgets(CFont, CBVariants)  ;  If IsGadget(CBItalic)    If ZFR_FontList()\ntmFlags & #NTM_ITALIC      ; Selected variant is intrinsically italic: save user checkbox state once, then force checked & disabled      If mItalicState = -1        mItalicState = GetGadgetState(CBItalic)      EndIf      SetGadgetState(CBItalic, 1)      DisableGadget(CBItalic, #True)    Else      If mItalicState <> -1        SetGadgetState(CBItalic, mItalicState)        mItalicState = -1      EndIf      DisableGadget(CBItalic, #False)    EndIf  EndIf  ;  If IsGadget(CBBold)    If ZFR_FontList()\ntmFlags & #NTM_BOLD      ; Selected variant is intrinsically bold: save user checkbox state once, then force checked & disabled      If mBoldState = -1        mBoldState = GetGadgetState(CBBold)      EndIf      SetGadgetState(CBBold, 1)      DisableGadget(CBBold, #True)    Else      If mBoldState <> -1        SetGadgetState(CBBold, mBoldState)        mBoldState = -1      EndIf      DisableGadget(CBBold, #False)    EndIf  EndIf  ;  If IsGadget(CBBold) And GetGadgetState(CBBold)    FontStyle | #PB_Font_Bold  EndIf  If IsGadget(CBItalic) And GetGadgetState(CBItalic)    FontStyle | #PB_Font_Italic  EndIf  If IsGadget(CBUnderline) And GetGadgetState(CBUnderline)    FontStyle | #PB_Font_Underline  EndIf  If IsGadget(CBStrikeOut) And GetGadgetState(CBStrikeOut)    FontStyle | #PB_Font_StrikeOut  EndIf  ;  If IsGadget(SSize)    Size = Round(ValF(GetGadgetText(SSize)), #PB_Round_Nearest)  Else    Size = 10  EndIf  If Size <= 0    Size = 10  EndIf  ;  ; Assign the new font to TExample before freeing the previous one so the gadget never holds a deleted HFONT:  NewFont = LoadFont(#PB_Any, ZFR_FontList()\FontName$, Size, FontStyle)  If NewFont    SetGadgetFont(TExample, FontID(NewFont))    If IsFont(TextFont)      FreeFont(TextFont)    EndIf    TextFont = NewFont  EndIf  ;  If FontColor = #PB_Default    CompilerIf Defined(SetGadgetsColorsFromTheme, #PB_Procedure)      If ListSize(InterfaceColorPresets()) > 0        FontColor = GetRealColorFromType("TextColor", InterfaceColorPresets()\TextColor)      EndIf    CompilerElseIf Defined(ObjectTheme, #PB_Module)      FontColor = ObjectTheme::GetObjectThemeAttribute(#PB_GadgetType_Button, #PB_Gadget_FrontColor)    CompilerEndIf    If FontColor = #PB_Default      FontColor = 0    EndIf  EndIf  SetGadgetColor(TExample, #PB_Gadget_FrontColor, FontColor)  ;  If DetailsToggle    SetGadgetText(TDetails, ZFR_GetFontInfosText())  EndIfEndProcedure;Procedure ZFR_ParseFontDescription(FontDescription$, *FontName.String = 0, *FontSize.Float = 0, *FontColor.Integer = 0, *FontStyle.Integer = 0)  ;  ; Role: Normalizes 'FontDescription$' and extracts its name, point size, foreground color, and  ;       PureBasic numeric style flags into the non-null output pointers, applying defaults  ;       ("Segoe UI", size 9, color #PB_Default) when fields are omitted.  ;  Protected parameter$, FontName$ = "Segoe UI", FontSize.f = 9.0, FontColor = #PB_Default, Found  ;  FontDescription$ = NormalizeFontDescription(FontDescription$)  ;  parameter$ = FD_ExtractParameter(FontDescription$, "name", #True, @Found)  If Found And parameter$ <> "" And parameter$ <> "default"    FontName$ = parameter$  EndIf  ;  parameter$ = FD_ExtractParameter(FontDescription$, "size", #True, @Found)  If Found And parameter$ <> "" And parameter$ <> "default"    FontSize = ValF(parameter$)    If FontSize <= 0      FontSize = 9.0    EndIf  EndIf  ;  parameter$ = FD_ExtractParameter(FontDescription$, "forecolor", #True, @Found)  If Found And parameter$ <> "" And parameter$ <> "default"    FontColor = Val(parameter$)  EndIf  ;  If *FontName    *FontName\s = FontName$  EndIf  If *FontSize    *FontSize\f = FontSize  EndIf  If *FontColor    *FontColor\i = FontColor  EndIf  If *FontStyle    *FontStyle\i = GetNumStyleFromAttributesDescription(FontDescription$)  EndIfEndProcedure;Procedure ZFR_UpdateCBVariantsFromCFont(CFont, CBVariants)  ;  ; Role: Populates 'CBVariants' with the style variants available for the family selected in 'CFont'  ;       and disables 'CBVariants' when only a single variant exists.  ;  Protected Pos, Variant$, SelectedMain$  ;  SelectedMain$ = GetGadgetText(CFont)  ForEach ZFR_FontList()    If ZFR_FontList()\MainFontName$ = SelectedMain$      Break    EndIf  Next  ;  ClearGadgetItems(CBVariants)  If ListSize(ZFR_FontList()) > 0    Pos = 0    Repeat      Pos + 1      Variant$ = StringField(ZFR_FontList()\Variants$, Pos, ",")      If Variant$        AddGadgetItem(CBVariants, -1, Variant$)      EndIf    Until Variant$ = ""  EndIf  ;  SetGadgetState(CBVariants, 0)  DisableGadget(CBVariants, Bool(CountGadgetItems(CBVariants) < 2))  InvalidateRect_(GadgetID(CBVariants), 0, #True)EndProcedure;Global ZFR_CFont, ZFR_CBVariants;Import "gdi32.lib"  CompilerIf #PB_Compiler_Processor = #PB_Processor_x86    ZFR_GetGlyphIndices.l(hdc.i, lpstr.p-unicode, c.l, *pgi, fl.l) As "_GetGlyphIndicesW@20"  CompilerElse    ZFR_GetGlyphIndices.l(hdc.i, lpstr.p-unicode, c.l, *pgi, fl.l) As "GetGlyphIndicesW"  CompilerEndIfEndImport;Procedure ZFR_GetOptimalDisplaySize(hDC, *FontEntry.FontInfoStruct)  #ZFR_GGO_METRICS = 0  #ZFR_GGI_MARK_NONEXISTING = 1  Protected gmO.GLYPHMETRICS, gmE.GLYPHMETRICS, gmCapO.GLYPHMETRICS, gmChar.GLYPHMETRICS  Protected mat2.MAT2, tm.TEXTMETRIC, SampleSize.SIZE  Protected Dim GlyphIdx.u(2)  Protected ProbeText$  Protected ProbeFont, FinalFont, oldFont, ResO, ResE, ResCapO  Protected ct, CharLen, CharCode, HasBounds, MaxTop, MinBottom, CharTop, CharBottom  Protected InkHeight.f, ScaleH.f, ScaleW.f, MaxSpanScale.f, OptimalSize  ;  ; Role: Computes and caches in '*FontEntry' both the optimal point size ('DisplaySize') and  ;       the vertical centering offset from a row's midpoint ('DisplayYOffset') based on true  ;       glyph ink bounds rather than raw font cell metrics, while flagging symbol/dingbat fonts.  ;  If *FontEntry\DisplaySize > 0    ProcedureReturn *FontEntry\DisplaySize  EndIf  ;  OptimalSize = 10  ProbeFont = LoadFont(#PB_Any, *FontEntry\FontName$, 20, #PB_Font_HighQuality)  If ProbeFont    oldFont = SelectObject_(hDC, FontID(ProbeFont))    ;    ; Promote Unicode symbol/barcode/icon fonts lacking basic Latin glyphs to IsSymbolFont:    If *FontEntry\IsSymbolFont = #False      If ZFR_GetGlyphIndices(hDC, "Aeo", 3, @GlyphIdx(0), #ZFR_GGI_MARK_NONEXISTING) <> #GDI_ERROR        If GlyphIdx(0) = $FFFF Or GlyphIdx(1) = $FFFF Or GlyphIdx(2) = $FFFF          *FontEntry\IsSymbolFont = #True          SelectObject_(hDC, oldFont)          FreeFont(ProbeFont)          *FontEntry\DisplaySize    = 12          *FontEntry\DisplayYOffset = 0          ProcedureReturn 12        EndIf      EndIf    EndIf    ;    GetTextMetrics_(hDC, @tm)    GetTextExtentPoint32_(hDC, "Abcde", 5, @SampleSize)    ;    ; Identity matrix (1.0 in 16.16 fixed-point format) required by GetGlyphOutline_:    mat2\eM11\value = 1    mat2\eM22\value = 1    ResO    = GetGlyphOutline_(hDC, 'o', #ZFR_GGO_METRICS, @gmO, 0, #Null, @mat2)    ResE    = GetGlyphOutline_(hDC, 'e', #ZFR_GGO_METRICS, @gmE, 0, #Null, @mat2)    ResCapO = GetGlyphOutline_(hDC, 'O', #ZFR_GGO_METRICS, @gmCapO, 0, #Null, @mat2)    ;    If ResO <> #GDI_ERROR And ResE <> #GDI_ERROR And (gmO\gmBlackBoxY > 0 Or gmE\gmBlackBoxY > 0)      ; Isolate pure x-height from the smaller of 'o' and 'e' to ignore cursive loops:      If gmO\gmBlackBoxY > 0 And gmE\gmBlackBoxY > 0        If gmO\gmBlackBoxY < gmE\gmBlackBoxY          InkHeight = gmO\gmBlackBoxY        Else          InkHeight = gmE\gmBlackBoxY        EndIf      ElseIf gmO\gmBlackBoxY > 0        InkHeight = gmO\gmBlackBoxY      Else        InkHeight = gmE\gmBlackBoxY      EndIf      ; Distinguish all-caps / small-caps faces (target 9.5 logical px) from mixed-case faces (target 8.2 logical px):      If ResCapO <> #GDI_ERROR And gmCapO\gmBlackBoxY > 0 And InkHeight >= gmCapO\gmBlackBoxY * 0.85        ScaleH = (DesktopScaledY(95) / 10.0) / InkHeight      Else        ScaleH = (DesktopScaledY(82) / 10.0) / InkHeight      EndIf      ;      ; Clamp ScaleH so the tallest ascender/swash and deepest descender of the displayed name fit within 17 logical px:      ProbeText$ = *FontEntry\FontName$ + " Hgp"      CharLen    = Len(ProbeText$)      HasBounds  = #False      For ct = 1 To CharLen        CharCode = Asc(Mid(ProbeText$, ct, 1))        If CharCode > 32          If GetGlyphOutline_(hDC, CharCode, #ZFR_GGO_METRICS, @gmChar, 0, #Null, @mat2) <> #GDI_ERROR And gmChar\gmBlackBoxY > 0            CharTop    = gmChar\gmptGlyphOrigin\y            CharBottom = CharTop - gmChar\gmBlackBoxY            If HasBounds = #False              MaxTop    = CharTop              MinBottom = CharBottom              HasBounds = #True            Else              If CharTop > MaxTop       : MaxTop = CharTop       : EndIf              If CharBottom < MinBottom : MinBottom = CharBottom : EndIf            EndIf          EndIf        EndIf      Next      If HasBounds And (MaxTop - MinBottom) > 0        MaxSpanScale = (DesktopScaledY(170) / 10.0) / (MaxTop - MinBottom)        If ScaleH > MaxSpanScale          ScaleH = MaxSpanScale        EndIf      EndIf    Else      ; Fallback for legacy non-TrueType vector/raster fonts (such as Windows 'Script' or 'Modern'):      InkHeight = tm\tmAscent - tm\tmInternalLeading      If InkHeight <= 0        InkHeight = tm\tmHeight * 0.75      EndIf      If InkHeight > 0        ScaleH = (DesktopScaledY(120) / 10.0) / InkHeight      Else        ScaleH = 0.5      EndIf    EndIf    ;    SelectObject_(hDC, oldFont)    FreeFont(ProbeFont)    ;    ; Horizontal brake: restrain ultra-wide display faces (Goudy Stout, Broadway BT) whose 5-char sample exceeds 55 logical px:    If SampleSize\cx * ScaleH > DesktopScaledX(55) And SampleSize\cx > 0      ScaleW = DesktopScaledX(55) / SampleSize\cx      ScaleH = Sqr(ScaleH * ScaleW)    EndIf    ;    OptimalSize = Round(20.0 * ScaleH, #PB_Round_Nearest)    If OptimalSize < 6      OptimalSize = 6    ElseIf OptimalSize > 64      OptimalSize = 64    EndIf  EndIf  ;  ; Measure exact ink vertical midpoint at the final point size so ExtTextOut_ centers ink regardless of internal leading:  *FontEntry\DisplayYOffset = -DesktopScaledY(8)  FinalFont = LoadFont(#PB_Any, *FontEntry\FontName$, OptimalSize, #PB_Font_HighQuality)  If FinalFont    oldFont = SelectObject_(hDC, FontID(FinalFont))    GetTextMetrics_(hDC, @tm)    ProbeText$ = *FontEntry\FontName$ + " Normal"    CharLen    = Len(ProbeText$)    HasBounds  = #False    For ct = 1 To CharLen      CharCode = Asc(Mid(ProbeText$, ct, 1))      If CharCode > 32        If GetGlyphOutline_(hDC, CharCode, #ZFR_GGO_METRICS, @gmChar, 0, #Null, @mat2) <> #GDI_ERROR And gmChar\gmBlackBoxY > 0          CharTop    = gmChar\gmptGlyphOrigin\y          CharBottom = CharTop - gmChar\gmBlackBoxY          If HasBounds = #False            MaxTop    = CharTop            MinBottom = CharBottom            HasBounds = #True          Else            If CharTop > MaxTop       : MaxTop = CharTop       : EndIf            If CharBottom < MinBottom : MinBottom = CharBottom : EndIf          EndIf        EndIf      EndIf    Next    If HasBounds      *FontEntry\DisplayYOffset = Round((MaxTop + MinBottom) / 2.0, #PB_Round_Nearest) - tm\tmAscent    Else      *FontEntry\DisplayYOffset = -Round((tm\tmHeight + tm\tmInternalLeading) / 2.0, #PB_Round_Nearest)    EndIf    SelectObject_(hDC, oldFont)    FreeFont(FinalFont)  EndIf  ;  *FontEntry\DisplaySize = OptimalSize  ProcedureReturn OptimalSizeEndProcedure;Procedure ZFR_OwnerDrawCallback(hWnd, uMsg, wParam, lParam)  Protected *measureItem.MEASUREITEMSTRUCT  Protected *drawItem.DRAWITEMSTRUCT  Protected rc.RECT, rcBack.RECT, rcClip.RECT, DSize.SIZE  Protected Text$, FontName$  Protected ZFR_OldCallBack, CtlID, itemNum, ODTType, DrawingComboTitle, HighLight  Protected hDC, BackColor, TextColor, hBrush, Font, oldFont, Size, DrawY  ;  ; Role: Window subclassing callback owner-drawing 'ZFR_CFont' and 'ZFR_CBVariants' so each  ;       font or variant is previewed in its own typeface with optical sizing and ink centering.  ;  ZFR_OldCallBack = GetProp_(hWnd, "ZFR_OldCallBack")  ;  Select uMsg    Case #WM_NCDESTROY      If ZFR_OldCallBack And GetWindowLongPtr_(hWnd, #GWL_WNDPROC) = @ZFR_OwnerDrawCallback()        SetWindowLongPtr_(hWnd, #GWL_WNDPROC, ZFR_OldCallBack)      EndIf      RemoveProp_(hWnd, "ZFR_OldCallBack")      If ZFR_OldCallBack        ProcedureReturn CallWindowProc_(ZFR_OldCallBack, hWnd, uMsg, wParam, lParam)      EndIf      ProcedureReturn 0      ;    Case #WM_MEASUREITEM      If lParam        *measureItem = lParam        If *measureItem\CtlType = #ODT_COMBOBOX          *measureItem\itemHeight = DesktopScaledY(20)          ProcedureReturn #True        EndIf      EndIf      ;    Case #WM_DRAWITEM      If lParam        *drawItem = lParam        itemNum = *drawItem\itemID        If IsGadget(ZFR_CFont) And *drawItem\hwndItem = GadgetID(ZFR_CFont)          CtlID = ZFR_CFont        ElseIf IsGadget(ZFR_CBVariants) And *drawItem\hwndItem = GadgetID(ZFR_CBVariants)          CtlID = ZFR_CBVariants        Else          CtlID = #PB_Default        EndIf        ;        If CtlID <> #PB_Default And itemNum > -1          hDC     = *drawItem\hdc          rc      = *drawItem\rcItem          rcBack  = rc          rcClip  = rc          ODTType = *drawItem\CtlType          ;          If ODTType = #ODT_COMBOBOX And (rc\bottom - rc\top) < SendMessage_(*drawItem\hwndItem, #CB_GETITEMHEIGHT, 0, 0)            DrawingComboTitle = 1          EndIf          ;          ; Never highlight the closed ComboBox selection box itself:          If (*drawItem\itemState & #ODS_SELECTED) And (ODTType <> #ODT_COMBOBOX Or DrawingComboTitle = 0)            HighLight = 1          EndIf          ;          If HighLight            BackColor = GetSysColor_(#COLOR_HIGHLIGHT)            TextColor = GetSysColor_(#COLOR_HIGHLIGHTTEXT)          Else            BackColor = GetSysColor_(#COLOR_WINDOW)            TextColor = GetSysColor_(#COLOR_WINDOWTEXT)            If DrawingComboTitle = 0              ; Leave the closed ComboBox field background to SetGadgetColorEx when not painting dropdown items:              CompilerIf Defined(SetGadgetsColorsFromTheme, #PB_Procedure)                If ListSize(InterfaceColorPresets()) > 0                  BackColor = GetRealColorFromType("BackgroundColor", InterfaceColorPresets()\BackgroundColor)                  TextColor = GetRealColorFromType("TextColor", InterfaceColorPresets()\TextColor)                EndIf              CompilerElseIf Defined(ObjectTheme, #PB_Module)                BackColor = ObjectTheme::GetObjectThemeAttribute(0, #PB_Gadget_BackColor)                TextColor = ObjectTheme::GetObjectThemeAttribute(#PB_GadgetType_Button, #PB_Gadget_FrontColor)              CompilerEndIf            EndIf          EndIf          SetTextColor_(hDC, TextColor)          ;          If ODTType = #ODT_COMBOBOX            rcBack\left - 1 : rcBack\top - 1 : rcBack\right + 1 : rcBack\bottom + 1            SelectClipRgn_(hDC, 0)          EndIf          hBrush = CreateSolidBrush_(BackColor)          FillRect_(hDC, @rcBack, hBrush)          DeleteObject_(hBrush)          ;          rc\left + DesktopScaledX(2)          Text$ = GetGadgetItemText(CtlID, itemNum)          ;          If CtlID = ZFR_CFont            FontName$ = ZFR_RetrieveFontListElementFromGadgets(ZFR_CFont, ZFR_CBVariants, #True, itemNum, -1)          Else            FontName$ = ZFR_RetrieveFontListElementFromGadgets(ZFR_CFont, ZFR_CBVariants, #False, -1, itemNum)          EndIf          ;          If ZFR_FontList()\IsSymbolFont = #False            Size = ZFR_GetOptimalDisplaySize(hDC, @ZFR_FontList())          EndIf          ;          SetBkMode_(hDC, #TRANSPARENT)          If ZFR_FontList()\IsSymbolFont            ; Render symbol/dingbat names in Segoe UI, followed by a short glyph preview in the font itself:            Font = LoadFont(#PB_Any, "Segoe UI", 10, #PB_Font_HighQuality)            If Font              oldFont = SelectObject_(hDC, FontID(Font))              DrawText_(hDC, Text$, Len(Text$), @rc, #DT_LEFT | #DT_VCENTER | #DT_SINGLELINE)              If CtlID = ZFR_CFont                GetTextExtentPoint32_(hDC, Text$, Len(Text$), @DSize)                rc\left + DSize\cx + DesktopScaledX(8)                SelectObject_(hDC, oldFont)                FreeFont(Font)                Font = LoadFont(#PB_Any, FontName$, 12, #PB_Font_HighQuality)                If Font                  oldFont = SelectObject_(hDC, FontID(Font))                  DrawText_(hDC, "Aaz1", 4, @rc, #DT_LEFT | #DT_VCENTER | #DT_SINGLELINE)                EndIf              EndIf              If Font                SelectObject_(hDC, oldFont)                FreeFont(Font)              EndIf            EndIf          Else            ; Center glyph ink vertically inside rcClip using cached DisplayYOffset and clip strictly to row bounds:            Font = LoadFont(#PB_Any, FontName$, Size, #PB_Font_HighQuality)            If Font              oldFont = SelectObject_(hDC, FontID(Font))              DrawY   = (rc\top + rc\bottom) / 2 + ZFR_FontList()\DisplayYOffset              ExtTextOut_(hDC, rc\left, DrawY, #ETO_CLIPPED, @rcClip, Text$, Len(Text$), #Null)              SelectObject_(hDC, oldFont)              FreeFont(Font)            EndIf          EndIf          ProcedureReturn #True        EndIf      EndIf  EndSelect  ;  If ZFR_OldCallBack    ProcedureReturn CallWindowProc_(ZFR_OldCallBack, hWnd, uMsg, wParam, lParam)  EndIf  ProcedureReturn DefWindowProc_(hWnd, uMsg, wParam, lParam)EndProcedure;; ****************************************************************************;;-                4. Zapman FontRequester public functions;; ****************************************************************************;Procedure.s FontRequesterEx(FontDescription$, AvailableStyles = #ZFR_FontRequester_Default, *UserChoice.Integer = 0, ParentID = #PB_Default, XShiftOrPos = 0, YShiftOrPos = 0, ParentAnchor = #CWO_Center, WindowAnchor = #CWO_Center)  ;  ; Role: Displays a customizable font selection dialog as an alternative to PureBasic's native FontRequester().  ;  ; ------------------------- RETURNED VALUE --------------------------  ; • Returns a textual description of the selected font formatted as:  ;       "FontName, FontSize[, $HexColor][, Bold][, Italic][, StrikeOut][, Underline]"  ;   (or returns the original 'FontDescription$' unchanged if the user cancels).  ; • Pass the returned string to LoadFontFromDescription(FontDescription$) to create the PureBasic font.  ; • On return, you can also call ZapmanFontName(), ZapmanFontSize(), ZapmanFontColor(), or  ;   ZapmanFontStyle() to retrieve individual attributes of the chosen font.  ;  ; ------------------------------ NOTE -------------------------------  ; • Instead of calling this function, you can also call ZapmanFontRequester() using parameters  ;   compatible with PureBasic's native FontRequester() function.  ;  ; ------------------------ ENTRY PARAMETERS -------------------------  ; • FontDescription$ specifies the initial font displayed when the requester opens:  ;   FontName, Size, optional Color, and optional comma-separated Styles (Bold, Italic, Underline, StrikeOut).  ;   - Size can be written as 'Size(x)', 'Size:x', or a plain number.  ;   - Color can be written as 'Color(x)', 'Color:x', 'RGB(r,g,b)', or a decimal/hexadecimal number.  ;   Example: "Segoe UI, 9, Color:$FF0020, Italic"  ;  ; • AvailableStyles customizes the options presented to the user via a combination of flags:  ;   #PB_Font_Bold       Adds a 'Bold' CheckBox to the dialog  ;   #PB_Font_Italic     Adds an 'Italic' CheckBox to the dialog  ;   #PB_Font_StrikeOut  Adds a 'StrikeOut' CheckBox to the dialog  ;   #PB_Font_Underline  Adds an 'Underline' CheckBox to the dialog  ;   #ZFR_ChooseColor    Allows choosing or modifying the font color  ;   #ZFR_ShowSize       Allows choosing or modifying the font size  ;   #CF_NOVERTFONTS     Excludes vertical fonts (names starting with "@")  ;   #CF_FIXEDPITCHONLY  Lists monospace fonts only  ;   #ZFR_NORASTERFONTS  Excludes raster fonts  ;   #CF_TTONLY          Lists TrueType fonts only  ;   #CF_NOVECTORFONTS   Excludes OEM/vector fonts  ;   #CF_SCRIPTSONLY     Excludes OEM and Symbol fonts  ;   Predefined combinations:  ;   - #ZFR_FontRequester_Effects = #PB_Font_Bold | #PB_Font_Italic | #PB_Font_StrikeOut | #PB_Font_Underline | #ZFR_ChooseColor | #ZFR_ShowSize | #CF_NOVERTFONTS  ;   - #ZFR_FontRequester_Default = #PB_Font_Bold | #PB_Font_Italic | #ZFR_ShowSize | #CF_NOVERTFONTS  ;   (Passing -1 is equivalent to #ZFR_FontRequester_Effects.)  ;  ; • *UserChoice (optional): integer pointer receiving 1 if validated with OK, or 0 if cancelled.  ;  ; • ParentID, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor:  ;   - If ParentID is a valid PureBasic window number (or OS HWND), the dialog is positioned relative  ;     to it and shifted by XShiftOrPos and YShiftOrPos.  ;   - If ParentID = #PB_Default (or #CWO_ActiveWindowPos), GetActiveWindow() is used if valid,  ;     falling back to the main monitor otherwise.  ;   - If ParentID = #CWO_AbsolutePos, XShiftOrPos and YShiftOrPos define absolute screen coordinates.  ;   - If ParentID = #CWO_MonitorPos, positioning is relative to the active window's monitor.  ;   - ParentAnchor and WindowAnchor accept #CWO_Center, #CWO_TopLeft, #CWO_TopRight,  ;     #CWO_BottomLeft, or #CWO_BottomRight.  ;  Enumeration ZFR_KeyboardShortcuts    #ZFR_ArrowDownShortcut = 50000    #ZFR_ArrowUpShortcut    #ZFR_PlusShortcut    #ZFR_MinusShortcut    #ZFR_Escape_Cmd    #ZFR_Enter  EndEnumeration  ;  Protected ParsedName.String  Protected FontSize.f, FontColor, SwatchColor, NFontColor, FontStyle  Protected mFontDescription$ = FontDescription$, FontName$, Variant$, ItemText$, NextChar$, GadgetList$  Protected ParentWindow = #PB_Default, ActiveWindow, ParentWindowID, CFWindow, ZFR_OldCallBack  Protected ParentHasBeenDisabled = #False, DetailsToggle = 0, GetOut = 0  Protected WWidth, WHeight, Margins, Intergadget, LineHeight, NbStyles  Protected LegendWidth, FontListWidth, DetailsHeight, UsableHeight, VPos, HPos, HPos2, GWidth, CBWidth, CBPosLeft  Protected BCancelWidth, BDetailsWidth, BOKWidth  Protected SFont, TVariants, CBBold, CBItalic, CBUnderline, CBStrikeOut  Protected TSize, SSize, TColor, CanvasColor, FExample, TExample, TDetails, BDetails, BCancel, BOK  Protected TextFont, ct, ItemCount, mLen, NLen, ScrollTarget, PosInGadgetList, Gadget  Protected Event, EventGadget, ActiveGad, BVariantState, CFontState, CurSize, Found  ;  If AvailableStyles = -1    AvailableStyles = #ZFR_FontRequester_Effects  EndIf  ;  ; Resolve ParentID (accepts a PureBasic window number, an OS HWND, #PB_Default, or a #CWO_... mode):  If IsWindow(ParentID)    ParentWindow = ParentID  ElseIf ParentID > 0 And IsWindow_(ParentID)    ParentWindow = GetProp_(ParentID, "PB_WindowID") - 1    If Not IsWindow(ParentWindow)      ParentWindow = #CWO_ActiveWindowPos    EndIf  ElseIf ParentID = #PB_Default    If IsWindow(GetActiveWindow())      ParentWindow = GetActiveWindow()    Else      ParentWindow = #CWO_ActiveWindowPos    EndIf  Else    ParentWindow = ParentID  EndIf  ;  ZFR_ParseFontDescription(FontDescription$, @ParsedName, @FontSize, @FontColor, @FontStyle)  FontName$ = ParsedName\s  ;  ; Resolve the exact system face name substituted by Windows if FontName$ does not exist as-is:  TextFont = LoadFont(#PB_Any, FontName$, Round(FontSize, #PB_Round_Nearest), FontStyle)  If TextFont    FontName$ = GetFontName(TextFont)    FreeFont(TextFont)  EndIf  ;  ; Compute dialog height dynamically from the active option rows:  WWidth      = 480  WHeight     = 230  Margins     = 10  Intergadget = 7  LineHeight  = 22  NbStyles    = 0  If AvailableStyles & #PB_Font_Bold      : NbStyles + 1 : EndIf  If AvailableStyles & #PB_Font_Italic    : NbStyles + 1 : EndIf  If AvailableStyles & #PB_Font_StrikeOut : NbStyles + 1 : EndIf  If AvailableStyles & #PB_Font_Underline : NbStyles + 1 : EndIf  If AvailableStyles & #ZFR_ChooseColor   : NbStyles + 1 : EndIf  If AvailableStyles & #ZFR_ShowSize      : NbStyles + 1 : EndIf  WHeight + ((LineHeight + Intergadget) * (NbStyles - 1)) / 2  If WHeight < 240    WHeight = 240  EndIf  ;  ActiveWindow = ParentWindow  If Not IsWindow(ActiveWindow)    ActiveWindow = GetActiveWindow()  EndIf  ;  ParentWindowID = ComputeWinOrigins(@HPos, @VPos, WWidth, WHeight, ParentWindow, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor)  CFWindow = OpenWindow(#PB_Any, HPos, VPos, WWidth, WHeight, GetTextFromCatalog("ChooseAFont"), #PB_Window_SystemMenu | #PB_Window_Invisible, ParentWindowID)  If CFWindow    If IsWindow(ActiveWindow) And IsWindowEnabled_(WindowID(ActiveWindow))      DisableWindow(ActiveWindow, #True)      ParentHasBeenDisabled = #True    EndIf    ;    ; Subclass CFWindow to owner-draw ZFR_CFont and ZFR_CBVariants:    ZFR_OldCallBack = SetWindowLongPtr_(WindowID(CFWindow), #GWL_WNDPROC, @ZFR_OwnerDrawCallback())    SetProp_(WindowID(CFWindow), "ZFR_OldCallBack", ZFR_OldCallBack)    ;    CompilerIf Defined(ApplyDarkModeToWindow, #PB_Procedure)      ApplyDarkModeToWindow(CFWindow)    CompilerEndIf    StickyWindow(CFWindow, #True)    ;    ; Create dialog gadgets:    LegendWidth   = 65    FontListWidth = 200    DetailsHeight = 90    UsableHeight  = WindowHeight(CFWindow) - Margins * 2    ;    SFont = StringGadget(#PB_Any, Margins, Margins, FontListWidth, LineHeight, "")    GadgetList$ = Str(SFont) + ","    ;    ZFR_CFont = ListViewGadget(#PB_Any, Margins, Margins + LineHeight + Intergadget, FontListWidth, UsableHeight - LineHeight - Intergadget - 1, #LBS_OWNERDRAWFIXED)    SendMessage_(GadgetID(ZFR_CFont), #LB_SETITEMHEIGHT, 0, DesktopScaledY(20))    GadgetList$ + Str(ZFR_CFont) + ","    ;    VPos      = Margins    HPos      = Margins + FontListWidth + Margins    HPos2     = HPos    TVariants = TextGadget(#PB_Any, HPos, VPos + 2, LegendWidth, LineHeight, GetTextFromCatalog("Variants:"), #PB_Text_Right)    GadgetList$ + Str(TVariants) + ","    ;    HPos + LegendWidth + Intergadget    GWidth         = WindowWidth(CFWindow) - Margins - HPos    ZFR_CBVariants = ComboBoxGadget(#PB_Any, HPos, VPos, GWidth, LineHeight, #CBS_OWNERDRAWFIXED | #CBS_HASSTRINGS)    GadgetList$ + Str(ZFR_CBVariants) + ","    ;    CBWidth   = 90    CBPosLeft = HPos    VPos + LineHeight + 3    HPos      = CBPosLeft    ;    If AvailableStyles & #PB_Font_Bold      CBBold = CheckBoxGadget(#PB_Any, HPos, VPos, CBWidth, LineHeight, GetTextFromCatalog("Bold"))      GadgetList$ + Str(CBBold) + ","      If FontStyle & #PB_Font_Bold        SetGadgetState(CBBold, #True)      EndIf      If HPos = CBPosLeft : HPos + CBWidth : Else : HPos = CBPosLeft : VPos + LineHeight - 2 : EndIf    Else      FontStyle & ~#PB_Font_Bold    EndIf    ;    If AvailableStyles & #PB_Font_Italic      CBItalic = CheckBoxGadget(#PB_Any, HPos, VPos, CBWidth, LineHeight, GetTextFromCatalog("Italic"))      GadgetList$ + Str(CBItalic) + ","      If FontStyle & #PB_Font_Italic        SetGadgetState(CBItalic, #True)      EndIf      If HPos = CBPosLeft : HPos + CBWidth : Else : HPos = CBPosLeft : VPos + LineHeight - 2 : EndIf    Else      FontStyle & ~#PB_Font_Italic    EndIf    ;    If AvailableStyles & #PB_Font_Underline      CBUnderline = CheckBoxGadget(#PB_Any, HPos, VPos, CBWidth, LineHeight, GetTextFromCatalog("Underline"))      GadgetList$ + Str(CBUnderline) + ","      If FontStyle & #PB_Font_Underline        SetGadgetState(CBUnderline, #True)      EndIf      If HPos = CBPosLeft : HPos + CBWidth : Else : HPos = CBPosLeft : VPos + LineHeight - 2 : EndIf    Else      FontStyle & ~#PB_Font_Underline    EndIf    ;    If AvailableStyles & #PB_Font_StrikeOut      CBStrikeOut = CheckBoxGadget(#PB_Any, HPos, VPos, CBWidth, LineHeight, GetTextFromCatalog("StrikeOut"))      GadgetList$ + Str(CBStrikeOut) + ","      If FontStyle & #PB_Font_StrikeOut        SetGadgetState(CBStrikeOut, #True)      EndIf      If HPos = CBPosLeft : HPos + CBWidth : Else : HPos = CBPosLeft : VPos + LineHeight - 2 : EndIf    Else      FontStyle & ~#PB_Font_StrikeOut    EndIf    ;    If HPos <> CBPosLeft      VPos + LineHeight - 2    EndIf    HPos = HPos2    VPos + 5    ;    If AvailableStyles & #ZFR_ShowSize      TSize = TextGadget(#PB_Any, HPos, VPos + 2, LegendWidth, LineHeight, GetTextFromCatalog("Size:"), #PB_Text_Right)      GadgetList$ + Str(TSize) + ","      HPos + LegendWidth + Intergadget      SSize = SpinGadget(#PB_Any, HPos, VPos, 45, LineHeight, 1, 500, #PB_Spin_Numeric)      SetWindowLongPtr_(GadgetID(SSize), #GWL_STYLE, GetWindowLongPtr_(GadgetID(SSize), #GWL_STYLE) | #ES_NUMBER)      GadgetList$ + Str(SSize) + ","      CurSize = Round(FontSize, #PB_Round_Nearest)      If CurSize < 1 : CurSize = 1 : ElseIf CurSize > 500 : CurSize = 500 : EndIf      SetGadgetState(SSize, CurSize)      HPos + 45    EndIf    ;    ; Resolve initial swatch color when no explicit color was provided in FontDescription$:    SwatchColor = FontColor    If SwatchColor = #PB_Default      CompilerIf Defined(SetGadgetsColorsFromTheme, #PB_Procedure)        If ListSize(InterfaceColorPresets()) > 0          SwatchColor = GetRealColorFromType("TextColor", InterfaceColorPresets()\TextColor)        EndIf      CompilerElseIf Defined(ObjectTheme, #PB_Module)        SwatchColor = ObjectTheme::GetObjectThemeAttribute(#PB_GadgetType_Button, #PB_Gadget_FrontColor)      CompilerEndIf      If SwatchColor = #PB_Default        SwatchColor = 0      EndIf    EndIf    ;    If AvailableStyles & #ZFR_ChooseColor      TColor = TextGadget(#PB_Any, HPos, VPos + 2, LegendWidth, LineHeight, GetTextFromCatalog("Color:"), #PB_Text_Right)      GadgetList$ + Str(TColor) + ","      HPos + LegendWidth + Intergadget      CanvasColor = CanvasGadget(#PB_Any, HPos, VPos, LineHeight, LineHeight, #PB_Canvas_Border)      GadgetList$ + Str(CanvasColor) + ","      If StartDrawing(CanvasOutput(CanvasColor))        Box(0, 0, OutputWidth(), OutputHeight(), SwatchColor)        StopDrawing()      EndIf    Else      FontColor = #PB_Default    EndIf    ;    HPos = HPos2    If (AvailableStyles & #ZFR_ShowSize) Or (AvailableStyles & #ZFR_ChooseColor)      VPos + LineHeight + Margins + Intergadget    Else      VPos + 3    EndIf    FExample = FrameGadget(#PB_Any, HPos, VPos - Margins, WindowWidth(CFWindow) - Margins - HPos, UsableHeight + 2 * Margins - LineHeight - Intergadget - VPos, GetTextFromCatalog("Sample"))    GadgetList$ + Str(FExample) + ","    TExample = TextGadget(#PB_Any, HPos + Margins, VPos + Margins, WindowWidth(CFWindow) - 3 * Margins - HPos, UsableHeight - 3 - LineHeight - Intergadget - VPos, GetTextFromCatalog("CAFDemoText"), #PB_Text_Center)    ;    VPos     = UsableHeight + Margins - LineHeight    TDetails = TextGadget(#PB_Any, Margins, VPos, WindowWidth(CFWindow) - 2 * Margins, DetailsHeight, "")    GadgetList$ + Str(TDetails) + ","    HideGadget(TDetails, #True)    ;    HPos          = HPos2    BDetailsWidth = 100    BCancelWidth  = 75    BOKWidth      = 60    BDetails      = ButtonGadget(#PB_Any, HPos, VPos, BDetailsWidth, LineHeight, GetTextFromCatalog("DetailsDwn"))    GadgetList$ + Str(BDetails) + ","    HPos + BDetailsWidth + Intergadget    BCancel       = ButtonGadget(#PB_Any, HPos, VPos, BCancelWidth, LineHeight, GetTextFromCatalog("Cancel"))    GadgetList$ + Str(BCancel) + ","    BOK           = ButtonGadget(#PB_Any, WindowWidth(CFWindow) - Margins - BOKWidth, VPos, BOKWidth, LineHeight, GetTextFromCatalog("OK"), #PB_Button_Default)    GadgetList$ + Str(BOK) + ","    ;    ; Populate ZFR_CFont with matching system fonts:    ZFR_ListFonts(CFWindow, ZFR_CFont, AvailableStyles)    ItemCount = CountGadgetItems(ZFR_CFont)    If ItemCount = 0      CloseWindow(CFWindow)      If ParentHasBeenDisabled And IsWindow(ActiveWindow)        DisableWindow(ActiveWindow, #False)      EndIf      If *UserChoice        *UserChoice\i = 0      EndIf      ProcedureReturn mFontDescription$    EndIf    ;    ; Select the longest matching main font family name (bounded at word/hyphen boundary):    mLen  = 0    Found = 0    For ct = 0 To ItemCount - 1      ItemText$ = GetGadgetItemText(ZFR_CFont, ct)      NLen      = Len(ItemText$)      If NLen > mLen And LCase(ItemText$) = LCase(Left(FontName$, NLen))        NextChar$ = Mid(FontName$, NLen + 1, 1)        If NextChar$ = "" Or NextChar$ = " " Or NextChar$ = "-"          mLen  = NLen          Found = ct        EndIf      EndIf    Next    ScrollTarget = Found + 5    If ScrollTarget >= ItemCount : ScrollTarget = ItemCount - 1 : EndIf    SetGadgetState(ZFR_CFont, ScrollTarget)    SetGadgetState(ZFR_CFont, Found)    ;    SetGadgetText(SFont, GetGadgetText(ZFR_CFont))    ZFR_UpdateCBVariantsFromCFont(ZFR_CFont, ZFR_CBVariants)    ;    Variant$ = LTrim(Trim(Mid(FontName$, Len(GetGadgetText(ZFR_CFont)) + 1)), "-")    If Variant$ = ""      Variant$ = GetTextFromCatalog("Normal")    EndIf    For ct = 0 To CountGadgetItems(ZFR_CBVariants) - 1      If LCase(Variant$) = LCase(GetGadgetItemText(ZFR_CBVariants, ct))        SetGadgetState(ZFR_CBVariants, ct)        Break      EndIf    Next    ;    ; Apply the shared UI font across all control gadgets (excluding TExample):    PosInGadgetList = 1    ItemText$ = StringField(GadgetList$, PosInGadgetList, ",")    While ItemText$ <> ""      Gadget = Val(ItemText$)      If IsGadget(Gadget)        SetGadgetFont(Gadget, PBBAllGadgetsFont)      EndIf      PosInGadgetList + 1      ItemText$ = StringField(GadgetList$, PosInGadgetList, ",")    Wend    ;    CompilerIf Defined(SetGadgetsColorsFromTheme, #PB_Procedure)      ; Apply active theme colors when 'ApplyColorThemes.pbi' is included before this library:      If ListSize(InterfaceColorPresets()) > 0        GadgetList$ + Str(TExample) + ","        SetGadgetsColorsFromTheme(CFWindow, InterfaceColorPresets(), GadgetList$)      EndIf    CompilerEndIf    ;    ZFR_ApplyFontToExample(ZFR_CFont, ZFR_CBVariants, SSize, CBBold, CBItalic, CBUnderline, CBStrikeOut, FontColor, TExample, TDetails, DetailsToggle, #True)    ;    AddKeyboardShortcut(CFWindow, #PB_Shortcut_Down,   #ZFR_ArrowDownShortcut)    AddKeyboardShortcut(CFWindow, #PB_Shortcut_Up,     #ZFR_ArrowUpShortcut)    If IsGadget(SSize)      AddKeyboardShortcut(CFWindow, #PB_Shortcut_Add,      #ZFR_PlusShortcut)      AddKeyboardShortcut(CFWindow, #PB_Shortcut_Subtract, #ZFR_MinusShortcut)    EndIf    AddKeyboardShortcut(CFWindow, #PB_Shortcut_Escape, #ZFR_Escape_Cmd)    AddKeyboardShortcut(CFWindow, #PB_Shortcut_Return, #ZFR_Enter)    ;    HideWindow(CFWindow, #False)    SetActiveGadget(SFont)    SendMessage_(GadgetID(SFont), #EM_SETSEL, 0, -1)    ;    ; Modal event loop:    Repeat      Event = WaitWindowEvent()      If EventWindow() <> CFWindow        If Event = #PB_Event_ActivateWindow Or Event = #PB_Event_LeftClick          SetActiveWindow(CFWindow)        EndIf        Continue      EndIf      ;      EventGadget = EventGadget()      If Event = #PB_Event_Menu        ActiveGad = GetActiveGadget()        Select EventMenu()          Case #ZFR_ArrowDownShortcut, #ZFR_ArrowUpShortcut            If IsGadget(SSize) And ActiveGad = SSize              Event = #PB_Event_Gadget              If EventMenu() = #ZFR_ArrowUpShortcut                EventGadget = #ZFR_PlusShortcut              Else                EventGadget = #ZFR_MinusShortcut              EndIf            ElseIf ActiveGad = ZFR_CBVariants              BVariantState = GetGadgetState(ZFR_CBVariants)              If EventMenu() = #ZFR_ArrowUpShortcut And BVariantState > 0                SetGadgetState(ZFR_CBVariants, BVariantState - 1)                ZFR_ApplyFontToExample(ZFR_CFont, ZFR_CBVariants, SSize, CBBold, CBItalic, CBUnderline, CBStrikeOut, FontColor, TExample, TDetails, DetailsToggle)              ElseIf EventMenu() = #ZFR_ArrowDownShortcut And BVariantState < CountGadgetItems(ZFR_CBVariants) - 1                SetGadgetState(ZFR_CBVariants, BVariantState + 1)                ZFR_ApplyFontToExample(ZFR_CFont, ZFR_CBVariants, SSize, CBBold, CBItalic, CBUnderline, CBStrikeOut, FontColor, TExample, TDetails, DetailsToggle)              EndIf            Else              If ActiveGad <> ZFR_CFont                SetActiveGadget(ZFR_CFont)              EndIf              CFontState = GetGadgetState(ZFR_CFont)              If EventMenu() = #ZFR_ArrowDownShortcut And CFontState < ItemCount - 1                SetGadgetState(ZFR_CFont, CFontState + 1)              ElseIf EventMenu() = #ZFR_ArrowUpShortcut And CFontState > 0                SetGadgetState(ZFR_CFont, CFontState - 1)              EndIf              ZFR_UpdateCBVariantsFromCFont(ZFR_CFont, ZFR_CBVariants)              SetGadgetText(SFont, GetGadgetText(ZFR_CFont))              ZFR_ApplyFontToExample(ZFR_CFont, ZFR_CBVariants, SSize, CBBold, CBItalic, CBUnderline, CBStrikeOut, FontColor, TExample, TDetails, DetailsToggle)            EndIf          Case #ZFR_PlusShortcut            Event       = #PB_Event_Gadget            EventGadget = #ZFR_PlusShortcut          Case #ZFR_MinusShortcut            Event       = #PB_Event_Gadget            EventGadget = #ZFR_MinusShortcut          Case #ZFR_Escape_Cmd            Event       = #PB_Event_Gadget            EventGadget = BCancel          Case #ZFR_Enter            If ActiveGad = ZFR_CBVariants              ; Confirm the current ComboBox variant and close its dropdown list:              SendMessage_(GadgetID(ZFR_CBVariants), #CB_SHOWDROPDOWN, #False, 0)            Else              Event       = #PB_Event_Gadget              EventGadget = BOK            EndIf        EndSelect      EndIf      ;      Select Event        Case #PB_Event_Gadget          Select EventGadget            Case BDetails              If DetailsToggle = 0                DetailsToggle = 1                SetGadgetText(BDetails, GetTextFromCatalog("DetailsUp"))                ResizeWindow(CFWindow, #PB_Ignore, #PB_Ignore, #PB_Ignore, WindowHeight(CFWindow) + DetailsHeight)                ResizeGadget(ZFR_CFont, #PB_Ignore, #PB_Ignore, #PB_Ignore, GadgetHeight(ZFR_CFont) - LineHeight - Intergadget)                HideGadget(TDetails, #False)                ZFR_ApplyFontToExample(ZFR_CFont, ZFR_CBVariants, SSize, CBBold, CBItalic, CBUnderline, CBStrikeOut, FontColor, TExample, TDetails, DetailsToggle)                ; Keep the selected font visible inside the shortened list:                CFontState   = GetGadgetState(ZFR_CFont)                ScrollTarget = CFontState + 5                If ScrollTarget >= ItemCount : ScrollTarget = ItemCount - 1 : EndIf                SetGadgetState(ZFR_CFont, ScrollTarget)                SetGadgetState(ZFR_CFont, CFontState)              Else                DetailsToggle = 0                SetGadgetText(BDetails, GetTextFromCatalog("DetailsDwn"))                ResizeWindow(CFWindow, #PB_Ignore, #PB_Ignore, #PB_Ignore, WindowHeight(CFWindow) - DetailsHeight)                ResizeGadget(ZFR_CFont, #PB_Ignore, #PB_Ignore, #PB_Ignore, GadgetHeight(ZFR_CFont) + LineHeight + Intergadget)                HideGadget(TDetails, #True)              EndIf              VPos = WindowHeight(CFWindow) - Margins - LineHeight              ResizeGadget(BDetails, #PB_Ignore, VPos, #PB_Ignore, #PB_Ignore)              ResizeGadget(BCancel,  #PB_Ignore, VPos, #PB_Ignore, #PB_Ignore)              ResizeGadget(BOK,      #PB_Ignore, VPos, #PB_Ignore, #PB_Ignore)              ;            Case SFont              If EventType() = #PB_EventType_Change                FontName$ = LCase(GetGadgetText(SFont))                Found     = -1                For ct = 0 To ItemCount - 1                  If LCase(Left(GetGadgetItemText(ZFR_CFont, ct), Len(FontName$))) = FontName$                    Found        = ct                    ScrollTarget = ct + 5                    If ScrollTarget >= ItemCount : ScrollTarget = ItemCount - 1 : EndIf                    SetGadgetState(ZFR_CFont, ScrollTarget)                    SetGadgetState(ZFR_CFont, ct)                    ZFR_UpdateCBVariantsFromCFont(ZFR_CFont, ZFR_CBVariants)                    ZFR_ApplyFontToExample(ZFR_CFont, ZFR_CBVariants, SSize, CBBold, CBItalic, CBUnderline, CBStrikeOut, FontColor, TExample, TDetails, DetailsToggle)                    Break                  EndIf                Next                If Found = -1                  ; Reject the unmatched trailing character and keep the caret at the end:                  SetGadgetText(SFont, Left(GetGadgetText(SFont), Len(FontName$) - 1))                  SendMessage_(GadgetID(SFont), #EM_SETSEL, Len(FontName$) - 1, Len(FontName$) - 1)                EndIf              ElseIf EventType() = #PB_EventType_Focus                SendMessage_(GadgetID(SFont), #EM_SETSEL, 0, -1)              EndIf              ;            Case ZFR_CFont, SSize, ZFR_CBVariants, CBBold, CBItalic, CBUnderline, CBStrikeOut, #ZFR_PlusShortcut, #ZFR_MinusShortcut              If IsGadget(SSize)                If EventGadget = #ZFR_PlusShortcut                  CurSize = Round(ValF(GetGadgetText(SSize)), #PB_Round_Nearest) + 1                  If CurSize > 500 : CurSize = 500 : EndIf                  SetGadgetState(SSize, CurSize)                ElseIf EventGadget = #ZFR_MinusShortcut                  CurSize = Round(ValF(GetGadgetText(SSize)), #PB_Round_Nearest) - 1                  If CurSize < 1 : CurSize = 1 : EndIf                  SetGadgetState(SSize, CurSize)                EndIf              EndIf              If EventGadget = ZFR_CFont                ZFR_UpdateCBVariantsFromCFont(ZFR_CFont, ZFR_CBVariants)                SetGadgetText(SFont, GetGadgetText(ZFR_CFont))              EndIf              ZFR_ApplyFontToExample(ZFR_CFont, ZFR_CBVariants, SSize, CBBold, CBItalic, CBUnderline, CBStrikeOut, FontColor, TExample, TDetails, DetailsToggle)              ;            Case CanvasColor              If EventType() = #PB_EventType_LeftButtonDown                CompilerIf Defined(ZapmanColorRequester, #PB_Procedure)                  NFontColor = ZapmanColorRequester(SwatchColor, WindowID(CFWindow))                CompilerElse                  NFontColor = ColorRequester(SwatchColor, WindowID(CFWindow))                CompilerEndIf                If NFontColor <> -1                  FontColor   = NFontColor                  SwatchColor = NFontColor                  If StartDrawing(CanvasOutput(CanvasColor))                    Box(0, 0, OutputWidth(), OutputHeight(), SwatchColor)                    StopDrawing()                  EndIf                  ZFR_ApplyFontToExample(ZFR_CFont, ZFR_CBVariants, SSize, CBBold, CBItalic, CBUnderline, CBStrikeOut, FontColor, TExample, TDetails, DetailsToggle)                EndIf              EndIf              ;            Case BCancel              GetOut = -1            Case BOK              GetOut = 1          EndSelect          ;        Case #PB_Event_CloseWindow          GetOut = -1      EndSelect    Until GetOut <> 0    ;    If GetOut = 1      ZFR_RetrieveFontListElementFromGadgets(ZFR_CFont, ZFR_CBVariants)      FontDescription$ = ZFR_FontList()\FontName$      If IsGadget(SSize)        FontDescription$ + ", " + GetGadgetText(SSize)      EndIf      If (AvailableStyles & #ZFR_ChooseColor) And FontColor <> #PB_Default        FontDescription$ + ", $" + Hex(FontColor)      EndIf      If IsGadget(CBBold) And GetGadgetState(CBBold) And IsWindowEnabled_(GadgetID(CBBold))        FontDescription$ + ", Bold"      EndIf      If IsGadget(CBItalic) And GetGadgetState(CBItalic) And IsWindowEnabled_(GadgetID(CBItalic))        FontDescription$ + ", Italic"      EndIf      If IsGadget(CBStrikeOut) And GetGadgetState(CBStrikeOut) And IsWindowEnabled_(GadgetID(CBStrikeOut))        FontDescription$ + ", StrikeOut"      EndIf      If IsGadget(CBUnderline) And GetGadgetState(CBUnderline) And IsWindowEnabled_(GadgetID(CBUnderline))        FontDescription$ + ", Underline"      EndIf    Else      GetOut = 0      FontDescription$ = mFontDescription$    EndIf    ;    CloseWindow(CFWindow)  EndIf  ;  ClearList(ZFR_FontList())  If *UserChoice    *UserChoice\i = GetOut  EndIf  If ParentHasBeenDisabled And IsWindow(ActiveWindow)    DisableWindow(ActiveWindow, #False)  EndIf  ;  ; Store the resulting description for ZapmanFontName(), ZapmanFontSize(), ZapmanFontColor(), and ZapmanFontStyle():  ZFR_FontDescription$ = FontDescription$  ProcedureReturn FontDescription$EndProcedure;Procedure ZapmanFontRequester(FontName$, FontSize, Options = 0, FontColor = 0, FontStyle = 0, ParentID = #PB_Default, XShiftOrPos = 0, YShiftOrPos = 0, ParentAnchor = #CWO_Center, WindowAnchor = #CWO_Center)  ;  ; Role: Drop-in replacement for PureBasic's native FontRequester() function, accepting  ;       compatible parameters while supporting custom positioning and theme integration.  ;  ; ------------------------- RETURNED VALUE --------------------------  ; • Returns 1 if the user confirmed with OK, or 0 if the dialog was cancelled.  ; • When the return value is non-zero, call ZapmanFontName(), ZapmanFontSize(),  ;   ZapmanFontColor(), and ZapmanFontStyle() instead of SelectedFontName(),  ;   SelectedFontSize(), SelectedFontColor(), and SelectedFontStyle() to retrieve  ;   the attributes chosen by the user.  ;  ; ------------------------------ NOTE -------------------------------  ; • You can also call FontRequesterEx() directly to work with single-string font descriptions.  ;  ; ------------------------ ENTRY PARAMETERS -------------------------  ; • FontName$ specifies the default font family selected when the dialog opens.  ; • FontSize specifies the default point size displayed in the dialog.  ; • Options customizes the controls and font filters active in the dialog via a combination of:  ;   #PB_Font_Bold       Adds a 'Bold' CheckBox to the dialog  ;   #PB_Font_Italic     Adds an 'Italic' CheckBox to the dialog  ;   #PB_Font_StrikeOut  Adds a 'StrikeOut' CheckBox to the dialog  ;   #PB_Font_Underline  Adds an 'Underline' CheckBox to the dialog  ;   #ZFR_ChooseColor    Allows choosing or modifying the font color  ;   #ZFR_ShowSize       Allows choosing or modifying the font size  ;   #CF_NOVERTFONTS     Excludes vertical fonts (names starting with "@")  ;   #CF_FIXEDPITCHONLY  Lists monospace fonts only  ;   #ZFR_NORASTERFONTS  Excludes raster fonts  ;   #CF_TTONLY          Lists TrueType fonts only  ;   #CF_NOVECTORFONTS   Excludes OEM/vector fonts  ;   #CF_SCRIPTSONLY     Excludes OEM and Symbol fonts  ;   Predefined combinations:  ;   - #ZFR_FontRequester_Default = #PB_Font_Bold | #PB_Font_Italic | #ZFR_ShowSize | #CF_NOVERTFONTS  ;   - #PB_FontRequester_Effects  = #PB_Font_Bold | #PB_Font_Italic | #PB_Font_StrikeOut | #PB_Font_Underline | #ZFR_ChooseColor | #ZFR_ShowSize  ;   - #ZFR_FontRequester_Effects = #PB_FontRequester_Effects | #CF_NOVERTFONTS  ;  ; • FontColor specifies the initial font color (modifiable by the user when #ZFR_ChooseColor  ;   or #PB_FontRequester_Effects is set in 'Options').  ; • FontStyle specifies the initial style flags (#PB_Font_Bold, #PB_Font_Italic,  ;   #PB_Font_StrikeOut, #PB_Font_Underline).  ; • ParentID, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor control dialog placement  ;   relative to a parent window, active window, monitor, or absolute screen coordinates  ;   (see ComputeWinOrigins() and FontRequesterEx() for full details).  ;  Protected AvailableStyles, UserChoice  Protected FontDescription$, Attributes$  ;  If Options = 0    AvailableStyles = #ZFR_FontRequester_Default  ElseIf Options & #PB_FontRequester_Effects    ; Expand #PB_FontRequester_Effects while preserving any additional #CF_... filter flags passed in Options:    AvailableStyles = (Options & ~#PB_FontRequester_Effects) | #PB_Font_Bold | #PB_Font_Italic | #PB_Font_StrikeOut | #PB_Font_Underline | #ZFR_ChooseColor | #ZFR_ShowSize  Else    AvailableStyles = Options  EndIf  ;  FontDescription$ = FontName$ + ", " + Str(FontSize)  If AvailableStyles & #ZFR_ChooseColor    FontDescription$ + ", ForeColor:$" + Hex(FontColor)  EndIf  Attributes$ = GetAttributesDescriptionFromNumStyle(FontStyle)  If Attributes$ <> ""    FontDescription$ + ", " + Attributes$  EndIf  ;  FontRequesterEx(FontDescription$, AvailableStyles, @UserChoice, ParentID, XShiftOrPos, YShiftOrPos, ParentAnchor, WindowAnchor)  ProcedureReturn UserChoiceEndProcedure;Procedure.s ZapmanFontName(FontDescription$ = "")  ;  ; Role: Returns the font family name from 'FontDescription$' (or from the last ZapmanFontRequester()  ;       / FontRequesterEx() call when omitted, replacing PureBasic's SelectedFontName()).  ;  Protected ParsedName.String  ;  If FontDescription$ = ""    FontDescription$ = ZFR_FontDescription$  EndIf  ZFR_ParseFontDescription(FontDescription$, @ParsedName)  ProcedureReturn ParsedName\sEndProcedure;Procedure ZapmanFontSize(FontDescription$ = "")  ;  ; Role: Returns the integer point size from 'FontDescription$' (or from the last ZapmanFontRequester()  ;       / FontRequesterEx() call when omitted, replacing PureBasic's SelectedFontSize()).  ;  Protected FontSize.f  ;  If FontDescription$ = ""    FontDescription$ = ZFR_FontDescription$  EndIf  ZFR_ParseFontDescription(FontDescription$, 0, @FontSize)  ProcedureReturn Round(FontSize, #PB_Round_Nearest)EndProcedure;Procedure ZapmanFontColor(FontDescription$ = "")  ;  ; Role: Returns the RGB font color from 'FontDescription$', or #PB_Default (-1) if none was set  ;       (uses the last ZapmanFontRequester() / FontRequesterEx() result when omitted, replacing SelectedFontColor()).  ;  Protected FontColor  ;  If FontDescription$ = ""    FontDescription$ = ZFR_FontDescription$  EndIf  ZFR_ParseFontDescription(FontDescription$, 0, 0, @FontColor)  ProcedureReturn FontColorEndProcedure;Procedure ZapmanFontStyle(FontDescription$ = "")  ;  ; Role: Returns the PureBasic style bitmask (#PB_Font_Bold, #PB_Font_Italic, etc.) from 'FontDescription$'  ;       (or from the last ZapmanFontRequester() / FontRequesterEx() call when omitted, replacing SelectedFontStyle()).  ;  Protected FontStyle  ;  If FontDescription$ = ""    FontDescription$ = ZFR_FontDescription$  EndIf  ZFR_ParseFontDescription(FontDescription$, 0, 0, 0, @FontStyle)  ProcedureReturn FontStyleEndProcedure;; ****************************************************************************;;-                                  5. DEMO;; ****************************************************************************;CompilerIf #PB_Compiler_IsMainFile  ; The following demo code only runs when this file is compiled directly as the main file:  ;  If OpenWindow(0, 100, 100, 400, 180, "FontRequester Demo", #PB_Window_SystemMenu | #PB_Window_ScreenCentered)    CompilerIf Defined(ApplyDarkModeToWindow, #PB_Procedure)      ApplyDarkModeToWindow(0)    CompilerEndIf    ButtonGadget(1, 50, 20, 300, 40, "Classical FontRequester")    ButtonGadget(2, 50, 70, 300, 40, "Zapman FontRequester")    ButtonGadget(3, 50, 120, 300, 40, "FontRequesterEx")    ;    Define FontDescription$ = "Segoe UI, 9, $FF0000, Italic"    Define UserChoice = 0    ;    Repeat      Select WaitWindowEvent()        Case #PB_Event_Gadget          Select EventGadget()            Case 1              If FontRequester("Segoe UI", 9, #PB_FontRequester_Effects, $FF0000, #PB_Font_Italic, WindowID(0))                FontDescription$ = SelectedFontName() + ", " + Str(SelectedFontSize())                If SelectedFontColor() <> 0                  FontDescription$ + ", $" + Hex(SelectedFontColor())                EndIf                If SelectedFontStyle()                  FontDescription$ + ", " + GetAttributesDescriptionFromNumStyle(SelectedFontStyle())                EndIf                SetGadgetText(1, FontDescription$)              EndIf              ;            Case 2              If ZapmanFontRequester("Segoe UI", 9, #PB_FontRequester_Effects, $FF0000, #PB_Font_Italic, WindowID(0), 70, 120)                ; After calling ZapmanFontRequester(), the simplest way to obtain the full font description                ; is to read ZFR_FontDescription$ directly (e.g. SetGadgetText(2, ZFR_FontDescription$)),                ; and LoadFontFromDescription(ZFR_FontDescription$) loads the matching PureBasic font.                ; The lines below demonstrate compatibility with the individual ZapmanFont...() accessors:                FontDescription$ = ZapmanFontName() + ", " + Str(ZapmanFontSize())                If ZapmanFontColor() <> #PB_Default                  FontDescription$ + ", $" + Hex(ZapmanFontColor())                EndIf                If ZapmanFontStyle()                  FontDescription$ + ", " + GetAttributesDescriptionFromNumStyle(ZapmanFontStyle())                EndIf                SetGadgetText(2, FontDescription$)              EndIf              ;            Case 3              UserChoice = 0              FontDescription$ = FontRequesterEx(FontDescription$, #ZFR_FontRequester_Effects, @UserChoice, WindowID(0), 70, 120)              If UserChoice                SetGadgetText(3, FontDescription$)              EndIf          EndSelect          ;        Case #PB_Event_CloseWindow          Break      EndSelect    ForEver    CloseWindow(0)  EndIf  ;CompilerEndIf; IDE Options = PureBasic 6.41 (Windows - x64); CursorPosition = 384; FirstLine = 189; Folding = AAA9AA-; EnableXP